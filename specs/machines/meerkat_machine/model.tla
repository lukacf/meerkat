ExtractionFailedTerminal(run_id, error) ==
    /\ phase = "Running"
    /\ (current_run_id = Some(run_id))
    /\ (IF (turn_phase = "Extracting") THEN TRUE ELSE (IF (turn_phase = "CallingLlm") THEN TRUE ELSE (turn_phase = "DrainingBoundary")))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ turn_phase' = "Completed"
    /\ turn_terminal_run_id' = Some(run_id)
