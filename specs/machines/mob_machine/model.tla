    /\ ((IF (agent_identity \in DOMAIN spawn_exec_phase) THEN Some((IF agent_identity \in DOMAIN spawn_exec_phase THEN spawn_exec_phase[agent_identity] ELSE "None")) ELSE None) = Some("MaterializePending"))
    /\ (((agent_identity \in identity_entry_tombstones) = FALSE) /\ ((agent_identity \in identity_entry_unreadable) = FALSE))
