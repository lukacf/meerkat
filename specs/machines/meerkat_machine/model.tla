    /\ ~((superseding_interaction_id \in DOMAIN live_interaction_channel_by_id))
    /\ phase' = "Stopped"
    /\ model_step_count' = model_step_count + 1
    /\ live_active_interaction_by_channel' = MapRemove(live_active_interaction_by_channel, channel_id)
