    /\ supervisor_revoke_pending_epoch' = IF (arg_phase = "PreviousRevokePending") THEN Some((IF "value" \in DOMAIN Some(previous_epoch) THEN Some(previous_epoch)["value"] ELSE None)) ELSE supervisor_revoke_pending_epoch
    /\ supervisor_rotation_operation_id' = Some(operation_id)
