transcript_ObserveRepeatedProviderControl(arg_channel, arg_sequence, arg_kind, arg_digest, arg_record_bytes) ==
    /\ \E packet \in SeqElements(pending_inputs) :
       /\ packet.machine = "transcript"
       /\ packet.variant = "ObserveProviderControl"
       /\ packet.payload.channel = arg_channel
       /\ packet.payload.sequence = arg_sequence
       /\ packet.payload.kind = arg_kind
       /\ packet.payload.digest = arg_digest
       /\ packet.payload.record_bytes = arg_record_bytes
       /\ ~HigherPriorityReady("transcript_authority")
       /\ transcript_phase = "Ready"
       /\ ((packet.payload.channel \in transcript_voice_channels) /\ ((IF (packet.payload.digest \in DOMAIN transcript_provider_control_channels) THEN Some((IF packet.payload.digest \in DOMAIN transcript_provider_control_channels THEN transcript_provider_control_channels[packet.payload.digest] ELSE "None")) ELSE None) = Some(packet.payload.channel)))
       /\ transcript_phase' = "Ready"
       /\ UnchangedFrame_7118e09940adb079
       /\ pending_inputs' = SeqRemove(pending_inputs, packet)
       /\ observed_inputs' = observed_inputs
       /\ pending_routes' = pending_routes
       /\ delivered_routes' = delivered_routes
       /\ emitted_effects' = emitted_effects \cup { [machine |-> "transcript", variant |-> "ProviderControlUnchanged", payload |-> [channel |-> packet.payload.channel, digest |-> packet.payload.digest, sequence |-> (IF "value" \in DOMAIN (IF (packet.payload.digest \in DOMAIN transcript_provider_control_sequences) THEN Some((IF packet.payload.digest \in DOMAIN transcript_provider_control_sequences THEN transcript_provider_control_sequences[packet.payload.digest] ELSE 0)) ELSE None) THEN (IF (packet.payload.digest \in DOMAIN transcript_provider_control_sequences) THEN Some((IF packet.payload.digest \in DOMAIN transcript_provider_control_sequences THEN transcript_provider_control_sequences[packet.payload.digest] ELSE 0)) ELSE None)["value"] ELSE None)], effect_id |-> (model_step_count + 1), source_transition |-> "ObserveRepeatedProviderControl"] }
       /\ observed_transitions' = observed_transitions \cup {[machine |-> "transcript", transition |-> "ObserveRepeatedProviderControl", actor |-> "transcript_authority", step |-> (model_step_count + 1), from_phase |-> transcript_phase, to_phase |-> "Ready"]}
       /\ model_step_count' = model_step_count + 1


transcript_RefuseConflictingProviderStart(arg_channel, arg_sequence, arg_kind, arg_digest, arg_record_bytes) ==
    /\ \E packet \in SeqElements(pending_inputs) :
       /\ packet.machine = "transcript"
       /\ packet.variant = "ObserveProviderControl"
