BeginImageOperationAcceptedIdle(operation_id, target_model, target_realtime_capable, requires_approval, approval_available, approval_denied, approval_reason, realtime_detach_allowed, requires_scoped_override) ==
    /\ phase = "Idle"
    /\ (model_routing_baseline_model # None)
    /\ (model_routing_operation_override_id = None)
    /\ (IF ~(requires_approval) THEN TRUE ELSE (approval_available /\ ~(approval_denied)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ model_routing_image_operation_phases' = MapSet(model_routing_image_operation_phases, operation_id, "PlanResolved")
    /\ model_routing_image_operation_target_models' = MapSet(model_routing_image_operation_target_models, operation_id, target_model)
    /\ model_routing_image_operation_realtime' = MapSet(model_routing_image_operation_realtime, operation_id, target_realtime_capable)
    /\ model_routing_image_operation_requires_scoped_override' = IF requires_scoped_override THEN MapSet(model_routing_image_operation_requires_scoped_override, operation_id, TRUE) ELSE model_routing_image_operation_requires_scoped_override
