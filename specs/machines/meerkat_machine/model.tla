ClassifyImageOperationTerminalProviderFailedRunning(operation_id, observation, http_status_code, error_code, provider_text) ==
    /\ phase = "Running"
    /\ (operation_id \in DOMAIN model_routing_image_operation_phases)
    /\ (IF (observation = "ProviderHttpError") THEN TRUE ELSE (observation = "ProviderNativeError"))
    /\ ((http_status_code # Some(408)) /\ (http_status_code # Some(504)) /\ (error_code # "GeminiDeadlineExceeded"))
    /\ (http_status_code # Some(499))
    /\ ((error_code # "OpenAiContentFilter") /\ (error_code # "GeminiSafety"))
    /\ ((error_code # "OpenAiModelRefusal") /\ (error_code # "GeminiModelRefusal"))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ model_routing_image_classified_terminals' = MapSet(model_routing_image_classified_terminals, operation_id, "Failed")
    /\ model_routing_image_classified_provider_text' = MapSet(model_routing_image_classified_provider_text, operation_id, provider_text)
