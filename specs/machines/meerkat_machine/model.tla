    /\ live_cancelled_recovery_channels' = IF (((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id)) /\ (IF (channel_id \in DOMAIN live_context_recovery_source_by_replacement) THEN TRUE ELSE (channel_id \in DOMAIN live_result_recovery_source_by_replacement))) THEN (live_cancelled_recovery_channels \cup {channel_id}) ELSE live_cancelled_recovery_channels
