#!/usr/bin/env python3
"""Scrub a recorded gpt-live provider stream into a committable replay fixture.

The live e2e harness writes `provider-stream.jsonl` beside each journal (see
`meerkat_openai::public_live::provider_recording`). That raw recording is an
evidence artifact; it can carry WebRTC SDP (ICE credentials, host candidates),
any credential-shaped value the provider echoes, and voice audio. This tool rewrites it so
it can be committed as a replay fixture, and refuses to write anything that
still matches a forbidden pattern afterwards.

Usage:
  gpt-live-scrub-provider-stream scrub IN.jsonl OUT.jsonl
  gpt-live-scrub-provider-stream check FILE_OR_DIR...

`check` is the CI gate for committed fixtures: it exits nonzero when any line
of any `*.jsonl` file matches a forbidden pattern. Findings print as
`path:line: rule` only; the matched text is never printed.

Exact secret values from the environment (OPENAI_API_KEY, RKAT_OPENAI_API_KEY,
BUILDBUDDY_API_KEY) are also scrubbed and checked when set.
"""

from __future__ import annotations

import base64
import json
import math
import struct
import os
import re
import sys
from pathlib import Path
from typing import Any

# Object keys whose values are dropped wholesale, compared case-insensitively.
REDACTED_KEYS = {
    "sdp",
    "client_secret",
    "authorization",
    "api_key",
    "apikey",
    "token",
    "access_token",
    "refresh_token",
    "ephemeral_key",
    "secret",
    "password",
    "cookie",
    "set-cookie",
}

# Value patterns that must never appear in a fixture. Scrub replaces them;
# check fails on them.
FORBIDDEN = [
    ("openai-key", re.compile(r"sk-[A-Za-z0-9_\-]{8,}")),
    ("ephemeral-key", re.compile(r"\bek_[A-Za-z0-9_\-]{8,}")),
    ("bearer", re.compile(r"(?i)bearer\s+[A-Za-z0-9._\-~+/=]{8,}")),
    ("jwt", re.compile(r"eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}")),
    ("sdp-ice-credential", re.compile(r"a=ice-(?:pwd|ufrag):\S+")),
    ("sdp-candidate", re.compile(r"a=candidate:[^\"\\]+")),
    # Anchored at a run boundary and bounded, so long base64 runs scan once.
    (
        "email",
        re.compile(r"(?<![A-Za-z0-9._%+\-])[A-Za-z0-9._%+\-]{1,64}@[A-Za-z0-9\-]{1,63}\.[A-Za-z0-9.\-]{2,}"),
    ),
    ("home-path", re.compile(r"/(?:home|Users)/[A-Za-z0-9._\-]+")),
    ("ipv4", re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")),
]

# Audio payload fields on provider audio frames (`session.input_audio.append`
# reflected uplink, `session.output_audio.delta` model speech). Replay needs
# their decoded length (timing and latency are derived from it), never the
# voice: scrub replaces each with `<silence-bytes:N>` (N decoded bytes), which
# the replay server expands to N zero bytes. A frame carrying speech energy
# keeps one bit of it: `<speech-bytes:N>`, which the replay server expands to
# N bytes of a fixed tone. The broker ends the user's floor on reflected-input
# silence (`session.input_audio.append`) and ends the model's response on
# model-output silence (`session.output_audio.delta`, where a deferred result
# cue is released), so the speech/silence bit of both streams (never the
# voice) is part of what a replay must reproduce. Check rejects any other
# value.
AUDIO_FIELDS = ("audio", "delta")
# meerkat_openai::public_live::USER_FLOOR_SPEECH_DBFS: the same floor.
SPEECH_DBFS = -50.0
# The audio frames whose speech/silence bit replay reproduces.
SPEECH_BIT_FRAMES = ("session.input_audio.append", "session.output_audio.delta")

ENV_SECRETS = ("OPENAI_API_KEY", "RKAT_OPENAI_API_KEY", "BUILDBUDDY_API_KEY")


def env_secrets() -> list[str]:
    values = [os.environ.get(name, "") for name in ENV_SECRETS]
    return sorted({value for value in values if len(value) >= 8}, key=len, reverse=True)


def scrub_text(text: str, secrets: list[str]) -> str:
    for secret in secrets:
        text = text.replace(secret, "<redacted-env-secret>")
    for rule, pattern in FORBIDDEN:
        text = pattern.sub(f"<redacted-{rule}>", text)
    return text


def scrub_value(value: Any, secrets: list[str]) -> Any:
    if isinstance(value, dict):
        out = {}
        for key, item in value.items():
            if key.lower() in REDACTED_KEYS and item is not None:
                out[key] = f"<redacted-{key.lower()}>"
            else:
                out[key] = scrub_value(item, secrets)
        return out
    if isinstance(value, list):
        return [scrub_value(item, secrets) for item in value]
    if isinstance(value, str):
        return scrub_text(value, secrets)
    return value


def audio_field(frame: Any) -> str | None:
    if not isinstance(frame, dict) or "audio" not in str(frame.get("type", "")):
        return None
    for field in AUDIO_FIELDS:
        if isinstance(frame.get(field), str):
            return field
    return None


PLACEHOLDER = re.compile(r"<(silence|speech)-bytes:[0-9]+>")


def frame_dbfs(data: bytes) -> float:
    samples = len(data) // 2
    if samples == 0:
        return float("-inf")
    total = sum(v * v for (v,) in struct.iter_unpack("<h", data[: samples * 2]))
    rms = math.sqrt(total / samples)
    return 20 * math.log10(rms / 32768) if rms > 0 else float("-inf")


def placeholder(payload: str, keep_speech_bit: bool) -> str:
    """The content-free stand-in for one audio payload."""
    if PLACEHOLDER.fullmatch(payload):
        return payload
    try:
        data = base64.b64decode(payload, validate=True)
    except ValueError:
        return f"<silence-bytes:{len(payload) * 3 // 4}>"
    kind = "speech" if keep_speech_bit and frame_dbfs(data) >= SPEECH_DBFS else "silence"
    return f"<{kind}-bytes:{len(data)}>"


def zero_fill_audio(line: Any) -> Any:
    frame = line.get("entry", {}).get("raw") if isinstance(line, dict) else None
    field = audio_field(frame)
    if field:
        frame[field] = placeholder(frame[field], frame.get("type") in SPEECH_BIT_FRAMES)
    return line


def audio_findings(raw: str) -> list[str]:
    try:
        line = json.loads(raw)
    except json.JSONDecodeError:
        return ["not-json"]
    frame = line.get("entry", {}).get("raw") if isinstance(line, dict) else None
    field = audio_field(frame)
    if not field:
        return []
    match = PLACEHOLDER.fullmatch(frame[field])
    if not match:
        return ["voice-audio"]
    if match.group(1) == "speech" and frame.get("type") not in SPEECH_BIT_FRAMES:
        return ["speech-bit-outside-audio-stream"]
    return []


def findings(text: str, secrets: list[str]) -> list[str]:
    rules = [rule for rule, pattern in FORBIDDEN if pattern.search(text)]
    if any(secret in text for secret in secrets):
        rules.append("env-secret")
    for key in REDACTED_KEYS:
        # Any value but a scrub placeholder or null: strings, objects, lists.
        pattern = r'"%s"\s*:(?!\s*"<redacted-|\s*null\b)' % re.escape(key)
        if re.search(pattern, text, re.I):
            rules.append(f"key:{key}")
    return rules


def scrub(source: Path, target: Path) -> int:
    secrets = env_secrets()
    lines = []
    for number, raw in enumerate(source.read_text().splitlines(), start=1):
        if not raw.strip():
            continue
        try:
            line = json.loads(raw)
        except json.JSONDecodeError:
            print(f"{source}:{number}: not JSON; refusing to scrub", file=sys.stderr)
            return 2
        text = json.dumps(
            scrub_value(zero_fill_audio(line), secrets), ensure_ascii=False, sort_keys=True
        )
        rules = findings(text, secrets) + audio_findings(text)
        if rules:
            print(f"{source}:{number}: still forbidden after scrub: {', '.join(rules)}", file=sys.stderr)
            return 1
        lines.append(text)
    if not lines:
        print(f"{source}: empty recording; refusing to write a fixture", file=sys.stderr)
        return 2
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join(lines) + "\n")
    print(f"wrote {target} ({len(lines)} lines)")
    return 0


def check(paths: list[Path]) -> int:
    secrets = env_secrets()
    files: list[Path] = []
    for path in paths:
        files.extend(sorted(path.rglob("*.jsonl")) if path.is_dir() else [path])
    bad = 0
    for file in files:
        for number, raw in enumerate(file.read_text().splitlines(), start=1):
            if not raw.strip():
                continue
            for rule in findings(raw, secrets) + audio_findings(raw):
                print(f"{file}:{number}: {rule}")
                bad += 1
    print(f"checked {len(files)} fixture file(s): {bad} finding(s)")
    return 1 if bad else 0


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[0] == "scrub":
        return scrub(Path(argv[1]), Path(argv[2]))
    if len(argv) >= 2 and argv[0] == "check":
        return check([Path(arg) for arg in argv[1:]])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
