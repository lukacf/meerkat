DeferInputBehindBacklogAlreadyResolvedIdle(input_id) ==
    /\ phase = "Idle"
    /\ (input_id \in DOMAIN input_phases)
    /\ ~((input_id \in DOMAIN input_lane))
    /\ ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") # "Queued")
