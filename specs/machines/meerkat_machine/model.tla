ResolveVisibleRuntimePhasePublishControlVisibleRewriteIdle(dsl_phase, dsl_pre_run_phase, control_phase, control_pre_run_phase, has_runtime_persistence) ==
    /\ phase = "Idle"
    /\ ((has_runtime_persistence = TRUE) /\ (control_phase # dsl_phase) /\ (IF (dsl_phase = "Retired") THEN TRUE ELSE (IF (dsl_phase = "Stopped") THEN TRUE ELSE (IF (dsl_phase = "Destroyed") THEN TRUE ELSE (IF (control_phase = "Running") THEN TRUE ELSE (IF (control_phase = "Retired") THEN TRUE ELSE (IF (control_phase = "Stopped") THEN TRUE ELSE (control_phase = "Destroyed"))))))) /\ ~(((control_phase = "Retired") /\ (dsl_phase = "Running") /\ (dsl_pre_run_phase = Some("Retired")))))
