    /\ phase = "Running"
    /\ (placed_completion_lifecycle_quiescing = FALSE)
    /\ ((host_id \in DOMAIN host_bind_phase) = FALSE)
    /\ ((host_id \in DOMAIN replacement_host_bind_endpoints) = FALSE)
    /\ (\A id \in DOMAIN member_placement : ((IF (id \in DOMAIN member_placement) THEN Some((IF id \in DOMAIN member_placement THEN member_placement[id] ELSE "None")) ELSE None) # Some(host_id)))
    /\ (binding_generation > 0)
