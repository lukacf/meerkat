RECURSIVE BeginSpawnExecRemote_ForEach0_member_boot_obligation_owed(_, _, _, _)
BeginSpawnExecRemote_ForEach0_member_boot_obligation_owed(acc, remaining, outer_agent_identity, captured_member_placement) == IF remaining = {} THEN acc ELSE LET item == CHOOSE x \in remaining : TRUE IN LET member_id == item IN LET next_acc == IF (((IF (member_id \in DOMAIN member_materialization) THEN Some((IF member_id \in DOMAIN member_materialization THEN member_materialization[member_id] ELSE "None")) ELSE None) = Some("Dormant")) /\ ((member_id \in DOMAIN captured_member_placement) = FALSE) /\ ((member_id \in DOMAIN acc) = FALSE) /\ mob_machine_wiring_contains_pair(wiring_edges, member_id, outer_agent_identity)) THEN IF ((member_id \in DOMAIN member_peer_endpoints) = TRUE) THEN MapSet(acc, member_id, "PlacedPeerWired") ELSE MapSet(acc, member_id, "EndpointPending") ELSE acc IN BeginSpawnExecRemote_ForEach0_member_boot_obligation_owed(next_acc, remaining \ {item}, outer_agent_identity, captured_member_placement)

