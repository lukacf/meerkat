ObserveLiveProviderTurnStartedIdle(channel_id, runtime_id, fence_token, generation, interaction_id, provider_turn_ref) ==
    /\ phase = "Idle"
    /\ ((interaction_id # "") /\ (provider_turn_ref # ""))
    /\ ((IF (channel_id \in DOMAIN live_execution_runtime_id_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_runtime_id_by_channel THEN live_execution_runtime_id_by_channel[channel_id] ELSE "None")) ELSE None) = Some(runtime_id))
    /\ ((IF (channel_id \in DOMAIN live_execution_fence_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_fence_by_channel THEN live_execution_fence_by_channel[channel_id] ELSE "None")) ELSE None) = Some(fence_token))
    /\ ((IF (channel_id \in DOMAIN live_execution_generation_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_generation_by_channel THEN live_execution_generation_by_channel[channel_id] ELSE "None")) ELSE None) = Some(generation))
    /\ (~((interaction_id \in DOMAIN live_interaction_channel_by_id)) /\ ~((interaction_id \in live_abandoned_interactions)) /\ ~((provider_turn_ref \in DOMAIN live_provider_interaction_by_turn)) /\ ~((provider_turn_ref \in DOMAIN live_provider_turn_channel_by_ref)))
    /\ (~((channel_id \in DOMAIN live_provider_turn_by_channel)) /\ ~((channel_id \in DOMAIN live_active_interaction_by_channel)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_conversation_started_channels' = (live_conversation_started_channels \cup {channel_id})
    /\ live_interaction_channel_by_id' = MapSet(live_interaction_channel_by_id, interaction_id, channel_id)
    /\ live_active_interaction_by_channel' = MapSet(live_active_interaction_by_channel, channel_id, interaction_id)
    /\ live_provider_turn_by_channel' = MapSet(live_provider_turn_by_channel, channel_id, provider_turn_ref)
    /\ live_provider_interaction_by_turn' = MapSet(live_provider_interaction_by_turn, provider_turn_ref, interaction_id)
    /\ live_provider_turn_channel_by_ref' = MapSet(live_provider_turn_channel_by_ref, provider_turn_ref, channel_id)
    /\ live_awaiting_assistant_interaction_by_channel' = MapRemove(live_awaiting_assistant_interaction_by_channel, channel_id)
    /\ live_result_speech_suppressed_operations' = IF (channel_id \in DOMAIN live_result_delivery_operation_by_channel) THEN (live_result_speech_suppressed_operations \cup {(IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_result_delivery_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_result_delivery_operation_by_channel THEN live_result_delivery_operation_by_channel[channel_id] ELSE "None")) ELSE None) THEN (IF (channel_id \in DOMAIN live_result_delivery_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_result_delivery_operation_by_channel THEN live_result_delivery_operation_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None)}) ELSE live_result_speech_suppressed_operations
    /\ UnchangedFrame_83d76c82c5d5249a


