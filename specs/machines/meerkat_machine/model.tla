ResolveStagedRollbackMaxAttemptsExhaustedIdle(input_id, lane) ==
    /\ phase = "Idle"
    /\ (input_id \in DOMAIN input_phases)
    /\ ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") = "Staged")
    /\ (input_id \in DOMAIN input_attempt_counts)
    /\ ((input_id \in DOMAIN input_recovery_lanes) /\ ((IF input_id \in DOMAIN input_recovery_lanes THEN input_recovery_lanes[input_id] ELSE "None") = lane))
    /\ ((IF input_id \in DOMAIN input_attempt_counts THEN input_attempt_counts[input_id] ELSE 0) >= max_stage_attempts)
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ input_phases' = MapSet(input_phases, input_id, "Abandoned")
    /\ input_terminal_kind' = MapSet(input_terminal_kind, input_id, "Abandoned")
