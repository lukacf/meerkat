    /\ (adaptive_active_run = None)
    /\ ((adaptive_run_id \in DOMAIN adaptive_run_phase) = FALSE)
    /\ mob_machine_adaptive_lifecycle_drained(adaptive_active_run, adaptive_active_layer, adaptive_active_members, adaptive_layer_phase, adaptive_layer_disposition)
    /\ ((max_depth > 0) /\ (max_total_decisions > 0) /\ (max_repair_attempts > 0) /\ (max_layer_failures > 0) /\ (max_attempts_per_layer > 0) /\ (max_members_per_layer > 0) /\ (max_total_spawned_members > 0) /\ (max_active_members > 0) /\ (max_retained_layer_mobs > 0) /\ (max_aggregate_tokens > 0) /\ (max_aggregate_tool_calls > 0) /\ (deadline_ms > 0))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ adaptive_active_run' = Some(adaptive_run_id)
    /\ adaptive_run_phase' = MapSet(adaptive_run_phase, adaptive_run_id, "Active")
    /\ adaptive_limit_max_depth' = MapSet(adaptive_limit_max_depth, adaptive_run_id, max_depth)
    /\ adaptive_limit_max_total_decisions' = MapSet(adaptive_limit_max_total_decisions, adaptive_run_id, max_total_decisions)
    /\ adaptive_limit_max_repair_attempts' = MapSet(adaptive_limit_max_repair_attempts, adaptive_run_id, max_repair_attempts)
    /\ adaptive_limit_max_layer_failures' = MapSet(adaptive_limit_max_layer_failures, adaptive_run_id, max_layer_failures)
    /\ adaptive_limit_max_attempts_per_layer' = MapSet(adaptive_limit_max_attempts_per_layer, adaptive_run_id, max_attempts_per_layer)
    /\ adaptive_limit_max_members_per_layer' = MapSet(adaptive_limit_max_members_per_layer, adaptive_run_id, max_members_per_layer)
    /\ adaptive_limit_max_total_spawned_members' = MapSet(adaptive_limit_max_total_spawned_members, adaptive_run_id, max_total_spawned_members)
    /\ adaptive_limit_max_active_members' = MapSet(adaptive_limit_max_active_members, adaptive_run_id, max_active_members)
