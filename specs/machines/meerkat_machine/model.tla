PeerRequestReceivedIdle(corr_id, handling_mode) ==
    /\ phase = "Idle"
    /\ (session_id # None)
    /\ ~((corr_id \in DOMAIN inbound_peer_requests))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
