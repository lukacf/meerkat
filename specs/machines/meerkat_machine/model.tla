RecordLiveCommandRejectedIdle(channel_id, command, rejection) ==
    /\ phase = "Idle"
    /\ (channel_id # "")
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_command_rejection_sequence' = (live_command_rejection_sequence) + 1
