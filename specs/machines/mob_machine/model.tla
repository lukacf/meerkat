    /\ member_restore_failures' = MapRemove(member_restore_failures, agent_identity)
    /\ member_restore_failure_codes' = MapRemove(member_restore_failure_codes, agent_identity)
    /\ runtime_retire_pending_sessions' = MapSet(runtime_retire_pending_sessions, agent_runtime_id, (IF "value" \in DOMAIN session_id THEN session_id["value"] ELSE None))
    /\ member_materialization' = MapRemove(member_materialization, agent_identity)
    /\ member_state_markers' = MapSet(member_state_markers, agent_runtime_id, "Retiring")
    /\ member_session_bindings' = MapRemove(member_session_bindings, agent_identity)
    /\ pending_session_ingress_detach_runtime_ids' = (pending_session_ingress_detach_runtime_ids \cup {agent_runtime_id})
    /\ topology_epoch' = (topology_epoch) + 1
    /\ member_wake_attempts' = MapRemove(member_wake_attempts, agent_identity)
    /\ member_wake_bound' = (member_wake_bound \ {agent_identity})
    /\ member_materialization_epoch' = MapRemove(member_materialization_epoch, agent_identity)
    /\ member_boot_obligation_owed' = MapRemove(member_boot_obligation_owed, agent_identity)
