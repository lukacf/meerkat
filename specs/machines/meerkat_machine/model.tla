    /\ phase = "Attached"
    /\ (surface_phase = "Operating")
    /\ ((surface_id \in DOMAIN surface_staged_op) /\ ((IF surface_id \in DOMAIN surface_staged_op THEN surface_staged_op[surface_id] ELSE "None") = "Add"))
    /\ ((surface_id \in DOMAIN surface_staged_intent_sequence) /\ ((IF surface_id \in DOMAIN surface_staged_intent_sequence THEN surface_staged_intent_sequence[surface_id] ELSE 0) = staged_intent_sequence))
    /\ (IF ~((surface_id \in DOMAIN surface_pending_op)) THEN TRUE ELSE ((IF surface_id \in DOMAIN surface_pending_op THEN surface_pending_op[surface_id] ELSE "None") = "None"))
    /\ (IF ~((surface_id \in DOMAIN surface_base_state)) THEN TRUE ELSE (IF ((IF surface_id \in DOMAIN surface_base_state THEN surface_base_state[surface_id] ELSE "None") = "Absent") THEN TRUE ELSE (IF ((IF surface_id \in DOMAIN surface_base_state THEN surface_base_state[surface_id] ELSE "None") = "Active") THEN TRUE ELSE ((IF surface_id \in DOMAIN surface_base_state THEN surface_base_state[surface_id] ELSE "None") = "Removed"))))
    /\ phase' = "Attached"
    /\ model_step_count' = model_step_count + 1
    /\ known_surfaces' = (known_surfaces \cup {surface_id})
    /\ surface_pending_op' = MapSet(surface_pending_op, surface_id, "Add")
    /\ surface_staged_op' = MapRemove(surface_staged_op, surface_id)
    /\ reload_staged_surfaces' = (reload_staged_surfaces \ {surface_id})
    /\ surface_staged_intent_sequence' = MapRemove(surface_staged_intent_sequence, surface_id)
    /\ surface_pending_task_sequence' = MapSet(surface_pending_task_sequence, surface_id, (next_pending_task_sequence + 1))
    /\ next_pending_task_sequence' = (next_pending_task_sequence + 1)
    /\ surface_pending_lineage_sequence' = MapSet(surface_pending_lineage_sequence, surface_id, staged_intent_sequence)
    /\ surface_last_delta_operation' = MapSet(surface_last_delta_operation, surface_id, "Add")
    /\ surface_last_delta_phase' = MapSet(surface_last_delta_phase, surface_id, "Pending")
    /\ snapshot_epoch' = (snapshot_epoch + 1)
