RecordLiveRefreshQueuedIdle(channel_id, queue_acceptance_sequence) ==
    /\ phase = "Idle"
    /\ (channel_id # "")
    /\ (queue_acceptance_sequence > 0)
    /\ (IF ~((channel_id \in DOMAIN live_refresh_queue_acceptance_sequence_by_channel)) THEN TRUE ELSE (queue_acceptance_sequence > (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_refresh_queue_acceptance_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_refresh_queue_acceptance_sequence_by_channel THEN live_refresh_queue_acceptance_sequence_by_channel[channel_id] ELSE 0)) ELSE None) THEN (IF (channel_id \in DOMAIN live_refresh_queue_acceptance_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_refresh_queue_acceptance_sequence_by_channel THEN live_refresh_queue_acceptance_sequence_by_channel[channel_id] ELSE 0)) ELSE None)["value"] ELSE None)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_refresh_result_sequence' = (live_refresh_result_sequence) + 1
