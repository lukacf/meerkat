layer_mob_ClassifyFlowFrameTerminalStatusFailedRunning(arg_frame_id) ==
    /\ \E packet \in SeqElements(pending_inputs) :
       /\ packet.machine = "layer_mob"
       /\ packet.variant = "ClassifyFlowFrameTerminalStatus"
       /\ packet.payload.frame_id = arg_frame_id
       /\ ~HigherPriorityReady("layer_mob_authority")
       /\ layer_mob_phase = "Running"
