CommitSpawnMembershipRemote(agent_identity, agent_runtime_id, fence_token, generation, profile_material_digest, external_addressable, runtime_mode, bridge_session_id, replacing, member_peer_endpoint, spec_digest_echo, ack_engine_version, placed_spawn_id, provision_operation_id, definition_wiring_exempt) ==
    /\ phase = "Running"
    /\ ((IF (agent_identity \in DOMAIN spawn_exec_phase) THEN Some((IF agent_identity \in DOMAIN spawn_exec_phase THEN spawn_exec_phase[agent_identity] ELSE "None")) ELSE None) = Some("MaterializePending"))
    /\ ((agent_identity \in DOMAIN member_placement) = TRUE)
    /\ (definition_wiring_exempt = FALSE)
    /\ ((agent_identity \in DOMAIN member_session_bindings) = FALSE)
    /\ ((agent_identity \in DOMAIN identity_to_runtime) = FALSE)
    /\ (Some(generation) = mob_machine_next_minted_generation(identity_runtime_generations, identity_generation_highwater, agent_identity))
    /\ (replacing = None)
    /\ (bridge_session_id # None)
    /\ (member_peer_endpoint # None)
    /\ (\A other \in DOMAIN member_peer_endpoints : (IF (other = agent_identity) THEN TRUE ELSE (mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN (IF (other \in DOMAIN member_peer_endpoints) THEN Some((IF other \in DOMAIN member_peer_endpoints THEN member_peer_endpoints[other] ELSE "None")) ELSE None) THEN (IF (other \in DOMAIN member_peer_endpoints) THEN Some((IF other \in DOMAIN member_peer_endpoints THEN member_peer_endpoints[other] ELSE "None")) ELSE None)["value"] ELSE None)) # mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN member_peer_endpoint THEN member_peer_endpoint["value"] ELSE None)))))
    /\ (\A host \in mob_hosts : (mob_machine_host_id_matches_peer_id(host, mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN member_peer_endpoint THEN member_peer_endpoint["value"] ELSE None))) = FALSE))
    /\ ((placed_spawn_id # None) /\ ((IF (agent_identity \in DOMAIN pending_placed_spawn_ids) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_ids THEN pending_placed_spawn_ids[agent_identity] ELSE "None")) ELSE None) = placed_spawn_id))
    /\ ((IF (agent_identity \in DOMAIN pending_placed_spawn_generations) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_generations THEN pending_placed_spawn_generations[agent_identity] ELSE "None")) ELSE None) = Some(generation))
    /\ ((IF (agent_identity \in DOMAIN pending_placed_spawn_fence_tokens) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_fence_tokens THEN pending_placed_spawn_fence_tokens[agent_identity] ELSE "None")) ELSE None) = Some(fence_token))
    /\ ((IF (agent_identity \in DOMAIN pending_placed_spawn_hosts) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_hosts THEN pending_placed_spawn_hosts[agent_identity] ELSE "None")) ELSE None) = (IF (agent_identity \in DOMAIN member_placement) THEN Some((IF agent_identity \in DOMAIN member_placement THEN member_placement[agent_identity] ELSE "None")) ELSE None))
