 \in {} |-> None])) ELSE None) THEN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None)["value"] ELSE None)) THEN Some((IF step_id \in DOMAIN (IF "value" \in DOMAIN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None) THEN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None)["value"] ELSE None) THEN (IF "value" \in DOMAIN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None) THEN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None)["value"] ELSE None)[step_id] ELSE None)) ELSE None) = Some(Some("Skipped"))) THEN TRUE ELSE ((IF (step_id \in DOMAIN (IF "value" \in DOMAIN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None) THEN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None)["value"] ELSE None)) THEN Some((IF step_id \in DOMAIN (IF "value" \in DOMAIN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \in DOMAIN control_mob_run_step_status THEN control_mob_run_step_status[run_id] ELSE [x \in {} |-> None])) ELSE None) THEN (IF (run_id \in DOMAIN control_mob_run_step_status) THEN Some((IF run_id \