            b and f.get('door') == f'"{door}"' and f.get('drop_partial') == 'TRUE' and admitted(1) and issue_once
            and 'B_DropSend' in actions)
    for door in ['Find', 'Launch']:
        for site in ['P', 'A']:
            for initial in ['First', 'Partial', 'Bound']:
                checks[f'row-held-b-{door.lower()}-{site.lower()}-{initial.lower()}'] = held(door, site, initial)
    return checks


def witness(name, fields, actions):
    checks = {**attempt_checks(fields, actions), **stage_b_checks(fields, actions)}
    if name not in checks:
        raise ValueError('no final-state predicate for ' + name)
    if not checks[name]:
        raise ValueError('wrong final state for ' + name)


def lasso(text):
    """The states of a liveness counterexample and how it repeats (a loop back or stuttering)."""
    body = text.split('The following behavior constitutes a counter-example:', 1)
    if len(body) != 2:
        raise ValueError('missing liveness counterexample')
    states, current = [], []
    for line in body[1].splitlines():
        if re.match(r'^(State )?\d+: ', line) or line.startswith('Back to state'):
            if current:
                states.append(parse_fields('\n'.join(current)))
            current = []
            continue
        current.append(line)
    if current:
        states.append(parse_fields('\n'.join(current)))
    states = [s for s in states if s]
    if re.search(r'^State \d+: Stuttering', body[1], re.MULTILINE) or 'Stuttering' in body[1]:
        loop = 'stuttering'
    elif 'Back to state' in body[1]:
        loop = 'back-to-state'
    else:
        raise ValueError('liveness counterexample without a loop')
    return states, loop


def live_witness(name, states, loop):
    last = states[-1]
    f = last.get
    procs = records(f('sp'))
    journal = records(f('jr'))

    def proc(**want):
        return any(all(q(p.get(k)) == v for k, v in want.items()) for p in procs)

    def jr(slot, key):
        return q(journal[slot - 1].get(key)) if len(journal) >= slot else ''

    native = tuples(f('native'))
    keys3 = [t[:3] for t in native]
    checks = {
        # The send's intent was committed and is never dispatched.
        'live-no-dispatch-fairness': f('offer_phase') == '"Offered"' and proc(pc='Call'),
        # Every read unavailable: Core admitted the key and the record is never observed.
        'live-core-unavailable-forever': f('offer_phase') == '"Offered"' and ['inc1', 'k1', '1'] in keys3
            and jr(1, 'read_owed') == 'TRUE' and any(s.get('raw_read') == '"Unavailable"' for s in states),
        'live-no-read-fairness': f('offer_phase') == '"Offered"' and ['inc1', 'k1', '1'] in keys3
            and jr(1, 'read_owed') == 'TRUE',
        # The wait's condition cleared before its deadline; the waiter never woke, the send ran
        # into the deadline and gave up, Held, the source free.
        'live-never-rebind': proc(out='Held', cause='SourceHeld') and f('gate') == '"Free"'
            and any(s.get('gate') == '"Free"' and 'MetaWait' in (s.get('sp') or '') for s in states),
        'live-no-restart-fairness': f('alive') == 'FALSE',
        'live-no-preparer-fairness': any(q(p.get('st')) == 'Running' for p in records(f('prep'))),
        'live-no-orphan-withdrawal': f('offer_phase') == '"Prepared"' and f('offer_preparation_epoch') == '1'
            and f('epoch') == '2',
        # The wait's condition persists and the deadline never passes.
        'live-no-deadline': (proc(pc='MetaWait', dl='FALSE') or proc(pc='PeerWait', dl='FALSE'))
            and (f('gate') == '"Held"' or f('current_inc') == '"inc2"'),
        'live-no-reoffer-fairness': f('door') == '"Peer"' and jr(1, 'fifo') == 'TRUE',
        # The live read fed as durable: the claim stays held and queued, the reads go on.
        'live-read-as-durable': f('door') == '"Peer"' and jr(1, 'fifo') == 'TRUE' and jr(1, 'held') == 'TRUE',
        # Without the declared wait assumption a send waits forever.
        'live-driver-only-disposition': f('offer_phase') == '"Offered"'
            and (proc(pc='MetaWait') or proc(pc='PeerWait')),
        'live-driver-only-rebind': proc(pc='MetaWait', dl='FALSE') and f('gate') == '"Free"',
        'live-driver-only-send-ends': proc(pc='MetaWait') or proc(pc='PeerWait'),
    }
    if name not in checks:
        raise ValueError('no liveness predicate for ' + name)
    if not checks[name]:
        raise ValueError('wrong liveness counterexample for ' + name)


def main():
    generated, run = Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()
    base_workers = int(sys.argv[3]) if len(sys.argv) > 3 else 1
    manifest = json.loads((generated / 'manifest.json').read_text())
    generator = Path(__file__).with_name('generate-combined-composition')
    if sha(generator) != manifest['generator_sha256']:
        raise ValueError('generator changed after export')
    source = Path(__file__).resolve().parents[1] / 'models' / manifest['attempt_model']['name']
    if sha(source) != manifest['attempt_model']['sha256']:
        raise ValueError('the attempt model changed after export')
    artifacts = manifest['artifact_hashes']
    if any(sha(generated / name) != digest for name, digest in artifacts.items()):
        raise ValueError('export changed')
    for name in manifest['profiles']:
        if re.search(r'CHECK_DEADLOCK\s+FALSE', (generated / (name + '.cfg')).read_text()):
            raise ValueError('generic deadlock checking must stay on')
    # An owner mutant's modules differ from the composed ones only where the manifest says: the
    # owner by its header and one guard conjunct, the combined module by its header and the two
    # offer INSTANCE lines.
    owner_text = (generated / 'offer_owner.tla').read_text()
    combined_text = (generated / 'combined_composition.tla').read_text()
    for mutant, spec in manifest.get('owner_mutants', {}).items():
        ident = spec['owner_module'].removeprefix('offer_owner_')
        expected_owner = owner_text.replace('---- MODULE offer_owner ----', f'---- MODULE {spec["owner_module"]} ----', 1)
        start = expected_owner.index('\n' + spec['transition'] + '(') + 1
        end = expected_owner.index('\n\n', start)
        block = expected_owner[start:end]
        if block.count(spec['conjunct']) != 1:
            raise ValueError(f'{mutant}: conjunct not unique in {spec["transition"]}')
        expected_owner = expected_owner[:start] + block.replace(spec['conjunct'], spec['replacement']) + expected_owner[end:]
        if (generated / (spec['owner_module'] + '.tla')).read_text() != expected_owner:
            raise ValueError(f'{mutant}: the owner mutant differs beyond its one conjunct')
        expected_combined = combined_text.replace('---- MODULE combined_composition ----',
                                                  f'---- MODULE {spec["module"]} ----', 1)
        for prefix in ('offer', 'offer2'):
            expected_combined = expected_combined.replace(f'{prefix} == INSTANCE offer_owner WITH',
                                                          f'{prefix} == INSTANCE offer_owner_{ident} WITH', 1)
        if (generated / (spec['module'] + '.tla')).read_text() != expected_combined:
            raise ValueError(f'{mutant}: the composed mutant module differs beyond its INSTANCE lines')
    known = set(manifest['actions'])
    properties = set(manifest['safety_properties'])
    run.mkdir(exist_ok=False)
    inputs = run / 'inputs'
    shutil.copytree(generated, inputs)
    result = {'started_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
              'scope': manifest['scope'], 'full_b1_acceptance': False,
              'manifest_sha256': sha(generated / 'manifest.json'),
              'verifier_sha256': sha(Path(__file__)), 'profiles': {},
              'resources': {'workers_mutants_rows': 1, 'workers_bases_controls_liveness': base_workers,
                            'heap': '2 GiB for mutants and rows, 16 GiB for the bases, controls and liveness',
                            'timeout_seconds': TIMEOUT, 'sequential': True, 'generic_deadlock_checking': 'ON'}}
    save(run / 'STARTED.json', result)
    profiles = manifest['profiles']
    order = ([n for n, p in profiles.items() if p['kind'] in ('mutant', 'row', 'live-mutant')]
             + [n for n, p in profiles.items() if p['kind'] in ('base', 'control', 'live-base')])
    only = os.environ.get('B1_ONLY_PROFILES')
    if only:
        order = [n for n in order if n in set(only.split(','))]
    passed = True
    union = {}
    for name in order:
        profile = profiles[name]
        expected = profile['expected']
        single = profile['kind'] in ('mutant', 'row')
        workers = 1 if single else base_workers
        env = os.environ.copy()
        env['JAVA_TOOL_OPTIONS'] = '-Xmx2048m' if single else '-Xmx16384m'
        log = run / (name + '.log')
        module = profile.get('module', 'combined_composition')
        if not (inputs / (module + '.tla')).is_file():
            raise ValueError(f'{name}: no module {module}')
        command = ['tlc', '-workers', str(workers), '-seed', '1', '-coverage', '5',
                   '-metadir', str(run / (name + '-states')),
                   '-config', str(inputs / (name + '.cfg')), str(inputs / (module + '.tla'))]
        row = {'kind': profile['kind'], 'command': command, 'expected': expected}
        started = datetime.datetime.now(datetime.timezone.utc)
        try:
            with log.open('wb') as out:
                process = subprocess.run(command, cwd=inputs, stdout=out, stderr=subprocess.STDOUT,
                                         env=env, timeout=TIMEOUT, check=False)
            text = log.read_text()
            row['exit_code'] = process.returncode
            row['states'] = re.findall(SUMMARY, text, re.MULTILINE)[-1:]
            if expected is None:
                if process.returncode != 0 or 'Model checking completed. No error has been found.' not in text:
                    raise ValueError('expected a clean pass')
                if profile['kind'] == 'base':
                    # TLC prints a coverage report every few minutes; only the last (the
                    # final one, after the search ended) counts.
                    reports = text.split('The coverage statistics at ')
                    if len(reports) < 2:
                        raise ValueError('no coverage report')
                    coverage = {}
                    for action, d, t in re.findall(
                            r'^<(\w+) line \d+, col \d+ to line \d+, col \d+ of module combined_composition>: '
                            r'(\d+):(\d+)$', reports[-1], re.MULTILINE):
                        action = normalize(action, known)
                        if action in known:
                            entry = coverage.setdefault(action, {'distinct': 0, 'total': 0})
                            entry['distinct'] += int(d)
                            entry['total'] += int(t)
                    if any(coverage.get(a, {}).get('total', 0) != 0 for a in manifest['fault_only_actions']):
                        raise ValueError('a fault-only action ran in a clean base')
                    row['action_coverage'] = coverage
                    for action, entry in coverage.items():
                        union[action] = union.get(action, 0) + entry['total']
            elif profile['kind'] == 'live-mutant':
                if process.returncode != 13 or f'Temporal property {expected} was violated' not in text:
                    raise ValueError('did not violate its attributed liveness property')
                states, loop = lasso(text)
                live_witness(name, states, loop)
                row['loop'] = loop
                row['final_state'] = states[-1]
                row['trace_length'] = len(states)
            else:
                if expected in properties:
                    ok = process.returncode == 13 and f'Action property {expected} is violated' in text
                else:
                    ok = process.returncode == 12 and f'Invariant {expected} is violated' in text
                if not ok:
                    raise ValueError('did not violate its attributed invariant or property')
                fields, actions = final_state(text, known)
                witness(name, fields, actions)
                row['final_state'] = fields
                row['actions'] = actions
            row['passed'] = True
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            row.update(passed=False, error=str(error))
            passed = False
        row['seconds'] = round((datetime.datetime.now(datetime.timezone.utc) - started).total_seconds(), 1)
        row['log_sha256'] = sha(log)
        result['profiles'][name] = row
        save(run / 'PROGRESS.json', result)
        print(json.dumps({'profile': name, 'kind': profile['kind'], 'passed': row['passed'],
                          'exit': row.get('exit_code'), 'states': row.get('states'), 'seconds': row['seconds'],
                          'error': row.get('error')}), flush=True)
    required = set(manifest['actions']) - set(manifest['fault_only_actions'])
    bases_run = [n for n in order if profiles[n]['kind'] == 'base']
    result['coverage_union'] = union
    if bases_run and not only:
        missing = sorted(a for a in required if union.get(a, 0) == 0)
        result['coverage_missing'] = missing
        if missing:
            passed = False
    result['export_unchanged'] = all(sha(generated / n) == d for n, d in artifacts.items())
    result['inputs_unchanged'] = all(sha(inputs / n) == d for n, d in artifacts.items())
    result['generator_unchanged'] = sha(generator) == manifest['generator_sha256']
    result['attempt_model_unchanged'] = sha(source) == manifest['attempt_model']['sha256']
    result['verifier_unchanged'] = sha(Path(__file__)) == result['verifier_sha256']
    passed &= (len(result['profiles']) == len(order)
               and all(value for key, value in result.items() if key.endswith('_unchanged')))
    if only:
        result['subset'] = sorted(only.split(','))
    result['result'] = ('passed' if passed and not only else 'passed_subset' if passed
                        else 'failed_or_incomplete')
    result['at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    save(run / 'RESULT.json', result)
    return 0 if passed else 1


if __name__ == '__main__':
    sys.exit(main())
