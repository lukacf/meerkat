CommitStickyModelFallbackRunning(previous_identity, previous_visibility_state, target_identity, target_model, target_profile_provider, target_profile_model, target_capability_surface, target_capability_surface_status, target_capability_base_filter, target_realtime_capable, view_image_tool_available, previous_view_image_visible, next_view_image_visible, previous_active_visibility_revision, previous_staged_visibility_revision, next_visibility_state, next_active_visibility_revision, tool_visibility_delta, retry_attempt) ==
    /\ phase = "Running"
    /\ (session_id # None)
    /\ (turn_phase = "ErrorRecovery")
    /\ (retry_attempt = llm_retry_attempt)
    /\ (current_session_llm_identity = Some(previous_identity))
    /\ ((previous_visibility_state.capability_base_filter = current_session_capability_base_filter) /\ (previous_visibility_state.inherited_base_filter = inherited_base_filter) /\ (previous_visibility_state.active_filter = active_filter) /\ (previous_visibility_state.staged_filter = staged_filter) /\ (previous_visibility_state.active_requested_deferred_names = active_deferred_names) /\ (previous_visibility_state.staged_requested_deferred_names = staged_deferred_names) /\ (previous_visibility_state.active_revision = active_visibility_revision) /\ (previous_visibility_state.staged_revision = staged_visibility_revision) /\ (previous_visibility_state.requested_witnesses = requested_visibility_witnesses) /\ (previous_visibility_state.filter_witnesses = filter_visibility_witnesses))
    /\ (target_identity.model = target_model)
