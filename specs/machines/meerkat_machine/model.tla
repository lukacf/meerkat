RunCompleted(run_id) ==
    /\ phase = "Running"
    /\ (current_run_id = Some(run_id))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ turn_phase' = IF ((turn_phase # "Completed") /\ (turn_phase # "Failed") /\ (turn_phase # "Cancelled")) THEN "Completed" ELSE turn_phase
    /\ turn_terminal_run_id' = Some(run_id)
