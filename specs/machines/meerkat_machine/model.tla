ClassifyTurnTerminalityTerminalIdle ==
    /\ phase = "Idle"
    /\ (IF (turn_phase = "Completed") THEN TRUE ELSE (IF (turn_phase = "Failed") THEN TRUE ELSE (turn_phase = "Cancelled")))
