       /\ observed_transitions' = observed_transitions \cup {[machine |-> "layer_mob", transition |-> "ClassifyFlowStepTerminalityTerminalRunning", actor |-> "layer_mob_authority", step |-> (model_step_count + 1), from_phase |-> layer_mob_phase, to_phase |-> "Running"]}
       /\ UnchangedFrame_5c73fa0d7ecc522a
