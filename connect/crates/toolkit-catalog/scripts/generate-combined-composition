#!/usr/bin/env python3
"""Compose the combined I1-I13 model: the bind attempt (stage A), the generated source,
offer and component lifetime owners, and the stage B send in the accepted order, in one module.

Usage: generate-combined-composition GENERATED_ORIGINALS NEW_DIRECTORY
Stage A is models/bind_attempt.tla, instanced byte-exact (the first-send write inventory
and the service setup observation record, their marks, the partial-issuance and shared-parent
states, the G3 witness). Stage B follows the accepted order: the offer owner is
prepared first, the door's first-send writes are issued outside protection (looked up again on
Duplicate), the preparation is sealed, the effect runner records the send intent (Offered with
its outbox) under the publication writer then the store transaction, records the dispatch start
in the owner, and only then calls Meta (a peer delivery: before its protected section). Meta's
protected section binds purely (genuine refusals first, then not-now) and, on Bound, enters
native admission through the entry fence in the same section; the effect runner records the
answer through the owner after Meta returns. A not-now waits in Meta or in Core's peer waiter
and binds again; Held and the peer deadline end only the caller's wait. Every fact that decides
an owner transition is generated owner state (the preparation's process epoch, each dispatch
with its epoch, a lost answer against its dispatch, the receipt's dispatch and kind, the
final-absence evidence, the close's unresolved record); the owner decides, the shell feeds it.
The peer door runs as Core's drain does: one peer bind per session at a time, the FIFO head
first; the binder answers Core per outcome (Denied for a verdict only; NotReady for contention, a
closed admission or a verdict over an ambiguous dispatch); durable deliveries keep Core's claim,
and a record withdrawn for no verdict is prepared again on Core's re-offer; volatile and
supervisor deliveries (no claim) end dropped past their deadline, their records kept for the
sender's retry. Two offer slots of one source and two send tasks; the
driver observes Core's outcome by the offer's own qualified key (Core's live read, ordered after
an admission write still in flight; with late landings also its durable read, whose absence never
counts a lost dispatch of this process); one crash and restart;
admission closure with the close's join, the close's unresolved record scoped to the closing
process, and in the stop profiles the process's end after its close and the restart into a new
component lifetime, whose re-drive and Core's re-offer dispatch the records the close recorded;
in the poison profiles the fail-stop on a poisoned publication (the typed fatal diagnostic, the
process's end by the crash's path without waiting for the close, the next process recovering).
The owner module headers are renamed for INSTANCE,
their bodies stay exact (an owner mutant composes a copy with one guard conjunct removed). The
rank table is read from the canonical export (lock_order/ranks.json). A bounded contract model,
not the Rust code.
"""

import hashlib
import json
from pathlib import Path
import re
import sys


def sha(data):
    return hashlib.sha256(data).hexdigest()


ALL_DOORS = ['Find', 'Launch', 'FindNative', 'ClassInput', 'ClassNative', 'BatchSetup', 'ConfiguredSetup',
             'SetupRequest', 'Console', 'Peer', 'Helper']
ALL_INITIAL = ['First', 'Partial', 'Bound', 'Shared']
OWN_INITIAL = ['First', 'Partial', 'Bound']
BOTH = ['A', 'B']
HELD_DOORS = ['Find', 'Launch']
# Stage B environment dimensions a profile may enable. The full-environment bases take ALL_ENV;
# the stop (the process ends after its close and restarts into a new component lifetime), the
# late landing (Core's admission write still in flight after its call returned, and the driver's
# durable read beside the live one) and the poisoned publication (the fail-stop) run in profiles
# of their own.
ALL_ENV = ['hold', 'revoke', 'session', 'srcclose', 'close', 'crash', 'drop', 'lost', 'corerefuse']
ENV_TOKENS = ALL_ENV + ['stop', 'late', 'poison']

# The attempt model's own variables (stage A), renamed a_*; the rest are shared with B.
A_OWN = ['attempt', 'effect', 'decided', 'wrote', 'nested', 'pc', 'step', 'after_store', 'bw', 'answer',
         'outcome', 'offers', 'waited', 'notnow_seen', 'dup_refused', 'backstop', 'witness', 'silent',
         'misplaced', 'firstw', 'ended', 'crashed']
SHARED = ['stage', 'door', 'initial', 'issued', 'issue_count', 'delivery_record', 'gate', 'gate_moves']
B_VARS = ['mode', 'sp', 'prep', 'jr', 'begun', 'native', 'core_refusals', 'lost_count', 'current_inc', 'auth_ok',
          'meta_holder', 'pub_holder', 'conn_holder', 'store_pc', 'alive', 'epoch', 'scanned', 'joined',
          'read_slot', 'raw_read', 'published_read', 'unavail_reads', 'dup_arts', 'prep_refused', 'drop_partial',
          'held_site', 'entered_after_close', 'claimed', 'lost_reply_seen', 'crashed_offered', 'admitted_stale',
          'cas_lost', 'replayed', 'close_waited_prep', 'dead_prep', 'a_held', 'refusals', 'life_cur', 'orphan_claim',
          'read_kind', 'landing', 'absence_epoch', 'fatal']
ATTEMPT_FAULTS = ['drop-controller-mark', 'silent-blocking-writer', 'drop-callback-mark', 'drop-callback-leaf-mark',
                  'drop-class-input-mark', 'drop-service-setup-mark', 'drop-service-observation-mark',
                  'drop-first-binding-mark', 'drop-configured-setup-mark', 'drop-configured-setup-grant-mark',
                  'drop-setup-target-mark', 'drop-setup-request-grant-mark', 'drop-native-root-mark',
                  'drop-native-child-mark', 'drop-peer-operation-mark', 'drop-peer-operation-and-entry-note',
                  'nested-fresh-attempt', 'peer-entry-unmarked', 'spawned-writer', 'early-decision', 'late-not-now',
                  'duplicate-issue', 'notnow-after-failed-write', 'refused-waits']
# The owner fields that decide its transitions, each with the value its I8 mutant writes
# outside a generated transition and the owner phase in which it does (a forge mutant checks
# only TypeOK and I8_OwnerFieldsByTransition: the forged value may break other invariants too).
FORGE_FIELDS = {
    'preparation_epoch': ('offer_preparation_epoch + 1', 'offer_phase = "Prepared"'),
    'dispatch_count': ('offer_dispatch_count + 1', 'offer_phase = "Offered"'),
    'dispatch_epochs': ('[x \\in {9} |-> 1]', 'offer_phase = "Offered"'),
    'unresolved_dispatches': ('offer_unresolved_dispatches \\cup {9}', 'offer_phase = "Offered"'),
    'last_dispatch_epoch': ('offer_last_dispatch_epoch + 1', 'offer_phase = "Offered"'),
    'receipt_kind': ('IF offer_receipt_kind = "Found" THEN "Admitted" ELSE "Found"', 'offer_phase = "CoreObserved"'),
    'receipt_dispatch': ('offer_receipt_dispatch + 1', 'offer_phase = "CoreObserved"'),
    'receipt_epoch': ('offer_receipt_epoch + 1', 'offer_phase = "CoreObserved"'),
    'absence_through': ('offer_absence_through + 1', 'offer_phase = "Offered"'),
    'close_epoch': ('offer_close_epoch + 1', 'offer_phase = "Offered"'),
    'withdrawal_cause': ('"PolicyDenied"', 'offer_phase = "Prepared"'),
}


def forge_fault(field):
    """The I8 mutant of one owner field: forge-field-*, apart from the older forge-admission."""
    return 'forge-field-' + field.replace('_', '-')


FORGE_FAULTS = {forge_fault(field) for field in FORGE_FIELDS}
# Owner mutants: the generated offer owner with exactly one guard conjunct of one transition
# replaced (each must match once inside that transition's definition), composed instead of
# the unchanged owner by a copy of the combined module that differs only in its INSTANCE lines.
OWNER_MUTANTS = {
    # The refusal settles while another recorded dispatch is open (in flight or ambiguous) or
    # unresolved. (The guard's "none unresolved" conjunct is implied by this one: an unresolved
    # dispatch stays recorded, so it is not mutated alone.)
    'notadmitted-while-inflight': ('RetainCoreReceipt', '(Cardinality(DOMAIN dispatch_epochs) = 1)', 'TRUE'),
    # The final absence is recorded before this process dispatched the record (its re-drive
    # or Core's re-offer still owed).
    'absence-without-redispatch': ('RecordFinalAbsence', '(last_dispatch_epoch = epoch)', 'TRUE'),
    # The final absence is recorded over any open or lost dispatch, one of this process in
    # flight included.
    'absence-in-process': ('RecordFinalAbsence', '\\A dispatch \\in DOMAIN dispatch_epochs :',
                           '\\A dispatch \\in {} :'),
    # The final absence counts a lost dispatch of this process on Core's durable read, which
    # takes no gate: the dispatch's admission write may still be in flight.
    'durable-read-counts': ('RecordFinalAbsence', '(read = "Live")', 'TRUE'),
    # The close's unresolved record blocks every later dispatch start, in every later process
    # (the record is never driven again after a stop and restart).
    'close-blocks-later-process': ('RecordDispatchStart', '(close_epoch < epoch)', '(close_epoch = 0)'),
}
# Actions present in Next but enabled only by a fault; no clean base takes them.
FAULT_ONLY_ACTIONS = (['A_SpawnedWrite', 'B_StoreHook', 'B_ForgetAmbiguity']
                      + ['B_Forge_' + field for field in FORGE_FIELDS])
# The attempt model's own stage B actions: stage B here is the composition's own send.
A_STAGE_B_ONLY = {'PrepareOutside', 'PeerWaiter', 'PeerWaitExpire'}
PROC = [('p', 'Procs')]
SLOT = [('i', 'Slots')]
SLOT_PROC = [('i', 'Slots'), ('p', 'Procs')]


def owner(root, directory, prefix, output, name):
    raw = (root / directory / 'model.tla').read_bytes()
    header = b'---- MODULE model ----\n'
    if not raw.startswith(header):
        raise ValueError('unexpected generated module header')
    renamed = f'---- MODULE {name} ----\n'.encode() + raw[len(header):]
    (output / (name + '.tla')).write_bytes(renamed)
    text = raw.decode()
    fields = re.search(r'^VARIABLES (.+)$', text, re.MULTILINE)[1].split(', ')
    constants = re.search(r'^CONSTANTS (.+)$', text, re.MULTILINE)[1].split(', ')
    config = (root / directory / 'ci.cfg').read_text()
    invariants = config.split('INVARIANTS\n', 1)[1].split('CONSTRAINTS\n', 1)[0].split()
    instance = (f'{prefix} == INSTANCE {name} WITH\n    '
                + ',\n    '.join(f'{field} <- {prefix}_{field}' for field in fields))
    provenance = {'generated_sha256': sha(raw), 'renamed_sha256': sha(renamed),
                  'body_sha256': sha(raw[len(header):])}
    return [f'{prefix}_{field}' for field in fields], fields, constants, invariants, instance, provenance


def attempt_actions(text):
    body = text.split('\nNext ==\n', 1)[1].split('\n\n', 1)[0]
    actions = []
    for line in body.splitlines():
        name = line.strip().removeprefix('\\/ ').strip()
        quantified = name.startswith('\\E ')
        if quantified:
            name = name.split(':', 1)[1].strip()
        name = name.split('(', 1)[0]
        if not name.isidentifier():
            raise ValueError(f'unexpected Next disjunct: {line!r}')
        actions.append((name, quantified))
    return actions


def held_rows():
    rows = {}
    for stage in BOTH:
        for door in HELD_DOORS:
            for site in ['P', 'A']:
                for initial in OWN_INITIAL:
                    rows[f'NotRowHeld_{stage}_{door}_{site}_{initial}'] = (
                        f'~(stage = "{stage}" /\\ door = "{door}" /\\ initial = "{initial}" /\\ HeldAt = "{site}")')
    return rows


def build_model(root, output):
    catalog = Path(__file__).resolve().parents[1]
    attempt_source = catalog / 'models' / 'bind_attempt.tla'
    attempt = attempt_source.read_bytes()
    table = json.loads((root / 'lock_order' / 'ranks.json').read_text())
    (output / attempt_source.name).write_bytes(attempt)
    src_vars, _, src_consts, src_invs, src_instance, src_prov = owner(root, 'source_record', 'src', output,
                                                                      'source_owner')
    offer_vars, offer_fields, offer_consts, offer_invs, offer_instance, offer_prov = owner(
        root, 'original_offer', 'offer', output, 'offer_owner')
    offer2_vars, _, _, _, offer2_instance, offer2_prov = owner(root, 'original_offer', 'offer2', output,
                                                               'offer_owner')
    if offer2_prov != offer_prov:
        raise ValueError('the two offer slots must instance the same generated owner')
    life_vars, _, life_consts, life_invs, life_instance, life_prov = owner(root, 'component_lifetime', 'life',
                                                                           output, 'lifetime_owner')
    # The next process's component lifetime (a new incarnation), opened by the restart after a stop.
    life2_vars, _, _, _, life2_instance, life2_prov = owner(root, 'component_lifetime', 'life2', output,
                                                            'lifetime_owner')
    if life2_prov != life_prov:
        raise ValueError('the two lifetimes must instance the same generated owner')
    a_vars = ['a_' + v for v in A_OWN]
    variables = SHARED + a_vars + src_vars + offer_vars + offer2_vars + life_vars + life2_vars + B_VARS
    constants = sorted(set(src_consts) | set(offer_consts) | set(life_consts))
    SRC, LIFE, LIFE2 = set(src_vars), set(life_vars), set(life2_vars)
    OFFERS = set(offer_vars) | set(offer2_vars)
    actions, definitions = [], []

    def frame(changed):
        return '    /\\ UNCHANGED <<' + ', '.join(v for v in variables if v not in changed) + '>>'

    def action(name, expressions, changed, stage='B', params=None):
        unknown = set(changed) - set(variables)
        if unknown:
            raise ValueError(f'{name}: unknown variables {sorted(unknown)}')
        actions.append(name)
        ACTION_PARAMS[name] = list(params or [])
        body = [f'stage = "{stage}"'] + list(expressions)
        text = '\n'.join('    /\\ ' + e for e in body) + '\n' + frame(changed)
        if params:
            args = ', '.join(v for v, _ in params)
            definitions.append(f'{name}Of({args}) ==\n' + text)
            bound = ', '.join(f'{v} \\in {d}' for v, d in params)
            definitions.append(f'{name} == \\E {bound} : {name}Of({args})')
        else:
            definitions.append(name + ' ==\n' + text)

    # Stage A: one wrapper per action of the attempt model. The held site is recorded for
    # the held rows (its converted sites (P) and (A), and SH:1505 for the helper).
    held_update = {
        'SiteP': "a_held' = IF RecordRows /\\ a_pc' = \"Answered\" THEN \"P\" ELSE a_held",
        'SiteA': "a_held' = IF RecordRows /\\ a_pc' \\in {\"Answered\", \"WaitInPlace\"} THEN \"A\" ELSE a_held",
        'HelperCheck': "a_held' = IF RecordRows /\\ a_pc' = \"Answered\" THEN \"H\" ELSE a_held",
    }
    for name, quantified in attempt_actions(attempt.decode()):
        if name in A_STAGE_B_ONLY:
            continue
        call = f'\\E w \\in BA!Attempts : BA!{name}(w)' if quantified else f'BA!{name}'
        expressions, changed = [call], set(SHARED) | set(a_vars)
        if name in held_update:
            expressions.append(held_update[name])
            changed.add('a_held')
        action('A_' + name, expressions, changed, stage='A')

    # ---- Stage B: the environment. ----
    # The source owner: registered and made ready at the start; it may close (and its
    # cancellation be confirmed) while a send is under way or an offer is not terminal,
    # an Offered one included (closing a source does not settle an offered input).
    action('B_SrcRegister', ['src!RegisterSource("source1", "scope1", "Ordinary", "", "source-prep1")'], SRC)
    action('B_SrcReady', ['src!MakeSourceReady(src_source_key, src_revision, src_preparation_id, "source-ready1")'],
           SRC)
    action('B_SrcClose', ['"srcclose" \\in Env', 'Busy \\/ \\E i \\in Slots : NonTerminal(i)',
                          'src!CloseSourceEligibility(src_source_key, src_revision, "cancel1")'], SRC)
    action('B_SrcCancel', ['"srcclose" \\in Env', 'Busy \\/ \\E i \\in Slots : NonTerminal(i)',
                           'src!ConfirmSourceCancellation(src_source_key, src_revision, src_cancellation_id, '
                           'src_revision, "revoked1", "published1")'], SRC)
    # The component lifetime: staged and opened at the start; admission closes while
    # anything is under way. The close's join waits for every running preparer, every
    # send task and the driver's read; then each Offered record is recorded durably unresolved
    # through its owner (RecordCloseUnresolved, with this process's epoch: no dispatch of this
    # process follows it), and only then is the lifetime settled. One close per behavior: the
    # next process's lifetime (after a stop) does not close.
    action('B_LifeStage', ['life!StageComponent("inc1", "component1", "activation1")'], LIFE)
    action('B_LifeOpen', ['life!OpenComponent(life_incarnation, life_revision)'], LIFE)
    action('B_LifeBeginClose', ['"close" \\in Env', 'Busy \\/ \\E i \\in Slots : NonTerminal(i)',
                                'life!CloseAdmission(life_incarnation, life_revision, "close1", "stop", FALSE)',
                                "close_waited_prep' = (close_waited_prep \\/ (RecordRows /\\ \\E n \\in Preparers : prep[n].st = \"Running\"))"],
           LIFE | {'close_waited_prep'})
    action('B_JoinDriver', ['LPhase = "Closing"', '~joined',
                            '(\\A n \\in Preparers : prep[n].st # "Running") \\/ Fault = "close-skips-preparers"',
                            '\\A p \\in Procs : ~Live(p)', 'read_slot = 0', "joined' = TRUE"],
           {'joined'})
    action('B_CloseRecord', ['LPhase = "Closing"', 'joined', 'OPhase(i) = "Offered"', 'OCloseEpoch(i) = 0',
                             'OCloseRecord(i)'],
           OFFERS, params=SLOT)
    action('B_LifeSettle', ['joined \\/ Fault = "close-without-join"',
                            '(\\A i \\in Slots : OPhase(i) = "Offered" => OCloseEpoch(i) > 0)\n'
                            '       \\/ Fault \\in {"close-without-join", "close-forgets-unresolved"}',
                            'life!SettleClosed(life_incarnation, life_revision, life_close_id)'], LIFE)
    # The stop: after its close settled, the process ends (the ordinary shutdown) while a record
    # is not terminal or Core holds a queued claim. Its in-process obligations end with it; the
    # owner records, their outboxes and Core's queued claims stay; an admission write still in
    # flight (env late) ends with it, landed or not.
    action('B_Stop', ['"stop" \\in Env', 'alive', 'epoch = 1', 'life_phase = "Closed"',
                      '(\\E i \\in Slots : NonTerminal(i)) \\/ QueuedClaim', "alive' = FALSE",
                      "jr' = [i \\in Slots |-> [jr[i] EXCEPT !.parked = FALSE, !.redrive = FALSE, !.read_owed = FALSE,\n"
                      '                              !.held = FALSE]]',
                      "\\E landed \\in SUBSET landing : native' = native \\cup landed", "landing' = {}"],
           {'alive', 'jr', 'native', 'landing'})
    # The next process's component lifetime, a new incarnation, staged and opened after a restart
    # that followed a stop.
    action('B_Life2Stage', ['life_cur = 2', 'alive', 'life2!StageComponent("inc2", "component1", "activation2")'],
           LIFE2)
    action('B_Life2Open', ['life_cur = 2', 'alive', 'life2!OpenComponent(life2_incarnation, life2_revision)'],
           LIFE2)
    # The source gate (an owner change holds the source) moves while a send is under way.
    action('B_Hold', ['"hold" \\in Env', 'Busy', 'gate = "Free"', 'gate_moves < GateBound', "gate' = \"Held\"",
                      "gate_moves' = gate_moves + 1"], {'gate', 'gate_moves'})
    action('B_Release', ['Busy', 'gate = "Held"', 'gate_moves < GateBound', "gate' = \"Free\"",
                         "gate_moves' = gate_moves + 1"], {'gate', 'gate_moves'})
    # A grant change (a revocation included) takes the publication writer; a session reset
    # (meta/reset) takes the identity's lifecycle lock, so it never lands inside Meta's
    # section between a bind and its native admission (only at any other time).
    action('B_Revoke', ['"revoke" \\in Env', 'auth_ok', 'pub_holder = "none"', 'Busy', "auth_ok' = FALSE"],
           {'auth_ok'})
    action('B_ReplaceSession', ['"session" \\in Env', 'current_inc = "inc1"', 'meta_holder = 0',
                                'Busy \\/ \\E i \\in Slots : NonTerminal(i)', "current_inc' = \"inc2\""],
           {'current_inc'})

    # ---- Stage B: the send in the accepted order. ----
    # A caller's send of the original begins (a door's send, a same-key replay of it, or a
    # peer delivery): only while the component admits and the source was made ready. A peer
    # delivery is Core's drain's: one peer bind per session at a time, and Core's FIFO head (a
    # queued claim, with or without a record) before any later delivery (the
    # peer-binds-concurrently mutant ignores both, peer-skips-queued-claim the second).
    action('B_Begin', ['~Live(p)', 'begun < SendBound', 'alive', 'scanned', 'src_readiness # "Preparing"',
                       'Admission', '\\E i \\in Slots : OPhase(i) # "Withdrawn" /\\ ~ObservedNotAdmitted(i)',
                       'door = "Peer" /\\ Fault # "peer-binds-concurrently"\n'
                       '       => (DrainFree /\\ (Fault = "peer-skips-queued-claim" \\/ ~QueuedClaim))',
                       "begun' = begun + 1",
                       "sp' = [sp EXCEPT ![p] = [FreshProc EXCEPT !.pc = \"Lookup\", !.n = begun + 1,\n"
                       '                                             !.kind = "caller"]]',
                       "entered_after_close' = (entered_after_close \\/ LPhase # \"Open\")"],
           {'begun', 'sp', 'entered_after_close'}, params=PROC)
    # The lookup by original: a non-terminal offer is used (a same-key replay of an Offered
    # one dispatches its kept intent); an admitted original answers Admitted; else a
    # new offer is created in a free slot (only after a terminal one). The
    # replay-reprepares mutant prepares a second offer instead of using the kept one. With both
    # offer slots used by terminal records, a new offer is outside the model's bound: the send
    # ends Bounded (no outcome; production prepares a further offer). A durable peer delivery
    # that meets a closed admission before its record exists answers Core NotReady: Core keeps
    # its claim (with no record yet) for the next process (the closed-admission-denied mutant
    # ends it).
    action('B_Lookup', ['sp[p].pc = "Lookup"', 'alive',
                        'LET nt == {i \\in Slots : NonTerminal(i)}\n'
                        '           free == {i \\in Slots : OPhase(i) = "Absent"}\n'
                        '           use == CHOOSE i \\in nt : TRUE\n'
                        '           fresh == Fault = "replay-reprepares" /\\ nt # {} /\\ OPhase(use) = "Offered" /\\ free # {}\n'
                        '       IN IF nt # {} /\\ ~fresh\n'
                        "          THEN /\\ sp' = [sp EXCEPT ![p] = UseOffer(sp[p], use)]\n"
                        "               /\\ prep' = IF OPhase(use) = \"Prepared\" /\\ ~OSealed(use) THEN StartPrep(sp[p].n) ELSE prep\n"
                        "               /\\ replayed' = (replayed \\/ (RecordRows /\\ OPhase(use) = \"Offered\"))\n"
                        '               /\\ UNCHANGED orphan_claim\n'
                        '          ELSE IF (\\E i \\in Slots : ObservedAdmitted(i)) /\\ ~fresh\n'
                        "          THEN /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Admitted\", \"None\")]\n"
                        '               /\\ UNCHANGED <<prep, replayed, orphan_claim>>\n'
                        '          ELSE IF free # {} /\\ SourceOpen /\\ Admission\n'
                        "          THEN /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Create\", !.slot = MinSlot(free)]]\n"
                        '               /\\ UNCHANGED <<prep, replayed, orphan_claim>>\n'
                        '          ELSE IF SourceOpen /\\ Admission\n'
                        "          THEN /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Bounded\", \"None\")]\n"
                        '               /\\ UNCHANGED <<prep, replayed, orphan_claim>>\n'
                        '          ELSE IF ~Admission /\\ ClaimedPeer /\\ Fault # "closed-admission-denied"\n'
                        "          THEN /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Pending\", \"AdmissionClosed\")]\n"
                        "               /\\ orphan_claim' = TRUE\n"
                        '               /\\ UNCHANGED <<prep, replayed>>\n'
                        "          ELSE /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Refused\",\n"
                        '                                     IF ~Admission THEN "AdmissionClosed" ELSE "SourceClosed")]\n'
                        '               /\\ UNCHANGED <<prep, replayed, orphan_claim>>'],
           {'sp', 'prep', 'replayed', 'orphan_claim'}, params=PROC)
    # The owner first (its Prepare): the Prepared record, with its preparing
    # process's epoch, exists before any grant. The CAS's loser reads the winner back and uses
    # its offer: no second offer, no refusal. The effects-before-owner mutant issues
    # the grants first and prepares the owner after them (the earlier order).
    action('B_Create', ['sp[p].pc = "Create"', 'alive',
                        'LET i == sp[p].slot\n'
                        '       IN IF OPhase(i) = "Absent"\n'
                        '          THEN /\\ IF Fault = "effects-before-owner" THEN UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                        '                  ELSE OPrepare(i)\n'
                        "               /\\ prep' = StartPrep(sp[p].n)\n"
                        "               /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Prepare\", !.key = Key(i)]]\n"
                        "               /\\ delivery_record' = (delivery_record \\/ door = \"Peer\")\n"
                        '               /\\ UNCHANGED cas_lost\n'
                        "          ELSE /\\ cas_lost' = (cas_lost \\/ RecordRows)\n"
                        '               /\\ UNCHANGED <<Offer1Vars, Offer2Vars, delivery_record>>\n'
                        '               /\\ IF NonTerminal(i)\n'
                        "                  THEN /\\ sp' = [sp EXCEPT ![p] = UseOffer(sp[p], i)]\n"
                        "                       /\\ prep' = IF OPhase(i) = \"Prepared\" /\\ ~OSealed(i) THEN StartPrep(sp[p].n) ELSE prep\n"
                        "                  ELSE /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Lookup\", !.slot = 0]]\n"
                        '                       /\\ UNCHANGED prep'],
           OFFERS | {'prep', 'sp', 'delivery_record', 'cas_lost'}, params=PROC)
    # The preparation outside protection: every first-send write of the door (the write
    # inventory and the service setup observation record, FI:533, PO:1610), each looked up,
    # then issued; Duplicate looks it up again and continues with the issued one, never
    # refused. Concurrent preparers of one original are the normal case. A dropped send's
    # preparer runs on.
    action('B_PrepLookup', ['prep[n].st = "Running" /\\ prep[n].phase = "lookup"',
                            'LET found == BA!Steps(door)[prep[n].pos].art \\in issued\n'
                            '           last == prep[n].pos = Len(BA!Steps(door))\n'
                            "       IN prep' = [prep EXCEPT ![n] = IF ~found THEN [@ EXCEPT !.phase = \"issue\"]\n"
                            '                                      ELSE IF last THEN [@ EXCEPT !.st = "Done"]\n'
                            '                                      ELSE [@ EXCEPT !.pos = @ + 1]]'],
           {'prep'}, params=[('n', 'Preparers')])
    action('B_PrepIssue', ['prep[n].st = "Running" /\\ prep[n].phase = "issue"',
                           'LET art == BA!Steps(door)[prep[n].pos].art\n'
                           '           dup == art \\in issued\n'
                           '           last == prep[n].pos = Len(BA!Steps(door))\n'
                           "       IN /\\ issued' = issued \\cup {art}\n"
                           "          /\\ issue_count' = IF dup THEN issue_count ELSE [issue_count EXCEPT ![art] = @ + 1]\n"
                           "          /\\ dup_arts' = IF dup /\\ RecordRows THEN dup_arts \\cup {art} ELSE dup_arts\n"
                           "          /\\ prep_refused' = (prep_refused \\/ (dup /\\ Fault = \"no-relookup-b\"))\n"
                           "          /\\ prep' = [prep EXCEPT ![n] =\n"
                           '                 IF dup THEN (IF Fault = "no-relookup-b" THEN [@ EXCEPT !.st = "Refused"]\n'
                           '                              ELSE [@ EXCEPT !.phase = "lookup"])\n'
                           '                 ELSE IF last THEN [@ EXCEPT !.st = "Done"]\n'
                           '                 ELSE [@ EXCEPT !.pos = @ + 1, !.phase = "lookup"]]'],
           {'issued', 'issue_count', 'dup_arts', 'prep_refused', 'prep'}, params=[('n', 'Preparers')])
    # The send goes on once its preparer and any other preparer have ended (a preparer that
    # runs on can only find the writes issued); the effects-before-owner mutant prepares its
    # owner only now.
    action('B_PrepDone', ['sp[p].pc = "Prepare"', 'alive', 'prep[sp[p].n].st \\in {"Done", "Refused"}',
                          '\\A m \\in Preparers : prep[m].st # "Running"',
                          'IF prep[sp[p].n].st = "Refused"\n'
                          "       THEN /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Refused\", \"PreparationRefused\")]\n"
                          '            /\\ UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                          "       ELSE /\\ sp' = [sp EXCEPT ![p].pc = \"Seal\"]\n"
                          '            /\\ IF OPhase(sp[p].slot) = "Absent" THEN OPrepare(sp[p].slot)\n'
                          '               ELSE UNCHANGED <<Offer1Vars, Offer2Vars>>'],
           OFFERS | {'sp'}, params=PROC)
    # The seal accepts the matching preparation; its CAS's loser reads the winner back. A
    # send whose offer was withdrawn or settled under it ends typed. The
    # send-before-owner mutant dispatches the sealed offer before its send intent.
    action('B_Seal', ['sp[p].pc = "Seal"', 'alive',
                      'LET i == sp[p].slot\n'
                      '       IN CASE OPhase(i) = "Prepared" /\\ ~OSealed(i) ->\n'
                      '                 /\\ OSeal(i)\n'
                      "                 /\\ sp' = [sp EXCEPT ![p].pc = IF Fault = \"send-before-owner\" THEN \"Call\" ELSE \"Commit\"]\n"
                      '                 /\\ UNCHANGED cas_lost\n'
                      '            [] OPhase(i) = "Prepared" ->\n'
                      '                 /\\ UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                      "                 /\\ sp' = [sp EXCEPT ![p].pc = \"Commit\"]\n"
                      "                 /\\ cas_lost' = (cas_lost \\/ RecordRows)\n"
                      '            [] OPhase(i) = "Offered" ->\n'
                      '                 /\\ UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                      "                 /\\ sp' = [sp EXCEPT ![p].pc = \"Call\"]\n"
                      "                 /\\ cas_lost' = (cas_lost \\/ RecordRows)\n"
                      '            [] OTHER ->\n'
                      '                 /\\ UNCHANGED <<Offer1Vars, Offer2Vars, cas_lost>>\n'
                      "                 /\\ sp' = [sp EXCEPT ![p] = EndUnder(sp[p], i)]"],
           OFFERS | {'sp', 'cas_lost'}, params=PROC)
    # The effect runner records the send intent outside protection: the publication writer,
    # then the store transaction (I10), feeding the owner the source (open, ready, the
    # snapshot's revision), admission, the current incarnation and the authority read inside
    # it; the owner decides (RecordOriginalSendIntent, or RefuseOriginalSendIntent below).
    # Offered and the outbox commit together before Meta is entered. A lost CAS reply is read
    # back. The CAS's loser reads the winner's Offered record back and dispatches it.
    action('B_CommitPub', ['sp[p].pc = "Commit"', 'alive', 'pub_holder = "none"', "pub_holder' = Runner(p)",
                           "sp' = [sp EXCEPT ![p].pc = \"CommitTx\"]"], {'pub_holder', 'sp'}, params=PROC)
    action('B_CommitStore', ['sp[p].pc = "CommitTx"', 'alive', 'conn_holder = "none"',
                             'LET i == sp[p].slot\n'
                             '       IN \\/ /\\ OPhase(i) = "Prepared" /\\ OSealed(i)\n'
                             '             /\\ ORecord(i)\n'
                             "             /\\ jr' = [jr EXCEPT ![i].outbox = (Fault # \"commit-without-outbox\"), ![i].ie = epoch,\n"
                             '                                 ![i].crev = src_revision, ![i].cinc = current_inc]\n'
                             '             /\\ \\E lost \\in BOOLEAN :\n'
                             "                    /\\ sp' = [sp EXCEPT ![p].pc = IF lost THEN \"ReadBack\" ELSE \"Call\"]\n"
                             "                    /\\ lost_reply_seen' = (lost_reply_seen \\/ (RecordRows /\\ lost))\n"
                             "             /\\ entered_after_close' = (entered_after_close \\/ LPhase # \"Open\")\n"
                             '             /\\ UNCHANGED cas_lost\n'
                             '          \\/ /\\ OPhase(i) = "Offered"\n'
                             '             /\\ UNCHANGED <<Offer1Vars, Offer2Vars, jr, lost_reply_seen, entered_after_close>>\n'
                             "             /\\ sp' = [sp EXCEPT ![p].pc = \"Call\"]\n"
                             "             /\\ cas_lost' = (cas_lost \\/ RecordRows)",
                             "pub_holder' = \"none\""],
           OFFERS | {'jr', 'sp', 'lost_reply_seen', 'entered_after_close', 'cas_lost', 'pub_holder'}, params=PROC)
    # A failed check: the owner withdraws the unsent preparation (never Offered), recording the
    # cause, and the send refuses typed by the check's cause; an offer withdrawn or settled
    # under the send ends it typed. A durable peer delivery whose cause is no verdict (a closed
    # admission, a replaced session) answers Core NotReady: Core keeps its claim and re-offers
    # it, and the same delivery is prepared again (the closed-admission-denied mutant ends it).
    action('B_CommitRefuse', ['sp[p].pc = "CommitTx"', 'alive', 'conn_holder = "none"',
                              'LET i == sp[p].slot\n'
                              '           c == CommitCause(i)\n'
                              '           keep == ClaimedPeer /\\ c \\in NotVerdictCauses /\\ Fault # "closed-admission-denied"\n'
                              '       IN \\/ /\\ OPhase(i) = "Prepared" /\\ OSealed(i)\n'
                              '             /\\ ORefuse(i)\n'
                              "             /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], IF keep THEN \"Pending\" ELSE \"Refused\",\n"
                              '                         IF Fault = "untyped-commit-refusal" THEN "None" ELSE c)]\n'
                              "             /\\ jr' = IF keep THEN [jr EXCEPT ![i].fifo = TRUE] ELSE jr\n"
                              '          \\/ /\\ OPhase(i) \\in {"Withdrawn", "CoreObserved"}\n'
                              '             /\\ UNCHANGED <<Offer1Vars, Offer2Vars, jr>>\n'
                              "             /\\ sp' = [sp EXCEPT ![p] = EndUnder(sp[p], i)]",
                              "pub_holder' = \"none\""],
           OFFERS | {'sp', 'pub_holder', 'jr'}, params=PROC)
    # A lost commit reply is resolved against the same transaction: the record is read back
    # and its intent dispatched, never a second offer (I3; the mutant prepares one).
    action('B_ReadBack', ['sp[p].pc = "ReadBack"', 'alive',
                          'IF Fault = "lost-reply-reprepare" /\\ \\E j \\in Slots : OPhase(j) = "Absent"\n'
                          "       THEN sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Create\",\n"
                          '                                      !.slot = MinSlot({j \\in Slots : OPhase(j) = "Absent"})]]\n'
                          "       ELSE sp' = [sp EXCEPT ![p].pc = \"Call\"]"],
           {'sp'}, params=PROC)
    # Executing the intent: the dispatch start is recorded in the owner (its id and this
    # process's epoch: RecordDispatchStart), then Meta is called (a peer delivery enters its
    # protected section) once: the production effect runner, or a declared fixture's
    # stand-in (I12). A dispatch of the record in this process, a caller's same-key replay
    # included, discharges the restart's re-drive (owed until this process dispatched the
    # record: the owner's last dispatch epoch). A send whose offer was settled or withdrawn
    # under it ends typed. The call-without-dispatch-record mutant calls Meta without the
    # record; send-before-owner calls it over a Prepared record; fresh-key-replay replays
    # under a new raw key after a restart.
    for name, mode in [('B_Call', 'production'), ('B_FixtureCall', 'fixture')]:
        action(name, ['sp[p].pc = "Call"', 'alive', '~joined', f'mode = "{mode}"',
                      'LET i == sp[p].slot\n'
                      '           d == ODispatchCount(i) + 1\n'
                      '           key == IF Fault = "fresh-key-replay" /\\ sp[p].kind = "driver" THEN "k3" ELSE Key(i)\n'
                      '       IN CASE OPhase(i) = "Offered" ->\n'
                      '                 /\\ IF Fault = "call-without-dispatch-record" THEN UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                      '                    ELSE ODispatch(i, d)\n'
                      "                 /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Lock\", !.key = key, !.d = d]]\n"
                      "                 /\\ jr' = [jr EXCEPT ![i].redrive = FALSE]\n"
                      '            [] Fault = "send-before-owner" /\\ OPhase(i) = "Prepared" ->\n'
                      '                 /\\ UNCHANGED <<Offer1Vars, Offer2Vars, jr>>\n'
                      "                 /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Lock\", !.key = key, !.d = d]]\n"
                      '            [] OTHER ->\n'
                      '                 /\\ UNCHANGED <<Offer1Vars, Offer2Vars, jr>>\n'
                      "                 /\\ sp' = [sp EXCEPT ![p] = EndUnder(sp[p], i)]"],
               OFFERS | {'sp', 'jr'}, params=PROC)
    # The bind's protected section. Meta's doors: the identity's lifecycle lock, held from the
    # bind through native submission (stage A runtime.rs:10988-11185), a FIFO tokio mutex. The
    # peer door: the peer binder's section inside Core's drain (one peer bind per session at a
    # time); it takes no Meta lock. Each bind reads its snapshot fresh (the cached-authority
    # mutant keeps the first bind's authority across the wait, for the bind and the entry
    # fence).
    for name, which in [('B_Lock', 'door # "Peer"'), ('B_PeerSection', 'door = "Peer"')]:
        action(name, ['sp[p].pc = "Lock"', 'alive', which, 'meta_holder = 0', "meta_holder' = p",
                      "sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = IF door = \"Helper\" THEN \"DecideA\" ELSE \"DecideP\",\n"
                      '                                  !.dec = "Pending",\n'
                      '                                  !.view = IF Fault = "cached-authority" /\\ sp[p].waited\n'
                      '                                           THEN sp[p].view ELSE auth_ok]]'],
               {'meta_holder', 'sp'}, params=PROC)
    # The pure decision at (P) and (A): a closed or expired source and a denied authority are
    # genuine refusals, checked first (I9); a held source and a replaced session answer
    # not-now (OriginalAdmissionPending: cross-session re-preparation stays closed); Bound
    # goes on to native admission in the same section. No write, wait or blocking lock
    # (I1; the block-in-protected mutant waits for the gate inside the section).
    for site, nxt in [('P', 'DecideP'), ('A', 'DecideA')]:
        action(f'B_Decide{site}', [f'sp[p].pc = "{nxt}"', 'meta_holder = p', 'alive',
                                   'Fault = "block-in-protected" => gate = "Free"',
                                   f'Decide(p, "{site}", DecisionAt(p, "{site}"))'],
               {'sp', 'meta_holder', 'held_site'}, params=PROC)
    # Native admission behind the entry fence, in the bind's section: the fence reads the
    # authority, the source and admission fresh (the entry-without-fence mutant reuses the
    # bind's view); Core admits the qualified key <<session, raw key>> once (a replay
    # deduplicates; a re-offered claim of an admitted record is bound with that record's own
    # key), may refuse it (NotAdmitted), or the answer is lost (AdmissionUnresolved: admitted
    # or not). Core's and the fence's refusals are Core's facts, recorded per dispatch. A
    # durable peer claim whose answer was lost stays Core's FIFO head (the drain's call failed;
    # a re-offer of an admitted key is deduplicated). A re-offered claim whose record Core
    # admitted passes no new fence: Core's dedup answers it (the readmitted-fence mutant fences
    # it again). The fence's refusal keeps its cause, checked in the decision's order (a closed
    # admission, a closed source, a denied authority): it decides the binder's answer to Core.
    # With late landings (env late) a lost answer may leave its admission write still in flight
    # after the call returned (LostPending): it lands or fails later (B_Land). It holds the
    # session's mutation gate and driver lock until then, so Core's next admission on the
    # session waits for it: the entry resolves the session's writes in flight first, then
    # deduplicates against what landed.
    action('B_Entry', ['sp[p].pc = "Entry"', 'meta_holder = p', 'alive',
                       'LET r == sp[p]\n'
                       '           fence == \\/ r.kind = "core" /\\ ObservedAdmitted(r.slot) /\\ Fault # "readmitted-fence"\n'
                       '                    \\/ /\\ (IF Fault = "entry-without-fence" \\/ (Fault = "cached-authority" /\\ r.waited)\n'
                       '                           THEN r.view ELSE auth_ok)\n'
                       '                       /\\ SourceOpen /\\ Admission\n'
                       '           inc == IF r.kind = "core" /\\ ObservedAdmitted(r.slot) THEN OInc(r.slot) ELSE current_inc\n'
                       '       IN \\E landed \\in SUBSET WritesInFlight(inc) :\n'
                       '          LET base == native \\cup landed\n'
                       '              dup == \\E x \\in base : x[1] = inc /\\ x[2] = r.key\n'
                       '          IN \\E res \\in EntryResults(fence, dup) :\n'
                       "            /\\ native' = IF res \\in {\"Admitted\", \"LostAfter\"} /\\ ~dup\n"
                       '                         THEN base \\cup {<<inc, r.key, epoch, r.d>>} ELSE base\n'
                       "            /\\ landing' = (landing \\ WritesInFlight(inc))\n"
                       '                          \\cup (IF res = "LostPending" THEN {<<inc, r.key, epoch, r.d>>} ELSE {})\n'
                       "            /\\ admitted_stale' = (admitted_stale \\/ (res \\in {\"Admitted\", \"LostAfter\", \"LostPending\"}\n"
                       '                                                     /\\ ~dup /\\ ~auth_ok))\n'
                       "            /\\ core_refusals' = IF res = \"NotAdmitted\" THEN core_refusals + 1 ELSE core_refusals\n"
                       "            /\\ refusals' = CASE res = \"NotAdmitted\" -> refusals \\cup {<<r.slot, r.d, \"CoreRefused\">>}\n"
                       "                            [] res = \"EntryRefused\" -> refusals \\cup {<<r.slot, r.d, \"EntryRefused\">>}\n"
                       '                            [] OTHER -> refusals\n'
                       "            /\\ lost_count' = IF res \\in LostResults THEN lost_count + 1 ELSE lost_count\n"
                       "            /\\ jr' = IF res \\in LostResults /\\ ClaimedPeer\n"
                       "                      THEN [jr EXCEPT ![r.slot].fifo = TRUE] ELSE jr\n"
                       "            /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Settle\",\n"
                       '                         !.ans = CASE res \\in LostResults -> "Unresolved"\n'
                       '                                   [] res = "NotAdmitted" -> "CoreRefused"\n'
                       '                                   [] OTHER -> res,\n'
                       '                         !.cause = IF res = "EntryRefused" THEN EntryFenceCause ELSE @]]',
                       "meta_holder' = 0"],
           {'native', 'landing', 'admitted_stale', 'core_refusals', 'refusals', 'lost_count', 'jr', 'sp', 'meta_holder'},
           params=PROC)
    # Core's store answers an admission write still in flight after its call returned (env
    # late): the write lands (the key admitted) or fails (never admitted). Until then it holds the
    # session's mutation gate and driver lock: Core's next admission on the session (B_Entry) and
    # its live read (B_ReadCore) wait for it; its durable read (B_ReadDurable) does not.
    action('B_Land', ['alive', 'landing # {}',
                      '\\E x \\in landing : \\E lands \\in BOOLEAN :\n'
                      "        /\\ native' = IF lands THEN native \\cup {x} ELSE native\n"
                      "        /\\ landing' = landing \\ {x}"],
           {'native', 'landing'})
    # After Meta returns (nothing durable inside its section or the entry's callbacks), the
    # effect runner feeds the dispatch's answer to the owner, which decides: an admission
    # settles (RetainCoreReceipt); a refusal settles only when its dispatch is the only one
    # recorded and none is unresolved, and otherwise leaves the journal
    # (RecordDispatchAnswer); a lost answer is recorded against its dispatch
    # (PreserveUnresolvedOffer) with a read by key owed (the forget-lost-reply mutant owes
    # none); a dispatch that ended without native submission (a held or refused bind, a
    # transport drop) leaves the journal. A durable delivery's bind the section refused for no
    # verdict is answered NotReady (KeepClaim) and Core keeps the claim queued: for a closed
    # admission, until the next process; for a verdict met while another dispatch of the record
    # may have admitted, the claim is held (Core re-offers it every second, and each re-offer
    # of this process meets the same verdict over the same ambiguity, so the model takes none
    # until the record changes) and a read by key is owed: a Found read settles the record (the
    # next re-offer binds), a final absence ends the ambiguity (the next re-offer is denied).
    # The entry fence's refusal of a durable delivery is answered the same way (EntryKeep):
    # NotReady for a closed admission and for a verdict over an ambiguous record (its dispatch
    # fed to the owner as not submitted: the fence stopped it before native submission), Denied
    # only for a verdict over a clear record (the fence's typed refusal settles the record).
    # The lost-as-not-submitted mutant feeds a lost answer as not submitted; receipt-wrong-kind
    # feeds the fence's refusal as Core's.
    action('B_Settle', ['sp[p].pc = "Settle"', 'alive',
                        'LET r == sp[p]\n'
                        '           i == r.slot\n'
                        '           open == OPhase(i) = "Offered" /\\ r.d \\in OOpen(i)\n'
                        '           fed == CASE Fault = "lost-as-not-submitted" /\\ r.ans = "Unresolved" -> "NotSubmitted"\n'
                        '                    [] Fault = "receipt-wrong-kind" /\\ r.ans = "EntryRefused" -> "CoreRefused"\n'
                        '                    [] EntryKeep(r) -> "NotSubmitted"\n'
                        '                    [] OTHER -> r.ans\n'
                        '           keep == KeepClaim(r) \\/ EntryKeep(r)\n'
                        '           hold == keep /\\ r.cause # "AdmissionClosed" /\\ OPhaseNext(i) = "Offered"\n'
                        '       IN /\\ IF open THEN OAnswer(i, r.d, fed) ELSE UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                        "          /\\ jr' = [jr EXCEPT ![i] =\n"
                        '                 IF keep THEN [(IF OPhaseNext(i) = "CoreObserved" THEN Settled(@) ELSE @)\n'
                        '                               EXCEPT !.fifo = TRUE, !.held = hold, !.read_owed = @ \\/ hold]\n'
                        '                 ELSE IF OPhaseNext(i) = "CoreObserved" THEN Settled(@)\n'
                        '                 ELSE IF r.ans = "Unresolved" /\\ Fault # "forget-lost-reply"\n'
                        '                 THEN [@ EXCEPT !.read_owed = TRUE]\n'
                        '                 ELSE @]\n'
                        "          /\\ claimed' = (claimed \\/ (r.ans = \"Admitted\" /\\ (mode = \"production\" \\/ Fault = \"fixture-claims\")))\n"
                        "          /\\ sp' = [sp EXCEPT ![p] = CASE r.ans = \"Admitted\" -> EndRec(r, \"Admitted\", r.cause)\n"
                        '                                     [] r.ans = "CoreRefused" -> EndRec(r, "NotAdmitted", "None")\n'
                        '                                     [] r.ans = "EntryRefused" /\\ ~EntryKeep(r) -> EndRec(r, "Refused", "EntryRefused")\n'
                        '                                     [] r.ans = "Unresolved" -> EndRec(r, "Unresolved", "None")\n'
                        '                                     [] keep -> [Finish(r) EXCEPT !.out = "Pending"]\n'
                        '                                     [] OTHER -> Finish(r)]',
                        # A read by key that started before this lost answer cannot speak for it
                        # (the stale-read-clears mutant lets it discharge the new read owed).
                        "read_slot' = IF StaleRead(p) THEN 0 ELSE read_slot",
                        "raw_read' = IF StaleRead(p) THEN \"Unread\" ELSE raw_read",
                        "published_read' = IF StaleRead(p) THEN \"Unread\" ELSE published_read",
                        "read_kind' = IF StaleRead(p) THEN \"\" ELSE read_kind"],
           OFFERS | {'jr', 'claimed', 'sp', 'read_slot', 'raw_read', 'published_read', 'read_kind'}, params=PROC)
    # Meta's wait (one deadline per send, at most 3 free rebinds) and Core's peer waiter (one
    # deadline per delivery). The wait ends when its condition clears (a rebind of the same
    # input and key), or at the deadline, which passes only while the condition persists:
    # then Held (Meta: the dispatch answered not submitted after Meta returns), or Pending (a
    # durable peer delivery: Core keeps its claim queued and the dispatch stays open), or a
    # transport drop (a volatile drop or a supervisor NotReady: no claim, the dispatch answered
    # not submitted, never a native verdict). None ends the offer: it stays Offered with its
    # intent. The never-rebind mutant's waiter never wakes on a cleared condition, so
    # its send runs into the deadline and gives up; discard-parked drops the queued claim;
    # discard-clears-obligation also clears the intent's outbox; drop-as-verdict feeds a
    # transport drop to the owner as Core's refusal.
    for who, waitpc, limit in [('Meta', 'MetaWait', True), ('Peer', 'PeerWait', False)]:
        rb = "sp[p].rb + 1" if limit else "sp[p].rb"
        action(f'B_{who}Rebind', [f'sp[p].pc = "{waitpc}"', 'alive', 'Cleared(p)', '~sp[p].dl',
                                  'Fault # "never-rebind"',
                                  f"sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Lock\", !.rb = {rb},\n"
                                  '                                  !.waited = sp[p].waited \\/ RecordRows]]'],
               {'sp'}, params=PROC)
    action('B_Deadline', ['Waiting(p)', 'alive', '~sp[p].dl', '~Cleared(p) \\/ Fault = "never-rebind"',
                          "sp' = [sp EXCEPT ![p].dl = TRUE]"],
           {'sp'}, params=PROC)
    action('B_MetaExpire', ['sp[p].pc = "MetaWait"', 'alive', 'sp[p].dl',
                            "sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Settle\", !.ans = \"NotSubmitted\", !.out = \"Held\"]]"],
           {'sp'}, params=PROC)
    action('B_PeerExpire', ['sp[p].pc = "PeerWait"', 'alive', 'sp[p].dl',
                            'IF PeerClaims\n'
                            "       THEN /\\ sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Pending\", sp[p].cause)]\n"
                            '            /\\ jr\' = [jr EXCEPT ![sp[p].slot].fifo = Fault \\notin {"discard-parked", "discard-clears-obligation"},\n'
                            '                                ![sp[p].slot].pend = TRUE,\n'
                            '                                ![sp[p].slot].outbox = @ /\\ Fault # "discard-clears-obligation"]\n'
                            "       ELSE /\\ sp' = [sp EXCEPT ![p] = [@ EXCEPT !.pc = \"Settle\", !.out = \"Dropped\",\n"
                            '                        !.ans = IF Fault = "drop-as-verdict" THEN "CoreRefused" ELSE "NotSubmitted"]]\n'
                            '            /\\ UNCHANGED jr'],
           {'sp', 'jr'}, params=PROC)
    # A caller's send is dropped at an await point before it enters Meta (Meta's send runs in
    # its foreground set and is not dropped by its caller; a peer delivery waits only to its
    # deadline): the preparer runs on; the guard changes no owner state (I8: the
    # drop-mutates-phase mutant withdraws the record, its cause included, and drop-clears-seal
    # clears the seal, without a generated transition).
    action('B_DropSend', ['"drop" \\in Env', 'door # "Peer"', 'sp[p].pc \\in {"Prepare", "Seal", "Commit"}',
                          'sp[p].kind = "caller"',
                          "sp' = [sp EXCEPT ![p] = EndRec(sp[p], \"Gone\", \"None\")]",
                          "drop_partial' = (drop_partial \\/ (RecordRows /\\ sp[p].pc = \"Prepare\" /\\ PartialIssuance))",
                          "offer_phase' = IF Fault = \"drop-mutates-phase\" /\\ sp[p].slot = 1 /\\ offer_phase = \"Prepared\"\n"
                          '                       THEN "Withdrawn" ELSE offer_phase',
                          "offer_withdrawal_cause' = IF Fault = \"drop-mutates-phase\" /\\ sp[p].slot = 1 /\\ offer_phase = \"Prepared\"\n"
                          '                                  THEN "ProcessEnded" ELSE offer_withdrawal_cause',
                          "offer_preparation_receipt' = IF Fault = \"drop-clears-seal\" /\\ sp[p].slot = 1\n"
                          '                                    THEN "" ELSE offer_preparation_receipt'],
           {'sp', 'drop_partial', 'offer_phase', 'offer_withdrawal_cause', 'offer_preparation_receipt'}, params=PROC)

    # ---- Stage B: the driver. ----
    # Reads by the offer's own qualified key when one is owed (a lost answer, a restart):
    # Found, a successful Absent or Unavailable (I13: unavailable is never absence; the
    # mutant publishes it as Absent). Core and storage are unavailable for at most
    # UnavailBound reads (the core-unavailable-forever profile drops the bound). The driver's
    # read is Core's live read, which takes the session's mutation gate and then its driver lock:
    # it waits for an admission write still in flight on the session and is ordered after it
    # (the live-read-as-durable mutant feeds it to the owner as durable). With late landings
    # (env late), and only while an admission write is in flight on the record's session (the
    # live read cannot answer then: Core degrades the session until it reloads), the driver
    # reads Core's durable read instead, which takes no gate: it can answer Absent while that
    # write is still in flight, and a durable read that is not final owes a live read. So a
    # held claim with no write in flight is settled by the live read and never loops on durable
    # reads (the durable-read-anytime mutant reads durably at any time).
    for name, kind, guards in [('B_ReadCore', 'IF Fault = "live-read-as-durable" THEN "Durable" ELSE "Live"',
                                ['WritesInFlight(OInc(i)) = {}']),
                               ('B_ReadDurable', '"Durable"',
                                ['"late" \\in Env', 'WritesInFlight(OInc(i)) # {} \\/ Fault = "durable-read-anytime"'])]:
        action(name, ['alive', 'scanned', '~joined', 'read_slot = 0', 'OPhase(i) = "Offered"', 'jr[i].read_owed',
                      *guards,
                      '\\E available \\in AvailChoices :\n'
                      "        /\\ raw_read' = IF ~available THEN \"Unavailable\" ELSE IF OfferAdmitted(i) THEN \"Found\" ELSE \"Absent\"\n"
                      "        /\\ published_read' = IF Fault = \"unavailable-as-absent\" /\\ ~available THEN \"Absent\" ELSE raw_read'\n"
                      "        /\\ unavail_reads' = IF available \\/ Fault = \"core-unavailable-forever\" THEN unavail_reads\n"
                      '                            ELSE unavail_reads + 1',
                      "read_slot' = i", f"read_kind' = {kind}"],
               {'raw_read', 'published_read', 'unavail_reads', 'read_slot', 'read_kind'}, params=SLOT)
    # The observation through the owner, with the read's kind: Found is Core's admission
    # (RetainFoundReceipt); a successful Absent keeps the record Offered (never NotAdmitted: the
    # absent-terminates mutant feeds it as Core's refusal of the last open dispatch) and, when
    # the owner finds it final (this process has dispatched the record, none of its dispatches
    # is in flight, and every dispatch left open or lost is an ended process's or, on Core's live
    # read, a lost one of this process), records the evidence with the dispatches it covers
    # (RecordFinalAbsence), which ends a held claim's hold; a durable read that is not final
    # leaves the read owed (only a live read or a later process can speak for a lost dispatch of
    # this process); Unavailable keeps it Offered and owes another read. An Unavailable or
    # non-final Absent read changes no owner field and is no owner input.
    action('B_ObserveRead', ['alive', 'read_slot # 0',
                             'LET i == read_slot\n'
                             '           open == OPhase(i) = "Offered"\n'
                             '       IN CASE published_read = "Found" \\/ (Fault = "forge-admission" /\\ published_read = "Unavailable") ->\n'
                             '                 /\\ IF open THEN ORetainFound(i) ELSE UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                             "                 /\\ jr' = [jr EXCEPT ![i] = Settled(@)]\n"
                             "                 /\\ claimed' = (claimed \\/ mode = \"production\" \\/ Fault = \"fixture-claims\")\n"
                             '            [] published_read = "Absent" /\\ Fault = "absent-terminates" ->\n'
                             '                 /\\ IF open /\\ OOpen(i) # {} THEN OAnswer(i, MaxOf(OOpen(i)), "CoreRefused")\n'
                             '                    ELSE UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                             "                 /\\ jr' = [jr EXCEPT ![i] = IF OPhaseNext(i) = \"CoreObserved\" THEN Settled(@)\n"
                             '                                            ELSE [@ EXCEPT !.read_owed = FALSE]]\n'
                             '                 /\\ UNCHANGED claimed\n'
                             '            [] published_read = "Absent" ->\n'
                             '                 LET final == open /\\ ENABLED OFinalAbsence(i)\n'
                             '                 IN /\\ IF final THEN OFinalAbsence(i) ELSE UNCHANGED <<Offer1Vars, Offer2Vars>>\n'
                             "                    /\\ jr' = [jr EXCEPT ![i].read_owed = (open /\\ read_kind = \"Durable\" /\\ ~final),\n"
                             '                                        ![i].held = @ /\\ ~final]\n'
                             '                    /\\ UNCHANGED claimed\n'
                             '            [] OTHER ->\n'
                             '                 /\\ UNCHANGED <<Offer1Vars, Offer2Vars, jr, claimed>>',
                             "read_slot' = 0", "raw_read' = \"Unread\"", "published_read' = \"Unread\"", "read_kind' = \"\"",
                             # The process that recorded the last final absence (rows only).
                             "absence_epoch' = IF RecordRows /\\ (offer_absence_through' # offer_absence_through\n"
                             "                                       \\/ offer2_absence_through' # offer2_absence_through)\n"
                             '                 THEN epoch ELSE absence_epoch'],
           OFFERS | {'jr', 'claimed', 'read_slot', 'raw_read', 'published_read', 'read_kind', 'absence_epoch'})
    # After a restart the driver dispatches each enumerated record's intent once more, with
    # the same key and input (a replay after a crash uses Core's dedup): every door's
    # record but a peer delivery's. A durable peer delivery's dispatcher is Core's claim;
    # a volatile or supervisor delivery has none, and nothing in production re-drives it (the
    # binder's only production caller is Core's drain, which offers only queued claims): its
    # record stays kept for its sender's retry. Core re-offers a queued durable claim from its
    # FIFO, whatever Connect's record says (Core does not read it): the binder answers it by the
    # record. A re-offer reuses the dispatch its delivery opened in this process; otherwise
    # it records a new one. A re-offer of a record withdrawn for no verdict (a closed admission,
    # a replaced session, an ended process) prepares the same delivery again (the
    # withdrawn-always-refused mutant refuses it); so does Core's re-offer of a claim that has no
    # record yet. A peer bind takes the session's drain. None starts while admission is closed.
    action('B_Redrive', ['alive', 'scanned', '~joined', 'LPhase = "Open"', 'OPhase(i) = "Offered"', 'jr[i].redrive',
                         '~Live(p)', 'door = "Peer" /\\ Fault # "peer-binds-concurrently" => DrainFree',
                         "sp' = [sp EXCEPT ![p] = [FreshProc EXCEPT !.pc = \"Call\", !.slot = i, !.kind = \"driver\",\n"
                         '                                             !.key = Key(i)]]',
                         "jr' = [jr EXCEPT ![i].redrive = FALSE]"],
           {'sp', 'jr'}, params=SLOT_PROC)
    action('B_CoreReoffer', ['alive', 'scanned', '~joined', 'LPhase = "Open"', 'jr[i].fifo', '~jr[i].held',
                             '~Live(p)', 'Fault = "peer-binds-concurrently" \\/ DrainFree',
                             'LET c == ClaimDispatch(i)\n'
                             "       IN sp' = [sp EXCEPT ![p] =\n"
                             '                 IF Reprepare(i) THEN [FreshProc EXCEPT !.pc = "Lookup", !.kind = "core"]\n'
                             '                 ELSE [FreshProc EXCEPT !.pc = IF OPhase(i) = "Offered" /\\ c = 0 THEN "Call" ELSE "Lock",\n'
                             '                                        !.slot = i, !.kind = "core", !.key = Key(i), !.d = c]]',
                             "jr' = [jr EXCEPT ![i].fifo = FALSE, ![i].pend = FALSE]"],
           {'sp', 'jr'}, params=SLOT_PROC)
    action('B_CoreReofferFresh', ['alive', 'scanned', '~joined', 'LPhase = "Open"', 'orphan_claim', '~Live(p)',
                                  'Fault = "peer-binds-concurrently" \\/ DrainFree',
                                  "sp' = [sp EXCEPT ![p] = [FreshProc EXCEPT !.pc = \"Lookup\", !.kind = \"core\"]]",
                                  "orphan_claim' = FALSE"],
           {'sp', 'orphan_claim'}, params=PROC)
    # One crash and restart: the send tasks, preparers, Meta's section, the store write and
    # the read die; the owner records (their dispatch journals included), outboxes, Core's
    # admissions and its queued claims survive, and the claim of a durable peer delivery still
    # in flight (or answered NotReady) is kept queued by Core, with its record or, before the
    # record exists, without one. A dispatch open at the crash stays open in the owner:
    # its outcome is unknown, and no later refusal settles the record over it (the
    # crash-clears-ambiguity mutant answers it as not submitted at the scan). An admission write
    # still in flight (env late) ends with the process, landed or not.
    process_end = [
        "sp' = [q \\in Procs |-> IF Live(q) THEN [FreshProc EXCEPT !.out = \"Crashed\", !.slot = sp[q].slot,\n"
        '                                                         !.kind = sp[q].kind]\n'
        '                           ELSE sp[q]]',
        "prep' = [n \\in Preparers |-> IF prep[n].st = \"Running\" THEN [prep[n] EXCEPT !.st = \"Dead\"] ELSE prep[n]]",
        "dead_prep' = (dead_prep \\/ (RecordRows /\\ \\E n \\in Preparers : prep[n].st = \"Running\"))",
        "pub_holder' = \"none\"", "conn_holder' = \"none\"", "meta_holder' = 0",
        "store_pc' = IF store_pc \\in {\"hook\", \"write\"} THEN \"done\" ELSE store_pc",
        "read_slot' = 0", "raw_read' = \"Unread\"", "published_read' = \"Unread\"", "read_kind' = \"\"",
        "jr' = [i \\in Slots |-> [jr[i] EXCEPT !.parked = FALSE, !.redrive = FALSE, !.read_owed = FALSE,\n"
        '                              !.held = FALSE,\n'
        '                              !.fifo = @ \\/ (ClaimedPeer /\\ OPhase(i) # "Absent"\n'
        '                                             /\\ \\E q \\in Procs : Live(q) /\\ sp[q].slot = i\n'
        '                                                /\\ (sp[q].pc # "Settle" \\/ KeepClaim(sp[q]) \\/ EntryKeep(sp[q])))]]',
        "orphan_claim' = (orphan_claim \\/ (ClaimedPeer /\\ \\E q \\in Procs : Live(q)\n"
        '                                    /\\ (sp[q].slot = 0 \\/ OPhase(sp[q].slot) = "Absent")))',
        "crashed_offered' = (crashed_offered \\/ (RecordRows /\\ \\E i \\in Slots : OPhase(i) = \"Offered\"))",
        "\\E landed \\in SUBSET landing : native' = native \\cup landed", "landing' = {}"]
    process_end_changed = {'sp', 'prep', 'dead_prep', 'pub_holder', 'conn_holder', 'meta_holder', 'store_pc',
                           'read_slot', 'raw_read', 'published_read', 'read_kind', 'jr', 'crashed_offered',
                           'orphan_claim', 'native', 'landing'}
    action('B_Crash', ['"crash" \\in Env', 'alive', 'epoch = 1', 'Busy \\/ \\E i \\in Slots : NonTerminal(i)',
                       "alive' = FALSE", *process_end],
           {'alive'} | process_end_changed)
    # The fail-stop on a poisoned publication (env poison). A holder of the authorization
    # publication the ingress shares with every authorization owner of the process panicked:
    # from then on every observation and owner change through it answers Unavailable (the
    # lifetime's close too: it takes an owner change), and nothing recovers it in place. The
    # binder's first observation that answers so raises the typed fatal diagnostic
    # (PublicationPoisoned) and the process ends through the driver's error path at once, during
    # its close too, never waiting for it. What the process loses and keeps is the crash's; the
    # next process is in a new lifetime when the ended one had begun its close, and its scan,
    # reads, re-drives and Core's re-offers recover the records.
    action('B_FailStop', ['"poison" \\in Env', 'alive', 'epoch = 1',
                          'Busy \\/ (\\E i \\in Slots : NonTerminal(i)) \\/ QueuedClaim',
                          "fatal' = \"PublicationPoisoned\"", "alive' = FALSE", *process_end],
           {'alive', 'fatal'} | process_end_changed)
    # The restart: a new process (epoch 2) scans before anything else. After a stop (the stop
    # profiles), or a fail-stop once the close had begun (the poison profiles), its component is
    # a new lifetime (staged and opened above) with no join of its own yet; otherwise the model
    # keeps the one lifetime across the crash.
    action('B_Restart', ['~alive', 'epoch = 1', "alive' = TRUE", "epoch' = 2", "scanned' = FALSE",
                         "life_cur' = IF NewLifetime THEN 2 ELSE life_cur",
                         "joined' = IF NewLifetime THEN FALSE ELSE joined"],
           {'alive', 'epoch', 'scanned', 'life_cur', 'joined'})
    # The restart scan enumerates every non-terminal record: a Prepared one is withdrawn
    # through its owner, which accepts only an ended process's preparation (its epoch: the
    # durable basis); every Offered one with its outbox is parked and a read by key owed, its
    # intent re-driven by the driver, except a peer delivery's (a durable one's dispatcher is
    # Core's claim; a volatile or supervisor one is kept for its sender's retry). The
    # skip-restart-scan mutant parks none; scan-first-record-only stops after the first record
    # (the I11 mutant over two).
    action('B_ScanWithdraw', ['alive', '~scanned', 'OPhase(i) = "Prepared"', 'OWithdraw(i)'],
           OFFERS, params=SLOT)
    action('B_ForgetAmbiguity', ['Fault = "crash-clears-ambiguity"', 'alive', '~scanned', 'OPhase(i) = "Offered"',
                                 '\\E d \\in OOpen(i) : ODispatchEpochs(i)[d] < epoch /\\ OAnswer(i, d, "NotSubmitted")'],
           OFFERS, params=SLOT)
    action('B_Scan', ['alive', '~scanned', '~\\E i \\in Slots : OPhase(i) = "Prepared" /\\ OPrepEpoch(i) < epoch',
                      "scanned' = TRUE",
                      "jr' = [i \\in Slots |-> LET pk == /\\ OPhase(i) = \"Offered\" /\\ jr[i].outbox\n"
                      '                                   /\\ Fault # "skip-restart-scan"\n'
                      '                                   /\\ ~(Fault = "scan-first-record-only" /\\ i = 2)\n'
                      '                       IN [jr[i] EXCEPT !.parked = pk, !.redrive = pk /\\ door # "Peer", !.read_owed = pk]]'],
           {'scanned', 'jr'})
    # The I8 mutants: each writes one owner field outside a generated transition.
    for field, (value, condition) in FORGE_FIELDS.items():
        action('B_Forge_' + field, [f'Fault = "{forge_fault(field)}"', 'alive', condition,
                                    f"offer_{field}' = {value}"],
               {'offer_' + field})
    # Another store write around a commit: the connection, and in the I10 mutant the
    # record-change hook's publication writer inside the transaction (A's inversion).
    action('B_StoreBegin', ['store_pc = "idle"', 'conn_holder = "none"',
                            '\\E p \\in Procs : sp[p].pc \\in {"Commit", "CommitTx"}', "conn_holder' = \"store\"",
                            "store_pc' = IF Fault = \"publication-inside-store\" THEN \"hook\" ELSE \"write\""],
           {'conn_holder', 'store_pc'})
    action('B_StoreHook', ['store_pc = "hook"', 'pub_holder = "none"', "pub_holder' = \"store\"",
                           "store_pc' = \"write\""], {'pub_holder', 'store_pc'})
    action('B_StoreEnd', ['store_pc = "write"', "conn_holder' = \"none\"",
                          "pub_holder' = IF pub_holder = \"store\" THEN \"none\" ELSE pub_holder",
                          "store_pc' = \"done\""], {'conn_holder', 'pub_holder', 'store_pc'})
    action('B_Finished', ['\\A p \\in Procs : ~Live(p)', '\\A n \\in Preparers : prep[n].st # "Running"',
                          'store_pc \\in {"idle", "done"}', 'read_slot = 0'], set())

    init = ['BA!Init', 'stage = "B" => gate = "Free"', 'src!Init', 'offer!Init', 'offer2!Init', 'life!Init',
            'life2!Init',
            'mode \\in (IF stage = "B" THEN ModeValues ELSE {"production"})',
            'sp = [p \\in Procs |-> FreshProc]',
            'prep = [n \\in Preparers |-> [st |-> "Idle", pos |-> 0, phase |-> "lookup"]]',
            'jr = [i \\in Slots |-> NoJournal]',
            'begun = 0', 'native = {}', 'core_refusals = 0', 'lost_count = 0', 'current_inc = "inc1"',
            'auth_ok = TRUE', 'meta_holder = 0', 'pub_holder = "none"', 'conn_holder = "none"', 'store_pc = "idle"',
            'alive = TRUE', 'epoch = 1', 'scanned = TRUE', 'joined = FALSE', 'read_slot = 0', 'raw_read = "Unread"',
            'published_read = "Unread"', 'unavail_reads = 0', 'dup_arts = {}', 'prep_refused = FALSE',
            'drop_partial = FALSE', 'held_site = ""', 'entered_after_close = FALSE', 'claimed = FALSE',
            'lost_reply_seen = FALSE', 'crashed_offered = FALSE', 'admitted_stale = FALSE', 'cas_lost = FALSE',
            'replayed = FALSE', 'close_waited_prep = FALSE', 'dead_prep = FALSE', 'a_held = ""', 'refusals = {}',
            'life_cur = 1', 'orphan_claim = FALSE', 'read_kind = ""', 'landing = {}', 'absence_epoch = 0',
            'fatal = ""']
    initialized = {re.match(r'(\w+)', e)[1] for e in init[7:]}
    if initialized != set(B_VARS):
        raise ValueError(f'B init mismatch: {sorted(initialized ^ set(B_VARS))}')
    ba_instance = ('BA == INSTANCE bind_attempt WITH\n    Fault <- AFault,\n    '
                   + ',\n    '.join(f'{v} <- a_{v}' for v in A_OWN))
    ranks = ', '.join(f'{entry["lock"]} |-> {entry["rank"]}' for entry in table)

    def per_slot(field):
        return f'O{field}(i) == IF i = 1 THEN offer_{field} ELSE offer2_{field}'

    def owner_op(name, call, args=''):
        sig = f'(i{", " + args if args else ""})'
        one = call.replace('$', 'offer')
        two = call.replace('$', 'offer2')
        return (f'O{name}{sig} ==\n'
                f'    IF i = 1\n    THEN offer!{one}\n         /\\ UNCHANGED Offer2Vars\n'
                f'    ELSE offer2!{two}\n         /\\ UNCHANGED Offer1Vars')

    identity = '$_offer_key, $_revision, $_input_digest, $_incarnation'
    commit_view = ('$_offer_key, $_revision, src_source_key,\n'
                   '        IF Fault = "stale-snapshot" THEN $_source_revision ELSE src_revision,\n'
                   '        IF Fault = "cached-incarnation" THEN $_incarnation ELSE current_inc,\n'
                   '        Fault = "stale-snapshot" \\/ src_phase = "Open",\n'
                   '        Fault = "stale-snapshot" \\/ src_readiness = "Ready", Admission, auth_ok')
    helpers = [
        'Procs == 1..ProcBound',
        'Sends == 1..SendBound',
        '\\* The preparers: one per caller send, and index 0 for Core\'s re-offer of a delivery',
        '\\* prepared again (one at a time: the drain binds one peer delivery at a time).',
        'Preparers == 0..SendBound',
        'Slots == {1, 2}',
        '\\* Meta binds again at most OWNER_CHANGE_FREE_REBUILDS times (owner_change_wait.rs:55).',
        'RebindLimit == 3',
        'Key(i) == IF i = 1 THEN "k1" ELSE "k2"',
        'Runner(p) == IF p = 1 THEN "runner1" ELSE "runner2"',
        'MinSlot(s) == IF 1 \\in s THEN 1 ELSE 2',
        'MaxOf(s) == CHOOSE x \\in s : \\A y \\in s : y <= x',
        '\\* The current process\'s component lifetime: the first, or the next process\'s new one (a\n'
        '\\* restart after a stop, or after a fail-stop once the close had begun).',
        'LPhase == IF life_cur = 2 THEN life2_phase ELSE life_phase',
        'NewLifetime == \\/ "stop" \\in Env /\\ life_phase = "Closed"\n'
        '               \\/ fatal # "" /\\ life_phase # "Open" /\\ Fault # "failstop-keeps-closing-lifetime"',
        'Admission == LPhase = "Open" \\/ (Fault = "admit-after-close" /\\ LPhase = "Closing")',
        'SourceOpen == src_phase = "Open" /\\ src_readiness = "Ready"',
        'Offer1Vars == <<' + ', '.join(offer_vars) + '>>',
        'Offer2Vars == <<' + ', '.join(offer2_vars) + '>>',
        *[per_slot(field) for field in offer_fields if field != 'phase'],
        per_slot('phase'),
        'OPhase(i) == Ophase(i)',
        'OSrcRev(i) == Osource_revision(i)',
        'OInc(i) == Oincarnation(i)',
        'OSealed(i) == Opreparation_receipt(i) # ""',
        'OPrepEpoch(i) == Opreparation_epoch(i)',
        'ODispatchCount(i) == Odispatch_count(i)',
        'ODispatchEpochs(i) == Odispatch_epochs(i)',
        'OUnresolved(i) == Ounresolved_dispatches(i)',
        'OLastDispatchEpoch(i) == Olast_dispatch_epoch(i)',
        'OReceiptKind(i) == Oreceipt_kind(i)',
        'OReceiptDispatch(i) == Oreceipt_dispatch(i)',
        'OReceiptEpoch(i) == Oreceipt_epoch(i)',
        'OAbsenceThrough(i) == Oabsence_through(i)',
        '\\* The close\'s unresolved record, with the closing process\'s epoch (0: none). One close per\n'
        '\\* behavior: the record is written once.',
        'OCloseEpoch(i) == Oclose_epoch(i)',
        '\\* Why an offer was withdrawn: a verdict on the delivery (a denied authority, a closed or\n'
        '\\* changed source) or not (a closed admission, a replaced session, an ended process), when the\n'
        '\\* same delivery is prepared again.',
        'OWithdrawalCause(i) == Owithdrawal_cause(i)',
        'OVerdictWithdrawal(i) == OWithdrawalCause(i) \\in {"PolicyDenied", "SourceClosed"}',
        'Reprepare(i) == OPhase(i) = "Withdrawn" /\\ ~OVerdictWithdrawal(i) /\\ Fault # "withdrawn-always-refused"',
        'NotVerdictCauses == {"AdmissionClosed", "PreparationStale"}',
        '\\* The dispatches recorded and not answered: in flight, or of an ended process (ambiguous).',
        'OOpen(i) == DOMAIN ODispatchEpochs(i) \\ OUnresolved(i)',
        '\\* Another dispatch of the record than d may have admitted: open (in flight, or an ended\n'
        '\\* process\'s) or unresolved, and not covered by the final-absence evidence.',
        'Ambiguous(i, d) == \\E x \\in (OOpen(i) \\ {d}) \\cup OUnresolved(i) : x > OAbsenceThrough(i)',
        'OPhaseNext(i) == IF i = 1 THEN offer_phase\' ELSE offer2_phase\'',
        'AdmittedReceipt(i) == "admitted-" \\o Key(i)',
        'RefusalReceipt(i) == "refused-" \\o Key(i)',
        'ReceiptFor(i, a) == CASE a = "Admitted" -> AdmittedReceipt(i)\n'
        '                     [] a \\in {"CoreRefused", "EntryRefused"} -> RefusalReceipt(i)\n'
        '                     [] OTHER -> ""',
        '\\* The generated offer owner\'s transitions, for one slot; the other slot is unchanged.',
        owner_op('Prepare', 'PrepareOriginalOffer(IF i = 1 THEN "offer1" ELSE "offer2", "source1", src_revision, '
                            'current_inc, IF i = 1 THEN "input1" ELSE "input2", IF i = 1 THEN "digest1" ELSE "digest2", '
                            'IF i = 1 THEN "binding1" ELSE "binding2", IF i = 1 THEN "prep1" ELSE "prep2", epoch)'),
        owner_op('Seal', 'SealOriginalPreparation($_offer_key, $_revision, $_preparation_id, $_input_digest, '
                         'IF i = 1 THEN "sealed1" ELSE "sealed2")'),
        '\\* The send intent, fed what the commit read (the owner decides whether it commits or\n'
        '\\* refuses): the stale-snapshot mutant passes the offer\'s own revision and claims the\n'
        '\\* source open and ready; cached-incarnation passes the offer\'s own incarnation.',
        owner_op('Record', 'RecordOriginalSendIntent(' + commit_view + ')'),
        owner_op('Refuse', 'RefuseOriginalSendIntent(' + commit_view + ')'),
        owner_op('Withdraw', 'WithdrawUnsentPreparation($_offer_key, $_revision, epoch)'),
        owner_op('Dispatch', 'RecordDispatchStart($_offer_key, $_revision, epoch, d)', 'd'),
        owner_op('RetainDispatch', f'RetainCoreReceipt({identity}, d, a, ReceiptFor(i, a))', 'd, a'),
        owner_op('PruneDispatch', f'RecordDispatchAnswer({identity}, d, a, ReceiptFor(i, a))', 'd, a'),
        owner_op('UnresolvedDispatch', f'PreserveUnresolvedOffer({identity}, d, a, "")', 'd, a'),
        '\\* A dispatch\'s answer, fed to the owner: exactly one of its three transitions accepts it.',
        'OAnswer(i, d, a) == ORetainDispatch(i, d, a) \\/ OPruneDispatch(i, d, a) \\/ OUnresolvedDispatch(i, d, a)',
