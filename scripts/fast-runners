}

# Runner classes. Machines are on-demand (STANDARD); the work area
# (checkouts, target dirs, Cargo home, temp) is a tmpfs sized well under RAM.
CLASSES = {
    "x64-xl": {"machine": "c4d-standard-192", "arch": "x64", "vcpus": 192, "boot_gb": 200, "work": "320g"},
    "x64-l": {"machine": "c4d-standard-96", "arch": "x64", "vcpus": 96, "boot_gb": 150, "work": "160g"},
    "arm64-xl": {"machine": "c4a-standard-72", "arch": "arm64", "vcpus": 72, "boot_gb": 200, "work": "120g"},
}
MAX_RUNNERS = 8
MAX_VCPUS = 1536
LANE_ID = re.compile(r"[a-z][a-z0-9-]{0,39}")
DEFAULT_SPEC = '[{"lane": "workspace-lib", "class": "x64-xl"}]'


class Failure(Exception):
    pass


def log(message):
    print(message, flush=True)


def die(message, code=1):
    print(f"::error::{message}", flush=True)
    sys.exit(code)


def mask(value):
    # Only for credentials. A masked value must never reach a job output:
    # GitHub drops outputs that contain one.
    if value:
        print(f"::add-mask::{value}", flush=True)


def env(name, default=""):
    return os.environ.get(name, default)


def write_outputs(**values):
    """Writes job outputs to GITHUB_OUTPUT without printing them."""
    path = env("GITHUB_OUTPUT")
    if not path:
        raise Failure("GITHUB_OUTPUT is not set")
    with open(path, "a", encoding="utf-8") as handle:
        handle.write("".join(f"{key}={value}\n" for key, value in values.items()))


# --- trigger -----------------------------------------------------------------


def trigger_problems():
    problems = []
    for name, want in (
        ("GITHUB_EVENT_NAME", "workflow_dispatch"),
        ("GITHUB_REF", "refs/heads/main"),
        ("GITHUB_REPOSITORY_OWNER", OWNER),
        ("GITHUB_ACTOR", OWNER),
        ("GITHUB_TRIGGERING_ACTOR", OWNER),
        ("RUNNER_ENVIRONMENT", "github-hosted"),
    ):
        if env(name) != want:
            problems.append(f"{name}={env(name)!r} (needs {want!r})")
    if env("GITHUB_REPOSITORY") not in REPOSITORIES:
        problems.append(f"GITHUB_REPOSITORY={env('GITHUB_REPOSITORY')!r} is not allowlisted")
    if env("GITHUB_WORKFLOW_REF") not in WORKFLOWS:
        problems.append(f"GITHUB_WORKFLOW_REF={env('GITHUB_WORKFLOW_REF')!r} is not allowlisted")
    if not re.fullmatch(r"[0-9]+", env("GITHUB_RUN_ID")) or not re.fullmatch(r"[0-9]+", env("GITHUB_RUN_ATTEMPT")):
        problems.append("GITHUB_RUN_ID / GITHUB_RUN_ATTEMPT are not numeric")
    return problems


def cmd_check_trigger():
    problems = trigger_problems()
    if problems:
        for problem in problems:
            log(f"not eligible: {problem}")
        return 1
    log("eligible: owner workflow_dispatch of an allowlisted workflow on refs/heads/main")
    return 0


# --- spec and names ---------------------------------------------------------------


def parse_spec():
    """Returns [(lane, class)]: one runner, one VM and one label per pool lane."""
    raw = env("FAST_RUNNERS_SPEC") or DEFAULT_SPEC
    try:
        spec = json.loads(raw)
    except ValueError as error:
        raise Failure(f"FAST_RUNNERS_SPEC is not JSON: {error}") from error
    if not isinstance(spec, list) or not spec:
        raise Failure("FAST_RUNNERS_SPEC must be a non-empty JSON list")
    lanes = []
    for entry in spec:
        if not isinstance(entry, dict) or set(entry) != {"lane", "class"}:
            raise Failure(f"runner entries are {{\"lane\", \"class\"}}, got {entry!r}")
        lane, cls = entry["lane"], entry["class"]
        if not isinstance(lane, str) or not LANE_ID.fullmatch(lane):
            raise Failure(f"lane id {lane!r} must match {LANE_ID.pattern}")
        if cls not in CLASSES:
            raise Failure(f"unknown runner class {cls!r} (known: {sorted(CLASSES)})")
        lanes.append((lane, cls))
    if len({lane for lane, _ in lanes}) != len(lanes):
        raise Failure("each pool lane gets exactly one runner; lane ids repeat")
    if len(lanes) > MAX_RUNNERS:
        raise Failure(f"{len(lanes)} runners requested; at most {MAX_RUNNERS} per run")
    vcpus = sum(CLASSES[cls]["vcpus"] for _, cls in lanes)
    if vcpus > MAX_VCPUS:
        raise Failure(f"{vcpus} vCPUs requested; at most {MAX_VCPUS} per run")
    return lanes


def runner_names(lanes, run_id=None, attempt=None):
    run_id = run_id or env("GITHUB_RUN_ID")
    attempt = attempt or env("GITHUB_RUN_ATTEMPT")
    return {lane: f"meerkat-fast-{run_id}-{attempt}-{index}" for index, (lane, _) in enumerate(lanes)}


def cmd_names():
    try:
        lanes = parse_spec()
    except Failure as error:
        die(str(error))
    names = runner_names(lanes)
    for lane, cls in lanes:
        print(f"{names[lane]}\t{lane}\t{cls}")
    return 0


# --- external calls ------------------------------------------------------------------


def run(cmd, stdin=None, check=True):
    proc = subprocess.run(cmd, input=stdin, capture_output=True)
    if check and proc.returncode != 0:
        stderr = proc.stderr.decode(errors="replace").strip().splitlines()
        raise Failure(f"{' '.join(cmd[:4])} failed: {stderr[-1] if stderr else proc.returncode}")
    return proc


def github(method, path, token, body=None, allow_missing=False):
    """Calls the GitHub REST API with curl; the token travels in a 0600 header file."""
    with tempfile.NamedTemporaryFile("w", dir=env("RUNNER_TEMP") or None, delete=False) as headers:
        os.chmod(headers.name, 0o600)
        headers.write(f"Authorization: Bearer {token}\n")
        headers.write("Accept: application/vnd.github+json\n")
        headers.write("X-GitHub-Api-Version: 2022-11-28\n")
    try:
        cmd = ["curl", "-sS", "-X", method, "-H", f"@{headers.name}", "-w", "\n%{http_code}"]
        if body is not None:
            cmd += ["-H", "Content-Type: application/json", "--data-binary", "@-"]
        cmd.append(GITHUB_API + path)
        proc = run(cmd, stdin=json.dumps(body).encode() if body is not None else None)
    finally:
        os.unlink(headers.name)
    text, _, status = proc.stdout.decode().rpartition("\n")
    if allow_missing and status == "404":
        return None
    if not status.startswith("2"):
        raise Failure(f"GitHub {method} {path} returned HTTP {status}")
    return json.loads(text) if text.strip() else {}


def paginate(path, token, key=None):
    """Every item of a paginated listing (100 per page)."""
    items, page = [], 1
    while True:
        separator = "&" if "?" in path else "?"
        data = github("GET", f"{path}{separator}per_page=100&page={page}", token)
        batch = data if key is None else (data or {}).get(key, [])
        items.extend(batch or [])
        if len(batch or []) < 100:
            return items
        page += 1


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def app_jwt():
    """A GitHub App JWT signed by the non-exportable Cloud KMS key (no private key here)."""
    app_id = env("MEERKAT_FAST_RUNNERS_APP_ID")
    if not re.fullmatch(r"[0-9]+", app_id):
        raise Failure("MEERKAT_FAST_RUNNERS_APP_ID is not set")
    now = int(time.time())
    signing_input = (b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode()) + "."
                     + b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode()))
    with tempfile.TemporaryDirectory(dir=env("RUNNER_TEMP") or None) as workdir:
        data = os.path.join(workdir, "jwt-input")
        signature = os.path.join(workdir, "jwt-signature")
        with open(data, "w", encoding="utf-8") as handle:
            handle.write(signing_input)
        run(["gcloud", "kms", "asymmetric-sign", "--project", PROJECT, "--location", REGION,
             "--keyring", KEYRING, "--key", APP_KEY, "--version", APP_KEY_VERSION,
             "--digest-algorithm", "sha256", "--input-file", data, "--signature-file", signature])
        with open(signature, "rb") as handle:
            raw = handle.read()
    if not raw:
        raise Failure("Cloud KMS returned an empty signature")
    return signing_input + "." + b64url(raw)


def installation_token(repository, permissions):
    """Mints a one-hour installation token limited to one repository and `permissions`."""
    jwt = app_jwt()
    installation = github("GET", f"/repos/{repository}/installation", jwt)
    token = github("POST", f"/app/installations/{installation['id']}/access_tokens", jwt, {
        "repositories": [repository.split("/", 1)[1]],
        "permissions": permissions,
    })["token"]
    mask(token)
    return token


def revoke(tokens):
    for token in tokens:
        if not token:
            continue
        try:
            github("DELETE", "/installation/token", token, allow_missing=True)
        except Failure as error:
            log(f"::warning title=Fast runners::could not revoke an installation token ({error}); it expires within the hour")


def encrypt(plaintext):
    ciphertext = run(["gcloud", "kms", "encrypt", "--project", PROJECT, "--location", REGION,
                      "--keyring", KEYRING, "--key", JIT_KEY,
                      "--plaintext-file", "-", "--ciphertext-file", "-"], stdin=plaintext.encode()).stdout
    return base64.b64encode(ciphertext).decode()


def instance_exists(name):
    proc = run(["gcloud", "compute", "instances", "describe", name, "--project", PROJECT, "--zone", ZONE,
                "--format", "value(name)"], check=False)
    if proc.returncode == 0:
        return True
    if b"was not found" in proc.stderr:
        return False
    raise Failure(f"cannot describe instance {name}")


# --- review precondition ------------------------------------------------------------------


def codeowners_pattern(pattern):
    """A CODEOWNERS (gitignore-style) pattern as a regex over repository paths."""
    anchored = pattern.startswith("/") or "/" in pattern.strip("/")
    body = pattern.strip("/")
    directory = pattern.endswith("/")
    regex, index = "", 0
    while index < len(body):
        if body.startswith("**", index):
            regex += ".*"
            index += 2
        elif body[index] == "*":
            regex += "[^/]*"
            index += 1
        elif body[index] == "?":
            regex += "[^/]"
            index += 1
        else:
            regex += re.escape(body[index])
            index += 1
    prefix = "" if anchored else "(?:.*/)?"
    suffix = "/.*" if directory else "(?:/.*)?"
    return re.compile("^" + prefix + regex + suffix + "$")


def codeowners_problems(repository, text):
    if text is None:
        return [f"{repository}: no .github/CODEOWNERS"]
    rules = []
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            parts = line.split()
            rules.append((codeowners_pattern(parts[0]), parts[1:]))
    problems = []
    for path in PROTECTED_PATHS[repository]:
        owners = None
        for pattern, rule_owners in rules:  # the last matching rule wins
            if pattern.match(path):
                owners = rule_owners
        if owners != [f"@{OWNER}"]:
            problems.append(f"{repository}: CODEOWNERS gives {path} to {owners}, not only @{OWNER}")
    return problems


def other_writers(repository, token):
    writers = []
    for user in paginate(f"/repos/{repository}/collaborators?affiliation=all", token):
        permissions = user.get("permissions") or {}
        if user.get("login") != OWNER and any(permissions.get(key) for key in ("admin", "maintain", "push")):
            writers.append(user.get("login"))
    for key in paginate(f"/repos/{repository}/keys", token):
        if not key.get("read_only", True):
            writers.append(f"deploy key {key.get('id')}")
    return writers


def review_ruleset_problems(repository, token):
    for summary in paginate(f"/repos/{repository}/rulesets?includes_parents=true", token):
        ruleset = github("GET", f"/repos/{repository}/rulesets/{summary['id']}", token)
        if ruleset.get("enforcement") != "active" or ruleset.get("target") != "branch":
            continue
        refs = (ruleset.get("conditions") or {}).get("ref_name") or {}
        main = {"~DEFAULT_BRANCH", "refs/heads/main", "~ALL"}
        if not main & set(refs.get("include") or []) or {"~DEFAULT_BRANCH", "refs/heads/main"} & set(refs.get("exclude") or []):
            continue
        bypass = ruleset.get("bypass_actors") or []
        if any(actor.get("actor_type") != "RepositoryRole" or actor.get("actor_id") != ADMIN_ROLE_ID for actor in bypass):
            continue
        for rule in ruleset.get("rules") or []:
            parameters = rule.get("parameters") or {}
            if (rule.get("type") == "pull_request"
                    and parameters.get("require_code_owner_review") is True
                    and parameters.get("dismiss_stale_reviews_on_push") is True
                    and parameters.get("require_last_push_approval") is True
                    and int(parameters.get("required_approving_review_count") or 0) >= 1):
                return []
    return [f"{repository}: no active main ruleset requires code-owner review, dismisses stale reviews and "
            "requires approval of the last push with only the admin role as bypass"]


def read_optional(path):
    if not path or not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def precondition_problems(repository, token, codeowners_text):
    """Another writer may exist only behind owner code review of the pool files."""
    writers = other_writers(repository, token)
    if not writers:
        return []
    problems = codeowners_problems(repository, codeowners_text)
    problems += review_ruleset_problems(repository, token)
    return [f"{problem} (other writers: {', '.join(writers)})" for problem in problems]


# --- startup and reaper scripts ----------------------------------------------------------------

STARTUP = r"""#!/bin/bash
# Meerkat fast runner boot (rendered by scripts/fast-runners render-startup).
# Runs as root once. It never prints the runner registration: GCE keeps this
# output in the serial console and the journal.
set -euo pipefail

MD=http://metadata.google.internal/computeMetadata/v1
md() { curl -fsS -H 'Metadata-Flavor: Google' "${MD}/instance/attributes/$1"; }

state=/var/lib/meerkat-fast-runner
if [[ -e "${state}/booted" ]]; then
  # One boot, one job: a restarted VM never registers again. It stays up
  # (powering off would clear the GCE max-run-duration), so runners-down,
  # that TTL or the reaper deletes it.
  echo "meerkat-fast-runner: second boot, not registering"
  exit 0
fi
install -d -m 0700 "${state}"
touch "${state}/booted"

run_id="$(md meerkat-fast-run-id)"
run_attempt="$(md meerkat-fast-run-attempt)"
kms_key="$(md meerkat-fast-kms-key)"
arch="$(md meerkat-fast-arch)"
work_size="$(md meerkat-fast-work-size)"
[[ "${run_id}" =~ ^[0-9]+$ && "${run_attempt}" =~ ^[0-9]+$ ]] || { echo "meerkat-fast-runner: bad run pin"; exit 1; }
[[ "${work_size}" =~ ^[0-9]+g$ ]] || { echo "meerkat-fast-runner: bad work size"; exit 1; }

# The job-started hook and its policy: root-owned, read-only to the job user.
install -d -m 0755 /etc/meerkat-fast-runner /opt/meerkat-fast-runner
md meerkat-fast-hook > /opt/meerkat-fast-runner/job-started-hook
chmod 0755 /opt/meerkat-fast-runner/job-started-hook
cat > /etc/meerkat-fast-runner/policy.env <<EOF
OWNER=@OWNER@
OWNER_ID=@OWNER_ID@
REPOSITORIES=@REPOSITORIES@
WORKFLOWS=@WORKFLOWS@
RUN_ID=${run_id}
RUN_ATTEMPT=${run_attempt}
EOF
chmod 0644 /etc/meerkat-fast-runner/policy.env

# The job user has no sudo, so a job cannot stop its VM (which would clear
# the GCE max-run-duration), undo the metadata block below or touch the hook.
id runner >/dev/null 2>&1 || useradd --create-home --shell /bin/bash runner
rm -f /etc/sudoers.d/runner

# Runner binary and the build basics hosted images ship: preinstalled in a
# custom image (it drops the image-ready marker), else installed here.
if [[ ! -e /opt/meerkat-fast-runner/image-ready ]]; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq build-essential pkg-config libssl-dev git curl jq zstd unzip ca-certificates \
    python3 python3-venv >/dev/null
fi
if [[ ! -x /opt/actions-runner/run.sh ]]; then
  case "${arch}" in
    x64) sum=@SHA_X64@ ;;
    arm64) sum=@SHA_ARM64@ ;;
    *) echo "meerkat-fast-runner: unknown arch"; exit 1 ;;
  esac
  pkg="actions-runner-linux-${arch}-@VERSION@.tar.gz"
  curl -fsSL -o "/tmp/${pkg}" "https://github.com/actions/runner/releases/download/v@VERSION@/${pkg}"
  echo "${sum}  /tmp/${pkg}" | sha256sum -c -
  install -d /opt/actions-runner
  tar -xzf "/tmp/${pkg}" -C /opt/actions-runner
  /opt/actions-runner/bin/installdependencies.sh
fi

# The work area (checkouts, target dirs, Cargo home, temp) lives in RAM at
# the runner's relative work folder; /home/runner/work points at it, as on
# GitHub-hosted runners.
install -d /opt/actions-runner/_work
mount -t tmpfs -o "size=${work_size},mode=0755" tmpfs /opt/actions-runner/_work
install -d -o runner -g runner /opt/actions-runner/_work/.cargo /opt/actions-runner/_work/_tmp
ln -sfn /opt/actions-runner/_work /home/runner/work
ln -sfn /opt/actions-runner/_work/.cargo /home/runner/.cargo
printf 'ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/meerkat-fast-runner/job-started-hook\nTMPDIR=/opt/actions-runner/_work/_tmp\n' > /opt/actions-runner/.env
chown -R runner:runner /opt/actions-runner
chown -h runner:runner /home/runner/work /home/runner/.cargo

# This VM's single-use registration, decrypted with the VM identity (the
# only Cloud KMS permission it has) into a file only the job user can read;
# the runner reads it into ACTIONS_RUNNER_INPUT_JITCONFIG and deletes it, so
# it is never in a command line or in sudo's log.
install -d -m 0700 -o runner -g runner /run/meerkat-fast-runner
token="$(curl -fsS -H 'Metadata-Flavor: Google' "${MD}/instance/service-accounts/default/token" |
  python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')"
umask 077
md meerkat-fast-jit-config-kms |
  python3 -c 'import json,sys; print(json.dumps({"ciphertext": sys.stdin.read().strip()}))' |
  curl -fsS -X POST -H @<(printf 'Authorization: Bearer %s\n' "${token}") -H 'Content-Type: application/json' \
    --data-binary @- "https://cloudkms.googleapis.com/v1/${kms_key}:decrypt" |
  python3 -c 'import base64,json,sys; sys.stdout.write(base64.b64decode(json.load(sys.stdin)["plaintext"]).decode())' \
  > /run/meerkat-fast-runner/jit
unset token
chown runner:runner /run/meerkat-fast-runner/jit
chmod 0400 /run/meerkat-fast-runner/jit

# Job processes do not reach the metadata server's token endpoint (DNS on
# port 53 keeps working); without sudo the job cannot undo this.
iptables -I OUTPUT -p tcp -d 169.254.169.254 --dport 80 -m owner --uid-owner runner -j REJECT

# Exactly one job. The VM then idles until runners-down, the GCE
# max-run-duration or the reaper deletes it.
cd /opt/actions-runner
runuser -u runner -- /bin/bash -c '
  ACTIONS_RUNNER_INPUT_JITCONFIG="$(cat /run/meerkat-fast-runner/jit)"
  export ACTIONS_RUNNER_INPUT_JITCONFIG
  rm -f /run/meerkat-fast-runner/jit
  export ACTIONS_RUNNER_HOOK_JOB_STARTED=/opt/meerkat-fast-runner/job-started-hook
  exec ./run.sh' || echo "meerkat-fast-runner: runner exited with $?"
echo "meerkat-fast-runner: job finished; waiting for deletion"
"""

REAPER = r"""#!/bin/bash
# Meerkat fast-runner reaper (rendered by scripts/fast-runners render-reaper).
# Runs every 15 minutes as meerkat-fast-reaper (Cloud Scheduler -> Cloud Run
# job) and deletes every pool VM older than @REAP@ minutes in ANY state:
# a stopped or suspended VM no longer has a max-run-duration.
set -uo pipefail
project=@PROJECT@
cutoff=$(( $(date -u +%s) - @REAP@ * 60 ))
listing="$(gcloud compute instances list --project "${project}" \
  --filter='labels.purpose=meerkat-fast-runner' \
  --format='value(name,zone.basename(),creationTimestamp,status)')" || { echo "reaper: listing failed"; exit 1; }
reaped=0
failed=0
while IFS=$'\t' read -r name zone created status; do
  [[ -n "${name}" ]] || continue
  if (( $(date -u -d "${created}" +%s) < cutoff )); then
    if gcloud compute instances delete "${name}" --zone "${zone}" --project "${project}" --delete-disks all --quiet; then
      echo "reaped ${name} (${zone}, ${status}, created ${created})"
      reaped=$((reaped + 1))
    else
      echo "reaper: could not delete ${name}"
      failed=1
    fi
  fi
done <<< "${listing}"
echo "meerkat-fast-reaper: reaped ${reaped}"
exit "${failed}"
"""


def render(template, values):
    for key, value in values.items():
        template = template.replace(key, value)
    return template


def render_startup():
    return render(STARTUP, {
        "@OWNER@": OWNER,
        "@OWNER_ID@": OWNER_ID,
        "@REPOSITORIES@": " ".join(REPOSITORIES),
        "@WORKFLOWS@": " ".join(WORKFLOWS),
        "@VERSION@": RUNNER_VERSION,
        "@SHA_X64@": RUNNER_SHA256["x64"],
        "@SHA_ARM64@": RUNNER_SHA256["arm64"],
    })


def render_reaper():
    return render(REAPER, {"@PROJECT@": PROJECT, "@REAP@": str(REAP_AFTER_MINUTES)})


def cmd_render_startup():
    sys.stdout.write(render_startup())
    return 0


def cmd_render_reaper():
    sys.stdout.write(render_reaper())
    return 0


# --- up / down -----------------------------------------------------------------------------------


def hosted(reason):
    log(f"lanes use GitHub-hosted runners: {reason}")
    write_outputs(backend="hosted", runs_on="{}", attempt=env("GITHUB_RUN_ATTEMPT", "0"))


def hook_source():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fast-runners-job-started-hook")
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def create_instance(name, lane, cls, ciphertext, workdir):
    spec = CLASSES[cls]
    startup = os.path.join(workdir, "startup-script")
    hook = os.path.join(workdir, "job-started-hook")
    jit = os.path.join(workdir, f"{name}.jit")
    with open(jit, "w", encoding="utf-8") as handle:
        handle.write(ciphertext)
    repo_label = SHORT[env("GITHUB_REPOSITORY")]
    metadata = ",".join([
        "enable-oslogin=TRUE",
        "block-project-ssh-keys=TRUE",
        "serial-port-enable=FALSE",
        f"meerkat-fast-run-id={env('GITHUB_RUN_ID')}",
        f"meerkat-fast-run-attempt={env('GITHUB_RUN_ATTEMPT')}",
        f"meerkat-fast-repository={env('GITHUB_REPOSITORY')}",
        f"meerkat-fast-kms-key={JIT_KEY_NAME}",
        f"meerkat-fast-arch={spec['arch']}",
        f"meerkat-fast-work-size={spec['work']}",
    ])
    labels = ",".join([
        "purpose=meerkat-fast-runner",
        f"repo={repo_label}",
        f"run-id={env('GITHUB_RUN_ID')}",
        f"run-attempt={env('GITHUB_RUN_ATTEMPT')}",
        f"lane={lane}",
        f"runner-class={cls}",
    ])
    cmd = [
        "gcloud", "compute", "instances", "create", name,
        "--project", PROJECT,
        "--zone", ZONE,
        "--machine-type", spec["machine"],
        f"--network-interface=subnet={SUBNET},no-address",
        "--service-account", RUNNER_SA,
        "--scopes", "cloud-platform",
        "--image-project", IMAGE_PROJECT,
        "--image-family", IMAGE_FAMILY[spec["arch"]],
        "--boot-disk-size", f"{spec['boot_gb']}GB",
        "--boot-disk-type", "hyperdisk-balanced",
        "--provisioning-model", "STANDARD",
        "--max-run-duration", f"{MAX_RUN_MINUTES}m",
        "--instance-termination-action", "DELETE",
        "--no-restart-on-failure",
        "--shielded-secure-boot",
        "--shielded-vtpm",
        "--shielded-integrity-monitoring",
        "--labels", labels,
        "--metadata", metadata,
        "--metadata-from-file",
        f"startup-script={startup},meerkat-fast-hook={hook},meerkat-fast-jit-config-kms={jit}",
        "--quiet",
    ]
    return subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)


def registered_runners(token, repository):
    return {runner.get("name"): runner for runner in paginate(f"/repos/{repository}/actions/runners", token, key="runners")}


def wait_online(token, repository, expected):
    """Waits until every runner is online; each must carry exactly its own label."""
    deadline = time.monotonic() + ONLINE_TIMEOUT
    while True:
        runners = registered_runners(token, repository)
        for name, label in expected.items():
            runner = runners.get(name)
            if runner is not None:
                labels = sorted(item.get("name") for item in runner.get("labels") or [])
                if labels != [label]:
                    raise Failure(f"runner {name} carries labels {labels}; it must carry only its own")
        missing = [name for name in expected if (runners.get(name) or {}).get("status") != "online"]
        if not missing:
            return
        if time.monotonic() >= deadline:
            raise Failure(f"runners not online after {ONLINE_TIMEOUT}s: {missing}")
        time.sleep(ONLINE_POLL)


def cleanup(names, token=None, settle=0):
    """Deletes the named VMs and runner registrations; returns the failures.

    With `settle` > 0, names not found are looked up once more after that
    many seconds: an insert sent by an `up` that was cancelled can still be
    in flight.
    """
    failures = []
    repository = env("GITHUB_REPOSITORY")
    existing = []

    def find(candidates):
        for name in candidates:
            try:
                if instance_exists(name):
                    existing.append(name)
            except Failure as error:
                failures.append(str(error))

    find(names)
    missing = [name for name in names if name not in existing]
    if missing and settle > 0:
        log(f"{len(missing)} VM(s) not found; looking again in {settle}s for inserts still in flight")
        time.sleep(settle)
        find(missing)
    if existing:
        try:
            run(["gcloud", "compute", "instances", "delete", *existing, "--project", PROJECT, "--zone", ZONE,
                 "--delete-disks", "all", "--quiet"])
            log(f"deleted VMs: {existing}")
        except Failure as error:
            failures.append(str(error))
    try:
        if token is None:
            raise Failure("no installation token to delete runner registrations with")
        for name, runner in registered_runners(token, repository).items():
            if name in names:
                github("DELETE", f"/repos/{repository}/actions/runners/{runner['id']}", token, allow_missing=True)
                log(f"deleted runner registration {name}")
    except Failure as error:
        failures.append(str(error))
    return failures


def cmd_up():
    backend = env("FAST_RUNNERS_BACKEND", "auto")
    if backend not in ("auto", "fast", "hosted"):
        die(f"FAST_RUNNERS_BACKEND={backend!r}; use auto, fast or hosted")
    if env("MEERKAT_FAST_RUNNERS_ENABLED") != "true":
        hosted("the repository variable MEERKAT_FAST_RUNNERS_ENABLED is not 'true'; nothing was started")
        return 1 if backend == "fast" else 0
    if backend == "hosted":
        hosted("backend 'hosted' was requested; nothing was started")
        return 0
    problems = trigger_problems()
    if problems:
        hosted("not an owner dispatch of an allowlisted workflow on main: " + "; ".join(problems))
        return 1 if backend == "fast" else 0
    try:
        lanes = parse_spec()
    except Failure as error:
        die(str(error))
    repository = env("GITHUB_REPOSITORY")
    names = runner_names(lanes)
    # Routing labels, not secrets: one per lane, unique to the run, the
    # attempt and a nonce. Never masked, or GitHub drops the job output.
    nonce = secrets.token_hex(8)
    labels = {lane: f"meerkat-fast-{env('GITHUB_RUN_ID')}-{env('GITHUB_RUN_ATTEMPT')}-{nonce}-{lane}" for lane, _ in lanes}
    tokens = []
    token = None
    try:
        try:
            token = installation_token(repository, {"administration": "write"})
            tokens.append(token)
            problems = precondition_problems(repository, token,
                                             read_optional(env("FAST_RUNNERS_CODEOWNERS_CALLER")))
            if repository != LAUNCHER_REPOSITORY:
                launcher_token = installation_token(LAUNCHER_REPOSITORY, {"administration": "read"})
                tokens.append(launcher_token)
                problems += precondition_problems(LAUNCHER_REPOSITORY, launcher_token,
                                                  read_optional(env("FAST_RUNNERS_CODEOWNERS_LAUNCHER")))
            if problems:
                raise Failure("review precondition not met: " + "; ".join(problems))
            with tempfile.TemporaryDirectory(dir=env("RUNNER_TEMP") or None) as workdir:
                with open(os.path.join(workdir, "startup-script"), "w", encoding="utf-8") as handle:
                    handle.write(render_startup())
                with open(os.path.join(workdir, "job-started-hook"), "w", encoding="utf-8") as handle:
                    handle.write(hook_source())
                procs = []
                for lane, cls in lanes:
                    registration = github("POST", f"/repos/{repository}/actions/runners/generate-jitconfig", token, {
                        "name": names[lane],
                        "runner_group_id": RUNNER_GROUP_ID,
                        "labels": [labels[lane]],
                        "work_folder": RUNNER_WORK,
                    })
                    encoded = registration["encoded_jit_config"]
                    mask(encoded)
                    procs.append((names[lane], create_instance(names[lane], lane, cls, encrypt(encoded), workdir)))
                    del encoded
                failed = []
                for name, proc in procs:
                    _, stderr = proc.communicate()
                    if proc.returncode != 0:
                        lines = stderr.decode(errors="replace").strip().splitlines()
                        failed.append(f"{name}: {lines[-1] if lines else proc.returncode}")
                if failed:
                    raise Failure("VM creation failed: " + "; ".join(failed))
            log(f"created {len(lanes)} VM(s); waiting for their runners")
            wait_online(token, repository, {names[lane]: labels[lane] for lane, _ in lanes})
        except Failure as error:
            log(f"::warning title=Fast runners unavailable::{error}")
            for failure in cleanup(list(names.values()), token):
                log(f"::warning title=Fast runner cleanup::{failure}")
            if backend == "fast":
                die(f"backend 'fast' was requested and the pool did not come up: {error}")
            hosted(f"the pool did not come up ({error}); cleaned up")
            return 0
    finally:
        revoke(tokens)
    write_outputs(backend="fast", runs_on=json.dumps(labels, separators=(",", ":")),
                  attempt=env("GITHUB_RUN_ATTEMPT"))
    log(f"{len(lanes)} pool runner(s) online; lanes routed to them")
    return 0


def cmd_fallback():
    hosted("the pool step did not report online runners")
    if env("FAST_RUNNERS_BACKEND", "auto") == "fast":
        die("backend 'fast' was requested and the pool did not come up")
    return 0


def cmd_down():
    if env("MEERKAT_FAST_RUNNERS_ENABLED") != "true":
        log("MEERKAT_FAST_RUNNERS_ENABLED is not 'true': nothing to delete")
        return 0
    if env("FAST_RUNNERS_BACKEND", "auto") == "hosted":
        log("backend 'hosted': no runner was created, nothing to delete")
        return 0
    problems = trigger_problems()
    if problems:
        log("not an owner dispatch on main, so no runner was created: " + "; ".join(problems))
        return 0
    try:
        names = list(runner_names(parse_spec()).values())
    except Failure as error:
        die(str(error))
    # An up that reported its outcome (fast, or hosted after its own cleanup)
    # left nothing in flight; one that was cancelled or crashed may have.
    settle = 0 if env("FAST_RUNNERS_UP_BACKEND") in ("fast", "hosted") else SETTLE_SECONDS
    token = None
    failures = []
    try:
        try:
            token = installation_token(env("GITHUB_REPOSITORY"), {"administration": "write"})
        except Failure as error:
            failures.append(f"no installation token: {error}")
        failures += cleanup(names, token, settle=settle)
    finally:
        revoke([token])
    if failures:
        for failure in failures:
            log(f"::error title=Fast runner cleanup::{failure}")
        log("the GCE max-run-duration and the reaper delete any VM left behind")
        return 1
    log(f"nothing of this run is left: {names}")
    return 0


# --- gate ------------------------------------------------------------------------------------------


def cmd_verify_lanes():
    """Fails unless every needed job succeeded and pool lanes ran on their own runners."""
    try:
        needs = json.loads(env("FAST_RUNNERS_NEEDS") or "{}")
        pool_lanes = json.loads(env("FAST_RUNNERS_POOL_LANES") or "[]")
    except ValueError as error:
        die(f"gate input is not JSON: {error}")
    problems = []
    if not needs or not pool_lanes:
        problems.append("the gate got no jobs or no pool lanes to check")
    for job, result in sorted(needs.items()):
        if (result or {}).get("result") != "success":
            problems.append(f"{job} is {(result or {}).get('result')!r}; every job must succeed (a skipped lane ran nothing)")
    for lane in pool_lanes:
        if lane not in needs:
            problems.append(f"the gate does not need pool lane {lane}")
    requested = env("FAST_RUNNERS_REQUESTED", "auto")
    up_backend = env("FAST_RUNNERS_UP_BACKEND")
    if requested == "fast" and up_backend != "fast":
        problems.append("backend 'fast' was requested and the pool did not come up")
    if up_backend == "fast" and not problems:
        try:
            runs_on = json.loads(env("FAST_RUNNERS_RUNS_ON") or "{}")
            lanes = parse_spec()
        except (ValueError, Failure) as error:
            die(f"cannot read the pool routing: {error}")
        names = runner_names(lanes)
        if sorted(runs_on) != sorted(lane for lane, _ in lanes) or sorted(pool_lanes) != sorted(runs_on):
            problems.append(f"pool routing {sorted(runs_on)} does not match the pool lanes {sorted(pool_lanes)}")
        else:
            path = (f"/repos/{env('GITHUB_REPOSITORY')}/actions/runs/{env('GITHUB_RUN_ID')}"
                    f"/attempts/{env('GITHUB_RUN_ATTEMPT')}/jobs")
            try:
                jobs = paginate(path, env("GITHUB_TOKEN"), key="jobs")
            except Failure as error:
                die(f"cannot list this run's jobs: {error}")
            for lane in pool_lanes:
                matches = [job for job in jobs if job.get("labels") == [runs_on[lane]]]
                if len(matches) != 1:
                    problems.append(f"lane {lane} did not run on its pool label (jobs requesting it: {len(matches)})")
                    continue
                job = matches[0]
                if job.get("runner_name") != names[lane] or job.get("conclusion") != "success":
                    problems.append(f"lane {lane} ran on {job.get('runner_name')!r} with {job.get('conclusion')!r}, "
                                    f"not on {names[lane]!r} with success")
    if problems:
        for problem in problems:
            log(f"::error title=Ultrafast gate::{problem}")
        return 1
    log(f"every job succeeded; lanes ran on {'their pool runners' if up_backend == 'fast' else 'GitHub-hosted runners'}")
    return 0


# --- WIF and approval rendering -----------------------------------------------------------------

def has_environment(name):
    return f"'environment' in assertion && assertion.environment == '{name}'"


WIF_MAPPING = {
    "google.subject": "assertion.sub",
    "attribute.repository_id": "assertion.repository_id",
    "attribute.actor_id": "assertion.actor_id",
    "attribute.workflow_ref": "assertion.workflow_ref",
    "attribute.job_workflow_ref": "assertion.job_workflow_ref",
    "attribute.runner_environment": "assertion.runner_environment",
    # Derived roles; each service account trusts exactly one of them.
    "attribute.fast_role": (
        "assertion.runner_environment == 'github-hosted' && assertion.job_workflow_ref == '" + LAUNCHER + "'"
        f" && {has_environment(LAUNCHER_ENVIRONMENT)} ? 'launcher'"
        f" : (assertion.runner_environment == 'self-hosted' ? ({has_environment(RELEASE_ENVIRONMENT)}"
        " ? 'release-' + assertion.repository_id : 'ci-' + assertion.repository_id) : 'none')"
    ),
}


def wif_condition():
    ids = ", ".join(f"'{repo_id}'" for repo_id in REPOSITORIES.values())
    repos = ", ".join(f"'{repo}'" for repo in REPOSITORIES)
    workflows = ", ".join(f"'{workflow}'" for workflow in WORKFLOWS)
    return " && ".join([
        f"assertion.repository_owner_id == '{OWNER_ID}'",
        f"assertion.repository_owner == '{OWNER}'",
        f"assertion.repository_id in [{ids}]",
        f"assertion.repository in [{repos}]",
        "assertion.event_name == 'workflow_dispatch'",
        "assertion.ref == 'refs/heads/main'",
        f"assertion.actor_id == '{OWNER_ID}'",
        f"assertion.actor == '{OWNER}'",
        f"assertion.workflow_ref in [{workflows}]",
    ])


def cmd_wif():
    print("attribute-mapping:")
    for key, value in WIF_MAPPING.items():
        print(f"  {key}={value}")
    print("attribute-condition:")
    print(f"  {wif_condition()}")
    return 0


def approval_commands():
    member = f"principalSet://iam.googleapis.com/projects/{PROJECT_NUMBER}/locations/global/workloadIdentityPools/{WIF_POOL}"
    mapping = ",".join(f"{key}={value}" for key, value in WIF_MAPPING.items())
    p = f"--project={PROJECT}"
    lines = [
        "# 0. Dedicated pool project: only the owner holds roles (the shared project is a fallback, see the end)",
        f"gcloud projects create {PROJECT} --name='Meerkat fast runners'",
        f"gcloud billing projects link {PROJECT} --billing-account=<billing-account-id>",
        f"gcloud projects get-iam-policy {PROJECT} --format=json",
        f"gcloud projects get-ancestors-iam-policy {PROJECT} --format=json",
        "# 1. APIs",
        f"gcloud services enable compute.googleapis.com cloudkms.googleapis.com iamcredentials.googleapis.com sts.googleapis.com run.googleapis.com cloudscheduler.googleapis.com {p}",
        "# 2. Isolated network: no external addresses, Cloud NAT egress, explicit deny of all ingress",
        f"gcloud compute networks create {NETWORK} --subnet-mode=custom {p}",
        f"gcloud compute networks subnets create {SUBNET} --network={NETWORK} --region={REGION} --range=10.88.0.0/20 --enable-private-ip-google-access {p}",
        f"gcloud compute firewall-rules create {NETWORK}-deny-all-ingress --network={NETWORK} --direction=INGRESS --action=DENY --rules=all --source-ranges=0.0.0.0/0 --priority=0 --description='Fast runners are outbound-only' {p}",
        f"gcloud compute routers create {ROUTER} --network={NETWORK} --region={REGION} {p}",
        f"gcloud compute routers nats create {ROUTER}-nat --router={ROUTER} --region={REGION} --auto-allocate-nat-external-ips --nat-all-subnet-ip-ranges --enable-dynamic-port-allocation --min-ports-per-vm=1024 --max-ports-per-vm=16384 {p}",
        "# 3. Service accounts (no project-level role except the launcher's conditioned one and the reaper's)",
        f"gcloud iam service-accounts create meerkat-fast-runner --display-name='Meerkat fast runner VMs' {p}",
        f"gcloud iam service-accounts create meerkat-fast-launcher --display-name='Meerkat fast runner launcher (WIF)' {p}",
        f"gcloud iam service-accounts create meerkat-fast-reaper --display-name='Meerkat fast runner reaper' {p}",
    ]
    for repo, short in SHORT.items():
        lines.append(f"gcloud iam service-accounts create meerkat-fast-cache-{short} --display-name='Meerkat fast runner CI cache, {repo} (WIF)' {p}")
    lines += [
        "# 4. KMS: the single-use registration key (launcher encrypts, runner VMs decrypt)",
        f"gcloud kms keyrings create {KEYRING} --location={REGION} {p}",
        f"gcloud kms keys create {JIT_KEY} --keyring={KEYRING} --location={REGION} --purpose=encryption --rotation-period=90d --next-rotation-time=$(date -u -d '+90 days' +%Y-%m-%dT%H:%M:%SZ) {p}",
        f"gcloud kms keys add-iam-policy-binding {JIT_KEY} --keyring={KEYRING} --location={REGION} --member=serviceAccount:{LAUNCHER_SA} --role=roles/cloudkms.cryptoKeyEncrypter {p}",
        f"gcloud kms keys add-iam-policy-binding {JIT_KEY} --keyring={KEYRING} --location={REGION} --member=serviceAccount:{RUNNER_SA} --role=roles/cloudkms.cryptoKeyDecrypter {p}",
        "# 5. The GitHub App key as a non-exportable HSM signing key (import, then destroy the PEM); JWTs are signed through KMS",
        f"gcloud kms keys create {APP_KEY} --keyring={KEYRING} --location={REGION} --purpose=asymmetric-signing --default-algorithm=rsa-sign-pkcs1-2048-sha256 --protection-level=hsm --skip-initial-version-creation --import-only {p}",
        f"gcloud kms import-jobs create {APP_KEY}-import --keyring={KEYRING} --location={REGION} --import-method=rsa-oaep-3072-sha256-aes-256 --protection-level=hsm {p}",
        "openssl pkcs8 -topk8 -nocrypt -inform PEM -outform DER -in <app-private-key.pem> -out <app-key.pk8.der>",
        f"gcloud kms keys versions import --import-job={APP_KEY}-import --keyring={KEYRING} --location={REGION} --key={APP_KEY} --algorithm=rsa-sign-pkcs1-2048-sha256 --target-key-file=<app-key.pk8.der> {p}",
        "shred -u <app-private-key.pem> <app-key.pk8.der>",
        f"gcloud kms keys add-iam-policy-binding {APP_KEY} --keyring={KEYRING} --location={REGION} --member=serviceAccount:{LAUNCHER_SA} --role=roles/cloudkms.signer {p}",
        "# 6. Launcher compute rights: a custom role bound with exact-name conditions",
        f"gcloud iam roles create meerkatFastRunnerLauncher {p} --title='Meerkat fast runner launcher' --permissions=compute.instances.create,compute.instances.delete,compute.instances.get,compute.instances.setMetadata,compute.instances.setLabels,compute.instances.setServiceAccount,compute.disks.create,compute.disks.delete,compute.disks.use,compute.subnetworks.use,compute.zoneOperations.get",
        f"gcloud projects add-iam-policy-binding {PROJECT} --member=serviceAccount:{LAUNCHER_SA} --role=projects/{PROJECT}/roles/meerkatFastRunnerLauncher --condition='title=meerkat-fast-only,expression=resource.name.startsWith(\"projects/{PROJECT}/zones/{ZONE}/instances/meerkat-fast-\") || resource.name.startsWith(\"projects/{PROJECT}/zones/{ZONE}/disks/meerkat-fast-\") || resource.name.startsWith(\"projects/{PROJECT}/zones/{ZONE}/operations/\") || resource.name == \"projects/{PROJECT}/regions/{REGION}/subnetworks/{SUBNET}\"'",
        f"gcloud iam service-accounts add-iam-policy-binding {RUNNER_SA} --member=serviceAccount:{LAUNCHER_SA} --role=roles/iam.serviceAccountUser {p}",
        "# 7. CI cache: one bucket and one account per repository; create and read, never overwrite (only the sccache probe object may be replaced). Releases build without a cache.",
    ]
    for repo, short in SHORT.items():
        bucket, sa = CACHE_BUCKET[repo], CACHE_SA[repo]
        lines += [
            f"gcloud storage buckets create gs://{bucket} --location={REGION} --uniform-bucket-level-access --public-access-prevention {p}",
            f"gcloud storage buckets update gs://{bucket} --lifecycle-file=<lifecycle: delete objects older than 30 days>",
            f"gcloud storage buckets add-iam-policy-binding gs://{bucket} --member=serviceAccount:{sa} --role=roles/storage.objectCreator",
            f"gcloud storage buckets add-iam-policy-binding gs://{bucket} --member=serviceAccount:{sa} --role=roles/storage.objectViewer",
            f"gcloud storage buckets add-iam-policy-binding gs://{bucket} --member=serviceAccount:{sa} --role=roles/storage.objectUser --condition='title=sccache-probe-only,expression=resource.name.endsWith(\"/.sccache_check\")'",
        ]
    reaper_script = "$(scripts/fast-runners render-reaper)"
    lines += [
        "# 8. Reaper: every 15 minutes, delete pool VMs older than the TTL plus a margin in ANY state (stopped included)",
        f"gcloud iam roles create meerkatFastRunnerReaper {p} --title='Meerkat fast runner reaper' --permissions=compute.instances.list,compute.instances.delete,compute.disks.delete,compute.zoneOperations.get",
        f"gcloud projects add-iam-policy-binding {PROJECT} --member=serviceAccount:{REAPER_SA} --role=projects/{PROJECT}/roles/meerkatFastRunnerReaper --condition=None",
        f"gcloud run jobs create meerkat-fast-reaper --region={REGION} --image=gcr.io/google.com/cloudsdktool/google-cloud-cli:stable --service-account={REAPER_SA} --command=bash --args=-c,\"{reaper_script}\" --max-retries=0 --task-timeout=10m {p}",
        f"gcloud run jobs add-iam-policy-binding meerkat-fast-reaper --region={REGION} --member=serviceAccount:{REAPER_SA} --role=roles/run.invoker {p}",
        f"gcloud scheduler jobs create http meerkat-fast-reaper --location={REGION} --schedule='*/15 * * * *' --http-method=POST --uri=https://run.googleapis.com/v2/projects/{PROJECT}/locations/{REGION}/jobs/meerkat-fast-reaper:run --oauth-service-account-email={REAPER_SA} {p}",
        "# 9. Dedicated WIF pool: owner workflow_dispatch of ultrafast.yml on main only",
        f"gcloud iam workload-identity-pools create {WIF_POOL} --location=global --display-name='Meerkat fast runners' {p}",
        f"gcloud iam workload-identity-pools providers create-oidc {WIF_PROVIDER} --location=global --workload-identity-pool={WIF_POOL} --issuer-uri=https://token.actions.githubusercontent.com --attribute-mapping=\"{mapping}\" --attribute-condition=\"{wif_condition()}\" {p}",
        f"gcloud iam service-accounts add-iam-policy-binding {LAUNCHER_SA} --role=roles/iam.workloadIdentityUser --member={member}/attribute.fast_role/launcher {p}",
    ]
    for repo, repo_id in REPOSITORIES.items():
        lines.append(f"gcloud iam service-accounts add-iam-policy-binding {CACHE_SA[repo]} --role=roles/iam.workloadIdentityUser --member={member}/attribute.fast_role/ci-{repo_id} {p}")
    lines += [
        "# 10. Quota: C4D CPUs in the region (>= 1536) and C4A CPUs (>= 144), via the console quota page",
        f"# FALLBACK ONLY, if the pool must live in the shared project {SHARED_PROJECT}: audit, then protect",
        f"gcloud projects get-iam-policy {SHARED_PROJECT} --format=json",
        f"gcloud projects get-ancestors-iam-policy {SHARED_PROJECT} --format=json",
    ]
    for name in ("meerkat-fast-runner", "meerkat-fast-launcher", "meerkat-fast-reaper"):
        lines.append(f"gcloud iam service-accounts get-iam-policy {name}@{SHARED_PROJECT}.iam.gserviceaccount.com --format=json")
    lines.append(f"gcloud iam policies create meerkat-fast-runners-protect --attachment-point=cloudresourcemanager.googleapis.com%2Fprojects%2F{SHARED_PROJECT} --kind=denypolicies --policy-file=<deny policy from DESIGN.md section 7.1>")
    return lines


def cmd_approval_commands():
    for line in approval_commands():
        print(line)
    return 0


COMMANDS = {
    "check-trigger": cmd_check_trigger,
    "up": cmd_up,
    "fallback": cmd_fallback,
    "down": cmd_down,
    "verify-lanes": cmd_verify_lanes,
    "names": cmd_names,
    "render-startup": cmd_render_startup,
    "render-reaper": cmd_render_reaper,
    "wif": cmd_wif,
    "approval-commands": cmd_approval_commands,
}


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        sys.stderr.write(__doc__)
        return 2
    return COMMANDS[argv[1]]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
