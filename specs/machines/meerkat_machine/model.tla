    /\ (IF ((IF (observation = "ProviderProcessed") THEN TRUE ELSE (observation = "ProviderRejected")) /\ ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("LocalWriteCompletedAwaitingProof"))) THEN TRUE ELSE (IF ((observation = "SubmissionAmbiguous") /\ (IF ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("SubmissionAttemptClaimed")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("LocalWriteCompletedAwaitingProof")))) THEN TRUE ELSE ((IF (observation = "CallExpired") THEN TRUE ELSE (observation = "CallAbandonedByClose")) /\ ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("SubmissionAuthorized")))))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
