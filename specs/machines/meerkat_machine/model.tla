RecoverSupervisorRotationTerminalReceiptDestroyed(operation_id, arg_phase, rejection, previous_name, previous_peer_id, previous_address, previous_signing_public_key, previous_epoch, next_name, next_peer_id, next_address, next_signing_public_key, next_epoch) ==
    /\ phase = "Destroyed"
    /\ (IF (arg_phase = "Completed") THEN TRUE ELSE (arg_phase = "Rejected"))
    /\ (IF ((arg_phase = "Rejected") /\ (rejection # None)) THEN TRUE ELSE ((arg_phase = "Completed") /\ (rejection = None)))
    /\ ~((operation_id \in DOMAIN supervisor_rotation_terminal_phases))
    /\ phase' = "Destroyed"
    /\ model_step_count' = model_step_count + 1
    /\ supervisor_rotation_terminal_phases' = MapSet(supervisor_rotation_terminal_phases, operation_id, arg_phase)
    /\ supervisor_rotation_terminal_rejections' = IF (arg_phase = "Rejected") THEN MapSet(supervisor_rotation_terminal_rejections, operation_id, (IF "value" \in DOMAIN rejection THEN rejection["value"] ELSE None)) ELSE supervisor_rotation_terminal_rejections
    /\ supervisor_rotation_terminal_previous_names' = MapSet(supervisor_rotation_terminal_previous_names, operation_id, previous_name)
    /\ supervisor_rotation_terminal_previous_peer_ids' = MapSet(supervisor_rotation_terminal_previous_peer_ids, operation_id, previous_peer_id)
    /\ supervisor_rotation_terminal_previous_addresses' = MapSet(supervisor_rotation_terminal_previous_addresses, operation_id, previous_address)
    /\ supervisor_rotation_terminal_previous_signing_public_keys' = MapSet(supervisor_rotation_terminal_previous_signing_public_keys, operation_id, previous_signing_public_key)
    /\ supervisor_rotation_terminal_previous_epochs' = MapSet(supervisor_rotation_terminal_previous_epochs, operation_id, previous_epoch)
    /\ supervisor_rotation_terminal_next_names' = MapSet(supervisor_rotation_terminal_next_names, operation_id, next_name)
    /\ supervisor_rotation_terminal_next_peer_ids' = MapSet(supervisor_rotation_terminal_next_peer_ids, operation_id, next_peer_id)
    /\ supervisor_rotation_terminal_next_addresses' = MapSet(supervisor_rotation_terminal_next_addresses, operation_id, next_address)
    /\ supervisor_rotation_terminal_next_signing_public_keys' = MapSet(supervisor_rotation_terminal_next_signing_public_keys, operation_id, next_signing_public_key)
    /\ supervisor_rotation_terminal_next_epochs' = MapSet(supervisor_rotation_terminal_next_epochs, operation_id, next_epoch)
