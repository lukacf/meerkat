RecordLiveWebrtcTokenIssuedRetired(arg_session_id, channel_id, token, issued_at_ms, ttl_ms) ==
    /\ phase = "Retired"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (token # "")
    /\ (issued_at_ms > 0)
    /\ (ttl_ms > 0)
    /\ ((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(channel_id))
    /\ ((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id))
    /\ (~((token \in DOMAIN live_webrtc_token_channel_by_token)) /\ ~((token \in live_webrtc_consumed_tokens)))
    /\ phase' = "Retired"
    /\ model_step_count' = model_step_count + 1
    /\ live_webrtc_token_issue_sequence' = (live_webrtc_token_issue_sequence) + 1
    /\ live_webrtc_token_channel_by_token' = MapSet(live_webrtc_token_channel_by_token, token, channel_id)
    /\ live_webrtc_token_expires_at_ms_by_token' = MapSet(live_webrtc_token_expires_at_ms_by_token, token, (issued_at_ms + ttl_ms))
