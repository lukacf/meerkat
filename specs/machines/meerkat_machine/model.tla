SatisfyWaitAllStopped(arg_wait_request_id, run_id, operation_id_tokens) ==
    /\ phase = "Stopped"
    /\ (wait_active = TRUE)
    /\ (wait_request_id = Some(arg_wait_request_id))
    /\ (wait_run_id = Some(run_id))
    /\ (wait_operation_id_tokens = operation_id_tokens)
    /\ (\A member_id \in wait_operation_ids : (IF ((IF (member_id \in DOMAIN op_statuses) THEN Some((IF member_id \in DOMAIN op_statuses THEN op_statuses[member_id] ELSE "None")) ELSE None) = Some("Completed")) THEN TRUE ELSE (IF ((IF (member_id \in DOMAIN op_statuses) THEN Some((IF member_id \in DOMAIN op_statuses THEN op_statuses[member_id] ELSE "None")) ELSE None) = Some("Failed")) THEN TRUE ELSE (IF ((IF (member_id \in DOMAIN op_statuses) THEN Some((IF member_id \in DOMAIN op_statuses THEN op_statuses[member_id] ELSE "None")) ELSE None) = Some("Aborted")) THEN TRUE ELSE (IF ((IF (member_id \in DOMAIN op_statuses) THEN Some((IF member_id \in DOMAIN op_statuses THEN op_statuses[member_id] ELSE "None")) ELSE None) = Some("Cancelled")) THEN TRUE ELSE (IF ((IF (member_id \in DOMAIN op_statuses) THEN Some((IF member_id \in DOMAIN op_statuses THEN op_statuses[member_id] ELSE "None")) ELSE None) = Some("Retired")) THEN TRUE ELSE ((IF (member_id \in DOMAIN op_statuses) THEN Some((IF member_id \in DOMAIN op_statuses THEN op_statuses[member_id] ELSE "None")) ELSE None) = Some("Terminated"))))))))
    /\ phase' = "Stopped"
    /\ model_step_count' = model_step_count + 1
    /\ wait_active' = FALSE
    /\ wait_request_id' = None
    /\ wait_run_id' = None
    /\ wait_operation_ids' = {}
    /\ wait_operation_id_tokens' = {}
