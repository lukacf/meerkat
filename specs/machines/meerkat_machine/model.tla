ion_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id THEN operation_token_by_id[(IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None) THEN (IF ((IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id) THEN Some((IF (IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN operation_token_by_id THEN operation_token_by_id[(IF "value" \in DOMAIN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by_token[operation_id_token] ELSE "None")) ELSE None) THEN (IF (operation_id_token \in DOMAIN operation_id_by_token) THEN Some((IF operation_id_token \in DOMAIN operation_id_by_token THEN operation_id_by