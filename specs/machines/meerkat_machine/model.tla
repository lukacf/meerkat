    /\ phase' = "Attached"
    /\ model_step_count' = model_step_count + 1
    /\ live_websocket_consumed_tokens' = (live_websocket_consumed_tokens \cup {token})
    /\ live_websocket_token_admission_sequence' = (live_websocket_token_admission_sequence) + 1
