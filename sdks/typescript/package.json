{
  "name": "@rkat/sdk",
  "version": "0.8.52",
  "description": "TypeScript SDK for Meerkat agent runtime",
  "homepage": "https://docs.rkat.ai/sdks/typescript/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukacf/meerkat.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/lukacf/meerkat/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsc --noEmit -p tests/tsconfig.json && node --test tests/*.test.js",
    "test:e2e": "npm run build && node --test tests/e2e_smoke.test.mjs tests/e2e_sdk_smoke.test.mjs",
    "test:live-smoke": "npm run build && node --test tests/e2e_smoke.test.mjs"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
