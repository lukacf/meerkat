#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_cargo="${script_dir}/repo-cargo"

# Core's members only: `--workspace` and an `--exclude` for every package of
# the other products, with every member's test features
# (scripts/core-workspace-args.mjs --tests).
core_selection="$(CARGO="${repo_cargo}" node "${script_dir}/core-workspace-args.mjs" --tests)" || {
  echo "cargo-fast-nextest: cannot derive Core's package selection" >&2
  exit 1
}
mapfile -t core_workspace <<<"${core_selection}"

exec "${repo_cargo}" nextest run \
  "${core_workspace[@]}" \
  --profile fast \
  --show-progress none \
  --status-level none \
  --final-status-level fail \
  "$@"
