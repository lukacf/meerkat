BeginImageOperationApprovalDeniedIdle(operation_id, target_model, target_realtime_capable, requires_approval, approval_available, approval_denied, approval_reason, realtime_detach_allowed, requires_scoped_override) ==
    /\ phase = "Idle"
    /\ (requires_approval /\ approval_available /\ approval_denied)
    /\ (approval_reason # None)
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ model_routing_image_operation_phases' = MapSet(model_routing_image_operation_phases, operation_id, "Terminal")
    /\ model_routing_image_terminals' = MapSet(model_routing_image_terminals, operation_id, "Denied")
    /\ model_routing_image_denials' = MapSet(model_routing_image_denials, operation_id, "DeniedDuringApproval")
    /\ model_routing_image_approval_reasons' = MapSet(model_routing_image_approval_reasons, operation_id, (IF "value" \in DOMAIN approval_reason THEN approval_reason["value"] ELSE None))
    /\ model_routing_approval_phases' = MapSet(model_routing_approval_phases, operation_id, "Denied")
    /\ model_routing_approval_parent_kind' = MapSet(model_routing_approval_parent_kind, operation_id, "ImageOperation")
