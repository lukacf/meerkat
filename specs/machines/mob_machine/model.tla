CommitSupervisorRotationRunning(current_peer_id, current_epoch, current_protocol_version, operation_id, next_peer_id, next_signing_key, next_epoch, next_protocol_version) ==
    /\ phase = "Running"
    /\ ((supervisor_authority_peer_id = Some(current_peer_id)) /\ (supervisor_authority_signing_key # None) /\ (supervisor_authority_epoch = Some(current_epoch)) /\ (supervisor_authority_protocol_version = Some(current_protocol_version)))
    /\ mob_machine_u64_is_exact_successor(current_epoch, next_epoch)
    /\ (next_peer_id # current_peer_id)
    /\ (supervisor_pending_authority_operation_id = Some(operation_id))
    /\ ((supervisor_pending_authority_peer_id = Some(next_peer_id)) /\ (supervisor_pending_authority_signing_key = Some(next_signing_key)) /\ (supervisor_pending_authority_epoch = Some(next_epoch)) /\ (supervisor_pending_authority_protocol_version = Some(next_protocol_version)))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ supervisor_authority_peer_id' = Some(next_peer_id)
    /\ supervisor_authority_signing_key' = Some(next_signing_key)
    /\ supervisor_authority_epoch' = Some(next_epoch)
    /\ supervisor_authority_protocol_version' = Some(next_protocol_version)
    /\ supervisor_pending_authority_peer_id' = None
    /\ supervisor_pending_authority_signing_key' = None
    /\ supervisor_pending_authority_epoch' = None
    /\ supervisor_pending_authority_protocol_version' = None
