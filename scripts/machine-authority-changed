#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: machine-authority-changed [--base <rev> --head <rev>] [changed-path ...]

Exits 0 when any changed path can affect the machine-authority CI lane.
Exits 1 when the supplied or diffed paths are unrelated.
EOF
}

base=""
head=""
paths=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      if [[ $# -lt 2 ]]; then
        echo "error: --base requires a revision" >&2
        usage >&2
        exit 2
      fi
      base="$2"
      shift 2
      ;;
    --head)
      if [[ $# -lt 2 ]]; then
        echo "error: --head requires a revision" >&2
        usage >&2
        exit 2
      fi
      head="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        paths+=("$1")
        shift
      done
      ;;
    -*)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      paths+=("$1")
      shift
      ;;
  esac
done

if [[ -n "${base}" || -n "${head}" ]]; then
  if [[ -z "${base}" || -z "${head}" ]]; then
    echo "error: --base and --head must be supplied together" >&2
    usage >&2
    exit 2
  fi
  diff_output="$(git diff --name-only "${base}" "${head}" --)" || {
    echo "error: cannot diff ${base}..${head}" >&2
    exit 2
  }
  paths=()
  if [[ -n "${diff_output}" ]]; then
    while IFS= read -r path; do
      paths+=("${path}")
    done <<<"${diff_output}"
  fi
fi

machine_authority_path() {
  local path="${1#./}"
  case "${path}" in
    .github/workflows/ci.yml|.github/workflows/cargo.yml|Makefile|scripts/machine-authority-changed|scripts/tests/xtask_scripts_dogma_gates.sh|crates/xtask/tests/ci_gate_requires_rmat.rs)
      # The required merge gate, canonical Make target, classifier, and its
      # pinning tests are themselves part of machine-verification authority.
      return 0
      ;;
    specs/machines/*|specs/compositions/*)
      return 0
      ;;
    docs/reference/machine-authority.mdx)
      return 0
      ;;
    crates/meerkat-machine-codegen/*|crates/meerkat-machine-derive/*|crates/meerkat-machine-dsl/*|crates/meerkat-machine-dsl-core/*|crates/meerkat-machine-kernels/*|crates/meerkat-machine-schema/*)
      return 0
      ;;
    crates/meerkat-runtime/src/meerkat_machine/*|crates/meerkat-runtime/src/auth_machine/*|crates/meerkat-mob/src/ids.rs|crates/meerkat-mob/src/machines/*|crates/meerkat-mob/src/runtime/*|crates/meerkat-schedule/src/machines/*)
      return 0
      ;;
    # meerkat-session is listed explicitly: protocol-codegen emits
    # session_turn_admission.rs there, and that name carries no `protocol_`
    # prefix, so the trailing glob does not reach it.
    crates/meerkat-machine-kernels/src/generated/*|crates/meerkat-core/src/generated/*|crates/meerkat-mob/src/generated/*|crates/meerkat-runtime/src/generated/*|crates/meerkat-schedule/src/generated/*|crates/meerkat-session/src/generated/*|*/src/generated/protocol_*.rs)
      return 0
      ;;
    crates/xtask/Cargo.toml|crates/xtask/BUILD.bazel|crates/xtask/src/lib.rs|crates/xtask/src/main.rs|crates/xtask/src/machines*.rs|crates/xtask/src/protocol_codegen.rs|crates/xtask/src/audit_generated_headers.rs|crates/xtask/src/public_contracts.rs|crates/xtask/src/runtime_authority_bypass.rs)
      return 0
      ;;
    crates/xtask/src/rmat_policy.rs|crates/xtask/src/seam_inventory.rs|crates/xtask/src/ownership_ledger.rs|crates/xtask/src/rmat_audit.rs|xtask/rmat-baseline.toml|xtask/ownership-baseline.toml|docs/internal/archive/public-docs-removed-2026-05-11/architecture/finite-ownership-ledger.md)
      return 0
      ;;
    crates/xtask/tests/machine_verify_all_tlc_test.sh|crates/xtask/tests/machines_contracts.rs|crates/xtask/tests/protocol_codegen_drift.rs|crates/xtask/tests/runtime_authority_bypass.rs)
      return 0
      ;;
  esac
  return 1
}

for path in "${paths[@]}"; do
  if machine_authority_path "${path}"; then
    echo "machine-authority changed: ${path}"
    exit 0
  fi
done

echo "machine-authority unchanged"
exit 1
