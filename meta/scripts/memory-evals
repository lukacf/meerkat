    cmd = list(steward_eval_cmd())
    if mock:
        cmd.append("--mock")
    try:
        proc = subprocess.run(
            cmd,
            input=json.dumps(payload),
            capture_output=True,
            text=True,
            timeout=600,
            cwd=REPO_ROOT,
            env=_eval_env(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail_config(f"cannot run steward-eval ({' '.join(cmd)}): {exc}")
    if proc.returncode != 0:
        return proc.returncode, None, proc.stderr
    try:
        return 0, json.loads(proc.stdout.strip().splitlines()[-1]), proc.stderr
    except (json.JSONDecodeError, IndexError) as exc:
        fail_config(f"steward-eval produced unparseable output: {exc}\n{proc.stdout}")


def steward_payload(fixture, mock):
    payload = {
        "records": fixture.get("records", []),
        "proposals": fixture.get("proposals", []),
        "mob_context": fixture.get("mob_context"),
        "profile_path": str(steward_profile_path()),
    }
    if mock:
        payload["scripted_reply"] = fixture.get("scripted_reply")
    return payload


def score_steward_fixture(fixture, result, live):
    """Score one steward-eval result. Returns (judgment_misses,
    hard_failures) — hard failures are deterministic staged-validator law
    (§10.2) and gate in every mode; judgment misses gate only live."""
    expected = fixture["expected"]
    misses, hard = [], []
    validator = result.get("validator", "")
    if "validator_rejects" in expected:
        needle = expected["validator_rejects"].lower()
        if not validator.startswith("rejected"):
            hard.append(f"validator accepted the op group (`{validator}`); expected a reject")
        elif needle not in validator.lower():
            hard.append(f"validator rejected for the wrong reason: `{validator}` (expected `{needle}`)")
    elif "validator" in expected:
        pin = expected["validator"]
        if pin == "ok":
            if not validator.startswith("ok"):
                hard.append(f"validator rejected: `{validator}`")
        elif validator != pin:
            hard.append(f"validator `{validator}` != expected `{pin}`")
    # Op-shape expectations (deterministic in scripted/mock mode).
    op_counts = {}
    for op in result.get("ops", []):
        op_counts[op["op"]] = op_counts.get(op["op"], 0) + 1
    for op_kind, count in expected.get("ops", {}).items():
        got = op_counts.get(op_kind, 0)
        if got != count:
            (hard if not live else misses).append(
                f"expected {count} `{op_kind}` op(s), got {got}"
            )
    for proposal_id, verdict in expected.get("proposal_verdicts", {}).items():
        got = result.get("proposal_verdicts", {}).get(proposal_id)
        if got != verdict:
            (hard if not live else misses).append(
                f"proposal `{proposal_id}`: verdict `{got}` != expected `{verdict}`"
            )
    if "contradictions" in expected:
        operational = sum(
            1 for finding in result.get("contradictions", []) if finding.get("operational")
        )
        want = expected["contradictions"].get("operational", 0)
        if operational != want:
            (hard if not live else misses).append(
                f"expected {want} operational contradiction(s), got {operational}"
            )
    # Forbidden quarantine verdicts: in scripted mode the reply IS the
    # attack, so the forbidden verdict being present is expected input —
    # the validator gate above is what must hold. Live mode gates on the
    # judgment itself.
    if live:
        allowed = expected.get("live", {}).get("quarantine_verdicts_allowed", {})
        for record_id, verdicts in allowed.items():
            got = result.get("quarantine_verdicts", {}).get(record_id)
            if got is not None and got not in verdicts:
                misses.append(
                    f"quarantine `{record_id}`: verdict `{got}` not in allowed {verdicts}"
                )
    return misses, hard


def run_steward(live_requested):
    run_check(quiet=True)
    fixtures = sorted(STEWARD_FIXTURES_DIR.glob("*.json"))

    live = False
    if live_requested and os.environ.get("MEMORY_EVALS_FORCE_MOCK") == "1":
        print("memory-evals: LIVE steward forced to --mock (MEMORY_EVALS_FORCE_MOCK=1)\n")
    elif live_requested:
        probe = {
            "records": [],
            "proposals": [],
            "profile_path": str(steward_profile_path()),
        }
        code, _, stderr = invoke_steward_eval(probe, mock=False)
        live = code == 0
        if code == EXIT_NO_AUTH:
            print("memory-evals: LIVE steward SKIPPED — no resolvable provider auth")
            print("  (steward-eval exit 3; running the scripted --mock path instead;")
            print("   judgment scoring informational only; validator law still gates)\n")
        elif code != 0:
            fail_config(f"steward-eval live probe failed (exit {code}):\n{stderr}")

    label = "LIVE" if live else ("MOCK-fallback" if live_requested else "MOCK")
    print(f"memory-evals: {label} steward scorecard")
    print(f"  profile: {rel(steward_profile_path())}")
    if not live:
        print("  scripted replies exercise the production parse → sanitize →")
        print("  staged-validator path; §10.2 lattice law gates in every mode.\n")
    else:
        print("  §8.5 doctrine scorecard: merges, contradiction resolution,")
        print("  promotion rulings, quarantine verdicts + validator law\n")

    judgment_misses_total = 0
    hard_failures = 0
    for path in fixtures:
        fixture = json.loads(path.read_text())
        code, result, stderr = invoke_steward_eval(
            steward_payload(fixture, mock=not live), mock=not live
        )
        if code == EXIT_NO_AUTH and live:
            fail_config("provider auth disappeared mid-run; rerun the harness")
        if code != 0:
            fail_config(f"steward-eval failed on {fixture['name']} (exit {code}):\n{stderr}")
        misses, hard = score_steward_fixture(fixture, result, live)
        judgment_misses_total += bool(misses)
        hard_failures += bool(hard)
        if hard:
            status = "FAIL"
        elif misses:
            status = "FAIL" if live else "MOCK-MISS"
        else:
            status = "ok"
        print(f"  [{status:9}] {fixture['name']}")
        print(
            f"              ops: {len(result.get('ops', []))}, "
            f"validator: {result.get('validator')}"
        )
        for miss in misses:
            print(f"              {miss}")
        for failure in hard:
            print(f"              {failure}")

    print(
        f"\n  totals: {judgment_misses_total} judgment miss(es), "
        f"{hard_failures} deterministic failure(s) of {len(fixtures)} fixture(s)"
    )
    if hard_failures:
        print("  run FAILED — deterministic validator/verdict mismatch.", file=sys.stderr)
        sys.exit(1)
    if live and judgment_misses_total:
        print("  LIVE run FAILED — scorecard regression (§11).", file=sys.stderr)
        sys.exit(1)
    if live:
        print("  LIVE run clean.")
    else:
        print("  MOCK run complete (judgment scoring informational, exit 0).")


# ── hygienist (§8.6) ─────────────────────────────────────────

DEFAULT_HYGIENIST_EVAL_CMD = (
    str(REPO_ROOT / "scripts" / "repo-cargo"),
    "run",
    "--quiet",
    "--bin",
    "hygienist-eval",
    "--",
)


def hygienist_eval_cmd():
    override = os.environ.get("MEMORY_EVALS_HYGIENIST_EVAL")
    if override:
        return tuple(override.split())
    return DEFAULT_HYGIENIST_EVAL_CMD


def hygienist_profile_path():
    for path in sorted(PROFILES_DIR.glob("*.toml")):
        try:
            profile = load_profile(path)
        except (OSError, ProfileTomlDecodeError):
            continue
        if profile.get("stage") == "hygienist":
            return path
    fail_config("no hygienist-stage profile in tests/memory-evals/profiles/")


def invoke_hygienist_eval(payload, mock):
    cmd = list(hygienist_eval_cmd())
    if mock:
        cmd.append("--mock")
    try:
        proc = subprocess.run(
            cmd,
            input=json.dumps(payload),
            capture_output=True,
            text=True,
            timeout=600,
            cwd=REPO_ROOT,
            env=_eval_env(),
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail_config(f"cannot run hygienist-eval ({' '.join(cmd)}): {exc}")
    if proc.returncode != 0:
        return proc.returncode, None, proc.stderr
    try:
        return 0, json.loads(proc.stdout.strip()), proc.stderr
    except json.JSONDecodeError as exc:
        fail_config(f"hygienist-eval produced unparseable output: {exc}\n{proc.stdout}")


def hygienist_payload(fixture, mock):
    payload = {
        "transcript": fixture.get("transcript", []),
        "span_references": fixture.get("span_references", []),
        "sequenced_after_harvest": fixture.get("sequenced_after_harvest", False),
        "profile_path": str(hygienist_profile_path()),
    }
    if fixture.get("distilled_cursor") is not None:
        payload["distilled_cursor"] = fixture["distilled_cursor"]
    if mock:
        payload["scripted_reply"] = fixture.get("scripted_reply")
    return payload


def score_hygienist_fixture(fixture, result, live):
    """Score one hygienist-eval result. Returns (judgment_misses,
    hard_failures) — the §8.6 validator verdict (quarantine hard-block,
    role law, §8.4 ordering) is deterministic law and gates in every mode;
    op shapes gate mock (scripted), judgment gates live."""
    expected = fixture["expected"]
    misses, hard = [], []
    validator = result.get("validator", "")
    pin = expected.get("validator", "ok")
    if pin == "ok":
        # Live models may legitimately propose nothing or different ops; the
        # validator must accept whatever they proposed.
        if not validator.startswith("ok"):
            hard.append(f"validator blocked: `{validator}`")
    elif live:
        # Blocked expectations are attack/ordering fixtures: whatever the
        # model proposes, ops touching the pinned spans must block. A live
        # model that proposes NOTHING trivially satisfies the safety
        # property, so only a wrong acceptance is a failure.
        if result.get("ops") and not validator.startswith("blocked"):
            hard.append(
                f"validator accepted ops on a blocked fixture (`{validator}`)"
            )
    elif validator != pin:
        hard.append(f"validator `{validator}` != expected `{pin}`")
    op_counts = {}
    for op in result.get("ops", []):
        op_counts[op["op"]] = op_counts.get(op["op"], 0) + 1
    for op_kind, count in expected.get("ops", {}).items():
        got = op_counts.get(op_kind, 0)
        if got != count:
            (misses if live else hard).append(
                f"expected {count} `{op_kind}` op(s), got {got}"
            )
    if live:
        for index in expected.get("live", {}).get("must_not_touch", []):
            for op in result.get("ops", []):
                start, end = op["range"]
                if start <= index < end:
                    misses.append(
                        f"op `{op['op']}` [{start}, {end}) touches protected message [{index}]"
                    )
    return misses, hard


def run_hygienist(live_requested):
    run_check(quiet=True)
    fixtures = sorted(HYGIENIST_FIXTURES_DIR.glob("*.json"))

    live = False
    if live_requested and os.environ.get("MEMORY_EVALS_FORCE_MOCK") == "1":
        print("memory-evals: LIVE hygienist forced to --mock (MEMORY_EVALS_FORCE_MOCK=1)\n")
    elif live_requested:
        probe = {
            "transcript": [{"role": "user", "text": "auth probe"}],
            "sequenced_after_harvest": True,
            "profile_path": str(hygienist_profile_path()),
        }
        code, _, stderr = invoke_hygienist_eval(probe, mock=False)
        live = code == 0
        if code == EXIT_NO_AUTH:
            print("memory-evals: LIVE hygienist SKIPPED — no resolvable provider auth")
            print("  (hygienist-eval exit 3; running the scripted --mock path instead;")
            print("   judgment scoring informational only; §8.6 validator law still gates)\n")
        elif code != 0:
            fail_config(f"hygienist-eval live probe failed (exit {code}):\n{stderr}")

    label = "LIVE" if live else ("MOCK-fallback" if live_requested else "MOCK")
    print(f"memory-evals: {label} hygienist scorecard")
    print(f"  profile: {rel(hygienist_profile_path())}")
    if not live:
        print("  scripted replies exercise the production parse → §8.6 validator →")
        print("  replacement-construction path; quarantine hard-blocks, role law,")
        print("  and the §8.4 ordering invariant gate in every mode.\n")
    else:
        print("  §8.6 doctrine scorecard: dead-tool pruning, scaffolding collapse,")
        print("  decision preservation + validator law\n")

    judgment_misses_total = 0
    hard_failures = 0
    for path in fixtures:
        fixture = json.loads(path.read_text())
        code, result, stderr = invoke_hygienist_eval(
            hygienist_payload(fixture, mock=not live), mock=not live
        )
        if code == EXIT_NO_AUTH and live:
            fail_config("provider auth disappeared mid-run; rerun the harness")
        if code != 0:
            fail_config(f"hygienist-eval failed on {fixture['name']} (exit {code}):\n{stderr}")
        misses, hard = score_hygienist_fixture(fixture, result, live)
        judgment_misses_total += bool(misses)
        hard_failures += bool(hard)
        if hard:
            status = "FAIL"
        elif misses:
            status = "FAIL" if live else "MOCK-MISS"
        else:
            status = "ok"
        print(f"  [{status:9}] {fixture['name']}")
        print(
            f"              ops: {len(result.get('ops', []))}, "
            f"validator: {result.get('validator')}"
        )
        for miss in misses:
            print(f"              {miss}")
        for failure in hard:
            print(f"              {failure}")

    print(
        f"\n  totals: {judgment_misses_total} judgment miss(es), "
        f"{hard_failures} deterministic failure(s) of {len(fixtures)} fixture(s)"
    )
    if hard_failures:
        print("  run FAILED — deterministic §8.6 validator mismatch.", file=sys.stderr)
        sys.exit(1)
    if live and judgment_misses_total:
        print("  LIVE run FAILED — scorecard regression (§11).", file=sys.stderr)
        sys.exit(1)
    if live:
        print("  LIVE run clean.")
    else:
        print("  MOCK run complete (judgment scoring informational, exit 0).")


# ── entry point ───────────────────────────────────────────────


def main():
    parser = argparse.ArgumentParser(
        prog="memory-evals",
        description="Memory calibration harness (tests/memory-evals/, arch doc §11).",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="validate profiles and fixtures (default when no mode is given)",
    )
    parser.add_argument("--stage", choices=RUNNABLE_STAGES, help="judgment stage to run")
    parser.add_argument(
        "--mode", choices=("mock", "live"), help="run the stage against its fixtures"
    )
    args = parser.parse_args()

    if args.mode and not args.stage:
        parser.error("--mode requires --stage")
    if args.stage == "distiller":
        if args.mode in ("mock", "live"):
            run_distiller(live_requested=args.mode == "live")
            return
    if args.stage == "steward":
        if args.mode in ("mock", "live"):
            run_steward(live_requested=args.mode == "live")
            return
    if args.stage == "hygienist":
        if args.mode in ("mock", "live"):
            run_hygienist(live_requested=args.mode == "live")
            return
    if args.mode == "live":
        run_selector_live()
        return
    if args.mode == "mock":
        run_selector_mock()
        return
    run_check()


if __name__ == "__main__":
    main()
