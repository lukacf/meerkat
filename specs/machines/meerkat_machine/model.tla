RecordLiveCloseClosedIdle(arg_session_id, channel_id, close_observation_sequence) ==
    /\ phase = "Idle"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (close_observation_sequence > 0)
    /\ (IF ~((arg_session_id \in DOMAIN live_active_channel_by_session)) THEN TRUE ELSE ((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(channel_id)))
    /\ (IF ~((channel_id \in DOMAIN live_channel_session_by_channel)) THEN TRUE ELSE ((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id)))
    /\ (IF ~((channel_id \in DOMAIN live_close_observation_sequence_by_channel)) THEN TRUE ELSE (close_observation_sequence > (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_close_observation_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_close_observation_sequence_by_channel THEN live_close_observation_sequence_by_channel[channel_id] ELSE 0)) ELSE None) THEN (IF (channel_id \in DOMAIN live_close_observation_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_close_observation_sequence_by_channel THEN live_close_observation_sequence_by_channel[channel_id] ELSE 0)) ELSE None)["value"] ELSE None)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_active_channel_by_session' = MapRemove(live_active_channel_by_session, arg_session_id)
    /\ live_channel_session_by_channel' = MapRemove(live_channel_session_by_channel, channel_id)
    /\ live_channel_identity_by_channel' = MapRemove(live_channel_identity_by_channel, channel_id)
    /\ live_close_result_sequence' = (live_close_result_sequence) + 1
    /\ live_close_observation_sequence_by_channel' = MapSet(live_close_observation_sequence_by_channel, channel_id, close_observation_sequence)
    /\ live_close_status_by_channel' = MapSet(live_close_status_by_channel, channel_id, "Closed")
    /\ UNCHANGED << session_id, active_runtime_id, active_fence_token, active_runtime_generation, active_runtime_epoch_id, current_run_id, pre_run_phase, runtime_stop_deferred, turn_phase, primitive_kind, admitted_content_shape, vision_enabled, image_tool_results_enabled, tool_calls_pending, pending_op_refs, barrier_operation_ids, has_barrier_ops, barrier_satisfied, boundary_count, cancel_after_boundary, boundary_cancel_dispatch_pending, boundary_cancel_dispatch_generation, turn_terminal_run_id, recovered_boundary_sequence, terminal_outcome, terminal_cause_kind, last_runtime_apply_failure_cause, last_runtime_apply_failure_message, runtime_completion_result_run_id, extraction_attempts, max_extraction_retries, extraction_active, llm_retry_attempt, llm_retry_max_retries, llm_retry_selected_delay_ms, llm_retry_last_failure_kind, silent_intent_overrides, model_routing_baseline_model, model_routing_baseline_realtime, model_routing_topology_epoch, model_routing_turn_override_id, model_routing_turn_request_id, model_routing_turn_target_model, model_routing_turn_realtime, model_routing_turn_remaining_turns, model_routing_operation_override_id, model_routing_operation_target_model, model_routing_operation_realtime, model_routing_pending_switch_request_id, model_routing_pending_switch_target_model, model_routing_pending_switch_realtime, model_routing_pending_switch_turns, model_routing_pending_switch_phase, model_routing_switch_terminal, model_routing_switch_denials, model_routing_switch_approval_reasons, model_routing_image_operation_phases, model_routing_image_operation_target_models, model_routing_image_operation_realtime, model_routing_image_operation_requires_scoped_override, model_routing_image_classified_terminals, model_routing_image_classified_provider_text, model_routing_image_terminals, model_routing_image_terminal_payloads, model_routing_image_denials, model_routing_image_approval_reasons, model_routing_image_plan_denials, model_routing_approval_phases, model_routi