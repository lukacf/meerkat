    /\ model_step_count' = model_step_count + 1
    /\ authority_staged_run' = Some(run_id)
    /\ authority_staged_batch' = (IF (input_id \in DOMAIN input_authority_batch_keys) THEN Some((IF input_id \in DOMAIN input_authority_batch_keys THEN input_authority_batch_keys[input_id] ELSE "None")) ELSE None)
    /\ input_phases' = MapSet(input_phases, input_id, "Staged")
    /\ input_attempt_counts' = MapIncrement(input_attempt_counts, input_id, 1)
    /\ input_run_associations' = MapSet(input_run_associations, input_id, run_id)
    /\ input_completion_boundaries' = MapRemove(input_completion_boundaries, input_id)
    /\ input_lane' = MapRemove(input_lane, input_id)
