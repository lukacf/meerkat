StageForRunIdle(input_id, run_id) ==
    /\ phase = "Idle"
    /\ ((input_id \in DOMAIN input_phases) /\ ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") = "Queued"))
    /\ (input_id \in DOMAIN input_lane)
    /\ (input_id \in DOMAIN input_admission_seq)
