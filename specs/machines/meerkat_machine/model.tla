PrioritizeInputIdle(input_id) ==
    /\ phase = "Idle"
    /\ (input_id \in DOMAIN input_lane)
    /\ (next_priority_admission_seq > 0)
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
