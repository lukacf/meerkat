operation_source_valid(source) == (IF (source = None) THEN TRUE ELSE (IF (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "SessionChild") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id = None)) THEN TRUE ELSE (IF (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "BackendPeer") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id = None)) THEN TRUE ELSE (((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "DetachedJob") /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).session_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).peer_id = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).address = None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).realm_id # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).job_id # None)))))
