ResolveStagedRollbackMaxAttemptsExhaustedStopped(input_id, lane) ==
    /\ phase = "Stopped"
    /\ (input_id \in DOMAIN input_phases)
    /\ ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") = "Staged")
    /\ (input_id \in DOMAIN input_attempt_counts)
    /\ ((input_id \in DOMAIN input_recovery_lanes) /\ ((IF input_id \in DOMAIN input_recovery_lanes THEN input_recovery_lanes[input_id] ELSE "None") = lane))
    /\ ((IF input_id \in DOMAIN input_attempt_counts THEN input_attempt_counts[input_id] ELSE 0) >= max_stage_attempts)
    /\ phase' = "Stopped"
    /\ model_step_count' = model_step_count + 1
    /\ input_phases' = MapSet(input_phases, input_id, "Abandoned")
    /\ input_terminal_kind' = MapSet(input_terminal_kind, input_id, "Abandoned")
    /\ input_superseded_by' = MapRemove(input_superseded_by, input_id)
    /\ input_aggregate_id' = MapRemove(input_aggregate_id, input_id)
    /\ input_abandon_reason' = MapSet(input_abandon_reason, input_id, "MaxAttemptsExhausted")
    /\ input_abandon_attempt_count' = MapSet(input_abandon_attempt_count, input_id, (IF input_id \in DOMAIN input_attempt_counts THEN input_attempt_counts[input_id] ELSE 0))
    /\ input_lane' = MapRemove(input_lane, input_id)
    /\ input_recovery_lanes' = MapRemove(input_recovery_lanes, input_id)
