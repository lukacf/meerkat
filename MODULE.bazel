# `audiopus_sys` builds its vendored libopus with CMake when pkg-config has no
# system Opus installation. Hosted macOS RBE workers intentionally do not have
# CMake on PATH, so provide a pinned universal tool to that build script.
http_archive(
    name = "cmake_macos_universal",
    build_file_content = '''
exports_files(
    ["CMake.app/Contents/bin/cmake"],
    visibility = ["//visibility:public"],
)
filegroup(
    name = "runtime",
    # `cmake` resolves its modules relative to the executable. Do not ship the
    # GUI, docs, Qt frameworks, signatures, or auxiliary binaries into every
    # remote native build action.
    srcs = glob(["CMake.app/Contents/share/cmake-3.30/**"]),
    visibility = ["//visibility:public"],
)
''',
    sha256 = "572bf27e2e98d7513e0835525a2b9dc0f3947f6ad7494615e22b60369e87db11",
    strip_prefix = "cmake-3.30.9-macos-universal",
    urls = ["https://github.com/Kitware/CMake/releases/download/v3.30.9/cmake-3.30.9-macos-universal.tar.gz"],
)

