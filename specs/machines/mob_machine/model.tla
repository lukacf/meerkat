    /\ ((IF (agent_identity \in DOMAIN pending_placed_spawn_hosts) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_hosts THEN pending_placed_spawn_hosts[agent_identity] ELSE "None")) ELSE None) = (IF (agent_identity \in DOMAIN member_placement) THEN Some((IF agent_identity \in DOMAIN member_placement THEN member_placement[agent_identity] ELSE "None")) ELSE None))
    /\ ((agent_identity \in DOMAIN pending_placed_spawn_hosts) /\ ((IF (agent_identity \in DOMAIN pending_placed_spawn_host_binding_generations) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_host_binding_generations THEN pending_placed_spawn_host_binding_generations[agent_identity] ELSE 0)) ELSE None) = (IF ((pending_placed_spawn_hosts)[agent_identity] \in DOMAIN host_binding_generations) THEN Some((IF (pending_placed_spawn_hosts)[agent_identity] \in DOMAIN host_binding_generations THEN host_binding_generations[(pending_placed_spawn_hosts)[agent_identity]] ELSE 0)) ELSE None)))
    /\ ((provision_operation_id # None) /\ (provision_operation_id = (IF (agent_identity \in DOMAIN pending_placed_spawn_provision_operation_ids) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_provision_operation_ids THEN pending_placed_spawn_provision_operation_ids[agent_identity] ELSE "None")) ELSE None)))
    /\ ((spec_digest_echo # None) /\ (spec_digest_echo = (IF (agent_identity \in DOMAIN spawn_profile_authority_resolved_spec_digests) THEN Some((IF agent_identity \in DOMAIN spawn_profile_authority_resolved_spec_digests THEN spawn_profile_authority_resolved_spec_digests[agent_identity] ELSE "None")) ELSE None)) /\ (spec_digest_echo = (IF (agent_identity \in DOMAIN pending_placed_spawn_spec_digests) THEN Some((IF agent_identity \in DOMAIN pending_placed_spawn_spec_digests THEN pending_placed_spawn_spec_digests[agent_identity] ELSE "None")) ELSE None)))
    /\ (((agent_identity \in DOMAIN member_placement) /\ ((member_placement)[agent_identity] \in DOMAIN host_engine_versions)) /\ (ack_engine_version = Some((host_engine_versions)[(member_placement)[agent_identity]])))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ live_runtime_ids' = (live_runtime_ids \cup {agent_runtime_id})
    /\ externally_addressable_runtime_ids' = IF external_addressable THEN (externally_addressable_runtime_ids \cup {agent_runtime_id}) ELSE (externally_addressable_runtime_ids \ {agent_runtime_id})
    /\ runtime_fence_tokens' = MapSet(runtime_fence_tokens, agent_runtime_id, fence_token)
    /\ identity_runtime_generations' = MapSet(identity_runtime_generations, agent_identity, generation)
    /\ identity_runtime_fence_tokens' = MapSet(identity_runtime_fence_tokens, agent_identity, fence_token)
    /\ member_startup_binding_requested' = (member_startup_binding_requested \ {agent_runtime_id})
