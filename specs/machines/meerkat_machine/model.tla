    /\ phase = "Idle"
    /\ (current_run_id = None)
    /\ (turn_terminal_run_id # Some(candidate_run_id))
    /\ (IF (observed_lifecycle = "MissingRow") THEN TRUE ELSE (IF (observed_lifecycle = "Idle") THEN TRUE ELSE (observed_lifecycle = "Retired")))
    /\ (observed_current_run = "NoRun")
    /\ (IF (class = "CompletedCandidate") THEN TRUE ELSE (class = "InterruptedRepairableCandidate"))
    /\ (IF (prior_commit = "NoPriorCommit") THEN TRUE ELSE (prior_commit = "PrecedesCandidate"))
