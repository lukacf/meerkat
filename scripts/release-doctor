#!/usr/bin/env bash
set -euo pipefail

workspace_root="$(git rev-parse --show-toplevel)"
cd "${workspace_root}"

# Contract tests point the doctor at a mutated copy of the release workflow.
release_workflow="${RELEASE_WORKFLOW_FILE:-.github/workflows/release.yml}"

ok=0
warn=0
fail=0

pass() {
  ok=$((ok + 1))
  printf 'PASS %s\n' "$1"
}

note() {
  warn=$((warn + 1))
  printf 'WARN %s\n' "$1"
}

bad() {
  fail=$((fail + 1))
  printf 'FAIL %s\n' "$1"
}

bool_enabled() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON|buildbuddy)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

workflow_job() {
  local job_name="$1"
  awk -v header="  ${job_name}:" '
    $0 == header { in_job = 1 }
    in_job && $0 != header && /^  [[:alnum:]_-]+:/ { exit }
    in_job { print }
  ' "${release_workflow}"
}

if command -v gh >/dev/null 2>&1; then
  pass "GitHub CLI is installed"
  if gh auth status --hostname github.com >/dev/null 2>&1; then
    pass "GitHub CLI is authenticated for github.com"
  else
    bad "GitHub CLI is not authenticated for github.com; run gh auth login before release dispatch"
  fi
else
  bad "GitHub CLI is not installed; release workflow dispatch needs gh"
fi

if command -v npm >/dev/null 2>&1; then
  pass "npm is installed"
  if npm whoami >/dev/null 2>&1; then
    pass "local npm authentication is available"
  else
    note "local npm authentication is not available; GitHub Actions publishes with NPM_TOKEN"
  fi
else
  bad "npm is not installed; SDK publish checks need npm"
fi

if release_python="$("${workspace_root}/scripts/require-python" 3.10 "release hook" 2>/dev/null)"; then
  release_python_version="$("${release_python}" -c 'import platform; print(platform.python_version())')"
  pass "release hook Python ${release_python_version} (${release_python}) satisfies >= 3.10"
else
  bad "$("${workspace_root}/scripts/require-python" 3.10 "release hook" 2>&1 >/dev/null)"
fi

# Bash >= 4.4 for the repository scripts (`#!/usr/bin/env bash`); see
# scripts/lib/require-bash.sh. Check what `env bash` resolves to.
env_bash_versinfo="$(env bash -c 'printf "%s %s %s" "${BASH_VERSINFO[0]:-0}" "${BASH_VERSINFO[1]:-0}" "${BASH_VERSION:-unknown}"' 2>/dev/null || true)"
read -r env_bash_major env_bash_minor env_bash_version <<<"${env_bash_versinfo:-0 0 missing}"
if [[ "${env_bash_major}" -gt 4 || ( "${env_bash_major}" -eq 4 && "${env_bash_minor}" -ge 4 ) ]]; then
  pass "env bash ${env_bash_version} satisfies >= 4.4"
else
  bad "env bash is ${env_bash_version}; repository scripts need Bash >= 4.4 (macOS: brew install bash, ahead of /bin in PATH)"
fi

if command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
  gh_user="$(gh api --hostname github.com user --jq '.login' 2>/dev/null || true)"
  owner_release_account=false
  if [[ "${gh_user}" == "lukacf" ]]; then
    owner_release_account=true
    pass "GitHub account can use owner BuildBuddy release paths"
  else
    note "GitHub account '${gh_user:-unknown}' will default release auto-dispatch to GitHub-hosted"
  fi

  release_bb="$(
    gh api --hostname github.com repos/lukacf/meerkat/actions/variables/MEERKAT_RELEASE_BUILDBUDDY \
      --jq '.value' 2>/dev/null || true
  )"
  if [[ "${owner_release_account}" == "true" ]]; then
    if bool_enabled "${release_bb}"; then
      pass "MEERKAT_RELEASE_BUILDBUDDY repo variable is enabled"
    else
      bad "MEERKAT_RELEASE_BUILDBUDDY repo variable is '${release_bb:-missing}'; set it to true before owner release"
    fi
  elif bool_enabled "${release_bb}"; then
    note "MEERKAT_RELEASE_BUILDBUDDY is enabled, but only lukacf auto-dispatch uses it"
  else
    pass "GitHub-hosted release default is available for non-owner account"
  fi

  runner_value="$(
    gh api --hostname github.com repos/lukacf/meerkat/actions/variables/MEERKAT_CI_RUNNER \
      --jq '.value' 2>/dev/null || true
  )"
  if [[ -n "${runner_value}" ]]; then
    pass "MEERKAT_CI_RUNNER repo variable is set"
  else
    note "MEERKAT_CI_RUNNER repo variable is not set; release gates will use GitHub-hosted defaults"
  fi

  for secret_name in CARGO_REGISTRY_TOKEN PYPI_API_TOKEN NPM_TOKEN HOMEBREW_TAP_TOKEN; do
    if gh api --hostname github.com "repos/lukacf/meerkat/actions/secrets/${secret_name}" --jq '.name' >/dev/null 2>&1; then
      pass "GitHub Actions secret ${secret_name} exists"
    elif [[ "${owner_release_account}" == "true" ]]; then
      bad "GitHub Actions secret ${secret_name} is missing"
    else
      note "GitHub Actions secret ${secret_name} metadata is not visible to this account"
    fi
  done
fi

if grep -Fq 'github.com/wasm-bindgen/wasm-pack/releases/download' "${release_workflow}"; then
  pass "Release workflow installs wasm-pack from maintained wasm-bindgen releases"
else
  bad "Release workflow does not use the maintained wasm-bindgen wasm-pack release URL"
fi

if grep -Fq 'build_web_sdk_package:' "${release_workflow}" &&
  grep -Fq 'scripts/release-build-web-sdk-package.sh' "${release_workflow}" &&
  grep -Fq 'name: rkat-web-package' "${release_workflow}" &&
  grep -Fq 'scripts/release-publish-web-sdk-package.sh' "${release_workflow}"; then
  pass "Release workflow builds @rkat/web once as an artifact before npm publishing"
else
  bad "Release workflow does not publish @rkat/web from a prebuilt package artifact"
fi

npm_preflight_job="$(workflow_job registry_credentials_preflight)"
npm_registry_publish_job="$(workflow_job publish_registries)"
npm_web_publish_job="$(workflow_job publish_web_sdk)"
if grep -Fq 'scripts/release-npm-publish-preflight' <<<"${npm_preflight_job}" &&
  grep -Fq 'alpha_crates_only' <<<"${npm_preflight_job}" &&
  grep -Eq '^    needs: \[.*registry_credentials_preflight.*\]$' <<<"${npm_registry_publish_job}" &&
  grep -Fq "needs.registry_credentials_preflight.result == 'success'" <<<"${npm_registry_publish_job}" &&
  grep -Eq '^    needs: \[.*registry_credentials_preflight.*\]$' <<<"${npm_web_publish_job}" &&
  grep -Fq "needs.registry_credentials_preflight.result == 'success'" <<<"${npm_web_publish_job}"; then
  pass "Release workflow verifies npm authentication and package write access before registry publication"
else
  bad "Release workflow must gate both npm publication jobs on the live npm credential preflight"
fi

web_release_ref_jobs="$(
  awk '
    /^  build_web_sdk_package:/ { job = "build"; next }
    /^  publish_web_sdk:/ { job = "publish"; next }
    /^  [[:alnum:]_-]+:/ { job = "" }
    job != "" &&
      /github\.event\.inputs\.release_tag !=/ &&
      /github\.event\.inputs\.release_tag \|\| github\.ref/ {
        pinned[job] = 1
      }
    END { print pinned["build"] + pinned["publish"] }
  ' "${release_workflow}"
)"
if [[ "${web_release_ref_jobs}" == "2" ]]; then
  pass "Web SDK build and publish recovery jobs are pinned to the selected release tag"
else
  bad "Web SDK recovery must check out release_tag in both build and publish jobs"
fi

if awk '
    /^  build_binaries_buildbuddy:/ { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { in_job = 0 }
    in_job && /release-build-(linux|macos)/ { found = 1 }
    in_job && /release-build-windows/ { windows = 1 }
    END { exit (found && !windows) ? 0 : 1 }
  ' "${release_workflow}"; then
  pass "Release workflow builds Linux/macOS assets on BuildBuddy for owner releases (no Windows BuildBuddy lane)"
else
  bad "Release workflow should build Linux/macOS assets on BuildBuddy and keep Windows off the BuildBuddy lane (no self-hosted Windows RBE executors are registered)"
fi

# Windows release binaries are cross-compiled from Linux with cargo-xwin and
# then verified on the pinned windows-2025-vs2026 runner; the binary gate
# requires both of those jobs whichever lane builds Linux/macOS, and no
# hosted matrix entry builds natively on windows-latest any more.
if awk '
    /^  build_binaries_windows_cross:/ { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { in_job = 0 }
    in_job && /uses: \.\/\.release-tooling\/\.github\/actions\/build-windows-cross/ { uses = 1 }
    in_job && /runs-on: ubuntu-24.04/ { linux = 1 }
    in_job && /name: meerkat-x86_64-pc-windows-msvc-windows-latest/ { artifact = 1 }
    END { exit (uses && linux && artifact) ? 0 : 1 }
  ' "${release_workflow}" &&
  awk '
    /^  verify_windows_binaries:/ { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { in_job = 0 }
    in_job && /runs-on: windows-2025-vs2026$/ { native = 1 }
    in_job && /--version/ { version = 1 }
    END { exit (native && version) ? 0 : 1 }
  ' "${release_workflow}" &&
  grep -Eq '^    needs: \[build_binaries, build_binaries_buildbuddy, build_binaries_windows_cross, verify_windows_binaries(, [a-z0-9_]+)*\]$' "${release_workflow}" &&
  grep -Fq '[[ "${windows_cross_result}" == "success" && "${windows_verify_result}" == "success" ]] || exit 1' "${release_workflow}" &&
  ! grep -Eq 'runs-on: *"?windows-latest"?.*target' "${release_workflow}" &&
  ! grep -Fq '"runs-on":"windows-latest","target":"x86_64-pc-windows-msvc"' "${release_workflow}" &&
  ! grep -Eq '[[:alnum:]-]+\.europe\.buildbuddy\.io' "${release_workflow}"; then
  pass "Release workflow cross-compiles Windows binaries on Linux, verifies them on the pinned windows-2025-vs2026 runner, and gates on both"
else
  bad "Release workflow should cross-compile Windows binaries on Linux (build_binaries_windows_cross using build-windows-cross from the workflow-ref tooling checkout), verify them on the pinned windows-2025-vs2026 runner (verify_windows_binaries), keep the artifact name meerkat-x86_64-pc-windows-msvc-windows-latest, and gate on both jobs"
fi

web_build_timeout="$(
  awk '
    /^  build_web_sdk_package:/ { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { in_job = 0 }
    in_job && /timeout-minutes:/ {
      gsub(/[^0-9]/, "", $0)
      print $0
      exit
    }
  ' "${release_workflow}"
)"
if [[ "${web_build_timeout:-0}" =~ ^[0-9]+$ ]] && ((web_build_timeout >= 120)); then
  pass "Web SDK package build job has a long timeout (${web_build_timeout} minutes)"
else
  bad "Web SDK package build job timeout is '${web_build_timeout:-missing}'; expected at least 120 minutes"
fi

web_publish_timeout="$(
  awk '
    /^  publish_web_sdk:/ { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { in_job = 0 }
    in_job && /timeout-minutes:/ {
      gsub(/[^0-9]/, "", $0)
      print $0
      exit
    }
  ' "${release_workflow}"
)"
if [[ "${web_publish_timeout:-0}" =~ ^[0-9]+$ ]] && ((web_publish_timeout <= 30)); then
  pass "Web SDK publish job is artifact-only (${web_publish_timeout} minute timeout)"
else
  bad "Web SDK publish job timeout is '${web_publish_timeout:-missing}'; expected at most 30 minutes for artifact-only publish"
fi

if grep -Fq 'Too Many Requests' scripts/release-publish-rust-crates.sh &&
  grep -Fq 'MEERKAT_CRATE_PUBLISH_ATTEMPTS' scripts/release-publish-rust-crates.sh; then
  pass "Rust crate publishing retries crates.io rate limits"
else
  bad "Rust crate publish script is missing crates.io rate-limit retry handling"
fi

# The publisher is product-aware (0.9.9): it walks the dependency levels of
# the crate list MEERKAT_RELEASE_CRATE_LIST names, Core's
# scripts/release-rust-crates.sh by default (release.yml) and Meta's
# scripts/release-meta-crates.sh in meta-release.yml, and waits for each level
# in the index before the next. So check that form of the publisher, then
# that each product's list answers its level plan. Contract tests point the
# doctor at a mutated copy of the publisher.
crate_publisher="${RELEASE_CRATE_PUBLISHER_FILE:-scripts/release-publish-rust-crates.sh}"
level_plans=()
level_plan_errors=()
for product_list in core:scripts/release-rust-crates.sh meta:scripts/release-meta-crates.sh; do
  product="${product_list%%:*}"
  crate_list="${product_list#*:}"
  if level_summary="$("${crate_list}" --levels --format summary 2>&1)" && [[ -n "${level_summary}" ]]; then
    level_count="$(wc -l <<<"${level_summary}" | tr -d ' ')"
    level_plans+=("${product} ${level_count} level$([[ "${level_count}" == 1 ]] || echo s)")
  else
    level_plan_errors+=("${product} (${crate_list}): ${level_summary:-no level plan}")
  fi
done
if ! grep -Eq '^CRATE_LIST="\$\{MEERKAT_RELEASE_CRATE_LIST:-.*scripts/release-rust-crates\.sh\}"$' "${crate_publisher}" ||
  ! grep -Fq '"$CRATE_LIST" --levels' "${crate_publisher}" ||
  ! grep -Fq 'wait_for_index "$level"' "${crate_publisher}"; then
  bad "Rust crate publishing must walk the dependency levels of the product's crate list (MEERKAT_RELEASE_CRATE_LIST, Core's scripts/release-rust-crates.sh by default) and wait for each level in the index (${crate_publisher})"
elif [[ ${#level_plan_errors[@]} -gt 0 ]]; then
  bad "Every product's crate list must answer its dependency level plan: $(IFS=';'; echo "${level_plan_errors[*]//$'\n'/ }")"
else
  pass "Rust crates publish by dependency level per product ($(IFS=,; echo "${level_plans[*]}" | sed 's/,/, /g')), each level visible in the index before the next"
fi

# The semver-gate and SLO assertions evaluate workflow behaviour under concrete
# events instead of grepping literal lines, so reflowing a condition cannot
# fail the doctor while removing the behaviour still does (#1091).
workflow_contract() {
  "${release_python:-python3}" scripts/check_release_workflow_contract.py \
    --workflow "${release_workflow}" "$@" 2>&1
}
if semver_contract="$(workflow_contract semver-evidence)"; then
  pass "Tag releases reuse exact-tree pre-tag semver evidence"
else
  bad "Tag releases must reuse exact-tree pre-tag semver evidence instead of rerunning the long semver measurement (${semver_contract//$'\n'/; })"
fi

if dispatch_contract="$(workflow_contract dispatch-binding)"; then
  pass "Publishing dispatches are bound to their version's tag"
else
  bad "A publishing dispatch without release_tag could publish a branch tip as the tagged version (${dispatch_contract//$'\n'/; })"
fi

if prebuild_contract="$(workflow_contract prebuild)"; then
  pass "Pre-tag prebuilds publish nothing, and a tag publishes the prebuild of its own commit, or of an ancestor whose changes since are all non-inputs, only through the attested-archive verification"
else
  bad "A pre-tag prebuild must publish nothing, and a tag may publish the prebuild of its own commit, or of an ancestor whose changes since are all non-inputs, only through the attested-archive verification (${prebuild_contract//$'\n'/; })"
fi

if non_inputs_contract="$(workflow_contract prebuild-non-inputs)"; then
  pass "No release build job, local action or script names a path a reused prebuild may differ in (another product's root, a product changelog, a CI-only file)"
else
  bad "A release build job, local action or script names a path a reused prebuild may differ in, so a tag could publish artifacts its own commit would build differently (${non_inputs_contract//$'\n'/; })"
fi

if baseline_contract="$(workflow_contract semver-baseline)"; then
  pass "Semver baseline rustdoc builds alongside the release and gates nothing; it attaches only to a published release, never replacing an attached one"
else
  bad "The semver baseline rustdoc must stay off every path a user waits on (${baseline_contract//$'\n'/; })"
fi

if trailing_contract="$(workflow_contract trailing-platforms)"; then
  pass "Linux and macOS arm64 assets publish without waiting for the trailing Intel macOS and Windows lanes; no upload replaces a published asset"
else
  bad "The trailing Intel macOS and Windows lanes must not gate the critical assets, and no upload may replace a published asset (${trailing_contract//$'\n'/; })"
fi

if token_contract="$(workflow_contract token-permissions)"; then
  pass "Release workflow token is read-only except for the jobs that attest or publish, which never persist it in a checkout; no workflow passes every secret to a reusable workflow"
else
  bad "Release workflow grants write or OIDC scopes beyond the jobs that need them, or a workflow passes every secret to a reusable workflow (${token_contract//$'\n'/; })"
fi

if web_tools_contract="$(workflow_contract web-sdk-tools)"; then
  pass "The Web SDK release build checks every download's sha256 and wasm-pack installs nothing: wasm-bindgen (Cargo.lock's version) and wasm-opt are pinned"
else
  bad "The Web SDK release build may run a tool it downloaded unchecked (${web_tools_contract//$'\n'/; })"
fi

if caches_contract="$(workflow_contract release-caches)"; then
  pass "GitHub Actions caches in release.yml jobs, the local actions they call and, on a tag, the reusable workflows they call are never saved on a dispatch and never cache ~/.cargo/bin; token jobs restore none, no release job or semver readiness run restores a cache on any event, OIDC or attesting jobs restore none that a dispatch-like run of any workflow saves, and no dispatch-like run saves the Bazel repository cache (reusable workflows never run on a dispatch); a workflow that produces what a tag trusts or checks out a ref its inputs choose saves no cache on a dispatch-like run; only push and schedule runs set CI's sccache client to write its bucket (a client-side setting), and CI installs a sha256-pinned sccache release without sccache-action, which would export the Actions cache token to its run steps"
else
  bad "A release cache can be saved on a dispatch, cache ~/.cargo/bin, reach a token, OIDC or attesting job, or be restored by a release job, or a workflow a tag trusts saves a cache on a dispatch-like run, or a run other than a push or schedule sets CI's sccache client to write, or CI installs sccache through sccache-action or without a pinned sha256 (${caches_contract//$'\n'/; })"
fi

if tag_validation_contract="$(workflow_contract tag-validation)"; then
  pass "Tag releases skip Cargo validation only on an exact-tree CI attestation that proves its lanes ran"
else
  bad "Tag releases may skip Cargo validation only on an exact-tree CI attestation that proves its lanes ran, keeping Cargo validation for every other attestation and manual dispatches (${tag_validation_contract//$'\n'/; })"
fi

registry_job="$(workflow_job publish_registries)"
registry_needs="$(grep -m1 '^[[:space:]]*needs:' <<<"${registry_job}" || true)"
if grep -Fq 'require_ci_green' <<<"${registry_needs}" &&
  grep -Fq 'release_validate_gate' <<<"${registry_needs}" &&
  grep -Fq 'release_semver_gate' <<<"${registry_needs}" &&
  grep -Fq 'registry_credentials_preflight' <<<"${registry_needs}" &&
  ! grep -Eq 'build_binaries|publish_github_release|publish_web_sdk' <<<"${registry_needs}"; then
  pass "Rust registry publication is independent of binary and SDK completion"
else
  bad "Rust registry publication has an invalid critical-path dependency: ${registry_needs:-missing needs}"
fi

if slo_contract="$(workflow_contract registry-slo)"; then
  pass "Rust registry publication reads crates back before the SDKs and enforces the 30 minute publication SLO"
else
  bad "Rust registry publication does not read crates back before the SDKs or enforce the 30 minute publication SLO (${slo_contract//$'\n'/; })"
fi

if [[ -n "${VERSION:-${RELEASE_TAG:-}}" ]]; then
  tag="${VERSION:-${RELEASE_TAG:-}}"
  case "${tag}" in
    v*) ;;
    *) tag="v${tag}" ;;
  esac
  if npm view "@rkat/sdk@${tag#v}" version >/dev/null 2>&1; then
    note "@rkat/sdk@${tag#v} is already published"
  else
    pass "@rkat/sdk@${tag#v} is not published yet"
  fi
  if npm view "@rkat/web@${tag#v}" version >/dev/null 2>&1; then
    note "@rkat/web@${tag#v} is already published"
  else
    pass "@rkat/web@${tag#v} is not published yet"
  fi
else
  note "VERSION/RELEASE_TAG not set; skipping package already-published checks"
fi

printf '\nrelease doctor: %d pass, %d warn, %d fail\n' "${ok}" "${warn}" "${fail}"
if ((fail > 0)); then
  exit 1
fi
