RunFlowRunning(run_id, step_ids, ordered_steps, step_status, output_recorded, step_condition_results, step_has_conditions, step_dependencies, step_dependency_modes, step_branches, step_collection_policies, step_quorum_thresholds, step_target_counts, step_target_success_counts, step_target_terminal_failure_counts, escalation_threshold, max_step_retries, max_active_nodes, max_active_frames, max_frame_depth) ==
    /\ phase = "Running"
    /\ (placed_completion_lifecycle_quiescing = FALSE)
    /\ (coordinator_bound = TRUE)
    /\ ((run_id \in DOMAIN run_status) = FALSE)
    /\ ((\A candidate \in step_ids : (candidate \in SeqElements(ordered_steps))) /\ (\A candidate \in SeqElements(ordered_steps) : (candidate \in step_ids)))
    /\ (\A candidate \in step_ids : (((IF (candidate \in DOMAIN step_status) THEN Some((IF candidate \in DOMAIN step_status THEN step_status[candidate] ELSE None)) ELSE None) = Some(None)) /\ ((IF (candidate \in DOMAIN output_recorded) THEN Some((IF candidate \in DOMAIN output_recorded THEN output_recorded[candidate] ELSE FALSE)) ELSE None) = Some(FALSE)) /\ ((IF (candidate \in DOMAIN step_condition_results) THEN Some((IF candidate \in DOMAIN step_condition_results THEN step_condition_results[candidate] ELSE None)) ELSE None) = Some(None)) /\ ((IF (candidate \in DOMAIN step_target_counts) THEN Some((IF candidate \in DOMAIN step_target_counts THEN step_target_counts[candidate] ELSE 0)) ELSE None) = Some(0)) /\ ((IF (candidate \in DOMAIN step_target_success_counts) THEN Some((IF candidate \in DOMAIN step_target_success_counts THEN step_target_success_counts[candidate] ELSE 0)) ELSE None) = Some(0)) /\ ((IF (candidate \in DOMAIN step_target_terminal_failure_counts) THEN Some((IF candidate \in DOMAIN step_target_terminal_failure_counts THEN step_target_terminal_failure_counts[candidate] ELSE 0)) ELSE None) = Some(0))))
    /\ (\A candidate \in step_ids : ((candidate \in DOMAIN step_has_conditions) /\ (candidate \in DOMAIN step_dependencies) /\ (candidate \in DOMAIN step_dependency_modes) /\ (candidate \in DOMAIN step_branches) /\ (candidate \in DOMAIN step_collection_policies) /\ (candidate \in DOMAIN step_quorum_thresholds)))
    /\ ((\A candidate \in DOMAIN step_status : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN output_recorded : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_condition_results : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_has_conditions : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_dependencies : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_dependency_modes : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_branches : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_collection_policies : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_quorum_thresholds : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_target_counts : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_target_success_counts : (candidate \in step_ids)) /\ (\A candidate \in DOMAIN step_target_terminal_failure_counts : (candidate \in step_ids)))
    /\ (\A candidate \in DOMAIN step_dependencies : (\A dependency \in (IF "value" \in DOMAIN (IF (candidate \in DOMAIN step_dependencies) THEN Some((IF candidate \in DOMAIN step_dependencies THEN step_dependencies[candidate] ELSE <<>>)) ELSE None) THEN (IF (candidate \in DOMAIN step_dependencies) THEN Some((IF candidate \in DOMAIN step_dependencies THEN step_dependencies[candidate] ELSE <<>>)) ELSE None)["value"] ELSE None) : (dependency \in step_ids)))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ active_run_count' = (active_run_count) + 1
    /\ run_status' = MapSet(run_status, run_id, "Pending")
    /\ run_ordered_steps' = MapSet(run_ordered_steps, run_id, ordered_steps)
    /\ run_tracked_steps' = MapSet(run_tracked_steps, run_id, step_ids)
    /\ run_step_status' = MapSet(run_step_status, run_id, step_status)
    /\ run_output_recorded' = MapSet(run_output_recorded, run_id, output_recorded)
    /\ run_step_condition_results' = MapSet(run_step_condition_results, run_id, step_condition_results)
    /\ run_step_has_conditions' = MapSet(run_step_has_conditions, run_id, step_has_conditions)
    /\ run_step_dependencies' = MapSet(run_step_dependencies, run_id, step_dependencies)
    /\ run_step_dependency_modes' = MapSet(run_step_dependency_modes, run_id, step_dependency_modes)
    /\ run_step_branches' = MapSet(run_step_branches, run_id, step_branches)
    /\ run_step_collection_policies' = MapSet(run_step_collection_policies, run_id, step_collection_policies)
    /\ run_step_quorum_thresholds' = MapSet(run_step_quorum_thresholds, run_id, step_quorum_thresholds)
    /\ run_step_target_counts' = MapSet(run_step_target_counts, run_id, step_target_counts)
    /\ run_step_target_success_counts' = MapSet(run_step_target_success_counts, run_id, step_target_success_counts)
    /\ run_step_target_terminal_failure_counts' = MapSet(run_step_target_terminal_failure_counts, run_id, step_target_terminal_failure_counts)
    /\ run_target_retry_counts' = MapSet(run_target_retry_counts, run_id, [x \in {} |-> None])
    /\ run_failure_count' = MapSet(run_failure_count, run_id, 0)
    /\ run_consecutive_failure_count' = MapSet(run_consecutive_failure_count, run_id, 0)
    /\ run_escalation_threshold' = MapSet(run_escalation_threshold, run_id, escalation_threshold)
    /\ run_max_step_retries' = MapSet(run_max_step_retries, run_id, max_step_retries)
    /\ run_ready_frames' = MapSet(run_ready_frames, run_id, <<>>)
    /\ run_ready_frame_membership' = MapSet(run_ready_frame_membership, run_id, {})
    /\ run_pending_body_frame_loops' = MapSet(run_pending_body_frame_loops, run_id, <<>>)
    /\ run_pending_body_frame_loop_membership' = MapSet(run_pending_body_frame_loop_membership, run_id, {})
