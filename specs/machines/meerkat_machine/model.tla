OptionSessionLlmIdentityValues == {None} \cup {Some(x) : x \in SessionLlmIdentityValues}
OptionStringValues == {None} \cup {Some(x) : x \in StringValues}
OptionSupervisorAuthorizeRejectionKindValues == {None} \cup {Some(x) : x \in SupervisorAuthorizeRejectionKindValues}
OptionSupervisorBindRejectionKindValues == {None} \cup {Some(x) : x \in SupervisorBindRejectionKindValues}
OptionSupervisorBridgeCommandRejectionKindValues == {None} \cup {Some(x) : x \in SupervisorBridgeCommandRejectionKindValues}
OptionSupervisorRotationPhaseValues == {None} \cup {Some(x) : x \in SupervisorRotationPhaseValues}
OptionSupervisorRotationRejectionKindValues == {None} \cup {Some(x) : x \in SupervisorRotationRejectionKindValues}
OptionTurnPrimitiveKindValues == {None} \cup {Some(x) : x \in TurnPrimitiveKindValues}
OptionTurnTerminalCauseKindValues == {None} \cup {Some(x) : x \in TurnTerminalCauseKindValues}
OptionTurnTerminalOutcomeValues == {None} \cup {Some(x) : x \in TurnTerminalOutcomeValues}
OptionU64Values == {None} \cup {Some(x) : x \in NatValues}
OptionWaitAllRejectReasonKindValues == {None} \cup {Some(x) : x \in WaitAllRejectReasonKindValues}
OptionWaitRequestIdValues == {None} \cup {Some(x) : x \in WaitRequestIdValues}
SeqOfStringValues == {<<>>} \cup {<<x>> : x \in StringValues} \cup {<<x, y>> : x \in StringValues, y \in StringValues}
MapStringSetStringValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in SetOfStringValues }

MapLookup(map, key) == IF key \in DOMAIN map THEN map[key] ELSE None
MapSet(map, key, value) == [x \in DOMAIN map \cup {key} |-> IF x = key THEN value ELSE map[x]]
MapIncrement(map, key, amount) == [x \in DOMAIN map \cup {key} |-> IF x = key THEN (IF key \in DOMAIN map THEN map[key] ELSE 0) + amount ELSE map[x]]
MapDecrement(map, key, amount) == [x \in DOMAIN map \cup {key} |-> IF x = key THEN (IF key \in DOMAIN map THEN map[key] ELSE 0) - amount ELSE map[x]]
MapRemove(map, key) == [x \in DOMAIN map \ {key} |-> map[x]]
StartsWith(seq, prefix) == /\ Len(prefix) <= Len(seq) /\ SubSeq(seq, 1, Len(prefix)) = prefix
SeqElements(seq) == {seq[i] : i \in 1..Len(seq)}
Count(seq, value) == Cardinality({i \in DOMAIN seq : seq[i] = value})
RECURSIVE SeqRemove(_, _)
SeqRemove(seq, value) == IF Len(seq) = 0 THEN <<>> ELSE IF Head(seq) = value THEN SeqRemove(Tail(seq), value) ELSE <<Head(seq)>> \o SeqRemove(Tail(seq), value)
RECURSIVE SeqRemoveAll(_, _)
SeqRemoveAll(seq, values) == IF Len(values) = 0 THEN seq ELSE SeqRemoveAll(SeqRemove(seq, Head(values)), Tail(values))

