    /\ host_memory_store' = MapRemove(host_memory_store, host_id)
    /\ host_mcp' = MapRemove(host_mcp, host_id)
    /\ host_resolvable_providers' = MapRemove(host_resolvable_providers, host_id)
    /\ host_approval_forwarding' = MapRemove(host_approval_forwarding, host_id)
