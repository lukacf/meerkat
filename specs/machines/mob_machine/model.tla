    /\ supervisor_pending_authority_protocol_version' = pending_protocol_version
    /\ supervisor_pending_authority_operation_id' = pending_operation_id
    /\ supervisor_pending_authority_accepted_peer_ids' = pending_accepted_peer_ids
    /\ supervisor_pending_authority_member_target_names' = pending_member_target_names
    /\ supervisor_pending_authority_member_target_addresses' = pending_member_target_addresses
    /\ UnchangedFrame_5898431fc56e1b3c


