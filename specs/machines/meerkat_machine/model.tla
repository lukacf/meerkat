    /\ phase = "Idle"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (token # "")
    /\ (observed_at_ms > 0)
    /\ (token \in DOMAIN live_webrtc_token_channel_by_token)
    /\ ~((token \in live_webrtc_consumed_tokens))
    /\ ((IF (token \in DOMAIN live_webrtc_token_channel_by_token) THEN Some((IF token \in DOMAIN live_webrtc_token_channel_by_token THEN live_webrtc_token_channel_by_token[token] ELSE "None")) ELSE None) # Some(channel_id))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_webrtc_consumed_tokens' = (live_webrtc_consumed_tokens \cup {token})
    /\ live_webrtc_answer_admission_sequence' = (live_webrtc_answer_admission_sequence) + 1
