    /\ model_step_count' = model_step_count + 1
    /\ channels' = (channels \cup {channel})
    /\ accepting_channels' = (accepting_channels \cup {channel})
    /\ source_accepting_channels' = (source_accepting_channels \cup {channel})
    /\ activation_sequences' = MapSet(activation_sequences, channel, sequence)
