RecoverInputCompletionBoundaryInitializing(input_id, run_id, sequence, boundary, execution_kind) ==
    /\ phase = "Initializing"
    /\ (session_id # None)
    /\ ((input_id \in DOMAIN input_phases) /\ ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") = "Consumed"))
