CallbackPendingCompleted(run_id) ==
    /\ phase = "Running"
    /\ (current_run_id = Some(run_id))
    /\ (turn_phase = "WaitingForOps")
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ turn_phase' = "Completed"
    /\ tool_calls_pending' = 0
    /\ pending_op_refs' = {}
    /\ barrier_operation_ids' = {}
    /\ has_barrier_ops' = FALSE
    /\ barrier_satisfied' = FALSE
    /\ turn_terminal_run_id' = Some(run_id)
    /\ terminal_outcome' = Some("Completed")
