RetireCompletedOpIdle(operation_id, outcome, payload) ==
    /\ phase = "Idle"
    /\ (operation_id \in DOMAIN op_statuses)
    /\ (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Running")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Retiring")))
    /\ (outcome = "Retired")
    /\ (payload.tag = "Retired")
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ op_statuses' = MapSet(op_statuses, operation_id, "Retired")
    /\ op_completion_seq' = MapSet(op_completion_seq, operation_id, (next_completion_seq) + 1)
    /\ completion_sequence_claims' = (completion_sequence_claims \cup {(next_completion_seq) + 1})
    /\ completion_feed_sequences' = IF (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("BackgroundToolOp")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("MobMemberChild")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("DetachedJobWait")))) THEN MapSet(completion_feed_sequences, operation_id, (next_completion_seq) + 1) ELSE completion_feed_sequences
    /\ completion_feed_kinds' = IF (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("BackgroundToolOp")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("MobMemberChild")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("DetachedJobWait")))) THEN MapSet(completion_feed_kinds, operation_id, (IF "value" \in DOMAIN (IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) THEN (IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None)["value"] ELSE None)) ELSE completion_feed_kinds
    /\ completion_feed_terminal_outcomes' = IF (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("BackgroundToolOp")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("MobMemberChild")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("DetachedJobWait")))) THEN MapSet(completion_feed_terminal_outcomes, operation_id, outcome) ELSE completion_feed_terminal_outcomes
    /\ completion_feed_terminal_payload' = IF (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("BackgroundToolOp")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("MobMemberChild")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_kinds) THEN Some((IF operation_id \in DOMAIN op_kinds THEN op_kinds[operation_id] ELSE "None")) ELSE None) = Some("DetachedJobWait")))) THEN MapSet(completion_feed_terminal_payload, operation_id, payload) ELSE completion_feed_terminal_payload
    /\ op_terminal_outcomes' = MapSet(op_terminal_outcomes, operation_id, outcome)
    /\ op_terminal_payload' = MapSet(op_terminal_payload, operation_id, payload)
    /\ active_op_count' = (active_op_count) - 1
