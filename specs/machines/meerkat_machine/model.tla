StageForRunRetired(input_id, run_id) ==
    /\ phase = "Retired"
    /\ ((input_id \in DOMAIN input_phases) /\ ((IF input_id \in DOMAIN input_phases THEN input_phases[input_id] ELSE "None") = "Queued"))
    /\ (input_id \in DOMAIN input_lane)
    /\ (input_id \in DOMAIN input_admission_seq)
    /\ (input_id \in DOMAIN input_recovery_lanes)
    /\ ~((input_id \in DOMAIN input_run_associations))
    /\ ((current_run_id # None) /\ ((IF "value" \in DOMAIN current_run_id THEN current_run_id["value"] ELSE None) = run_id))
    /\ phase' = "Retired"
    /\ model_step_count' = model_step_count + 1
    /\ input_phases' = MapSet(input_phases, input_id, "Staged")
    /\ input_attempt_counts' = MapIncrement(input_attempt_counts, input_id, 1)
    /\ input_run_associations' = MapSet(input_run_associations, input_id, run_id)
    /\ input_lane' = MapRemove(input_lane, input_id)
