RecordLiveWebrtcAnswerAcceptedRunning(arg_session_id, channel_id, answer_observation_sequence) ==
    /\ phase = "Running"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (answer_observation_sequence > 0)
    /\ ((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(channel_id))
    /\ ((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id))
    /\ (IF ~((channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel)) THEN TRUE ELSE (answer_observation_sequence > (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel THEN live_webrtc_answer_observation_sequence_by_channel[channel_id] ELSE 0)) ELSE None) THEN (IF (channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_webrtc_answer_observation_sequence_by_channel THEN live_webrtc_answer_observation_sequence_by_channel[channel_id] ELSE 0)) ELSE None)["value"] ELSE None)))
