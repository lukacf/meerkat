    /\ phase = "Retired"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (close_observation_sequence > 0)
    /\ (IF ~((arg_session_id \in DOMAIN live_active_channel_by_session)) THEN TRUE ELSE ((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(channel_id)))
