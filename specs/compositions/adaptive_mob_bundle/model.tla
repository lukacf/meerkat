       /\ emitted_effects' = emitted_effects \cup { [machine |-> "control_mob", variant |-> "EmitRunLifecycleNotice", payload |-> [tag |-> "unit"], effect_id |-> (model_step_count + 1), source_transition |-> "AuthorizeLoopIterationReducerCommandBodyFrameStarted"] }
       /\ observed_transitions' = observed_transitions \cup {[machine |-> "control_mob", transition |-> "AuthorizeLoopIterationReducerCommandBodyFrameStarted", actor |-> "control_mob_authority", step |-> (model_step_count + 1), from_phase |-> control_mob_phase, to_phase |-> "Running"]}
