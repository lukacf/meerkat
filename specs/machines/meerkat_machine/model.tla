PublishLocalEndpointTerminalSupervisorCleanupRetired(endpoint) ==
    /\ phase = "Retired"
    /\ (IF (supervisor_binding_kind = "Bound") THEN TRUE ELSE (IF (supervisor_revoke_pending_peer_id # None) THEN TRUE ELSE (IF (supervisor_revoked_peer_id # None) THEN TRUE ELSE (supervisor_rotation_phase # None))))
    /\ phase' = "Retired"
