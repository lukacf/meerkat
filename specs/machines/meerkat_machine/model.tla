RecoverOpRecordIdle(operation_id, status, kind, source, peer_ready, progress_count, arg_terminal_outcome, terminal_payload, completion_sequence) ==
    /\ phase = "Idle"
    /\ ~((operation_id \in DOMAIN op_statuses))
    /\ (IF ((IF (status = "Completed") THEN TRUE ELSE (IF (status = "Failed") THEN TRUE ELSE (IF (status = "Aborted") THEN TRUE ELSE (IF (status = "Cancelled") THEN TRUE ELSE (IF (status = "Retired") THEN TRUE ELSE (status = "Terminated")))))) /\ (arg_terminal_outcome # None) /\ (terminal_payload # None) /\ (completion_sequence # None)) THEN TRUE ELSE ((kind = "DetachedJobWait") /\ (status = "Running") /\ (arg_terminal_outcome = None) /\ (terminal_payload = None) /\ (completion_sequence = None)))
    /\ operation_source_valid(source)
    /\ (IF (kind # "DetachedJobWait") THEN TRUE ELSE ((source # None) /\ ((IF "value" \in DOMAIN source THEN source["value"] ELSE None).kind = "DetachedJob")))
    /\ (IF (completion_sequence = None) THEN TRUE ELSE ~(((IF "value" \in DOMAIN completion_sequence THEN completion_sequence["value"] ELSE None) \in completion_sequence_claims)))
    /\ (IF ((kind = "DetachedJobWait") /\ (status = "Running") /\ (arg_terminal_outcome = None)) THEN TRUE ELSE (IF ((status = "Completed") /\ (arg_terminal_outcome = Some("Completed"))) THEN TRUE ELSE (IF ((status = "Failed") /\ (arg_terminal_outcome = Some("Failed"))) THEN TRUE ELSE (IF ((status = "Aborted") /\ (arg_terminal_outcome = Some("Aborted"))) THEN TRUE ELSE (IF ((status = "Cancelled") /\ (arg_terminal_outcome = Some("Cancelled"))) THEN TRUE ELSE (IF ((status = "Retired") /\ (arg_terminal_outcome = Some("Retired"))) THEN TRUE ELSE ((status = "Terminated") /\ (arg_terminal_outcome = Some("Terminated")))))))))
    /\ (IF ((kind = "DetachedJobWait") /\ (status = "Running") /\ (terminal_payload = None)) THEN TRUE ELSE (IF ((status = "Completed") /\ ((IF "value" \in DOMAIN terminal_payload THEN terminal_payload["value"] ELSE None).tag = "Completed")) THEN TRUE ELSE (IF ((status = "Failed") /\ ((IF "value" \in DOMAIN terminal_payload THEN terminal_payload["value"] ELSE None).tag = "Failed")) THEN TRUE ELSE (IF ((status = "Aborted") /\ ((IF "value" \in DOMAIN terminal_payload THEN terminal_payload["value"] ELSE None).tag = "Aborted")) THEN TRUE ELSE (IF ((status = "Cancelled") /\ ((IF "value" \in DOMAIN terminal_payload THEN terminal_payload["value"] ELSE None).tag = "Cancelled")) THEN TRUE ELSE (IF ((status = "Retired") /\ ((IF "value" \in DOMAIN terminal_payload THEN terminal_payload["value"] ELSE None).tag = "Retired")) THEN TRUE ELSE ((status = "Terminated") /\ ((IF "value" \in DOMAIN terminal_payload THEN terminal_payload["value"] ELSE None).tag = "Terminated"))))))))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ op_statuses' = MapSet(op_statuses, operation_id, status)
    /\ op_completion_seq' = IF (completion_sequence # None) THEN MapSet(op_completion_seq, operation_id, (IF "value" \in DOMAIN completion_sequence THEN completion_sequence["value"] ELSE None)) ELSE op_completion_seq
    /\ completion_sequence_claims' = IF (completion_sequence # None) THEN (completion_sequence_claims \cup {(IF "value" \in DOMAIN completion_sequence THEN completion_sequence["value"] ELSE None)}) ELSE completion_sequence_claims
    /\ completion_feed_sequences' = IF ((completion_sequence # None) /\ (IF (kind = "BackgroundToolOp") THEN TRUE ELSE (IF (kind = "MobMemberChild") THEN TRUE ELSE (kind = "DetachedJobWait")))) THEN MapSet(completion_feed_sequences, operation_id, (IF "value" \in DOMAIN completion_sequence THEN completion_sequence["value"] ELSE None)) ELSE completion_feed_sequences
