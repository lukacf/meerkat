ResolveSupervisorCleanupCommandAdmissionAcceptedPendingRevokeIdle(command_kind, supervisor_peer_id, supervisor_epoch, sender_peer_id) ==
    /\ phase = "Idle"
    /\ (command_kind = "Revoke")
