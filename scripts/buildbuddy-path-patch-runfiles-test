#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${RUNFILES_DIR:-}" && -d "${RUNFILES_DIR}/_main" ]]; then
  workspace_root="${RUNFILES_DIR}/_main"
else
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  workspace_root="$(cd -- "${script_dir}/.." && pwd)"
fi

required=(
  "Cargo.toml"
  "Cargo.lock"
  "MODULE.bazel"
  "MODULE.bazel.lock"
  "meerkat-openai/Cargo.toml"
  "scripts/check-public-live-dependency.py"
)

for path in "${required[@]}"; do
  if [[ ! -f "${workspace_root}/${path}" ]]; then
    echo "error: Bazel workspace runfiles omit Cargo path-patch input ${path}" >&2
    exit 1
  fi
done

python3 "${workspace_root}/scripts/check-public-live-dependency.py" "${workspace_root}"
