#!/usr/bin/env python3
"""Check the combined I1-I13 model: RED legs first, then GREEN.

Usage: verify-combined-composition GENERATED_DIRECTORY NEW_RESULT_DIRECTORY [BASE_WORKERS]
Generate with generate-combined-composition first. Every mutant must violate exactly its
attributed invariant or action property with the intended final state (an owner mutant runs
its own module, the combined module over the owner with one guard conjunct removed), every row
must be reachable (its negated end state violated), every liveness mutant must violate its
property with the intended lasso; then the clean bases must pass, together taking every
non-fault action (no base takes a fault-only one; each base's coverage is its last, final TLC
report), every control must pass, and every liveness base must hold its properties. Mutants
and rows run on one worker (their counts depend on the search order); the bases, controls and
liveness profiles may run on more. Generic deadlock checking stays on.
"""

import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

SUMMARY = r'^.*states generated, .*distinct states found, .*states left on queue\.$'
SHARED = {'stage', 'door', 'initial', 'issued', 'issue_count', 'delivery_record', 'gate', 'gate_moves'}
TIMEOUT = 21600


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(path, value):
    path.write_text(json.dumps(value, indent=2) + '\n')


def normalize(name, actions):
    # A per-task step is printed as its parameterized operator (B_LookupOf).
    if name.endswith('Of') and name[:-2] in actions:
        return name[:-2]
    return name


def parse_fields(block):
    # One state's block: `/\ var = value` lines, values wrapped over several lines; the
    # block ends at its first blank line.
    fields, current = {}, None
    for line in block.splitlines():
        if not line.strip():
            if fields:
                break
            continue
        match = re.match(r'^/\\ (\w+) = (.*)$', line)
        if match:
            current = match[1]
            fields[current] = match[2].strip()
        elif current is not None:
            fields[current] += ' ' + line.strip()
    return {name: re.sub(r'\s+', ' ', value) for name, value in fields.items()}


def final_state(text, known):
    states = re.split(r'^State \d+:.*\n', text, flags=re.MULTILINE)[1:]
    if not states:
        states = re.split(r'^Error: Invariant \w+ is violated by the initial state:\n', text,
                          flags=re.MULTILINE)[1:]
    if not states:
        raise ValueError('missing counterexample')
    fields = parse_fields(states[-1].split('\n\n', 1)[0])
    actions = [normalize(a, known) for a in re.findall(r'^State \d+: <(\w+)', text, re.MULTILINE)]
    return fields, actions


def records(value):
    return [dict(re.findall(r'(\w+) \|-> ("[^"]*"|\{[^}]*\}|\w+)', body))
            for body in re.findall(r'\[([^\]]*)\]', value or '')]


def seq(value):
    inner = (value or '').strip()
    if not (inner.startswith('<<') and inner.endswith('>>')):
        return []
    inner = inner[2:-2].strip()
    return [item.strip().strip('"') for item in inner.split(',')] if inner else []


def counts(value):
    rows = records(value)
    return {key: int(number) for key, number in rows[0].items()} if rows else {}


def strings(value):
    return set(re.findall(r'"([^"]*)"', value or ''))


def tuples(value):
    # The elements of a printed set of tuples, each as a list of plain values.
    return [[item.strip().strip('"') for item in body.split(',')]
            for body in re.findall(r'<<([^<>]*)>>', value or '')]


def after_index(actions, later, earlier):
    if earlier not in actions:
        return False
    return later in actions[actions.index(earlier) + 1:]


def q(value):
    return (value or '').strip('"')


def attempt_checks(fields, actions):
    """The attempt model's predicates, over its variables inside the combined model."""
    def f(name):
        return fields.get(name if name in SHARED else 'a_' + name)
    acts = [a.removeprefix('A_') for a in actions]
    a_stage = f('stage') == '"A"'
    first, ended, effect, wrote = seq(f('firstw')), seq(f('ended')), seq(f('effect')), seq(f('wrote'))

    def g3(funnel, site, attempt, door, last, first_site=None):
        return (a_stage and f('door') == f'"{door}"' and acts[-1] == last
                and f('witness') == f'{{<<"{funnel}", "{site}", {attempt}>>}}' and f('silent') == '{}'
                and len(first) >= attempt and first[attempt - 1] == (first_site or site))

    def after(site, attempt_end, door):
        return (a_stage and f('door') == f'"{door}"' and f('attempt') == '2' and first[1:2] == [site]
                and ended[:1] == [attempt_end])

    def held(door, site, initial):
        return (a_stage and f('door') == f'"{door}"' and f('initial') == f'"{initial}"'
                and fields.get('a_held') == f'"{site}"')

    checks = {
        'a-drop-controller-mark': g3('grants.change', 'FI:533', 1, 'Find', 'WriterIssue')
            and [r.get('vis') for r in records(f('bw'))] == ['1'],
        'a-silent-blocking-writer': a_stage and f('silent') == '{"FI:533"}' and f('witness') == '{}'
            and acts[-1] == 'WriterIssue' and [r.get('vis') for r in records(f('bw'))] == ['0'],
        'a-drop-callback-mark': g3('grants.change', 'callbacks.rs:106', 1, 'ClassInput', 'InlineWrite'),
        'a-drop-service-setup-mark': g3('grants.change', 'service.rs:325', 1, 'BatchSetup', 'InlineWrite'),
        'a-drop-first-binding-mark': f('initial') == '"Partial"'
            and g3('toolkit_store.compare_and_swap', 'PO:1610', 1, 'Find', 'InlineWrite'),
        'a-drop-first-binding-mark-after-drop': f('initial') == '"First"'
            and g3('toolkit_store.compare_and_swap', 'PO:1610', 2, 'Find', 'InlineWrite') and 'DropBind' in acts,
        'a-nested-fresh-attempt': a_stage and f('door') == '"Console"' and f('pc') == '"P"' and f('nested') == '2'
            and effect == ['console.source_record', ''] and f('witness') == '{}' and f('backstop') == 'FALSE',
        'a-peer-entry-unmarked': a_stage and f('door') == '"Peer"' and f('pc') == '"P"' and f('attempt') == '2'
            and f('offers') == '2' and effect[:2] == ['peer.operation_grant', ''] and wrote[:2] == ['TRUE', 'TRUE']
            and first[:2] == ['PI:872-876', ''] and f('witness') == '{}' and f('silent') == '{}'
            and 'PeerRecord' in acts,
        'a-spawned-writer': a_stage and f('silent') == '{"spawned_task"}' and f('witness') == '{}'
            and acts[-1] == 'SpawnedWrite',
        'a-early-decision': a_stage and f('misplaced') == '{"FI:533"}' and acts[-1] == 'WriterIssue',
        'a-late-not-now': a_stage and f('answer') == '"NotNow"' and f('pc') == '"Answered"'
            and f('decided') == '<<"original.admitted", "">>' and acts[-1] == 'PostWrites',
        'a-duplicate-issue': a_stage and counts(f('issue_count')).get('controller_grant') == 2 and 'DropBind' in acts,
        'a-drop-configured-setup-mark': g3('toolkit_store.compare_and_swap', 'configured_setup.rs:414', 1,
                                           'ConfiguredSetup', 'InlineWrite'),
        'a-drop-setup-request-grant-mark': g3('grants.change', 'setup_request.rs:318', 1, 'SetupRequest',
                                              'WriterIssue'),
        'a-drop-native-root-mark': g3('grants.change', 'native_operations.rs:894', 1, 'FindNative', 'WriterIssue'),
        'a-drop-peer-operation-and-entry-note': g3('grants.change', 'peer_ingress.rs:615', 1, 'Peer', 'WriterIssue',
                                                   first_site='PI:872-876') and f('offers') == '1',
        'a-drop-configured-setup-grant-mark': g3('grants.change', 'configured_setup.rs:293', 2, 'ConfiguredSetup',
                                                 'WriterIssue') and ended[:1] == ['Gone']
            and acts[acts.index('DropBind') - 1] == 'InlineWrite',
        'a-drop-setup-target-mark-configured': g3('grants.change', 'setup_targets.rs:154', 2, 'ConfiguredSetup',
                                                  'WriterIssue') and ended[:1] == ['Gone'],
        'a-drop-setup-target-mark-request': g3('grants.change', 'setup_targets.rs:154', 2, 'SetupRequest',
                                               'WriterIssue') and ended[:1] == ['Gone'],
        'a-drop-native-child-mark': g3('grants.change', 'native_operations.rs:938', 2, 'FindNative', 'WriterIssue')
            and ended[:1] == ['Gone'] and 'WriterFail' in acts,
        'a-drop-native-child-mark-after-crash': g3('grants.change', 'native_operations.rs:938', 2, 'FindNative',
                                                   'WriterIssue') and ended[:1] == ['Crashed'],
        'a-drop-callback-leaf-mark': g3('grants.change', 'callbacks.rs:165', 2, 'ClassInput', 'InlineWrite')
            and ended[:1] == ['Refused'] and 'InlineFail' in acts,
        'a-drop-callback-leaf-mark-after-crash': g3('grants.change', 'callbacks.rs:165', 2, 'ClassInput',
                                                    'InlineWrite') and ended[:1] == ['Crashed'],
        'a-drop-class-input-mark': g3('toolkit_store.compare_and_swap', 'class_input.rs:284', 1, 'ClassInput',
                                      'InlineWrite') and f('initial') == '"Shared"',
        'a-drop-class-input-mark-after-refusal': g3('toolkit_store.compare_and_swap', 'class_input.rs:284', 2,
                                                    'ClassInput', 'InlineWrite')
            and ended[:1] == ['Refused'] and 'InlineFail' in acts,
        'a-drop-native-child-mark-shared': g3('grants.change', 'native_operations.rs:938', 1, 'FindNative',
                                              'WriterIssue') and f('initial') == '"Shared"'
            and 'DropBind' not in acts and 'WriterFail' not in acts,
        'a-drop-service-observation-mark': g3('toolkit_store.compare_and_swap', 'service.rs:379', 2, 'BatchSetup',
                                              'InlineWrite') and ended[:1] == ['Refused'] and 'InlineFail' in acts,
        'a-drop-service-observation-mark-after-crash': g3('toolkit_store.compare_and_swap', 'service.rs:379', 2,
                                                          'BatchSetup', 'InlineWrite') and ended[:1] == ['Crashed'],
        'a-notnow-after-failed-write': a_stage and f('backstop') == 'TRUE' and f('door') == '"ClassInput"'
            and effect[:1] == ['original.class_input'] and wrote[:1] == ['FALSE'] and acts[-1] == 'Handle'
            and 'InlineFail' in acts,
        'a-refused-waits': a_stage and f('pc') == '"MetaWait"' and f('answer') == '"Refused"'
            and wrote[:1] == ['TRUE'] and acts[-1] == 'Handle' and 'InlineFail' in acts,
        'row-class-first-send-a': a_stage and f('door') == '"ClassInput"' and f('outcome') == '"Admitted"'
            and f('waited') == 'TRUE' and f('notnow_seen') == 'FALSE' and f('attempt') == '1'
            and effect == ['original.callback_grant', ''],
        'row-batch-first-send-a': a_stage and f('door') == '"BatchSetup"' and f('outcome') == '"Admitted"'
            and f('waited') == 'TRUE' and f('notnow_seen') == 'FALSE' and f('attempt') == '1'
            and effect == ['original.service_setup_grant', ''],
        'row-bound-resend-a': a_stage and f('door') == '"Find"' and f('outcome') == '"Admitted"'
            and f('notnow_seen') == 'TRUE' and f('attempt') == '2',
        'row-orphan-duplicate': a_stage and f('dup_refused') == 'TRUE'
            and counts(f('issue_count')).get('controller_grant') == 1 and f('outcome') == '"Refused"'
            and 'DropBind' in acts,
        'row-orphan-duplicate-retry': a_stage and f('dup_refused') == 'TRUE'
            and counts(f('issue_count')).get('controller_grant') == 1 and f('outcome') == '"Admitted"'
            and f('attempt') == '3' and 'DropBind' in acts,
        'row-leaf-first-after-refusal': after('callbacks.rs:165', 'Refused', 'ClassInput') and 'InlineFail' in acts,
        'row-leaf-first-after-crash': after('callbacks.rs:165', 'Crashed', 'ClassInput'),
        'row-native-child-first-after-drop': after('native_operations.rs:938', 'Gone', 'FindNative')
            and 'WriterFail' in acts,
        'row-native-child-first-after-crash': after('native_operations.rs:938', 'Crashed', 'FindNative'),
        'row-configured-targets-first-after-drop': after('setup_targets.rs:154', 'Gone', 'ConfiguredSetup'),
        'row-request-targets-first-after-drop': after('setup_targets.rs:154', 'Gone', 'SetupRequest'),
        'row-configured-grant-first-after-drop': after('configured_setup.rs:293', 'Gone', 'ConfiguredSetup'),
        'row-class-selection-first-shared': a_stage and f('initial') == '"Shared"'
            and f('door') in ('"ClassInput"', '"ClassNative"') and f('attempt') == '1'
            and first[:1] == ['class_input.rs:284'],
        'row-class-selection-first-after-refusal': after('class_input.rs:284', 'Refused', 'ClassInput')
            and 'InlineFail' in acts,
        'row-native-child-first-shared': a_stage and f('initial') == '"Shared"' and f('door') == '"FindNative"'
            and f('attempt') == '1' and first[:1] == ['native_operations.rs:938'],
        'row-service-observation-first-after-refusal': after('service.rs:379', 'Refused', 'BatchSetup')
            and 'InlineFail' in acts,
        'row-service-observation-first-after-crash': after('service.rs:379', 'Crashed', 'BatchSetup'),
    }
    for door in ['Find', 'Launch']:
        for site in ['P', 'A']:
            for initial in ['First', 'Partial', 'Bound']:
                checks[f'row-held-a-{door.lower()}-{site.lower()}-{initial.lower()}'] = held(door, site, initial)
    return checks


def stage_b_checks(f, actions):
    last = actions[-1] if actions else 'Initial'
    b = f.get('stage') == '"B"'
    procs = records(f.get('sp'))
    journal = records(f.get('jr'))
    preps = records(f.get('prep'))
    native = tuples(f.get('native'))
    # Core's admissions as <<session, raw key, epoch>> (the admitting dispatch dropped).
    keys3 = [t[:3] for t in native]
    refused = tuples(f.get('refusals'))
    issue_once = all(v <= 1 for v in counts(f.get('issue_count')).values())

    def proc(**want):
        return any(all(q(p.get(k)) == v for k, v in want.items()) for p in procs)

    def jr(slot, key):
        return q(journal[slot - 1].get(key)) if len(journal) >= slot else ''

    def o(slot, field):
        return q(f.get(('offer_' if slot == 1 else 'offer2_') + field))

    def phase(slot):
        return o(slot, 'phase')

    def admitted(slot):
        return phase(slot) == 'CoreObserved' and o(slot, 'receipt_kind') in ('Admitted', 'Found')

    def not_admitted(slot):
        return phase(slot) == 'CoreObserved' and o(slot, 'receipt_kind') in ('CoreRefused', 'EntryRefused')

    def num(slot, field):
        value = o(slot, field)
        return int(value) if value.isdigit() else -1

    def before_last(earlier, later):
        # `earlier` occurs before the last occurrence of `later`.
        if later not in actions:
            return False
        cut = len(actions) - 1 - actions[::-1].index(later)
        return earlier in actions[:cut]

    def held(door, site, initial):
        return (b and q(f.get('door')) == door and q(f.get('initial')) == initial and q(f.get('held_site')) == site
                and proc(pc='MetaWait', cause='SourceHeld') and last == f'B_Decide{site}')

    checks = {
        'block-in-protected': b and f.get('gate') == '"Held"'
            and any(q(p.get('pc')) in ('DecideP', 'DecideA') for p in procs) and f.get('meta_holder') != '0',
        'stale-snapshot': b and last == 'B_CommitStore' and phase(1) == 'Offered'
            and f.get('src_readiness') == '"ClosedToOffers"' and f.get('offer_source_revision') != jr(1, 'crev'),
        'cached-incarnation': b and last == 'B_CommitStore' and phase(1) == 'Offered'
            and f.get('current_inc') == '"inc2"' and f.get('offer_incarnation') == '"inc1"' and jr(1, 'cinc') == 'inc2',
        'fresh-key-replay': b and last == 'B_Entry' and f.get('epoch') == '2' and 'B_Crash' in actions
            and any(t[1] == 'k3' for t in native) and proc(kind='driver', key='k3'),
        'dispatch-current-session': b and last == 'B_Entry' and ['inc2', 'k1', '1'] in keys3
            and f.get('offer_incarnation') == '"inc1"' and 'B_ReplaceSession' in actions,
        # The first send ended Held; the next send prepares a second offer instead of the kept one.
        'replay-reprepares': b and last == 'B_Create' and phase(1) == 'Offered' and phase(2) == 'Prepared'
            and 'B_MetaExpire' in actions,
        'lost-reply-reprepare': b and last == 'B_Create' and phase(1) == 'Offered' and phase(2) == 'Prepared'
            and f.get('lost_reply_seen') == 'TRUE' and 'B_ReadBack' in actions,
        'effects-before-owner': b and last == 'B_PrepIssue' and phase(1) == 'Absent' and phase(2) == 'Absent'
            and f.get('issued') not in (None, '{}'),
        'send-before-owner': b and last == 'B_Call' and phase(1) == 'Prepared' and proc(pc='Lock'),
        # Meta called (the protected section entered) without the dispatch start recorded.
        'call-without-dispatch-record': b and last == 'B_Call' and phase(1) == 'Offered' and proc(pc='Lock')
            and num(1, 'dispatch_count') == 0,
        'commit-without-outbox': b and last == 'B_CommitStore' and phase(1) == 'Offered' and jr(1, 'outbox') == 'FALSE',
        'discard-clears-obligation': b and last == 'B_PeerExpire' and f.get('door') == '"Peer"'
            and phase(1) == 'Offered' and jr(1, 'outbox') == 'FALSE' and jr(1, 'fifo') == 'FALSE',
        'refusal-as-notnow': b and last in ('B_DecideP', 'B_DecideA') and f.get('auth_ok') == 'FALSE'
            and proc(cause='PolicyDenied', dec='NotNow'),
        'closed-as-notnow': b and last in ('B_DecideP', 'B_DecideA') and f.get('src_readiness') == '"ClosedToOffers"'
            and proc(cause='SourceClosed', dec='NotNow'),
        'held-before-closed': b and last in ('B_DecideP', 'B_DecideA') and f.get('gate') == '"Held"'
            and f.get('src_readiness') == '"ClosedToOffers"' and proc(cause='SourceHeld', dec='NotNow'),
        'untyped-commit-refusal': b and last == 'B_CommitRefuse' and phase(1) == 'Withdrawn'
            and f.get('auth_ok') == 'FALSE' and proc(out='Refused', cause='None'),
        'drop-retry-owner': b and last in ('B_DecideP', 'B_DecideA') and proc(out='NotNow', cause='SourceHeld'),
        'discard-parked': b and last == 'B_PeerExpire' and f.get('door') == '"Peer"' and phase(1) == 'Offered'
            and jr(1, 'pend') == 'TRUE' and jr(1, 'fifo') == 'FALSE' and jr(1, 'outbox') == 'TRUE',
        # Two peer binds of the session live at once: the drain ignored.
        'peer-binds-concurrently': b and f.get('door') == '"Peer"'
            and sum(1 for p in procs if q(p.get('pc')) not in ('Idle', 'Done')) == 2,
        'forge-admission': b and last == 'B_ObserveRead' and admitted(1) and native == []
            and f.get('published_read') == '"Unread"',
        'forget-lost-reply': b and last == 'B_Settle' and phase(1) == 'Offered' and proc(out='Unresolved')
            and ['inc1', 'k1', '1'] in keys3 and jr(1, 'read_owed') == 'FALSE',
        # A read taken before the re-drive's admission, whose answer was lost, clears the read
        # owed after that loss.
        'stale-read-clears': b and last == 'B_ObserveRead' and phase(1) == 'Offered' and proc(out='Unresolved')
            and any(t[1] == 'k1' for t in native) and jr(1, 'read_owed') == 'FALSE',
        'drop-mutates-phase': b and last == 'B_DropSend' and phase(1) == 'Withdrawn' and proc(out='Gone'),
        'drop-clears-seal': b and last == 'B_DropSend' and phase(1) == 'Prepared'
            and f.get('offer_preparation_receipt') == '""' and f.get('offer_revision') == '2' and proc(out='Gone'),
        'cached-authority': b and last == 'B_Entry' and f.get('admitted_stale') == 'TRUE'
            and f.get('auth_ok') == 'FALSE' and proc(waited='TRUE') and 'B_Revoke' in actions
            and 'B_MetaRebind' in actions,
        'entry-without-fence': b and last == 'B_Entry' and f.get('admitted_stale') == 'TRUE'
            and f.get('auth_ok') == 'FALSE' and after_index(actions, 'B_Revoke', 'B_Lock'),
        'publication-inside-store': b and last == 'B_StoreBegin' and f.get('store_pc') == '"hook"'
            and f.get('conn_holder') == '"store"',
        'skip-restart-scan': b and last == 'B_Scan' and f.get('epoch') == '2' and phase(1) == 'Offered'
            and jr(1, 'parked') == 'FALSE' and jr(1, 'outbox') == 'TRUE',
        'scan-first-record-only': b and last == 'B_Scan' and f.get('epoch') == '2' and phase(2) == 'Offered'
            and jr(2, 'parked') == 'FALSE' and jr(2, 'outbox') == 'TRUE' and phase(1) == 'CoreObserved',
        'admit-after-close': b and f.get('life_phase') == '"Closing"' and f.get('entered_after_close') == 'TRUE',
        'close-without-join': b and last == 'B_LifeSettle' and f.get('life_phase') == '"Closed"'
            and f.get('joined') == 'FALSE',
        'close-forgets-unresolved': b and last == 'B_LifeSettle' and f.get('life_phase') == '"Closed"'
            and f.get('joined') == 'TRUE' and phase(1) == 'Offered' and num(1, 'close_epoch') == 0,
        'close-skips-preparers': b and last == 'B_LifeSettle' and f.get('life_phase') == '"Closed"'
            and f.get('joined') == 'TRUE' and any(q(p.get('st')) == 'Running' for p in preps),
        'omit-driver-undeclared': b and f.get('mode') == '"undeclared"' and phase(1) == 'Offered'
            and last == 'B_CommitStore',
        # The declared fixture's stand-in claims a production admission.
        'fixture-claims': b and f.get('mode') == '"fixture"' and f.get('claimed') == 'TRUE' and admitted(1)
            and 'B_FixtureCall' in actions,
        # An Unavailable read published as Absent discharges the read owed after a lost answer:
        # the record is kept with nothing owed over Core's admission, with a false final absence.
        'unavailable-as-absent': b and last == 'B_ObserveRead' and f.get('epoch') == '1' and phase(1) == 'Offered'
            and num(1, 'absence_through') == 1 and ['inc1', 'k1', '1'] in keys3 and jr(1, 'read_owed') == 'FALSE',
        # An Absent read fed as Core's refusal of the last open dispatch: the receipt names a
        # refusal Core never made.
        'absent-terminates': b and last == 'B_ObserveRead' and not_admitted(1)
            and o(1, 'receipt_kind') == 'CoreRefused' and refused == [] and 'B_Crash' in actions,
        # A lost answer fed as not submitted; a later fence refusal settles against Core.
        'lost-as-not-submitted': b and not_admitted(1) and ['inc1', 'k1', '1', '1'] in native
            and o(1, 'receipt_kind') == 'EntryRefused' and num(1, 'receipt_dispatch') == 2,
        # The owner settles a refusal while another dispatch of the key is open (owner mutant).
        'notadmitted-while-inflight': b and not_admitted(1) and ['inc1', 'k1', '1'] in keys3
            and f.get('core_refusals') == '1',
        # Admitted in the ended process, the answer lost; the restart answers that dispatch as not
        # submitted and the re-drive's fence refusal settles the record NotAdmitted.
        'crash-clears-ambiguity': b and last == 'B_Settle' and not_admitted(1) and ['inc1', 'k1', '1'] in keys3
            and f.get('epoch') == '2' and proc(out='Refused', cause='EntryRefused') and 'B_ForgetAmbiguity' in actions,
        # The fence's refusal recorded as Core's.
        'receipt-wrong-kind': b and last == 'B_Settle' and not_admitted(1) and o(1, 'receipt_kind') == 'CoreRefused'
            and ['1', '1', 'EntryRefused'] in refused,
        # A volatile or supervisor drop fed as Core's refusal: a native verdict from a transport end.
        'drop-as-verdict': b and last == 'B_Settle' and f.get('door') == '"Peer"' and not_admitted(1)
            and refused == [] and 'B_PeerExpire' in actions,
        # The final absence recorded at the restart's read, the re-drive still owed (owner mutant).
