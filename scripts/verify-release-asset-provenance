#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: verify-release-asset-provenance [--recovery-source <sha> | --source-run <run-id> [--source-attempt <n>] [--source-gate <job>] [--prebuild]] [--stamps <dir>] <artifact-dir> <release-tag> [signer-workflow]

Verify every release archive in artifact-dir against GitHub's signed build
provenance. signer-workflow defaults to the release workflow.

Default (tag push, or a dispatch on the tag ref): the certificate-bound
source repository digest must equal the commit named by release-tag.

--recovery-source <sha> --stamps <dir>: an asset recovery dispatched from
main runs main's workflow at <sha> and checks out the tag, so the
attestations name <sha> (the run's commit), not the tag. Then every archive
must be attested by the release workflow with source digest <sha> and source
ref refs/heads/main, and must have exactly one <archive>.source-commit stamp
under <dir>, itself attested the same way, whose content is the tag's commit
(written by the build job after it checked that its checkout is the tag).

--source-run <run-id> --stamps <dir>: publish the archives of an earlier
asset recovery run without rebuilding. The run must be this repository's
release.yml, dispatched on main, at a commit in main's history, and its
Release binary build gate job (or the job named by --source-gate, for
example "Release critical binary build gate" when only the critical
platforms' archives are verified) must have succeeded; its head_sha becomes the
recovery source above. A run built before archives were stamped
has no stamps: then the tag must be an ancestor of that head_sha and every
path changed between them must be under .github/ or CHANGELOG.md, so the
compiled sources are the tag's whichever of the two trees the run checked out.

--source-attempt <n> pins the run attempt whose jobs are checked, and refuses
the run if it was re-run since (its latest attempt is not <n>).

A pre-tag prebuild run (one with a "Release prebuild gate" job) never waited
for exact-main CI, so it is refused as a source run unless --prebuild says the
caller is a tag run that requires that CI itself: GITHUB_REF must be
refs/tags/<release-tag>, the run's Release prebuild gate must have succeeded,
and the run's head must be the tag commit itself or an ancestor whose
prebuild serves it (scripts/release-prebuild-equivalent: every path changed
since is a non-input of Core's release artifacts). The stamps then name the
run's head.
EOF
  exit 2
}

recovery_source=""
source_run=""
source_gate="Release binary build gate"
source_attempt=""
prebuild=false
stamps_dir=""
stamped_source=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --recovery-source)
      recovery_source="${2:?--recovery-source requires a commit}"
      shift 2
      ;;
    --source-run)
      source_run="${2:?--source-run requires a run id}"
      shift 2
      ;;
    --source-gate)
      source_gate="${2:?--source-gate requires a job name}"
      shift 2
      ;;
    --prebuild)
      prebuild=true
      shift
      ;;
    --source-attempt)
      source_attempt="${2:?--source-attempt requires an attempt number}"
      shift 2
      ;;
    --stamps)
      stamps_dir="${2:?--stamps requires a directory}"
      shift 2
      ;;
    --*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

[[ "$#" -ge 2 && "$#" -le 3 ]] || usage
if [[ -n "${source_run}" ]]; then
  [[ -z "${recovery_source}" ]] || { echo "--source-run and --recovery-source are exclusive" >&2; exit 2; }
  [[ "${source_run}" =~ ^[0-9]+$ ]] || { echo "--source-run must be a run id: ${source_run}" >&2; exit 2; }
  repository_for_run="${GITHUB_REPOSITORY:-lukacf/meerkat}"
  run_meta="$(gh api "repos/${repository_for_run}/actions/runs/${source_run}" \
    --jq '[.path, .event, .head_branch, .head_sha, .repository.full_name, .run_attempt] | @tsv')"
  IFS=$'\t' read -r run_path run_event run_branch run_sha run_repo run_attempt <<<"${run_meta}"
  jobs_path="repos/${repository_for_run}/actions/runs/${source_run}/jobs?per_page=100"
  if [[ -n "${source_attempt}" ]]; then
    [[ "${source_attempt}" =~ ^[0-9]+$ ]] || { echo "--source-attempt must be a number: ${source_attempt}" >&2; exit 2; }
    if [[ "${run_attempt}" != "${source_attempt}" ]]; then
      echo "run ${source_run} is at attempt ${run_attempt}, not the pinned attempt ${source_attempt}" >&2
      exit 1
    fi
    jobs_path="repos/${repository_for_run}/actions/runs/${source_run}/attempts/${source_attempt}/jobs?per_page=100"
  fi
  if [[ "${run_path}" != ".github/workflows/release.yml" || "${run_event}" != "workflow_dispatch" \
        || "${run_branch}" != "main" || "${run_repo}" != "${repository_for_run}" ]]; then
    echo "run ${source_run} is not a release.yml workflow_dispatch on main in ${repository_for_run} (path=${run_path} event=${run_event} branch=${run_branch} repo=${run_repo})" >&2
    exit 1
  fi
  git merge-base --is-ancestor "${run_sha}" HEAD || {
    echo "run ${source_run} commit ${run_sha} is not in the checked-out main history" >&2
    exit 1
  }
  # That run's own build gate covers what this run skips: every lane built,
  # each binary embedded the version, Windows binaries ran on Windows.
  case "${source_gate}" in
    "Release binary build gate"|"Release critical binary build gate") ;;
    *) echo "--source-gate must name a release binary build gate job: ${source_gate}" >&2; exit 2 ;;
  esac
  jobs_json="$(gh api "${jobs_path}" --paginate \
    --jq '.jobs[] | [.name, (.conclusion // "pending")] | @tsv')"
  build_gate="$(awk -F '\t' -v name="${source_gate}" '$1 == name { print $2 }' <<<"${jobs_json}")"
  if [[ "${build_gate}" != "success" ]]; then
    echo "run ${source_run}: ${source_gate} did not succeed (${build_gate:-absent})" >&2
    exit 1
  fi
  # A prebuild never waited for exact-main CI: only a tag run, which required
  # that CI itself, may publish its archives, and only of the tag commit or
  # of an ancestor whose prebuild serves it.
  # Every release.yml dispatch lists the gate, but only a prebuild runs it
  # (its always() condition never skips there): a skipped gate marks an
  # ordinary dispatch, whose archives an asset recovery may reuse.
  prebuild_gate="$(awk -F '\t' '$1 == "Release prebuild gate" { print $2 }' <<<"${jobs_json}")"
  if [[ -n "${prebuild_gate}" && "${prebuild_gate}" != "skipped" && "${prebuild}" != "true" ]]; then
    echo "run ${source_run} is a pre-tag prebuild; only a tag run may publish its archives (--prebuild)" >&2
    exit 1
  fi
  if [[ "${prebuild}" == "true" ]]; then
    tag_commit="$(git rev-parse "${2:-}^{commit}" 2>/dev/null || true)"
    if [[ "${prebuild_gate}" != "success" ]]; then
      echo "run ${source_run}: --prebuild needs a successful Release prebuild gate (${prebuild_gate:-absent})" >&2
      exit 1
    fi
    if [[ "${GITHUB_REF:-}" != "refs/tags/${2:-}" ]]; then
      echo "--prebuild is accepted only in the tag run of ${2:-the release tag} (GITHUB_REF=${GITHUB_REF:-unset})" >&2
      exit 1
    fi
    if [[ "${run_sha}" != "${tag_commit}" ]]; then
      if ! equivalence="$("$(dirname "${BASH_SOURCE[0]}")/release-prebuild-equivalent" "${run_sha}" "${tag_commit:-unknown}" 2>&1)"; then
        echo "run ${source_run} built ${run_sha}, not the ${2:-} commit ${tag_commit:-unknown}, and that prebuild does not serve it:" >&2
        echo "${equivalence}" >&2
        exit 1
      fi
      echo "${equivalence}"
    fi
    # The prebuild stamped its own checkout: the tag commit or that ancestor.
    stamped_source="${run_sha}"
  fi
  recovery_source="${run_sha}"
  echo "source run ${source_run}: release.yml on main at ${run_sha}, ${source_gate} passed"
fi
if [[ -n "${recovery_source}" || -n "${stamps_dir}" ]]; then
  [[ "${recovery_source}" =~ ^[0-9a-f]{40}$ ]] || {
    echo "--recovery-source must be a full commit sha: ${recovery_source}" >&2
    exit 2
  }
  [[ -d "${stamps_dir}" ]] || {
    echo "--stamps directory does not exist: ${stamps_dir}" >&2
    exit 2
  }
fi

artifact_dir="$1"
release_tag="$2"
signer_workflow="${3:-github.com/${GITHUB_REPOSITORY:-lukacf/meerkat}/.github/workflows/release.yml}"
repository="${GITHUB_REPOSITORY:-lukacf/meerkat}"

[[ -d "${artifact_dir}" ]] || {
  echo "release artifact directory does not exist: ${artifact_dir}" >&2
  exit 1
}
[[ "${release_tag}" == v* ]] || {
  echo "release tag must start with v: ${release_tag}" >&2
  exit 1
}
command -v gh >/dev/null 2>&1 || {
  echo "gh is required to verify release attestations" >&2
  exit 1
}

release_sha="$(git rev-parse "${release_tag}^{commit}")"
[[ "${release_sha}" =~ ^[0-9a-f]{40}$ ]] || {
  echo "release tag did not resolve to a commit: ${release_tag}" >&2
  exit 1
}

archives=()
while IFS= read -r -d '' archive; do
  archives+=("${archive}")
done < <(find "${artifact_dir}" -type f \( -name '*.tar.gz' -o -name '*.zip' \) -print0)

if [[ "${#archives[@]}" -eq 0 ]]; then
  echo "no release archives found under ${artifact_dir}" >&2
  exit 1
fi

if [[ -z "${recovery_source}" ]]; then
  for archive in "${archives[@]}"; do
    gh attestation verify "${archive}" \
      --repo "${repository}" \
      --source-digest "${release_sha}" \
      --signer-workflow "${signer_workflow}" \
      >/dev/null
    echo "verified release provenance: $(basename "${archive}") <- ${release_sha}"
  done
  echo "Verified ${#archives[@]} release archive attestations for ${release_tag} at ${release_sha}"
  exit 0
fi

verify_recovery_attestation() {
  gh attestation verify "$1" \
    --repo "${repository}" \
    --source-digest "${recovery_source}" \
    --source-ref refs/heads/main \
    --signer-workflow "${signer_workflow}" \
    >/dev/null
}

stamp_count="$(find "${stamps_dir}" -type f -name '*.source-commit' | wc -l | tr -d ' ')"
if [[ "${stamp_count}" -eq 0 && -n "${source_run}" ]]; then
  # A run from before archives were stamped: prove the compiled sources do
  # not depend on which of the tag and the run's commit it checked out.
  git merge-base --is-ancestor "${release_sha}" "${recovery_source}" || {
    echo "${release_tag} (${release_sha}) is not an ancestor of the run commit ${recovery_source}" >&2
    exit 1
  }
  changed="$(git diff --name-only "${release_sha}" "${recovery_source}")"
  outside="$(grep -vE '^(\.github/|CHANGELOG\.md$)' <<<"${changed}" || true)"
  if [[ -n "${outside}" ]]; then
    echo "run ${source_run} has no source stamps and its commit changes build inputs since ${release_tag}:" >&2
    echo "${outside}" >&2
    exit 1
  fi
  for archive in "${archives[@]}"; do
    verify_recovery_attestation "${archive}"
    echo "verified recovery provenance: $(basename "${archive}") <- release.yml@${recovery_source} (refs/heads/main), sources identical to ${release_tag}"
  done
  echo "Verified ${#archives[@]} archive attestations of run ${source_run} for ${release_tag}: built by release.yml at ${recovery_source}; ${release_tag}..${recovery_source} changes only:"
  echo "${changed:-<nothing>}" | sed 's/^/  /'
  exit 0
fi

# Each stamp names the tree its build job checked out: the tag commit, or a
# prebuild's own commit (checked above to be the tag commit or to serve it).
expected_source="${stamped_source:-${release_sha}}"
for archive in "${archives[@]}"; do
  name="$(basename "${archive}")"
  verify_recovery_attestation "${archive}"
  stamps=()
  while IFS= read -r -d '' stamp; do
    stamps+=("${stamp}")
  done < <(find "${stamps_dir}" -type f -name "${name}.source-commit" -print0)
  if [[ "${#stamps[@]}" -ne 1 ]]; then
    echo "${name}: expected exactly one ${name}.source-commit stamp under ${stamps_dir}, found ${#stamps[@]}" >&2
    exit 1
  fi
  verify_recovery_attestation "${stamps[0]}"
  stamped="$(tr -d '[:space:]' < "${stamps[0]}")"
  if [[ "${stamped}" != "${expected_source}" ]]; then
    if [[ "${expected_source}" == "${release_sha}" ]]; then
      echo "${name}: built from ${stamped}, expected the ${release_tag} commit ${release_sha}" >&2
    else
      echo "${name}: built from ${stamped}, expected the prebuild's commit ${expected_source}, which serves ${release_tag}" >&2
    fi
    exit 1
  fi
  echo "verified recovery provenance: ${name} <- release.yml@${recovery_source} (refs/heads/main), source tree ${expected_source}"
done
echo "Verified ${#archives[@]} recovery archive attestations for ${release_tag}: built by release.yml at ${recovery_source} from the ${expected_source} tree"
