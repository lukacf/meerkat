crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
# These crates are optional in Cargo and enabled only by the generated Bazel
# feature union for `meerkat-live`. Resolve that union in a separate generated
# repository so crate_universe never writes its synthetic direct-dependency
# package into Cargo's authoritative workspace lockfile.
crate.spec(package = "bytes", repositories = ["meerkat_live_crates"], version = "=1.11.1")
crate.spec(package = "opus", repositories = ["meerkat_live_crates"], version = "=0.3.1")
crate.spec(package = "rubato", repositories = ["meerkat_live_crates"], version = "=2.0.0")
crate.spec(package = "webrtc", repositories = ["meerkat_live_crates"], version = "=0.14.0")
crate.spec(package = "webrtc-media", repositories = ["meerkat_live_crates"], version = "=0.11.0")
crate.annotation_select(
    crate = "audiopus_sys",
    build_script_data = ["@@+http_archive+cmake_macos_universal//:runtime"],
    build_script_env = {
        "CMAKE": "$(execpath @@+http_archive+cmake_macos_universal//:CMake.app/Contents/bin/cmake)",
        # rules_rust defaults Cargo build scripts to one job. libopus is a
        # vendored native build, so let CMake use the hosted executor cores.
        "NUM_JOBS": "8",
    },
    build_script_tools = ["@@+http_archive+cmake_macos_universal//:CMake.app/Contents/bin/cmake"],
    triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
    ],
    repositories = ["meerkat_live_crates"],
    version = "0.2.2",
)
crate.annotation_select(
    crate = "audiopus_sys",
    build_script_data = ["@@+http_archive+cmake_linux_aarch64//:runtime"],
    build_script_env = {
        "CMAKE": "$(execpath @@+http_archive+cmake_linux_aarch64//:bin/cmake)",
        "NUM_JOBS": "8",
    },
    build_script_tools = ["@@+http_archive+cmake_linux_aarch64//:bin/cmake"],
    triples = ["aarch64-unknown-linux-gnu"],
    repositories = ["meerkat_live_crates"],
    version = "0.2.2",
)
crate.annotation_select(
    crate = "audiopus_sys",
    build_script_data = ["@@+http_archive+cmake_linux_x86_64//:runtime"],
    build_script_env = {
        "CMAKE": "$(execpath @@+http_archive+cmake_linux_x86_64//:bin/cmake)",
        "NUM_JOBS": "8",
    },
    build_script_tools = ["@@+http_archive+cmake_linux_x86_64//:bin/cmake"],
    triples = ["x86_64-unknown-linux-gnu"],
    repositories = ["meerkat_live_crates"],
