CommitSpawnMembershipFresh(agent_identity, agent_runtime_id, fence_token, generation, profile_material_digest, external_addressable, runtime_mode, bridge_session_id, replacing, member_peer_endpoint, spec_digest_echo, ack_engine_version, placed_spawn_id, provision_operation_id, definition_wiring_exempt) ==
    /\ phase = "Running"
    /\ ((IF (agent_identity \in DOMAIN spawn_exec_phase) THEN Some((IF agent_identity \in DOMAIN spawn_exec_phase THEN spawn_exec_phase[agent_identity] ELSE "None")) ELSE None) = Some("Opened"))
    /\ (((agent_identity \in identity_entry_tombstones) = FALSE) /\ ((agent_identity \in identity_entry_unreadable) = FALSE))
    /\ (IF ((IF (agent_identity \in DOMAIN identity_entry_unseated) THEN Some((IF agent_identity \in DOMAIN identity_entry_unseated THEN identity_entry_unseated[agent_identity] ELSE "None")) ELSE None) # Some("PreparationPending")) THEN TRUE ELSE ((agent_identity \in DOMAIN identity_entry_constructions_activating) = TRUE))
    /\ ((member_peer_endpoint = None) /\ (spec_digest_echo = None) /\ (ack_engine_version = None) /\ (placed_spawn_id = None) /\ (provision_operation_id = None))
    /\ ((agent_identity \in DOMAIN member_session_bindings) = FALSE)
    /\ ((agent_identity \in DOMAIN identity_to_runtime) = FALSE)
    /\ (Some(generation) = mob_machine_next_minted_generation(identity_runtime_generations, identity_generation_highwater, agent_identity))
    /\ (replacing = None)
    /\ (bridge_session_id # None)
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ live_runtime_ids' = (live_runtime_ids \cup {agent_runtime_id})
    /\ externally_addressable_runtime_ids' = IF external_addressable THEN (externally_addressable_runtime_ids \cup {agent_runtime_id}) ELSE (externally_addressable_runtime_ids \ {agent_runtime_id})
    /\ runtime_fence_tokens' = MapSet(runtime_fence_tokens, agent_runtime_id, fence_token)
    /\ identity_runtime_generations' = MapSet(identity_runtime_generations, agent_identity, generation)
    /\ identity_runtime_fence_tokens' = MapSet(identity_runtime_fence_tokens, agent_identity, fence_token)
    /\ member_startup_binding_requested' = (member_startup_binding_requested \cup {agent_runtime_id})
    /\ member_startup_runtime_ready' = (member_startup_runtime_ready \ {agent_runtime_id})
    /\ member_startup_ready' = (member_startup_ready \ {agent_runtime_id})
    /\ member_kickoff_pending' = (member_kickoff_pending \ {agent_identity})
    /\ member_kickoff_starting' = (member_kickoff_starting \ {agent_identity})
    /\ member_kickoff_callback_pending' = (member_kickoff_callback_pending \ {agent_identity})
    /\ member_kickoff_started' = (member_kickoff_started \ {agent_identity})
    /\ member_kickoff_failed' = (member_kickoff_failed \ {agent_identity})
    /\ member_kickoff_cancelled' = (member_kickoff_cancelled \ {agent_identity})
    /\ member_kickoff_error' = MapRemove(member_kickoff_error, agent_identity)
    /\ member_kickoff_input_ids' = MapRemove(member_kickoff_input_ids, agent_identity)
    /\ retained_placed_kickoff_obligations' = MapRemove(retained_placed_kickoff_obligations, agent_identity)
    /\ member_placed_kickoff_outcome_kinds' = MapRemove(member_placed_kickoff_outcome_kinds, agent_identity)
    /\ member_placed_kickoff_outcome_errors' = MapRemove(member_placed_kickoff_outcome_errors, agent_identity)
    /\ member_placed_kickoff_closure_kinds' = MapRemove(member_placed_kickoff_closure_kinds, agent_identity)
    /\ member_restore_failures' = MapRemove(member_restore_failures, agent_identity)
    /\ member_restore_failure_codes' = MapRemove(member_restore_failure_codes, agent_identity)
    /\ member_materialization' = MapSet(member_materialization, agent_identity, "Live")
    /\ member_run_open' = MapRemove(member_run_open, agent_identity)
    /\ member_in_flight_work' = MapRemove(member_in_flight_work, agent_identity)
    /\ member_progress_tokens' = MapRemove(member_progress_tokens, agent_identity)
    /\ member_last_observed_at_ms' = MapRemove(member_last_observed_at_ms, agent_identity)
    /\ member_last_progress_at_ms' = MapRemove(member_last_progress_at_ms, agent_identity)
    /\ member_last_progress_event' = MapRemove(member_last_progress_event, agent_identity)
    /\ member_health_class' = MapRemove(member_health_class, agent_identity)
    /\ spawn_exec_phase' = MapSet(spawn_exec_phase, agent_identity, "MembershipCommitted")
    /\ pending_respawn_topology' = (pending_respawn_topology \ {agent_identity})
    /\ abandoned_respawn_topology' = MapRemove(abandoned_respawn_topology, agent_identity)
    /\ identity_to_runtime' = MapSet(identity_to_runtime, agent_identity, agent_runtime_id)
    /\ member_session_bindings' = MapSet(member_session_bindings, agent_identity, (IF "value" \in DOMAIN bridge_session_id THEN bridge_session_id["value"] ELSE None))
    /\ member_profile_names' = MapSet(member_profile_names, agent_identity, (IF "value" \in DOMAIN (IF (agent_identity \in DOMAIN spawn_profile_authority_profile_names) THEN Some((IF agent_identity \in DOMAIN spawn_profile_authority_profile_names THEN spawn_profile_authority_profile_names[agent_identity] ELSE "None")) ELSE None) THEN (IF (agent_identity \in DOMAIN spawn_profile_authority_profile_names) THEN Some((IF agent_identity \in DOMAIN spawn_profile_authority_profile_names THEN spawn_profile_authority_profile_names[agent_identity] ELSE "None")) ELSE None)["value"] ELSE None))
    /\ member_runtime_modes' = MapSet(member_runtime_modes, agent_identity, runtime_mode)
    /\ spawn_profile_authority_profile_names' = MapRemove(spawn_profile_authority_profile_names, agent_identity)
    /\ spawn_profile_authority_models' = MapRemove(spawn_profile_authority_models, agent_identity)
    /\ spawn_profile_authority_material_digests' = MapRemove(spawn_profile_authority_material_digests, agent_identity)
    /\ spawn_profile_authority_tool_config_digests' = MapRemove(spawn_profile_authority_tool_config_digests, agent_identity)
    /\ spawn_profile_authority_skills_digests' = MapRemove(spawn_profile_authority_skills_digests, agent_identity)
    /\ spawn_profile_authority_provider_params_digests' = MapRemove(spawn_profile_authority_provider_params_digests, agent_identity)
    /\ spawn_profile_authority_output_schema_digests' = MapRemove(spawn_profile_authority_output_schema_digests, agent_identity)
    /\ spawn_profile_authority_external_addressable' = MapRemove(spawn_profile_authority_external_addressable, agent_identity)
    /\ topology_epoch' = (topology_epoch) + 1
