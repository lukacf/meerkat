OwnerFeedbackHasProtocolProvenance ==
    \A input_packet \in observed_inputs :
        input_packet.source_kind /= "owner"
        \/ ((/\ input_packet.machine = "meerkat" /\ input_packet.variant = "OpsBarrierSatisfied" /\ input_packet.source_machine = "meerkat" /\ input_packet.source_effect = "WaitAllSatisfied" /\ \E effect_packet \in emitted_effects : /\ effect_packet.machine = "meerkat" /\ effect_packet.variant = "WaitAllSatisfied" /\ effect_packet.effect_id = input_packet.effect_id) \/ (/\ input_packet.machine = "meerkat" /\ input_packet.variant = "SurfaceMarkPendingSucceeded" /\ input_packet.source_machine = "meerkat" /\ input_packet.source_effect = "ScheduleSurfaceCompletion" /\ \E effect_packet \in emitted_effects : /\ effect_packet.machine = "meerkat" /\ effect_packet.variant = "ScheduleSurfaceCompletion" /\ effect_packet.effect_id = input_packet.effect_id) \/ (/\ input_packet.machine = "meerkat" /\ input_packet.variant = "SurfaceMarkPendingFailed" /\ input_packet.source_machine = "meerkat" /\ input_packet.source_effect = "ScheduleSurfaceCompletion" /\ \E effect_packet \in emitted_effects : /\ effect_packet.machine = "meerkat" /\ effect_packet.variant = "ScheduleSurfaceCompletion" /\ effect_packet.effect_id = input_packet.effect_id) \/ (/\ input_packet.machine = "meerkat" /\ input_packet.variant = "SurfaceSnapshotAligned" /\ input_packet.source_machine = "meerkat" /\ input_packet.source_effect = "RefreshVisibleSurfaceSet" /\ \E effect_packet \in emitted_effects : /\ effect_packet.machine = "meerkat" /\ effect_packet.variant = "RefreshVisibleSurfaceSet" /\ effect_packet.effect_id = input_packet.effect_id) \/ (/\ input_packet.machine = "mob" /\ input_packet.variant = "SessionIngressDetachedForMobDestroy" /\ input_packet.source_machine = "mob" /\ input_packet.source_effect = "RequestSessionIngressDetachForMobDestroy" /\ \E effect_packet \in emitted_effects : /\ effect_packet.machine = "mob" /\ effect_packet.variant = "RequestSessionIngressDetachForMobDestroy" /\ effect_packet.effect_id = input_packet.effect_id) \/ (/\ input_packet.machine = "mob" /\ input_packet.variant = "SessionIngressDetachFailedForMobDestroy" /\ input_packet.source_machine = "mob" /\ input_packet.source_effect = "RequestSessionIngressDetachForMobDestroy" /\ \E effect_packet \in emitted_effects : /\ effect_packet.machine = "mob" /\ effect_packet.variant = "RequestSessionIngressDetachForMobDestroy" /\ effect_packet.effect_id = input_packet.effect_id))

