placed_spawn_committed_attempt_is_complete == ((\A id \in DOMAIN current_placed_spawn_ids : ((id \in DOMAIN current_placed_spawn_host_binding_generations) /\ ((IF "value" \in DOMAIN (IF (id \in DOMAIN current_placed_spawn_host_binding_generations) THEN Some((IF id \in DOMAIN current_placed_spawn_host_binding_generations THEN current_placed_spawn_host_binding_generations[id] ELSE 0)) ELSE None) THEN (IF (id \in DOMAIN current_placed_spawn_host_binding_generations) THEN Some((IF id \in DOMAIN current_placed_spawn_host_binding_generations THEN current_placed_spawn_host_binding_generations[id] ELSE 0)) ELSE None)["value"] ELSE None) > 0) /\ (id \in DOMAIN current_placed_spawn_provision_operation_ids) /\ (id \in DOMAIN current_placed_spawn_operation_owner_session_ids))) /\ (\A id \in DOMAIN current_placed_spawn_host_binding_generations : (id \in DOMAIN current_placed_spawn_ids)) /\ (\A id \in DOMAIN current_placed_spawn_provision_operation_ids : (id \in DOMAIN current_placed_spawn_ids)) /\ (\A id \in DOMAIN current_placed_spawn_operation_owner_session_ids : (id \in DOMAIN current_placed_spawn_ids)))
placed_spawn_attempt_is_not_both_pending_and_committed == (\A id \in DOMAIN pending_placed_spawn_ids : ((id \in DOMAIN current_placed_spawn_ids) = FALSE))
identity_runtime_history_is_coherent == ((\A id \in DOMAIN identity_runtime_generations : (id \in DOMAIN identity_runtime_fence_tokens)) /\ (\A id \in DOMAIN identity_runtime_generations : (id \in DOMAIN member_profile_names)) /\ (\A id \in DOMAIN identity_runtime_generations : (id \in DOMAIN member_runtime_modes)) /\ (\A id \in DOMAIN identity_runtime_fence_tokens : (id \in DOMAIN identity_runtime_generations)) /\ (\A id \in DOMAIN member_profile_names : (id \in DOMAIN identity_runtime_generations)) /\ (\A id \in DOMAIN member_runtime_modes : (id \in DOMAIN identity_runtime_generations)))
