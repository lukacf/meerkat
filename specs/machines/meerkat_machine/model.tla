ClassifyRecoveredInputDurabilityRetainDurableDerivedOrMissingInitializing(input_id, durability) ==
    /\ phase = "Initializing"
    /\ (IF (durability = "Durable") THEN TRUE ELSE (IF (durability = "Derived") THEN TRUE ELSE (durability = "Missing")))
