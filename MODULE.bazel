# The bundled SQLite's lock profile, meerkat_sqlite::REQUIRED_LIBSQLITE3_FLAGS
# (see .cargo/config.toml, which sets the same value for cargo).
crate.annotation(
    crate = "libsqlite3-sys",
    build_script_env = {
        "LIBSQLITE3_FLAGS": "-DSQLITE_DEFAULT_MEMSTATUS=0 -USQLITE_ENABLE_MEMORY_MANAGEMENT -DSQLITE_DISABLE_PAGECACHE_OVERFLOW_STATS",
    },
    repositories = ["crates"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "wasm32-unknown-unknown",
    ],
)
crate.from_specs(
    name = "meerkat_live_crates",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "wasm32-unknown-unknown",
    ],
)
use_repo(crate, "crates", "meerkat_live_crates")
