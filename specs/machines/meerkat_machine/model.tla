    /\ supervisor_rotation_terminal_previous_names' = IF (arg_phase = "Rejected") THEN MapSet(IF (arg_phase = "Completed") THEN MapSet(supervisor_rotation_terminal_previous_names, operation_id, (IF "value" \in DOMAIN Some(previous_name) THEN Some(previous_name)["value"] ELSE None)) ELSE supervisor_rotation_terminal_previous_names, operation_id, (IF "value" \in DOMAIN Some(previous_name) THEN Some(previous_name)["value"] ELSE None)) ELSE IF (arg_phase = "Completed") THEN MapSet(supervisor_rotation_terminal_previous_names, operation_id, (IF "value" \in DOMAIN Some(previous_name) THEN Some(previous_name)["value"] ELSE None)) ELSE supervisor_rotation_terminal_previous_names
