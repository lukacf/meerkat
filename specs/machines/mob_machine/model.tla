    /\ phase = "Running" \/ phase = "Stopped" \/ phase = "Completed"
    /\ (explicit_resume_attempt = None)
    /\ mob_machine_adaptive_lifecycle_drained(adaptive_active_run, adaptive_active_layer, adaptive_active_members, adaptive_layer_phase, adaptive_layer_disposition)
    /\ (IF (member_rotation_session_ids = [x \in {} |-> None]) THEN TRUE ELSE (destroy_admitted = TRUE))
    /\ (pending_session_ingress_detach_runtime_ids = {})
    /\ (placed_completion_lifecycle_quiescing = TRUE)
    /\ (placed_completion_lifecycle_intent = Some("Destroy"))
    /\ (pending_remote_turn_outcomes = {})
    /\ (committed_remote_turn_outcomes = {})
    /\ (resolved_remote_turn_outcomes = {})
    /\ (pending_placed_completion_outcomes = {})
    /\ (cancel_requested_placed_completion_outcomes = {})
    /\ (resolved_placed_completion_outcomes = {})
    /\ (pending_placed_kickoff_outcomes = {})
    /\ (resolved_placed_kickoff_outcomes = {})
    /\ (host_bind_phase = [x \in {} |-> None])
    /\ ((replacement_host_bind_endpoints = [x \in {} |-> None]) /\ (replacement_host_binding_generations = [x \in {} |-> None]))
    /\ (mob_hosts = {})
    /\ (host_authority_epochs = [x \in {} |-> None])
    /\ (host_public_keys = [x \in {} |-> None])
    /\ (host_endpoints = [x \in {} |-> None])
    /\ (host_live_endpoints = [x \in {} |-> None])
    /\ (pending_placed_carrier_cleanup = {})
    /\ (pending_placed_spawn_ids = [x \in {} |-> None])
    /\ (current_placed_spawn_ids = [x \in {} |-> None])
    /\ ((member_kickoff_pending = {}) /\ (member_kickoff_starting = {}) /\ (member_kickoff_callback_pending = {}))
    /\ ((pending_spawn_count = 0) /\ (pending_spawn_sessions = [x \in {} |-> None]))
    /\ phase' = "Destroyed"
    /\ model_step_count' = model_step_count + 1
    /\ destroy_admitted' = TRUE
    /\ live_runtime_ids' = {}
    /\ externally_addressable_runtime_ids' = {}
    /\ runtime_fence_tokens' = [x \in {} |-> None]
