    /\ (meerkat_tool_visibility_state_replacement_matches(arg_inherited_base_filter, arg_active_filter, arg_staged_filter, arg_active_deferred_names, arg_staged_deferred_names, requested_witnesses, filter_witnesses, arg_active_deferred_authorities, arg_staged_deferred_authorities, deferred_visibility_authority_catalog, filter_visibility_authority_catalog, active_revision, staged_revision) = TRUE)
