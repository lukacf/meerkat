    /\ (IF (rejection_cause = "AlreadyBound") THEN TRUE ELSE (IF (rejection_cause = "InvalidBootstrapToken") THEN TRUE ELSE (IF (rejection_cause = "UnsupportedProtocolVersion") THEN TRUE ELSE (IF (rejection_cause = "InvalidSupervisorSpec") THEN TRUE ELSE (IF (rejection_cause = "InvalidPeerSpec") THEN TRUE ELSE (IF (rejection_cause = "AddressMismatch") THEN TRUE ELSE (IF (rejection_cause = "Unsupported") THEN TRUE ELSE (rejection_cause = "Internal"))))))))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_9673ab48951cc429


