    /\ ((operation_id \in live_delegation_result_eligible_operations) /\ ~((operation_id \in live_delegation_late_terminal_operations)) /\ ((IF (operation_id \in DOMAIN live_delegation_worker_terminal_by_operation) THEN Some((IF operation_id \in DOMAIN live_delegation_worker_terminal_by_operation THEN live_delegation_worker_terminal_by_operation[operation_id] ELSE "None")) ELSE None) = Some("Completed")))
    /\ ~((operation_id \in live_result_released_operations))
    /\ ~((channel_id \in DOMAIN live_result_delivery_operation_by_channel))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_result_released_operations' = (live_result_released_operations \cup {operation_id})
    /\ live_result_release_disposition_by_operation' = MapSet(live_result_release_disposition_by_operation, operation_id, (IF ((IF (channel_id \in DOMAIN live_active_interaction_by_channel) THEN Some((IF channel_id \in DOMAIN live_active_interaction_by_channel THEN live_active_interaction_by_channel[channel_id] ELSE "None")) ELSE None) = Some(interaction_id)) THEN "OpenTurn" ELSE "DeferredContext"))
    /\ live_result_delivery_operation_by_channel' = MapSet(live_result_delivery_operation_by_channel, channel_id, operation_id)
