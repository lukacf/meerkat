---- MODULE model ----
EXTENDS TLC, Naturals, Sequences, FiniteSets

\* Generated semantic machine model for LiveRequestMachine.

\* RustU64Max is the TLA boundary for Expr::U64Max; production generated Rust renders u64::MAX.
CONSTANTS BooleanValues, LiveCompletionCreditSchemaValues, LiveEffectPhaseValues, LiveInputRecoveryDispositionValues, LiveInputRecoveryPurposeValues, LiveRecoveryApplicationEvidenceValues, LiveRecoveryInputPhaseValues, LiveRequestCancellationReasonValues, LiveRequestEvidenceKindValues, LiveRequestPhaseValues, LiveSourceRefusalValues, NatValues, ScopedEffectKindValues, ScopedTokenAccountingStatusValues, SetOfLiveRequestEvidenceKindValues, SetOfStringValues, SetOfToolMutationClassValues, StringValues, ToolMutationClassValues, RustU64Max

None == [tag |-> "none", value |-> "none"]
Some(v) == [tag |-> "some", value |-> v]

MapStringBoolValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in BOOLEAN }
MapStringLiveEffectPhaseValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in LiveEffectPhaseValues }
MapStringLiveRequestCancellationReasonValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in LiveRequestCancellationReasonValues }
MapStringLiveRequestEvidenceKindValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in LiveRequestEvidenceKindValues }
MapStringLiveRequestPhaseValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in LiveRequestPhaseValues }
MapStringLiveSourceRefusalValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in LiveSourceRefusalValues }
MapStringScopedEffectKindValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in ScopedEffectKindValues }
MapStringScopedTokenAccountingStatusValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in ScopedTokenAccountingStatusValues }
MapStringStringValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in StringValues }
MapStringU64Values == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in NatValues }
MapStringSetStringValues == {[x \in {} |-> None]} \cup { [x \in {k} |-> v] : k \in StringValues, v \in SetOfStringValues }

MapLookup(map, key) == IF key \in DOMAIN map THEN map[key] ELSE None
MapSet(map, key, value) == [x \in DOMAIN map \cup {key} |-> IF x = key THEN value ELSE map[x]]
MapIncrement(map, key, amount) == [x \in DOMAIN map \cup {key} |-> IF x = key THEN (IF key \in DOMAIN map THEN map[key] ELSE 0) + amount ELSE map[x]]
MapDecrement(map, key, amount) == [x \in DOMAIN map \cup {key} |-> IF x = key THEN (IF key \in DOMAIN map THEN map[key] ELSE 0) - amount ELSE map[x]]
MapRemove(map, key) == [x \in DOMAIN map \ {key} |-> map[x]]
StartsWith(seq, prefix) == /\ Len(prefix) <= Len(seq) /\ SubSeq(seq, 1, Len(prefix)) = prefix
SeqElements(seq) == {seq[i] : i \in 1..Len(seq)}
Count(seq, value) == Cardinality({i \in DOMAIN seq : seq[i] = value})
RECURSIVE SeqRemove(_, _)
SeqRemove(seq, value) == IF Len(seq) = 0 THEN <<>> ELSE IF Head(seq) = value THEN SeqRemove(Tail(seq), value) ELSE <<Head(seq)>> \o SeqRemove(Tail(seq), value)
RECURSIVE SeqRemoveAll(_, _)
SeqRemoveAll(seq, values) == IF Len(values) = 0 THEN seq ELSE SeqRemoveAll(SeqRemove(seq, Head(values)), Tail(values))

