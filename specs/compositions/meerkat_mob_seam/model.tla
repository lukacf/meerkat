)) THEN "ReleaseSessionAuthority" ELSE (IF (retirement_receipt = "Unavailable") THEN "Backoff" ELSE (IF (retirement_receipt = "Missing") THEN "SealRetirementProven" ELSE (IF (retirement_receipt = "Matching") THEN "Tombstoned" ELSE "RepairBlocked"))))))))))))))) ELSE (IF (session = "Unavailable") THEN "Backoff" ELSE (IF (IF (session = "Malformed") THEN TRUE ELSE (IF (session = "IrrecoverablyCorrupt") THEN TRUE ELSE (IF (session = "AmbiguousDivergence") THEN TRUE ELSE ((session = "Missing") /\ (intent = "PresentRequireExisting"))))) THEN (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Matching") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (member = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (member = "Matching") THEN TRUE ELSE (member = "Divergent")) THEN "RetireMemberMaterialization" ELSE (IF (runtime = "Unavailable") THEN "Backoff" ELSE (IF (runtime = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (runtime = "Matching") THEN TRUE ELSE (runtime = "Divergent")) THEN "RetireRuntimeRegistration" ELSE (IF (session = "IrrecoverablyCorrupt") THEN "Quarantined" ELSE "RepairBlocked")))))))))) ELSE (IF (IF (session = "Missing") THEN TRUE ELSE (session = "RecoverableDivergence")) THEN (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Unavailable")) THEN "Backoff" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (IF (session_creation_receipt = "Conflicting") THEN TRUE ELSE (IF (session_creation_receipt = "Malformed") THEN TRUE ELSE (session_creation_receipt = "NotRequired")))) THEN "RepairBlocked" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Matching") /\ (session = "Missing")) THEN "RepairBlocked" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (IF (session_creation_receipt = "Missing") THEN TRUE ELSE (session_creation_receipt = "Matching"))) THEN "EnsureSessionAuthority" ELSE (IF ((intent = "PresentRequireExisting") /\ (session_creation_receipt = "NotRequired")) THEN "EnsureSessionAuthority" ELSE (IF ((intent = "PresentRequireExisting") /\ (session_creation_receipt = "Unavailable")) THEN "Backoff" ELSE "RepairBlocked")))))) ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Unavailable")) THEN "Backoff" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Missing")) THEN "SealSessionCreationConsumed" ELSE (IF ~((IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Matching")) THEN TRUE ELSE ((intent = "PresentRequireExisting") /\ (session_creation_receipt = "NotRequired")))) THEN "RepairBlocked" ELSE (IF (runtime = "Unavailable") THEN "Backoff" ELSE (IF (runtime = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (runtime = "Missing") THEN TRUE ELSE (runtime = "Divergent")) THEN "EnsureRuntimeRegistration" ELSE (IF (external_binding_required = TRUE) THEN (IF (external_binding_receipt = "Unavailable") THEN "Backoff" ELSE (IF (external_binding_receipt = "Missing") THEN "EnsureExternalBindingReceipt" ELSE (IF (IF (external_binding_receipt = "Conflicting") THEN TRUE ELSE (IF (external_binding_receipt = "Malformed") THEN TRUE ELSE (external_binding_receipt = "NotRequired"))) THEN "RepairBlocked" ELSE (IF (external_trust = "Unavailable") THEN "Backoff" ELSE (IF (external_trust = "Absent") THEN (IF (external_ceremony = "FreshAvailable") THEN "EnsureExternalBinding" ELSE (IF (external_ceremony = "AwaitFresh") THEN "AwaitExternalBindingCeremony" ELSE (IF (external_ceremony = "TemporarilyUnavailable") THEN "Backoff" ELSE "RepairBlocked"))) ELSE (IF (IF (external_trust = "Contradictory") THEN TRUE ELSE (IF (external_trust = "Indeterminate") THEN TRUE ELSE (IF (external_trust = "Malformed") THEN TRUE ELSE (external_trust = "NotRequired")))) THEN "RepairBlocked" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (IF (member = "Malformed") THEN TRUE ELSE (member = "Divergent")) THEN "RepairBlocked" ELSE (IF (member = "Missing") THEN "EnsureMemberMaterialization" ELSE (IF (initial_delivery_required = TRUE) THEN (IF (initial_delivery_receipt = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery_receipt = "Missing") THEN "EnsureInitialDeliveryReceipt" ELSE (IF (IF (initial_delivery_receipt = "Conflicting") THEN TRUE ELSE (IF (initial_delivery_receipt = "Malformed") THEN TRUE ELSE (initial_delivery_receipt = "NotRequired"))) THEN "RepairBlocked" ELSE (IF (initial_delivery = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery = "ProvenAbsent") THEN "EnsureInitialDelivery" ELSE (IF (initial_delivery = "AcceptedPendingExact") THEN "AwaitInitialDelivery" ELSE (IF (IF (initial_delivery = "ContentOnlyMatch") THEN TRUE ELSE (IF (initial_delivery = "OperationCollision") THEN TRUE ELSE (IF (initial_delivery = "Contradictory") THEN TRUE ELSE (IF (initial_delivery = "Indeterminate") THEN TRUE ELSE (IF (initial_delivery = "Malformed") THEN TRUE ELSE (initial_delivery = "NotRequired")))))) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))) ELSE (IF (IF (initial_delivery_receipt # "NotRequired") THEN TRUE ELSE (initial_delivery # "NotRequired")) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))))))) ELSE (IF (IF (external_binding_receipt # "NotRequired") THEN TRUE ELSE (IF (external_trust # "NotRequired") THEN TRUE ELSE (external_ceremony # "NotRequired"))) THEN "RepairBlocked" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (IF (member = "Malformed") THEN TRUE ELSE (member = "Divergent")) THEN "RepairBlocked" ELSE (IF (member = "Missing") THEN "EnsureMemberMaterialization" ELSE (IF (initial_delivery_required = TRUE) THEN (IF (initial_delivery_receipt = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery_receipt = "Missing") THEN "EnsureInitialDeliveryReceipt" ELSE (IF (IF (initial_delivery_receipt = "Conflicting") THEN TRUE ELSE (IF (initial_delivery_receipt = "Malformed") THEN TRUE ELSE (initial_delivery_receipt = "NotRequired"))) THEN "RepairBlocked" ELSE (IF (initial_delivery = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery = "ProvenAbsent") THEN "EnsureInitialDelivery" ELSE (IF (initial_delivery = "AcceptedPendingExact") THEN "AwaitInitialDelivery" ELSE (IF (IF (initial_delivery = "ContentOnlyMatch") THEN TRUE ELSE (IF (initial_delivery = "OperationCollision") THEN TRUE ELSE (IF (initial_delivery = "Contradictory") THEN TRUE ELSE (IF (initial_delivery = "Indeterminate") THEN TRUE ELSE (IF (initial_delivery = "Malformed") THEN TRUE ELSE (initial_delivery = "NotRequired")))))) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))) ELSE (IF (IF (initial_delivery_receipt # "NotRequired") THEN TRUE ELSE (initial_delivery # "NotRequired")) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))))))))))))))))))))))))

mob__entry_packet__mob_machine_next_respawn_generation(arg_identity_runtime_generations, arg_agent_identity) ==
    IF arg_agent_identity \notin DOMAIN arg_identity_runtime_generations
    THEN Some(0)
    ELSE IF arg_identity_runtime_generations[arg_agent_identity] = RustU64Max
         THEN None
         ELSE Some(arg_identity_runtime_generations[arg_agent_identity] + 1)
mob__entry_packet__mob_machine_u64_is_exact_successor(arg_current, arg_next) ==
    /\ arg_current # RustU64Max
    /\ arg_next = arg_current + 1
mob__entry_packet__mob_machine_optional_u64_is_exact_successor(arg_current, arg_next) ==
    /\ arg_current # RustU64Max
    /\ arg_next = Some(arg_current + 1)
mob__entry_packet__mob_machine_remote_turn_custody_admits(pending, committed, resolved, candidate) ==
    LET same_member_host_count == Cardinality({ row \in pending : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
            + Cardinality({ row \in committed : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
            + Cardinality({ row \in resolved : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
    IN /\ Cardinality(pending) + Cardinality(committed) + Cardinality(resolved) < 4096
       /\ candidate.dispatch_sequence > 0
       /\ candidate.input_id # ""
       /\ candidate.run_id # ""
       /\ candidate.step_id # ""
       /\ candidate.host_id # ""
       /\ candidate.member_session_id # ""
       /\ \A row \in pending : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ \A row \in committed : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ \A row \in resolved : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ same_member_host_count < 256
mob__entry_packet__mob_machine_placed_completion_obligation_well_formed(candidate) ==
    /\ candidate.agent_identity # ""
    /\ candidate.host_id # ""
    /\ candidate.host_binding_generation > 0
    /\ candidate.member_session_id # ""
    /\ candidate.dispatch_sequence > 0
    /\ candidate.input_id # ""
mob__entry_packet__mob_machine_placed_completion_custody_admits(pending, resolved, candidate) ==
    LET rows == pending \cup resolved
        same_member_host == Cardinality({ row \in rows : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
    IN /\ Cardinality(rows) < 4096
       /\ \A row \in rows : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ same_member_host < 256
mob__entry_packet__mob_machine_adaptive_lifecycle_drained(active_run, active_layer, active_members, layer_phases, layer_dispositions) ==
    /\ active_run = None
    /\ DOMAIN active_layer = {}
    /\ \A run_id \in DOMAIN active_members : active_members[run_id] = 0
    /\ \A layer_id \in DOMAIN layer_phases :
           \/ layer_phases[layer_id] = "Validating"
           \/ /\ layer_id \in DOMAIN layer_dispositions
              /\ layer_phases[layer_id] \in {"Completed", "SetupFailed", "RunFailed", "ResultInvalid", "Canceled"}
mob__entry_packet__mob_machine_adaptive_run_custody_drained(adaptive_run_id, active_layer, active_members, layer_run, layer_phases, layer_dispositions) ==
    /\ adaptive_run_id \notin DOMAIN active_layer
    /\ (IF adaptive_run_id \in DOMAIN active_members THEN active_members[adaptive_run_id] ELSE 0) = 0
    /\ \A layer_id \in DOMAIN layer_run :
           \/ layer_run[layer_id] # adaptive_run_id
           \/ /\ layer_id \in DOMAIN layer_dispositions
              /\ layer_id \in DOMAIN layer_phases
              /\ layer_phases[layer_id] \in {"Completed", "SetupFailed", "RunFailed", "ResultInvalid", "Canceled"}
mob__entry_packet__mob_machine_finalized_placed_kickoff_recovery_well_formed(started, callback_pending, failed, cancelled, kickoff_errors, identity, outcome_kind, outcome_error, closure_kind) ==
    /\ Cardinality({ kickoff_phase \in {"Started", "CallbackPending", "Failed", "Cancelled"} :
           CASE kickoff_phase = "Started" -> identity \in started
             [] kickoff_phase = "CallbackPending" -> identity \in callback_pending
             [] kickoff_phase = "Failed" -> identity \in failed
             [] OTHER -> identity \in cancelled }) = 1
    /\ CASE outcome_kind = "Failed" -> outcome_error # None
          [] outcome_kind = "RejectedNoEffect" -> /\ outcome_error # None /\ outcome_error.value # ""
          [] OTHER -> outcome_error = None
    /\ CASE closure_kind = "Acknowledged" -> /\ outcome_kind # "RejectedNoEffect" /\ outcome_kind # "Disposed"
          [] closure_kind = "RejectedNoEffect" -> outcome_kind = "RejectedNoEffect"
          [] OTHER -> outcome_kind # "RejectedNoEffect"
    /\ CASE identity \in cancelled -> identity \notin DOMAIN kickoff_errors
          [] identity \in started -> /\ outcome_kind = "Started" /\ identity \notin DOMAIN kickoff_errors
          [] identity \in callback_pending -> /\ outcome_kind = "CallbackPending" /\ identity \notin DOMAIN kickoff_errors
          [] OTHER -> /\ outcome_kind \in {"Failed", "RejectedNoEffect"} /\ identity \in DOMAIN kickoff_errors /\ outcome_error = Some(kickoff_errors[identity])
mob__entry_packet__mob_machine_placed_kickoff_obligation_well_formed(candidate) ==
    /\ candidate.agent_identity # ""
    /\ candidate.host_id # ""
    /\ candidate.host_binding_generation > 0
    /\ candidate.member_session_id # ""
    /\ candidate.input_id # ""
    /\ candidate.objective_id # ""
mob__entry_packet__mob_machine_placed_kickoff_correlation_available(pending_kickoffs, resolved_kickoffs, retained_kickoffs, pending_turns, committed_turns, resolved_turns, pending_completions, resolved_completions, candidate) ==
    /\ \A row \in pending_kickoffs \cup resolved_kickoffs : /\ row.agent_identity # candidate.agent_identity /\ \lnot (/\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
    /\ \A identity \in DOMAIN retained_kickoffs : retained_kickoffs[identity].agent_identity # candidate.agent_identity
    /\ \A row \in pending_turns \cup committed_turns \cup resolved_turns : \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
    /\ \A row \in pending_completions \cup resolved_completions : \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
mob__entry_packet__mob_machine_placed_kickoff_custody_absent_for_identity(pending, resolved, agent_identity) ==
    \A row \in pending \cup resolved : row.agent_identity # agent_identity
mob__entry_packet__mob_machine_placed_kickoff_custody_absent_for_host(pending, resolved, host_id) ==
    \A row \in pending \cup resolved : row.host_id # host_id
mob__entry_packet__mob_machine_remote_turn_input_id_available_to_kickoff(pending, resolved, retained, candidate) ==
    /\ \A row \in pending \cup resolved : \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
    /\ \A identity \in DOMAIN retained : \lnot (/\ retained[identity].agent_identity = candidate.agent_identity /\ retained[identity].host_id = candidate.host_id /\ retained[identity].generation = candidate.generation /\ retained[identity].fence_token = candidate.fence_token /\ retained[identity].input_id = candidate.input_id)
mob__entry_packet__mob_machine_wiring_edges_without_identity(arg_wiring_edges, arg_agent_identity) ==
    { edge \in arg_wiring_edges : /\ edge.a # arg_agent_identity /\ edge.b # arg_agent_identity }
mob__entry_packet__mob_machine_external_peer_edges_without_identity(arg_external_peer_edges, arg_agent_identity) ==
    { edge \in arg_external_peer_edges : edge.local # arg_agent_identity }
mob__entry_packet__mob_machine_external_peer_edges_by_key_without_identity(arg_external_peer_edges_by_key, arg_agent_identity) ==
    [key \in { key \in DOMAIN arg_external_peer_edges_by_key : key.local # arg_agent_identity } |-> arg_external_peer_edges_by_key[key]]
mob__entry_packet__mob_machine_members_to_spawn(arg_identity_to_runtime, arg_desired) ==
    { member \in arg_desired : member \notin DOMAIN arg_identity_to_runtime }
mob__entry_packet__mob_machine_members_to_retire(arg_identity_to_runtime, arg_desired, arg_retire_stale) ==
    IF arg_retire_stale
    THEN { member \in DOMAIN arg_identity_to_runtime : member \notin arg_desired }
    ELSE {}
mob__entry_packet__mob_machine_placed_cleanup_absent_for_identity(arg_obligations, arg_agent_identity) ==
    \A obligation \in arg_obligations : obligation.agent_identity # arg_agent_identity
mob__entry_packet__mob_machine_placed_cleanup_obligation(arg_agent_identity, arg_spawn_id, arg_generation, arg_fence_token, arg_provision_operation_id, arg_operation_owner_session_id, arg_expected_phase) ==
    [agent_identity |-> arg_agent_identity, spawn_id |-> arg_spawn_id, generation |-> arg_generation, fence_token |-> arg_fence_token, provision_operation_id |-> arg_provision_operation_id, operation_owner_session_id |-> arg_operation_owner_session_id, expected_phase |-> arg_expected_phase]
mob__entry_packet__mob_machine_placed_carrier_binding_active(arg_member_placement, arg_current_binding_generations, arg_host_bind_phase, arg_host_binding_generations, arg_agent_identity) ==
    IF arg_agent_identity \notin DOMAIN arg_member_placement
    THEN FALSE
    ELSE LET host == arg_member_placement[arg_agent_identity]
         IN IF host \notin DOMAIN arg_host_bind_phase
            THEN FALSE
            ELSE IF arg_host_bind_phase[host] # "Bound"
                 THEN FALSE
                 ELSE IF arg_agent_identity \notin DOMAIN arg_current_binding_generations
                      THEN FALSE
                      ELSE LET generation == arg_current_binding_generations[arg_agent_identity]
                           IN /\ generation > 0
                              /\ host \in DOMAIN arg_host_binding_generations
                              /\ arg_host_binding_generations[host] = generation
mob__entry_packet__mob_machine_host_binding_generation_tombstone(arg_host_id, arg_binding_generation) ==
    [host_id |-> arg_host_id, binding_generation |-> arg_binding_generation]
mob__entry_packet__mob_machine_placed_carrier_binding_confirmed_revoked(arg_member_placement, arg_current_binding_generations, arg_host_bind_phase, arg_confirmed_revocations, arg_agent_identity) ==
    IF arg_agent_identity \notin DOMAIN arg_member_placement
    THEN FALSE
    ELSE LET host == arg_member_placement[arg_agent_identity]
         IN IF arg_agent_identity \notin DOMAIN arg_current_binding_generations
            THEN FALSE
            ELSE LET generation == arg_current_binding_generations[arg_agent_identity]
                 IN /\ generation > 0
                    /\ (IF host \in DOMAIN arg_host_bind_phase THEN arg_host_bind_phase[host] # "Bound" ELSE TRUE)
                    /\ [host_id |-> host, binding_generation |-> generation] \in arg_confirmed_revocations
mob__entry_packet__mob_coordination_expired_at(expires_at_ms, now_ms) ==
    /\ expires_at_ms # None
    /\ expires_at_ms.value <= now_ms
mob__entry_packet__mob_coordination_work_intent_unexpired(expires_at_ms, now_ms) == ~mob__entry_packet__mob_coordination_expired_at(expires_at_ms, now_ms)
mob__entry_packet__mob_coordination_resource_claim_unexpired(expires_at_ms, now_ms) == ~mob__entry_packet__mob_coordination_expired_at(expires_at_ms, now_ms)
mob__entry_packet__mob_coordination_resource_claim_active_at(status, expires_at_ms, now_ms) ==
    /\ status = "Active"
    /\ ~mob__entry_packet__mob_coordination_expired_at(expires_at_ms, now_ms)
mob__entry_packet__mob_coordination_resource_claim_inactive_at(status, expires_at_ms, now_ms) == ~mob__entry_packet__mob_coordination_resource_claim_active_at(status, expires_at_ms, now_ms)
mob__entry_packet__mob_machine_external_peer_edge_has_matching_key(edges_by_key, edge) ==
    LET key == [local |-> edge.local, name |-> edge.endpoint.name]
    IN /\ key \in DOMAIN edges_by_key
       /\ edges_by_key[key] = edge
mob__entry_packet__mob_machine_external_peer_edge_local(edge) == edge.local
mob__entry_packet__mob_machine_external_peer_edge_peer_id(edge) == edge.endpoint.peer_id
mob__entry_packet__mob_machine_external_peer_key_matches_edge(key, edge) ==
    /\ key.local = edge.local
    /\ key.name = edge.endpoint.name
mob__entry_packet__mob_machine_external_peer_key_matches_local(key, agent_identity) == key.local = agent_identity
mob__entry_packet__mob_machine_external_peer_identity_absent(edges, agent_identity) ==
    \A edge \in edges : edge.endpoint.name /= agent_identity
mob__entry_packet__mob_machine_identity_has_session_binding(arg_member_session_bindings, agent_identity) ==
    /\ agent_identity \in DOMAIN arg_member_session_bindings
    /\ arg_member_session_bindings[agent_identity] /= ""
mob__entry_packet__mob_machine_session_bound_live_runtime_ids_match(arg_identity_to_runtime, arg_member_session_bindings, arg_live_runtime_ids, expected_runtime_ids) ==
    LET eligible_ids == { candidate \in DOMAIN arg_member_session_bindings : arg_member_session_bindings[candidate] /= "" /\ candidate \in DOMAIN arg_identity_to_runtime /\ arg_identity_to_runtime[candidate] \in arg_live_runtime_ids }
    IN expected_runtime_ids = { arg_identity_to_runtime[id] : id \in eligible_ids }
mob__entry_packet__mob_machine_member_peer_endpoint_peer_id(endpoint) == endpoint.peer_id
mob__entry_packet__mob_machine_host_id_matches_peer_id(host_id, peer_id) == host_id = peer_id
mob__entry_packet__mob_machine_member_peer_id_available_for_identity(current_endpoints, prior_endpoints, agent_identity, candidate_endpoint) ==
    /\ \A other_identity \in DOMAIN current_endpoints : other_identity = agent_identity \/ current_endpoints[other_identity].peer_id /= candidate_endpoint.peer_id
    /\ \A other_identity \in DOMAIN prior_endpoints : other_identity = agent_identity \/ \A endpoint \in prior_endpoints[other_identity] : endpoint.peer_id /= candidate_endpoint.peer_id
mob__entry_packet__mob_machine_member_has_no_external_peer_edges(edges, agent_identity) ==
    \A edge \in edges : edge.local /= agent_identity
mob__entry_packet__mob_machine_member_prior_peer_endpoints_after_migration(all_prior_endpoints, agent_identity, current_endpoint, next_endpoint) ==
    LET prior == IF agent_identity \in DOMAIN all_prior_endpoints THEN all_prior_endpoints[agent_identity] ELSE {}
        retained == { endpoint \in (prior \cup {current_endpoint}) : endpoint.peer_id /= next_endpoint.peer_id }
    IN IF retained = {}
       THEN [id \in (DOMAIN all_prior_endpoints \ {agent_identity}) |-> all_prior_endpoints[id]]
       ELSE [id \in (DOMAIN all_prior_endpoints \cup {agent_identity}) |-> IF id = agent_identity THEN retained ELSE all_prior_endpoints[id]]
mob__entry_packet__mob_machine_member_endpoint_migration_cleanup_peer_id(endpoint_identity, migrated_identity, retained_peer_endpoint, current_peer_ids) ==
    IF endpoint_identity = migrated_identity THEN retained_peer_endpoint.peer_id ELSE current_peer_ids[endpoint_identity]
mob__entry_packet__mob_machine_wiring_edge_a(edge) == edge.a
mob__entry_packet__mob_machine_wiring_edge_b(edge) == edge.b
mob__entry_packet__mob_machine_wiring_edge_contains_identity(edge, agent_identity) == edge.a = agent_identity \/ edge.b = agent_identity
mob__entry_packet__mob_machine_member_peer_overlay_complete(arg_wiring_edges, arg_member_peer_endpoints, agent_identity) ==
    \A edge \in arg_wiring_edges: IF edge.a = agent_identity THEN edge.b \in DOMAIN arg_member_peer_endpoints ELSE IF edge.b = agent_identity THEN edge.a \in DOMAIN arg_member_peer_endpoints ELSE TRUE
mob__entry_packet__mob_machine_member_peer_overlay(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity) ==
    LET outgoing_edges == { edge \in arg_wiring_edges : edge.a = agent_identity /\ edge.b \in DOMAIN arg_member_peer_endpoints }
        incoming_edges == { edge \in arg_wiring_edges : edge.b = agent_identity /\ edge.a \in DOMAIN arg_member_peer_endpoints }
        local_external_edges == { edge \in arg_external_peer_edges : edge.local = agent_identity }
    IN { arg_member_peer_endpoints[edge.b] : edge \in outgoing_edges }
       \cup { arg_member_peer_endpoints[edge.a] : edge \in incoming_edges }
       \cup { [name |-> edge.endpoint.name, peer_id |-> edge.endpoint.peer_id, address |-> edge.endpoint.address, signing_key |-> edge.endpoint.signing_key] : edge \in local_external_edges }
mob__entry_packet__mob_machine_wiring_contains_pair(arg_wiring_edges, a_identity, b_identity) == \E edge \in arg_wiring_edges: (edge.a = a_identity /\ edge.b = b_identity) \/ (edge.a = b_identity /\ edge.b = a_identity)
mob__entry_packet__mob_machine_member_peer_overlay_without_identity_complete(arg_wiring_edges, arg_member_peer_endpoints, agent_identity, excluded_identity) ==
    \A edge \in arg_wiring_edges: IF edge.a = agent_identity /\ edge.b # excluded_identity THEN edge.b \in DOMAIN arg_member_peer_endpoints ELSE IF edge.b = agent_identity /\ edge.a # excluded_identity THEN edge.a \in DOMAIN arg_member_peer_endpoints ELSE TRUE
mob__entry_packet__mob_machine_member_peer_overlay_without_identity(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity, excluded_identity) ==
    LET outgoing_edges == { edge \in arg_wiring_edges : edge.a = agent_identity /\ edge.b # excluded_identity /\ edge.b \in DOMAIN arg_member_peer_endpoints }
        incoming_edges == { edge \in arg_wiring_edges : edge.b = agent_identity /\ edge.a # excluded_identity /\ edge.a \in DOMAIN arg_member_peer_endpoints }
        local_external_edges == { edge \in arg_external_peer_edges : edge.local = agent_identity }
    IN { arg_member_peer_endpoints[edge.b] : edge \in outgoing_edges }
       \cup { arg_member_peer_endpoints[edge.a] : edge \in incoming_edges }
       \cup { [name |-> edge.endpoint.name, peer_id |-> edge.endpoint.peer_id, address |-> edge.endpoint.address, signing_key |-> edge.endpoint.signing_key] : edge \in local_external_edges }
mob__entry_packet__mob_machine_member_peer_overlay_without_identity_peer_ids_unique(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity, excluded_identity) ==
    LET overlay == mob__entry_packet__mob_machine_member_peer_overlay_without_identity(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity, excluded_identity) IN Cardinality(overlay) = Cardinality({endpoint.peer_id : endpoint \in overlay})
mob__entry_packet__mob_machine_member_peer_overlay_peer_ids_unique(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity) ==
    LET overlay == mob__entry_packet__mob_machine_member_peer_overlay(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity) IN Cardinality(overlay) = Cardinality({endpoint.peer_id : endpoint \in overlay})
mob__entry_packet__mob_machine_wiring_edge_matches_members(edge, a_identity, b_identity) ==
    /\ edge.a = a_identity
    /\ edge.b = b_identity
mob__entry_packet__mob_machine_run_step_status_after_set(all_statuses, run_id, step_id, status) ==
    LET current == IF run_id \in DOMAIN all_statuses THEN all_statuses[run_id] ELSE [x \in {} |-> None]
    IN MapSet(all_statuses, run_id, MapSet(current, step_id, Some(status)))
mob__entry_packet__mob_machine_run_step_status_after_cancel_unfinished(all_statuses, run_id) ==
    LET current == IF run_id \in DOMAIN all_statuses THEN all_statuses[run_id] ELSE [x \in {} |-> None]
        folded == [step_id \in DOMAIN current |-> IF current[step_id] = None \/ current[step_id] = Some("Dispatched") THEN Some("Canceled") ELSE current[step_id]]
    IN MapSet(all_statuses, run_id, folded)
mob__entry_packet__mob_machine_run_step_bool_after_set(all_values, run_id, step_id, value) ==
    LET current == IF run_id \in DOMAIN all_values THEN all_values[run_id] ELSE [x \in {} |-> FALSE]
    IN MapSet(all_values, run_id, MapSet(current, step_id, value))
mob__entry_packet__mob_machine_run_step_condition_result_after_set(all_results, run_id, step_id, result) ==
    LET current == IF run_id \in DOMAIN all_results THEN all_results[run_id] ELSE [x \in {} |-> None]
    IN MapSet(all_results, run_id, MapSet(current, step_id, Some(result)))
mob__entry_packet__mob_machine_run_step_u64_after_set(all_counts, run_id, step_id, value) ==
    LET current == IF run_id \in DOMAIN all_counts THEN all_counts[run_id] ELSE [x \in {} |-> 0]
    IN MapSet(all_counts, run_id, MapSet(current, step_id, value))
mob__entry_packet__mob_machine_run_step_u64_after_increment(all_counts, run_id, step_id, delta) ==
    LET current == IF run_id \in DOMAIN all_counts THEN all_counts[run_id] ELSE [x \in {} |-> 0]
        current_value == IF step_id \in DOMAIN current THEN current[step_id] ELSE 0
    IN MapSet(all_counts, run_id, MapSet(current, step_id, current_value + delta))
mob__entry_packet__mob_machine_run_retry_count_after_increment(all_counts, run_id, retry_key, delta) ==
    LET current == IF run_id \in DOMAIN all_counts THEN all_counts[run_id] ELSE [x \in {} |-> 0]
        current_value == IF retry_key \in DOMAIN current THEN current[retry_key] ELSE 0
    IN MapSet(all_counts, run_id, MapSet(current, retry_key, current_value + delta))
mob__entry_packet__mob_machine_frame_node_bool_after_set(all_values, frame_id, node_id, value) ==
    LET current == IF frame_id \in DOMAIN all_values THEN all_values[frame_id] ELSE [x \in {} |-> FALSE]
    IN MapSet(all_values, frame_id, MapSet(current, node_id, value))
mob__entry_packet__mob_machine_node_terminal(status) == status \in {"Completed", "Failed", "Skipped", "Canceled"}
mob__entry_packet__mob_machine_step_status_from_frame_node_status(status) ==
    IF status = "Completed" THEN "Completed"
    ELSE IF status = "Skipped" THEN "Skipped"
    ELSE IF status = "Failed" THEN "Failed"
    ELSE IF status = "Canceled" THEN "Canceled"
    ELSE "Dispatched"
mob__entry_packet__mob_machine_frame_node_status_after_admit(all_statuses, frame_branches, ordered_nodes_by_frame, frame_id, node_id) ==
    LET current == IF frame_id \in DOMAIN all_statuses THEN all_statuses[frame_id] ELSE [x \in {} |-> None]
        branches == IF frame_id \in DOMAIN frame_branches THEN frame_branches[frame_id] ELSE [x \in {} |-> None]
        admitted_branch == IF node_id \in DOMAIN branches THEN branches[node_id] ELSE None
        after_branch_reservation == [candidate \in DOMAIN current |->
            IF admitted_branch # None
                /\ candidate # node_id
                /\ candidate \in DOMAIN branches
                /\ branches[candidate] = admitted_branch
                /\ current[candidate] = "Ready"
            THEN "Pending" ELSE current[candidate]]
        after_admit == MapSet(after_branch_reservation, node_id, "Running")
    IN MapSet(all_statuses, frame_id, after_admit)
mob__entry_packet__mob_machine_frame_ready_queue_after_terminal(all_ready_queues, all_statuses, ordered_nodes_by_frame, frame_id) ==
    LET statuses == IF frame_id \in DOMAIN all_statuses THEN all_statuses[frame_id] ELSE [x \in {} |-> None]
        ordered == IF frame_id \in DOMAIN ordered_nodes_by_frame THEN ordered_nodes_by_frame[frame_id] ELSE <<>>
    IN MapSet(all_ready_queues, frame_id, SelectSeq(ordered, LAMBDA candidate: candidate \in DOMAIN statuses /\ statuses[candidate] = "Ready"))
mob__entry_packet__mob_machine_frame_ready_queue_after_admit(all_ready_queues, all_statuses, ordered_nodes_by_frame, frame_id) ==
    mob__entry_packet__mob_machine_frame_ready_queue_after_terminal(all_ready_queues, all_statuses, ordered_nodes_by_frame, frame_id)
mob__entry_packet__mob_machine_frame_node_status_after_terminal_branch(current, branches, node_id, terminal_status) ==
    LET after_terminal == MapSet(current, node_id, terminal_status)
    IN [candidate \in DOMAIN after_terminal |->
        IF terminal_status = "Completed" /\ candidate # node_id
            /\ candidate \in DOMAIN branches /\ node_id \in DOMAIN branches
            /\ branches[node_id] # None
            /\ branches[candidate] = branches[node_id]
            /\ ~mob__entry_packet__mob_machine_node_terminal(after_terminal[candidate])
            /\ after_terminal[candidate] # "Running"
        THEN "Skipped" ELSE after_terminal[candidate]]
mob__entry_packet__mob_machine_frame_node_status_after_terminal_dependencies(after_branch, dependencies, dependency_modes) ==
    [candidate \in DOMAIN after_branch |->
        IF after_branch[candidate] # "Pending" THEN after_branch[candidate]
        ELSE LET deps == IF candidate \in DOMAIN dependencies THEN dependencies[candidate] ELSE <<>>
                 mode == IF candidate \in DOMAIN dependency_modes THEN dependency_modes[candidate] ELSE "All"
                 failed == Len(deps) # 0
                     /\ ((mode = "All" /\ \E dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] \in {"Failed", "Skipped", "Canceled"})
                         \/ (mode = "Any" /\ \A dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] \in {"Failed", "Skipped", "Canceled"}))
                 satisfied == Len(deps) = 0
                     \/ (mode = "All" /\ \A dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] = "Completed")
                     \/ (mode = "Any" /\ \E dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] = "Completed")
             IN IF failed THEN "Skipped" ELSE IF satisfied THEN "Ready" ELSE after_branch[candidate]]
mob__entry_packet__mob_machine_frame_node_status_after_terminal(all_statuses, frame_branches, ordered_nodes_by_frame, dependencies_by_frame, dependency_modes_by_frame, frame_id, node_id, terminal_status) ==
    LET current == IF frame_id \in DOMAIN all_statuses THEN all_statuses[frame_id] ELSE [x \in {} |-> None]
        branches == IF frame_id \in DOMAIN frame_branches THEN frame_branches[frame_id] ELSE [x \in {} |-> None]
        dependencies == IF frame_id \in DOMAIN dependencies_by_frame THEN dependencies_by_frame[frame_id] ELSE [x \in {} |-> <<>>]
        dependency_modes == IF frame_id \in DOMAIN dependency_modes_by_frame THEN dependency_modes_by_frame[frame_id] ELSE [x \in {} |-> "All"]
        after_branch == mob__entry_packet__mob_machine_frame_node_status_after_terminal_branch(current, branches, node_id, terminal_status)
        after_dependencies == mob__entry_packet__mob_machine_frame_node_status_after_terminal_dependencies(after_branch, dependencies, dependency_modes)
    IN MapSet(all_statuses, frame_id, after_dependencies)

