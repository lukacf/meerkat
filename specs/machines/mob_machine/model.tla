    /\ replacement_host_binding_generations' = MapRemove(replacement_host_binding_generations, host_id)
    /\ host_bind_phase' = MapRemove(host_bind_phase, host_id)
    /\ host_protocol_min' = MapRemove(host_protocol_min, host_id)
    /\ host_protocol_max' = MapRemove(host_protocol_max, host_id)
    /\ host_engine_versions' = MapRemove(host_engine_versions, host_id)
    /\ host_durable_sessions' = MapRemove(host_durable_sessions, host_id)
    /\ host_autonomous_members' = MapRemove(host_autonomous_members, host_id)
