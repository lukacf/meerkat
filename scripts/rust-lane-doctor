#!/usr/bin/env bash
set -euo pipefail

workspace_root="$(git rev-parse --show-toplevel)"
cd "${workspace_root}"

ok=0
warn=0
fail=0

pass() {
  ok=$((ok + 1))
  printf 'PASS %s\n' "$1"
}

note() {
  warn=$((warn + 1))
  printf 'WARN %s\n' "$1"
}

bad() {
  fail=$((fail + 1))
  printf 'FAIL %s\n' "$1"
}

value_from_env() {
  local key="$1"
  local text="$2"
  printf '%s\n' "${text}" | awk -F= -v key="${key}" '$1 == key { print substr($0, length(key) + 2) }'
}

contains_line() {
  local needle="$1"
  local text="$2"
  [[ $'\n'"${text}"$'\n' == *$'\n'"${needle}"$'\n'* ]]
}

doctor_output="$(./scripts/repo-cargo --doctor 2>&1 || true)"
if contains_line "doctor=ok" "${doctor_output}"; then
  pass "repo-cargo doctor passes"
else
  bad "repo-cargo doctor failed"
  printf '%s\n' "${doctor_output}" >&2
fi

default_env="$(./scripts/repo-cargo --print-env)"
default_target="$(value_from_env CARGO_TARGET_DIR "${default_env}")"
default_home="$(value_from_env CARGO_HOME "${default_env}")"
default_lane="$(value_from_env lane_key "${default_env}")"
default_rustup_toolchain="$(value_from_env RUSTUP_TOOLCHAIN "${default_env}")"
default_toolchain_bin="$(value_from_env MEERKAT_RUST_TOOLCHAIN_BIN "${default_env}")"
default_rustc="$(value_from_env RUSTC "${default_env}")"
if [[ "${default_target}" == "${workspace_root}"* || "${default_home}" == "${workspace_root}"* ]]; then
  bad "Cargo cache paths resolve inside the repository"
else
  pass "Cargo cache paths are outside the repository"
fi

lane_a_env="$(RUST_LANE_ID=doctor-a ./scripts/repo-cargo --print-env)"
lane_b_env="$(RUST_LANE_ID=doctor-b ./scripts/repo-cargo --print-env)"
lane_a_target="$(value_from_env CARGO_TARGET_DIR "${lane_a_env}")"
lane_b_target="$(value_from_env CARGO_TARGET_DIR "${lane_b_env}")"
lane_a_home="$(value_from_env CARGO_HOME "${lane_a_env}")"
lane_b_home="$(value_from_env CARGO_HOME "${lane_b_env}")"
lane_a_toolchain_bin="$(value_from_env MEERKAT_RUST_TOOLCHAIN_BIN "${lane_a_env}")"
lane_b_toolchain_bin="$(value_from_env MEERKAT_RUST_TOOLCHAIN_BIN "${lane_b_env}")"

if [[ "${lane_a_target}" != "${lane_b_target}" &&
  "${lane_a_toolchain_bin}" != "${lane_b_toolchain_bin}" ]]; then
  pass "RUST_LANE_ID creates distinct target and toolchain-wrapper directories"
else
  bad "RUST_LANE_ID target or toolchain-wrapper directories collide"
fi

codex_agent_env="$(
  env -u RUST_LANE_ID -u MEERKAT_AGENT_LANE -u GITHUB_JOB -u GITHUB_RUN_ID \
    -u GITHUB_RUN_ATTEMPT CODEX_AGENT_ID=doctor-codex-agent \
    ./scripts/repo-cargo --print-env
)"
codex_agent_lane="$(value_from_env lane_key "${codex_agent_env}")"
if [[ "${codex_agent_lane}" == "doctor-codex-agent" ]]; then
  pass "CODEX_AGENT_ID creates a distinct same-worktree Cargo lane"
else
  bad "CODEX_AGENT_ID was not used as the default Cargo lane"
fi

github_lane_env="$(
  env -u RUST_LANE_ID -u MEERKAT_AGENT_LANE -u CODEX_AGENT_ID \
    GITHUB_JOB=fmt-lint GITHUB_RUN_ID=12345 GITHUB_RUN_ATTEMPT=2 \
    ./scripts/repo-cargo --print-env
)"
github_lane="$(value_from_env lane_key "${github_lane_env}")"
if [[ "${github_lane}" == "gha-12345-2-fmt-lint" ]]; then
  pass "GitHub Actions target lanes are isolated per run attempt"
else
  bad "GitHub Actions target lanes do not include the run attempt"
fi

if [[ "${lane_a_home}" == "${lane_b_home}" ]]; then
  pass "Cargo home stays shared per repository"
else
  bad "Cargo home changes across same-repo lanes"
fi

repo_cache_identity_probe="$(./scripts/test-repo-cargo-cache-identity.sh 2>&1 || true)"
if contains_line "repo-cargo linked-worktree cache identity selftest passed" "${repo_cache_identity_probe}"; then
  pass "linked worktrees share repository cache identity while default lanes stay isolated"
else
  bad "linked worktrees split repository caches or collapse default lanes"
  printf '%s\n' "${repo_cache_identity_probe}" >&2
fi

fast_profile_output="$(./scripts/repo-cargo nextest show-config version --profile fast --color never --no-pager 2>&1 || true)"
if grep -q '\[profile.fast\]' .config/nextest.toml &&
  grep -q 'default-filter' .config/nextest.toml &&
  [[ "${fast_profile_output}" != *"error:"* ]]; then
  pass "nextest fast profile is valid"
else
  bad "nextest fast profile is invalid"
fi

if grep -q '^e2e-build = ' .cargo/config.toml &&
  grep -q -- '--test e2e_build_lane' .cargo/config.toml &&
  grep -q -- '--run-ignored ignored-only' .cargo/config.toml; then
  pass "e2e-build is an explicit nextest ignored lane"
else
  bad "e2e-build is not configured as an explicit ignored nextest lane"
fi

if awk '/^test-all:/ { in_target=1; next } /^[[:alnum:]_.-]+:/ { in_target=0 } in_target && /nextest run --workspace/ { found=1 } END { exit found ? 0 : 1 }' Makefile; then
  bad "Makefile test-all runs a broad workspace nextest command"
else
  pass "Makefile test-all delegates to the filtered fast profile"
fi

# ripgrep exits 0 when it finds a match and 1 when it finds none. Any other
# status (2 for an unreadable path or a bad pattern, 127 when rg is missing)
# means the scan did not run; that must fail, never read as "no bypass".
raw_cargo_shell_scan_status=0
raw_cargo_shell_hits="$(
  rg -n '^\s*(cargo|exec cargo)\s+(check|test|nextest|run|xtask|build|unit|int|e2e|clippy|fmt|machete)\b|\bcargo run -p xtask\b' \
    scripts specs \
    --glob '*.sh' \
    --glob '!scripts/repo-cargo' 2>&1
)" || raw_cargo_shell_scan_status=$?
if [[ "${raw_cargo_shell_scan_status}" -eq 0 ]]; then
  bad "shell build/test entrypoints bypass scripts/repo-cargo"
  printf '%s\n' "${raw_cargo_shell_hits}" >&2
elif [[ "${raw_cargo_shell_scan_status}" -eq 1 ]]; then
  pass "shell build/test entrypoints use the repo Cargo wrapper"
else
  bad "shell build/test entrypoint scan failed (rg exit ${raw_cargo_shell_scan_status}; 127 means ripgrep is not installed)"
  printf '%s\n' "${raw_cargo_shell_hits}" >&2
fi

raw_cargo_workflow_hits="$(python3 - <<'PYTHON'
from pathlib import Path
import re

# The ripgrep scan this replaces, without needing ripgrep: the same pattern,
# per "\n"-separated line, over every readable file below .github/workflows.
# The ASCII lookahead is rg's `\b` after the subcommand; Python's Unicode `\s`
# covers rg's. Where the two differ, this flags a line rg missed, never the
# reverse.
RAW_CARGO = re.compile(
    r"run: cargo"
    r"|^\s+cargo (?:check|test|nextest|run|xtask|build|unit|int|e2e|clippy|machete)"
    r"(?![A-Za-z0-9_])"
)

root = Path(".github/workflows")
if root.is_dir():
    for path in sorted(entry for entry in root.rglob("*") if entry.is_file()):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line_number, line in enumerate(text.split("\n"), 1):
            if RAW_CARGO.search(line):
                print(f"{path}:{line_number}:{line}")
PYTHON
)"
direct_nextest_workflow_hits="$(python3 - <<'PYTHON'
from pathlib import Path
import shlex


def check_command(path, line_number, command):
    if "cargo-nextest" not in command:
        return
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|")
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        print(f"{path}:{line_number}: cannot validate direct Nextest command")
        return
    for index, token in enumerate(tokens):
        if Path(token).name != "cargo-nextest":
            continue
        if token != "cargo-nextest" or tokens[index + 1:index + 3] not in (
                ["nextest", "run"], ["nextest", "list"]):
            print(f"{path}:{line_number}: only literal direct Nextest archive run/list is allowed")
            continue
        arguments = []
        for argument in tokens[index + 3:]:
            if argument == "--" or set(argument) <= set(";&|"):
                break
            arguments.append(argument)
        if not any(argument == "--archive-file" or argument.startswith("--archive-file=")
                   for argument in arguments):
            print(f"{path}:{line_number}: direct Nextest run/list requires --archive-file")


for path in sorted(Path(".github/workflows").glob("*.y*ml")):
    pending = ""
    first_line = 0
    for line_number, line in enumerate(path.read_text().splitlines(), 1):
        if not pending:
            first_line = line_number
        line = line.rstrip()
        continued = False
        if line.endswith("\\"):
            try:
                shlex.split(line, comments=True)
            except ValueError:
                continued = True
        pending += line[:-1] + " " if continued else line
        if not continued:
            check_command(path, first_line, pending)
            pending = ""
    if pending:
        check_command(path, first_line, pending)
PYTHON
)"
if [[ -n "${raw_cargo_workflow_hits}" || -n "${direct_nextest_workflow_hits}" ]]; then
  bad "GitHub workflow Rust entrypoints bypass scripts/repo-cargo"
  printf '%s\n' "${raw_cargo_workflow_hits}" >&2
  printf '%s\n' "${direct_nextest_workflow_hits}" >&2
else
  pass "GitHub workflow Rust entrypoints use the repo Cargo wrapper"
fi

# Bash >= 4.4 for the repository scripts (`#!/usr/bin/env bash`); see
# scripts/lib/require-bash.sh. Check what `env bash` resolves to.
env_bash_versinfo="$(env bash -c 'printf "%s %s %s" "${BASH_VERSINFO[0]:-0}" "${BASH_VERSINFO[1]:-0}" "${BASH_VERSION:-unknown}"' 2>/dev/null || true)"
read -r env_bash_major env_bash_minor env_bash_version <<<"${env_bash_versinfo:-0 0 missing}"
if [[ "${env_bash_major}" -gt 4 || ( "${env_bash_major}" -eq 4 && "${env_bash_minor}" -ge 4 ) ]]; then
  pass "env bash ${env_bash_version} satisfies >= 4.4"
else
  bad "env bash is ${env_bash_version}; repository scripts need Bash >= 4.4 (macOS: brew install bash, ahead of /bin in PATH)"
fi

rust_channel="$(awk -F '"' '/^[[:space:]]*channel[[:space:]]*=/ { print $2; exit }' rust-toolchain.toml)"
default_rustc_release=""
if [[ -x "${default_rustc}" ]]; then
  default_rustc_verbose="$("${default_rustc}" -Vv 2>/dev/null || true)"
  default_rustc_release="$(printf '%s\n' "${default_rustc_verbose}" | awk -F ': ' '$1 == "release" { print $2; exit }')"
fi
if [[ -n "${rust_channel}" ]] &&
  [[ "${default_rustc_release}" == "${rust_channel}" ]] &&
  [[ "${default_rustc}" == "${default_home}/.repo-cargo-toolchain-bin/${rust_channel}-"*"/${default_lane}/rustc" ]] &&
  [[ "${default_toolchain_bin}" == "${default_home}/.repo-cargo-toolchain-bin/${rust_channel}-"*"/${default_lane}" ]]; then
  pass "repo-cargo resolves stable pinned Rust toolchain wrappers"
else
  bad "repo-cargo does not resolve stable pinned Rust toolchain wrappers"
fi

# The toolchain action is pinned to a commit of its `<channel>` branch, which
# installs that channel (it takes no toolchain input); the `# <channel>`
# comment names the ref the commit was resolved from.
if [[ -n "${rust_channel}" ]] &&
  grep -Eq "dtolnay/rust-toolchain@[0-9a-f]{40} # ${rust_channel//./\\.}\$" .github/actions/setup-rust-ci/action.yml &&
  grep -Eq "dtolnay/rust-toolchain@[0-9a-f]{40} # ${rust_channel//./\\.}\$" .github/actions/setup-buildbuddy-ci/action.yml &&
  ! grep -Eq '^ +toolchain:' .github/actions/setup-rust-ci/action.yml .github/actions/setup-buildbuddy-ci/action.yml &&
  grep -Fq "uses: ./.github/actions/setup-rust-ci" .github/workflows/cargo.yml &&
  ! grep -Fq 'dtolnay/rust-toolchain@stable' .github/workflows/cargo.yml &&
  ! grep -Fq 'dtolnay/rust-toolchain@stable' .github/actions/setup-buildbuddy-ci/action.yml; then
  pass "Cargo and BuildBuddy CI install the pinned Rust toolchain"
else
  bad "Cargo or BuildBuddy CI Rust toolchain does not match rust-toolchain.toml"
fi

if [[ -n "${rust_channel}" ]] &&
  [[ "${default_rustup_toolchain}" == "${rust_channel}" ]] &&
  grep -Fq "RUSTUP_TOOLCHAIN: ${rust_channel}" .github/workflows/cargo.yml &&
  grep -Fq "RUSTUP_TOOLCHAIN: ${rust_channel}" .github/workflows/buildbuddy.yml &&
  grep -Fq "RUSTUP_TOOLCHAIN: ${rust_channel}" .github/actions/setup-buildbuddy-ci/action.yml &&
  grep -Fq "scripts/ci-pin-rust-toolchain-env" .github/actions/setup-rust-ci/action.yml &&
  grep -Fq "scripts/ci-pin-rust-toolchain-env" .github/actions/setup-buildbuddy-ci/action.yml &&
  grep -Fq "RUSTC=" scripts/ci-pin-rust-toolchain-env &&
  grep -Fq 'GITHUB_PATH' scripts/ci-pin-rust-toolchain-env; then
  pass "Cargo and BuildBuddy CI export stable pinned Rust toolchain wrappers"
else
  bad "Cargo or BuildBuddy CI can fall back to runner Rust binaries"
fi

# Hosted runners give every job a fresh VM; the Cargo home must be STABLE
# across runs so rust-cache/sccache can reuse registry sources. (The old
# per-run /tmp isolation was for the retired shared self-hosted runner and
# invalidated every dep compile hash on hosted runners.)
if grep -q 'CARGO_HOME: /home/runner/.cargo' .github/workflows/cargo.yml &&
  grep -q 'CARGO_HOME: /home/runner/.cargo' .github/workflows/nightly.yml &&
  ! grep -Fq '${GITHUB_JOB:-job}' scripts/ci-pin-rust-toolchain-env; then
  pass "CI workflows use a stable per-VM Cargo home (cacheable across runs)"
else
  bad "CI Cargo home is unstable across runs (breaks sccache/rust-cache reuse)"
fi

selector_selftest_output="$(./scripts/rust-selector-selftest.mjs 2>&1 || true)"
if contains_line "rust selector selftest ok" "${selector_selftest_output}"; then
  pass "Rust selector module parser selftest passes"
else
  bad "Rust selector module parser selftest failed"
  printf '%s\n' "${selector_selftest_output}" >&2
fi

# The pre-push hook reuses source-test evidence across lock-only changes and
# leaves compiling the resolved graph to the required CI Clippy lanes: the CI
# planner treats a Cargo.lock change it cannot scope as global, so every
# package of the workspace plan is in a Clippy shard over all its targets
# (the shard's TARGETS).
lock_ci_probe="$(node scripts/ci-cargo-lanes.mjs --format json -- Cargo.lock 2>/dev/null || true)"
if [[ "${lock_ci_probe}" == *'"mode": "workspace"'* || "${lock_ci_probe}" == *'"mode":"workspace"'* ]] &&
  node -e 'const plan = JSON.parse(require("fs").readFileSync(0, "utf8")); const linted = new Set(plan.shards.flatMap((shard) => (shard.targets === "--all-targets" ? shard.packages : []))); process.exit(plan.packages.length > 0 && plan.packages.every((name) => linted.has(name)) ? 0 : 1)' <<<"${lock_ci_probe}" 2>/dev/null &&
  grep -Fq -- '--no-deps ${TARGETS} --all-features -- -D warnings' .github/workflows/ci.yml &&
  grep -Fq 'require_ran "Clippy"' .github/workflows/ci.yml; then
  pass "lock-only pushes leave the resolved workspace graph to required CI Clippy before merge"
else
  bad "lock-only pushes can reuse source tests without any required Clippy over the resolved graph"
  printf '%s\n' "${lock_ci_probe}" >&2
fi

# The local affected-test selection (scripts/affected-tests.mjs) runs an edit
# confined to integration test targets as just those targets, the modules
# they declare included, with the package's test features (no dev-dependency
# turns them on), and names a live-provider target instead of running it.
# Print-only: these read cargo metadata and the CI planner, no build.
exact_test_probe="$(node scripts/affected-tests.mjs -- crates/meerkat-runtime/tests/meerkat_machine.rs 2>&1 || true)"
if [[ "${exact_test_probe}" == *"nextest run -p meerkat-runtime --features live,local-authorization,sqlite-store,test-support --test meerkat_machine --profile"* &&
  "${exact_test_probe}" == *"meerkat-runtime: only test targets changed (meerkat_machine)"* ]]; then
  pass "affected tests narrow a direct integration test edit to its test binary"
else
  bad "affected tests did not narrow a direct integration test edit to its test binary"
  printf '%s\n' "${exact_test_probe}" >&2
fi

support_test_probe="$(node scripts/affected-tests.mjs -- crates/meerkat/tests/support/test_session_store.rs 2>&1 || true)"
if [[ "${support_test_probe}" == *"nextest run -p meerkat --features "*",workspace-tests --test "*"--test sdk_agentfactory --test sdk_structured_output --profile"* ]]; then
  pass "affected tests narrow an integration support edit to the importing test binaries"
else
  bad "affected tests did not narrow an integration support edit to the importing test binaries"
  printf '%s\n' "${support_test_probe}" >&2
fi

live_test_probe="$(node scripts/affected-tests.mjs -- crates/meerkat-cli/tests/cli_mobpack_live_smoke.rs 2>&1 || true)"
if [[ "${live_test_probe}" == *"rkat --test cli_mobpack_live_smoke needs integration-real-tests (live provider credentials): not run"* &&
  "${live_test_probe}" != *"cli_mobpack_live_smoke --profile"* ]]; then
  pass "affected tests name a live-provider test edit instead of running it"
else
  bad "affected tests ran or dropped a live-provider test edit"
  printf '%s\n' "${live_test_probe}" >&2
fi

if [[ -n "$(git status --short)" ]]; then
  note "working tree has local changes; doctor did not modify them"
else
  pass "working tree is clean"
fi

printf '\nRust lane doctor: %s pass, %s warn, %s fail\n' "${ok}" "${warn}" "${fail}"
if [[ "${fail}" -gt 0 ]]; then
  exit 1
fi
