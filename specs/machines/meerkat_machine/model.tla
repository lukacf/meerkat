EvictCompletedOpIdle(operation_id) ==
    /\ phase = "Idle"
    /\ (operation_id \in DOMAIN op_statuses)
    /\ (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Completed")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Failed")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Aborted")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Cancelled")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Retired")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Terminated")))))))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
