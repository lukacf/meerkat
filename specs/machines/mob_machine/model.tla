OptionLt(a, b) == IF b.tag = "none" THEN FALSE ELSE IF a.tag = "none" THEN TRUE ELSE a.value < b.value
OptionLe(a, b) == IF a.tag = "none" THEN TRUE ELSE IF b.tag = "none" THEN FALSE ELSE a.value <= b.value
