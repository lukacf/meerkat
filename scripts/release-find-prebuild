#!/usr/bin/env bash
# Find the pre-tag prebuild of a release commit.
#
# Usage: release-find-prebuild <release-commit-sha>
#
# Prints "<run id> <run attempt>" of the release.yml run whose prebuilt
# release artifacts serve <release-commit-sha>, or nothing when there is none:
#   - a workflow_dispatch run of .github/workflows/release.yml on main in this
#     repository (GITHUB_REPOSITORY), started and triggered by the repository
#     owner (or an account listed in MEERKAT_PREBUILD_ACTORS);
#   - whose head is that commit or, failing a usable run of exactly it, an
#     ancestor whose prebuild serves it: every path changed between the two is
#     a non-input of Core's release artifacts (scripts/release-prebuild-equivalent,
#     which needs this checkout's history; without it only the exact commit
#     qualifies). Runs of exactly the commit come first, then the others, each
#     newest first;
#   - whose "Release prebuild gate" job succeeded (only a
#     prebuild_release_artifacts dispatch has that job, and it passes once the
#     critical Linux and macOS arm64 binaries and the Web SDK package are
#     built; the run's trailing Intel macOS and Windows lanes may still be
#     running, and the tag's trailing publisher waits for them);
#   - whose critical artifacts are still downloadable: an unexpired archive
#     artifact for each critical target, no expired meerkat-* artifact, and
#     rkat-web-package.
# A matching run whose gate has not concluded yet is waited for, polling every
# MEERKAT_PREBUILD_POLL_SECONDS (default 60), until the gate concludes or
# MEERKAT_PREBUILD_WAIT_SECONDS (default 8400) have passed since the run
# started: a prebuild already under way finishes no later than a fresh build.
# The default leaves about 45 minutes over the slowest gate measured on the
# backend tags select (v0.9.2's BuildBuddy prebuild: 94.7 minutes). A run one
# of whose CRITICAL_JOBS (the jobs the gate needs) failed, timed out or was
# cancelled is given up at once: its gate can no longer succeed. A usable run of
# exactly the commit is taken even while a run listed before it is still
# waited for. A run of an earlier commit is taken only while no run of exactly
# the commit is still waited for (the exact commit's prebuild is preferred),
# and never once one of its TRAILING_JOBS failed, timed out or was cancelled:
# the tag run would publish its critical archives and then stop without the
# trailing ones.
#
# The id is only a pointer, pinned to the attempt examined here: the
# publishing jobs verify every archive and the Web SDK package against their
# build attestations, that attempt's gates and the commit equivalence again,
# before anything is published. "No prebuild" exits 0 with empty output; an
# API failure exits non-zero.

set -euo pipefail
shopt -s inherit_errexit

PREBUILD_GATE_JOB="Release prebuild gate"
CRITICAL_TARGETS=(x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu aarch64-apple-darwin)
WEB_SDK_ARTIFACT="rkat-web-package"
EQUIVALENCE="$(dirname "${BASH_SOURCE[0]}")/release-prebuild-equivalent"
# Display names, a glob for the matrix legs.
CRITICAL_JOBS=(
  "Require green CI"
  "Build and package surface binaries with GitHub-hosted runners (*)"
  "Build and package surface binaries via BuildBuddy"
  "Build Web SDK package"
  "Release critical binary build gate"
)
# The trailing lanes and the full binary build gate, display names, a glob for
# the matrix legs.
TRAILING_JOBS=(
  "Release binary build gate"
  "Cross-compile and package Windows surface binaries on Linux"
  "Verify Windows binaries on a Windows runner"
  "Cross-compile and package Intel macOS surface binaries on Apple silicon (*)"
  "Build and package Intel macOS surface binaries via BuildBuddy"
  "Run and inspect the BuildBuddy Intel macOS binaries on Apple silicon"
)

usage() {
  sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

[[ "$#" -eq 1 ]] || usage
release_sha="$1"
[[ "${release_sha}" =~ ^[0-9a-f]{40}$ ]] || {
  echo "release-find-prebuild: expected a full commit sha, got ${release_sha}" >&2
  exit 2
}
repository="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY must name the repository}"
poll_seconds="${MEERKAT_PREBUILD_POLL_SECONDS:-60}"
wait_seconds="${MEERKAT_PREBUILD_WAIT_SECONDS:-8400}"
[[ "${poll_seconds}" =~ ^[0-9]+$ && "${wait_seconds}" =~ ^[0-9]+$ ]] || {
  echo "release-find-prebuild: poll and wait seconds must be integers" >&2
  exit 2
}

log() {
  printf '%s\n' "$*" >&2
}

equivalence_cache="$(mktemp -d "${TMPDIR:-/tmp}/release-find-prebuild.XXXXXX")"
trap 'rm -rf "${equivalence_cache}"' EXIT

# id<TAB>status<TAB>started-epoch<TAB>attempt<TAB>head of every release.yml
# dispatch on main in this repository, by an allowed actor, that the runs
# query $1 lists, newest first.
list_runs() {
  local query="$1" listing
  listing="$(gh api \
    "repos/${repository}/actions/workflows/release.yml/runs?${query}" \
    --jq '.workflow_runs[] | [.id, .status, .path, .event, .head_branch, .head_sha, .repository.full_name, (.run_started_at // .created_at), .run_attempt, (.actor.login // ""), (.triggering_actor.login // ""), (.repository.owner.login // "")] | @tsv')" ||
    { log "cannot list release.yml runs (${query})"; return 1; }
  local id status path event branch sha repo started attempt actor trigger owner allowed
  while IFS=$'\t' read -r id status path event branch sha repo started attempt actor trigger owner; do
    [[ -n "${id}" ]] || continue
    # The query parameters filter server-side; check every field again.
    if [[ "${path}" != ".github/workflows/release.yml" || "${event}" != "workflow_dispatch" ||
          "${branch}" != "main" || "${repo}" != "${repository}" ]]; then
      continue
    fi
    allowed=" ${MEERKAT_PREBUILD_ACTORS:-${owner}} "
    if [[ -z "${actor}" || -z "${trigger}" || "${allowed}" != *" ${actor} "* || "${allowed}" != *" ${trigger} "* ]]; then
      log "run ${id}: started by ${actor:-unknown}, triggered by ${trigger:-unknown}; only${allowed%% }may prebuild a release"
      continue
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "${id}" "${status}" "$(date -u -d "${started}" +%s)" "${attempt}" "${sha}"
  done <<<"${listing}" | sort -t $'\t' -k1,1nr
}

# Whether a prebuild of commit $1, which is not the release commit, serves the
# release (scripts/release-prebuild-equivalent), decided once per commit.
serves_release() {
  local commit="$1" verdict
  verdict="${equivalence_cache}/${commit}"
  if [[ ! -f "${verdict}" ]]; then
    if [[ "${commit}" =~ ^[0-9a-f]{40}$ ]] && "${EQUIVALENCE}" "${commit}" "${release_sha}" >"${verdict}.log" 2>&1; then
      echo serves >"${verdict}"
      log "$(cat "${verdict}.log")"
    else
      echo refused >"${verdict}"
      log "$(head -n 1 "${verdict}.log" 2>/dev/null || echo "${commit}: not a commit")"
    fi
  fi
  [[ "$(cat "${verdict}")" == serves ]]
}

# id<TAB>status<TAB>started-epoch<TAB>attempt<TAB>head for every candidate run:
# the runs of exactly the release commit, then the runs of other commits whose
# prebuild serves it, each newest first.
candidate_runs() {
  local exact others id status started attempt sha
  exact="$(list_runs "event=workflow_dispatch&branch=main&head_sha=${release_sha}&per_page=100")" || return 1
  others="$(list_runs "event=workflow_dispatch&branch=main&per_page=100")" || return 1
  while IFS=$'\t' read -r id status started attempt sha; do
    [[ -n "${id}" && "${sha}" == "${release_sha}" ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "${id}" "${status}" "${started}" "${attempt}" "${sha}"
  done <<<"${exact}"
  while IFS=$'\t' read -r id status started attempt sha; do
    [[ -n "${id}" && "${sha}" != "${release_sha}" ]] || continue
    serves_release "${sha}" || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "${id}" "${status}" "${started}" "${attempt}" "${sha}"
  done <<<"${others}"
}

# The prebuild gate's conclusion: success, failure, ..., "pending" while it
# has not concluded, "absent" when the run has no such job, or "doomed" when
# it has not concluded but one of the CRITICAL_JOBS failed, timed out or was
# cancelled; then a tab and the first of the TRAILING_JOBS that failed, timed
# out or was cancelled ("<name>: <conclusion>"), empty when none did.
prebuild_gate_state() {
  local run_id="$1" listing name conclusion critical pattern gate="absent" doomed="" trailing=""
  listing="$(gh api --paginate "repos/${repository}/actions/runs/${run_id}/jobs?per_page=100" \
    --jq '.jobs[] | [.name, (.conclusion // "pending")] | @tsv')" ||
    { log "cannot list the jobs of run ${run_id}"; exit 1; }
  while IFS=$'\t' read -r name conclusion; do
    if [[ "${name}" == "${PREBUILD_GATE_JOB}" ]]; then
      gate="${conclusion}"
    fi
    for critical in "${CRITICAL_JOBS[@]}"; do
      # shellcheck disable=SC2053 # a glob
      if [[ "${name}" == ${critical} && "${conclusion}" =~ ^(failure|timed_out|cancelled)$ ]]; then
        doomed="${name}: ${conclusion}"
      fi
    done
    for pattern in "${TRAILING_JOBS[@]}"; do
      # shellcheck disable=SC2053 # a glob
      if [[ -z "${trailing}" && "${name}" == ${pattern} && "${conclusion}" =~ ^(failure|timed_out|cancelled)$ ]]; then
        trailing="${name}: ${conclusion}"
      fi
    done
  done <<<"${listing}"
  if [[ -n "${doomed}" && ( "${gate}" == "pending" || "${gate}" == "absent" ) ]]; then
    log "run ${run_id}: ${doomed}, so its ${PREBUILD_GATE_JOB} cannot pass; not waiting for it"
    gate="doomed"
  fi
  printf '%s\t%s\n' "${gate}" "${trailing}"
}

artifacts_downloadable() {
  local run_id="$1" listing name expired target web=0 missing=()
  local -A critical=()
  listing="$(gh api --paginate "repos/${repository}/actions/runs/${run_id}/artifacts?per_page=100" \
    --jq '.artifacts[] | [.name, (.expired | tostring)] | @tsv')" ||
    { log "cannot list the artifacts of run ${run_id}"; exit 1; }
  while IFS=$'\t' read -r name expired; do
    [[ -n "${name}" ]] || continue
    case "${name}" in
      "${WEB_SDK_ARTIFACT}")
        [[ "${expired}" == "false" ]] && web=1
        ;;
      meerkat-*)
        if [[ "${expired}" != "false" ]]; then
          log "run ${run_id}: artifact ${name} has expired"
          return 1
        fi
        for target in "${CRITICAL_TARGETS[@]}"; do
          [[ "${name}" == "meerkat-${target}-"* ]] && critical["${target}"]=1
        done
        ;;
    esac
  done <<<"${listing}"
  for target in "${CRITICAL_TARGETS[@]}"; do
    [[ -n "${critical[${target}]:-}" ]] || missing+=("${target}")
  done
  [[ "${web}" -eq 1 ]] || missing+=("${WEB_SDK_ARTIFACT}")
  if [[ "${#missing[@]}" -gt 0 ]]; then
    log "run ${run_id}: critical artifacts missing: ${missing[*]}"
    return 1
  fi
}

while true; do
  runs="$(candidate_runs)"
  pending=0
  exact_pending=0
  while IFS=$'\t' read -r run_id status started attempt sha; do
    [[ -n "${run_id}" ]] || continue
    state="$(prebuild_gate_state "${run_id}")"
    gate="${state%%$'\t'*}"
    trailing="${state#*$'\t'}"
    if [[ "${gate}" == "pending" || ( "${gate}" == "absent" && "${status}" != "completed" ) ]]; then
      if (($(date -u +%s) - started < wait_seconds)); then
        log "run ${run_id} for ${sha} is ${status} and its ${PREBUILD_GATE_JOB} has not concluded; waiting for it"
        pending=1
        [[ "${sha}" != "${release_sha}" ]] || exact_pending=1
      else
        log "run ${run_id} for ${sha}: no ${PREBUILD_GATE_JOB} conclusion ${wait_seconds}s after it started; not waiting longer"
      fi
      continue
    fi
    if [[ "${gate}" != "success" ]]; then
      log "run ${run_id}: ${PREBUILD_GATE_JOB} ${gate} (not a usable prebuild)"
      continue
    fi
    # The runs of exactly the release commit come first, so a run of an
    # earlier commit is reached only after each of them was judged.
    if [[ "${sha}" != "${release_sha}" ]]; then
      if [[ "${exact_pending}" -eq 1 ]]; then
        log "run ${run_id} for ${sha} is ready, but a prebuild of exactly ${release_sha} is still under way; waiting for that one"
        continue
      fi
      if [[ -n "${trailing}" ]]; then
        log "run ${run_id}: ${trailing}, so its trailing archives cannot be published; an earlier commit's prebuild is taken only whole"
        continue
      fi
    fi
    if ! artifacts_downloadable "${run_id}"; then
      continue
    fi
    if [[ "${sha}" == "${release_sha}" ]]; then
      log "run ${run_id} attempt ${attempt} prebuilt the critical release artifacts of ${release_sha} (run ${status})"
    else
      log "run ${run_id} attempt ${attempt} prebuilt the critical release artifacts of ${sha}, which serve ${release_sha} (run ${status})"
    fi
    printf '%s %s\n' "${run_id}" "${attempt}"
    exit 0
  done <<<"${runs}"
  if [[ "${pending}" -eq 0 ]]; then
    log "no usable prebuild of ${release_sha}"
    exit 0
  fi
  sleep "${poll_seconds}"
done
