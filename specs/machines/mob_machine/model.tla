retiring_entry_is_a_declared_entry == (\A id \in identity_entry_retiring : (((IF (id \in DOMAIN identity_entry_origins) THEN Some((IF id \in DOMAIN identity_entry_origins THEN identity_entry_origins[id] ELSE "None")) ELSE None) = Some("Declared")) /\ (id \in DOMAIN identity_to_runtime)))
held_creation_entry_was_never_created == (\A id \in DOMAIN identity_entry_unseated : (IF ((IF (id \in DOMAIN identity_entry_unseated) THEN Some((IF id \in DOMAIN identity_entry_unseated THEN identity_entry_unseated[id] ELSE "None")) ELSE None) # Some("HeldCreation")) THEN TRUE ELSE ((id \in DOMAIN identity_runtime_generations) = FALSE)))
archived_session_record_is_unseated == (\A id \in DOMAIN identity_entry_archived_sessions : ((id \in DOMAIN identity_to_runtime) = FALSE))
role_hold_belongs_to_an_entry == (\A id \in DOMAIN member_host_preparation_causes : (IF ((IF (id \in DOMAIN member_host_preparation_causes) THEN Some((IF id \in DOMAIN member_host_preparation_causes THEN member_host_preparation_causes[id] ELSE "None")) ELSE None) # Some("RoleMigrationUndeclared")) THEN TRUE ELSE ((id \in DOMAIN identity_entry_origins) = TRUE)))
placed_entry_custody_is_hosted_on_first_use == (\A id \in spawn_exec_entry_custody : (IF ((id \in DOMAIN member_placement) = FALSE) THEN TRUE ELSE ((IF (id \in DOMAIN identity_entry_unseated) THEN Some((IF id \in DOMAIN identity_entry_unseated THEN identity_entry_unseated[id] ELSE "None")) ELSE None) = Some("HostedOnFirstUse"))))
worker_reconcile_spares_entries == ((\A id \in members_to_spawn : ((id \in DOMAIN identity_entry_origins) = FALSE)) /\ (\A id \in members_to_retire : ((id \in DOMAIN identity_entry_origins) = FALSE)))
entry_custody_ladder_is_open == (\A id \in spawn_exec_entry_custody : (IF ((IF (id \in DOMAIN spawn_exec_phase) THEN Some((IF id \in DOMAIN spawn_exec_phase THEN spawn_exec_phase[id] ELSE "None")) ELSE None) = Some("Opened")) THEN TRUE ELSE ((IF (id \in DOMAIN spawn_exec_phase) THEN Some((IF id \in DOMAIN spawn_exec_phase THEN spawn_exec_phase[id] ELSE "None")) ELSE None) = Some("MaterializePending"))))
owed_edge_repairs_join_seated_members == ((\A edge \in owed_edge_repairs : ((edge \in wiring_edges) /\ (mob_machine_wiring_edge_a(edge) \in DOMAIN identity_to_runtime) /\ (mob_machine_wiring_edge_b(edge) \in DOMAIN identity_to_runtime))) /\ (\A edge \in owed_external_edge_repairs : ((edge \in external_peer_edges) /\ (mob_machine_external_peer_edge_local(edge) \in DOMAIN identity_to_runtime))))
destroyed_mob_holds_no_member_lifecycle == (IF (phase # "Destroyed") THEN TRUE ELSE ((member_materialization = [x \in {} |-> None]) /\ (member_wake_attempts = [x \in {} |-> None]) /\ (member_rotation_session_ids = [x \in {} |-> None]) /\ (member_rotation_peer_endpoints = [x \in {} |-> None]) /\ (member_rotation_targets = [x \in {} |-> None]) /\ (member_host_preparation_causes = [x \in {} |-> None]) /\ (runtime_retire_archive_only = {}) /\ (identity_entry_origins = [x \in {} |-> None]) /\ (identity_entry_unseated = [x \in {} |-> None]) /\ (identity_entry_retiring = {}) /\ (identity_entry_archived_sessions = [x \in {} |-> None]) /\ (spawn_exec_entry_custody = {})))

