    /\ (explicit_resume_attempt = Some(attempt))
    /\ ((IF (agent_identity \in DOMAIN explicit_resume_member_work) THEN Some((IF agent_identity \in DOMAIN explicit_resume_member_work THEN explicit_resume_member_work[agent_identity] ELSE "None")) ELSE None) = Some(binding))
    /\ (explicit_resume_cancel_requested = FALSE)
    /\ (definition_epoch = binding.definition_epoch)
    /\ ((IF (agent_identity \in DOMAIN identity_to_runtime) THEN Some((IF agent_identity \in DOMAIN identity_to_runtime THEN identity_to_runtime[agent_identity] ELSE "None")) ELSE None) = Some(binding.agent_runtime_id))
    /\ ((IF (agent_identity \in DOMAIN identity_runtime_fence_tokens) THEN Some((IF agent_identity \in DOMAIN identity_runtime_fence_tokens THEN identity_runtime_fence_tokens[agent_identity] ELSE "None")) ELSE None) = Some(binding.fence_token))
    /\ ((IF (agent_identity \in DOMAIN member_session_bindings) THEN Some((IF agent_identity \in DOMAIN member_session_bindings THEN member_session_bindings[agent_identity] ELSE "None")) ELSE None) = Some(binding.session_id))
    /\ ((agent_identity \in DOMAIN member_wake_attempts) = TRUE)
    /\ (observation = "DurableSnapshotMissing")
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ member_restore_failures' = MapSet(member_restore_failures, agent_identity, reason)
    /\ member_restore_failure_codes' = MapRemove(member_restore_failure_codes, agent_identity)
    /\ member_materialization' = MapRemove(member_materialization, agent_identity)
    /\ topology_epoch' = (topology_epoch) + 1
    /\ member_wake_attempts' = MapRemove(member_wake_attempts, agent_identity)
    /\ member_wake_bound' = (member_wake_bound \ {agent_identity})
    /\ member_materialization_epoch' = MapRemove(member_materialization_epoch, agent_identity)
    /\ member_boot_obligation_owed' = MapRemove(member_boot_obligation_owed, agent_identity)
    /\ UnchangedFrame_022d107716f1ad40


