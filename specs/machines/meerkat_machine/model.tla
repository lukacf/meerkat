ResolveLiveWebsocketTokenAdmissionTokenExpiredRetired(arg_session_id, channel_id, token, observed_at_ms) ==
    /\ phase = "Retired"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (token # "")
