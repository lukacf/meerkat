RECURSIVE BeginSpawnExecRemote_ForEach0_member_boot_obligation_owed(_, _, _, _)
BeginSpawnExecRemote_ForEach0_member_boot_obligation_owed(acc, remaining, outer_agent_identity, captured_member_placement) == IF remaining = {} THEN acc ELSE LET item == CHOOSE x \in remaining : TRUE IN LET member_id == item IN LET next_acc == IF (((IF (member_id \in DOMAIN member_materialization) THEN Some((IF member_id \in DOMAIN member_materialization THEN member_materialization[member_id] ELSE "None")) ELSE None) = Some("Dormant")) /\ ((member_id \in DOMAIN captured_member_placement) = FALSE) /\ ((member_id \in DOMAIN acc) = FALSE) /\ mob_machine_wiring_contains_pair(wiring_edges, member_id, outer_agent_identity)) THEN IF ((member_id \in DOMAIN member_peer_endpoints) = TRUE) THEN MapSet(acc, member_id, "PlacedPeerWired") ELSE MapSet(acc, member_id, "EndpointPending") ELSE acc IN BeginSpawnExecRemote_ForEach0_member_boot_obligation_owed(next_acc, remaining \ {item}, outer_agent_identity, captured_member_placement)

RECURSIVE ObserveRuntimeReady_ForEach1_member_materialization_epoch(_, _, _, _)
ObserveRuntimeReady_ForEach1_member_materialization_epoch(acc, remaining, outer_agent_runtime_id, outer_runtime_epoch_id) == IF remaining = {} THEN acc ELSE LET item == CHOOSE x \in remaining : TRUE IN LET member_id == item IN LET next_acc == IF (((IF (member_id \in DOMAIN identity_to_runtime) THEN Some((IF member_id \in DOMAIN identity_to_runtime THEN identity_to_runtime[member_id] ELSE "None")) ELSE None) = Some(outer_agent_runtime_id)) /\ ((member_id \in DOMAIN member_materialization) = TRUE)) THEN MapSet(acc, member_id, outer_runtime_epoch_id) ELSE acc IN ObserveRuntimeReady_ForEach1_member_materialization_epoch(next_acc, remaining \ {item}, outer_agent_runtime_id, outer_runtime_epoch_id)

RECURSIVE AdmitDestroyCleanup_ForEach2_member_materialization(_, _)
AdmitDestroyCleanup_ForEach2_member_materialization(acc, remaining) == IF remaining = {} THEN acc ELSE LET item == CHOOSE x \in remaining : TRUE IN LET member_id == item IN LET next_acc == MapSet(acc, member_id, "Dormant") IN AdmitDestroyCleanup_ForEach2_member_materialization(next_acc, remaining \ {item})

RECURSIVE AdmitDestroyCleanup_ForEach2_member_materialization_epoch(_, _)
