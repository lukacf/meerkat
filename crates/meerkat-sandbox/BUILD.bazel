        package_name = "crates/meerkat-sandbox",
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "meerkat_sandbox",
    crate_root = "src/lib.rs",
    crate_features = [],
    edition = "2024",
    rustc_flags = WORKSPACE_LINT_RUSTC_FLAGS,
    compile_data = [
        "Cargo.toml",
    ],
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    rustc_env = {
        "CARGO_PKG_VERSION": "0.8.50",
        "CARGO_MANIFEST_DIR": "./crates/meerkat-sandbox",
    },
    tags = [
        "fast",
        "unit",
    ],
    size = "medium",
    data = [
        ":package_runfiles",
    ],
    env = {
        "RUST_MIN_STACK": "8388608",
        "RUST_TEST_THREADS": "1",
    },
    proc_macro_deps = all_crate_deps(
        package_name = "crates/meerkat-sandbox",
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//crates/meerkat-core:meerkat_core",
    ] + all_crate_deps(
        package_name = "crates/meerkat-sandbox",
        normal = True,
        normal_dev = True,
    ),
)

