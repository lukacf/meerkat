NormalizeRecoveredInputAppliedCommittedInitializing(input_id, arg_phase, applied_boundary_committed) ==
    /\ phase = "Initializing"
    /\ (IF (arg_phase = "Applied") THEN TRUE ELSE (arg_phase = "AppliedPendingConsumption"))
    /\ ((applied_boundary_committed # None) /\ ((IF "value" \in DOMAIN applied_boundary_committed THEN applied_boundary_committed["value"] ELSE None) = TRUE))
