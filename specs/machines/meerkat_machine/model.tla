RollbackUnreturnedOpIdle(operation_id) ==
    /\ phase = "Idle"
    /\ (operation_id \in DOMAIN op_statuses)
    /\ (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Provisioning")) THEN TRUE ELSE (IF ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Running")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN op_statuses) THEN Some((IF operation_id \in DOMAIN op_statuses THEN op_statuses[operation_id] ELSE "None")) ELSE None) = Some("Retiring"))))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ op_statuses' = MapRemove(op_statuses, operation_id)
    /\ op_kinds' = MapRemove(op_kinds, operation_id)
    /\ op_sources' = MapRemove(op_sources, operation_id)
    /\ op_peer_ready' = MapRemove(op_peer_ready, operation_id)
    /\ op_progress_counts' = MapRemove(op_progress_counts, operation_id)
    /\ active_op_count' = (active_op_count) - 1
