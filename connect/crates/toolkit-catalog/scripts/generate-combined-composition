    **{f'row-b-partial-resend-{door.lower()}': r(f'NotRowBPartialResend{door}', door=[door], procs=2, sends=2,
                                                  env=['drop'])
       for door in ['ClassInput', 'FindNative', 'BatchSetup', 'ConfiguredSetup', 'SetupRequest']},
    # The held rows of the protected slice: stages A and B, Find and Launch, (P) and
    # (A), first send, one-write (Partial) and bound originals.
    **{f'row-held-{stage.lower()}-{door.lower()}-{site.lower()}-{initial.lower()}':
       r(f'NotRowHeld_{stage}_{door}_{site}_{initial}', stage=[stage], door=[door], initial=[initial],
         env=['hold'] if stage == 'B' else [])
       for stage in BOTH for door in HELD_DOORS for site in ['P', 'A'] for initial in OWN_INITIAL},
    # The two largest clean bases last (the verifier runs the clean profiles in this order): the
    # full stage B environment on Find and on the helper door.
    'none-b-find': profile('base', door=['Find'], **FULL_ENV_B),
    'none-b-helper': profile('base', door=['Helper'], **FULL_ENV_B),
}


