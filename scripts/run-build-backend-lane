#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: run-build-backend-lane <lane>

Runs a developer-facing lane with Cargo by default and BuildBuddy when
MEERKAT_BUILDBUDDY=1 is set.

Lanes:
  build
  check
  lint
  test
  test-all
  test-unit
  test-int
  e2e-fast
  e2e-system
  e2e-live
  e2e-smoke
  e2e-auth
EOF
}

if [[ $# -ne 1 ]]; then
  usage >&2
  exit 2
fi

lane="$1"
root="$(git rev-parse --show-toplevel)"
cd "${root}"

source "${root}/scripts/build-backend-env"

cargo_bin="${CARGO:-${root}/scripts/repo-cargo}"

use_standard_rust_test_stack() {
  export RUST_MIN_STACK="${RUST_MIN_STACK:-33554432}"
}

run_head_canonical_kill_window() {
  # This is the sole real-process-death HeadCanonical regression. Its hidden
  # crash-stop command is intentionally feature-gated, so run the one target
  # explicitly and fail if filtering/cfg drift ever selects zero tests.
  "${cargo_bin}" nextest run \
    -p meerkat-mob \
    --test cold_restart_mob_resume \
    --features test-support \
    --profile fast \
    --no-tests=fail \
    --show-progress none \
    --status-level none \
    --final-status-level fail \
    -E 'test(mob_cold_restart_resume_after_kill_between_commit_points)'
}

prebuild_e2e_system_rkat_tests() {
  # System scenarios enforce behavior timeouts around their nested commands.
  # Compile each test target separately so Cargo uses the same dev-dependency
  # feature graph as the nested scenario command. Combining targets can unify a
  # broader graph that the single-target command then rebuilds under its timer.
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests \
    --test cli_mobpack_live_smoke \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests,memory-store-session \
    --test system_cli_resume \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests,mob,comms \
    --test system_mob_cli_verbs \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests,mob \
    --test system_mob_run_custody \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests,mob,comms \
    --test system_mob_host_daemon \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests \
    --test system_cli_mcp_pending \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests \
    --test system_cli_init \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests \
    --test system_cli_export_atif \
    --no-run
  "${cargo_bin}" test \
    -p rkat \
    --features integration-real-tests \
    --test live_smoke_cli \
    --no-run
}

prebuild_e2e_system_other_tests() {
  "${cargo_bin}" test \
    -p meerkat-rest \
    --features integration-real-tests \
    --test system_rest_resume \
    --no-run
  "${cargo_bin}" test \
    -p meerkat-integration-tests \
    --test system_realm_inheritance \
    --no-run
  "${cargo_bin}" test \
    -p meerkat-integration-tests \
    --test system_shared_realm \
    --no-run
}

prebuild_e2e_system_harness() {
  # Build the harness before the nested rkat graphs. Compiling the harness
  # unifies test-support features across its dependency graph; doing that after
  # the rkat prebuild can invalidate those artifacts and force recompilation
  # inside the first scenario's behavior timeout.
  "${cargo_bin}" test \
    -p meerkat-integration-tests \
    --test e2e_system_lane \
    --no-run
}

case "${lane}" in
  build)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" build
    fi
    exec "${cargo_bin}" build --workspace
    ;;
  check)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" check
    fi
    exec "${cargo_bin}" check --workspace --all-targets --all-features
    ;;
  lint)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" clippy
    fi
    exec "${cargo_bin}" clippy --workspace --all-targets --all-features -- -D warnings
    ;;
  test)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" test
    fi
    use_standard_rust_test_stack
    # Cargo's worktree+parent config-merge concatenates list-form aliases
    # (the workspace's `fast`/`int`/`rct` aliases live as TOML arrays at
    # both the worktree and the main checkout's `.cargo/config.toml`),
    # which duplicates `--workspace` and trips clap's "cannot be used
    # multiple times" guard. Expand the alias inline until the upstream
    # aliases are normalized to string form on `main`.
    "${cargo_bin}" nextest run --workspace --profile fast --show-progress none --status-level none --final-status-level fail
    run_head_canonical_kill_window
    exec "${cargo_bin}" test -p meerkat-session --features session-store projection_continuity -- --quiet
    ;;
  test-all)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" test-all
    fi
    use_standard_rust_test_stack
    exec "${cargo_bin}" nextest run --workspace --profile fast --show-progress none --status-level none --final-status-level fail --all-features
    ;;
  test-unit)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" test-unit
    fi
    use_standard_rust_test_stack
    exec "${cargo_bin}" nextest run --workspace --lib --show-progress none --status-level none --final-status-level fail
    ;;
  test-int)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" test-int
    fi
    use_standard_rust_test_stack
    "${cargo_bin}" nextest run --workspace --tests --profile fast --show-progress none --status-level none --final-status-level fail
    run_head_canonical_kill_window
    ;;
  e2e-fast)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" e2e-fast
    fi
    exec "${cargo_bin}" e2e-fast
    ;;
  e2e-system)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" e2e-system
    fi
    # The system harness forces this value for every nested scenario to avoid
    # macOS relink/signature races. Use the same compiler fingerprint while
    # prebuilding or Cargo will rebuild the graph inside the scenario timeout.
    export CARGO_INCREMENTAL=0
    export RUST_MIN_STACK=$((16 * 1024 * 1024))
    prebuild_e2e_system_harness
    prebuild_e2e_system_other_tests
    prebuild_e2e_system_rkat_tests
    exec "${cargo_bin}" e2e-system
    ;;
  e2e-live)
    meerkat_load_local_secrets_env "${root}"
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" e2e-live
    fi
    exec "${cargo_bin}" e2e-live
    ;;
  e2e-smoke)
    meerkat_load_local_secrets_env "${root}"
    if meerkat_buildbuddy_enabled; then
      "${root}/scripts/buildbuddy-dev" e2e-smoke
      case "${BUILDBUDDY_DRY_RUN:-}" in
        1|true|TRUE|yes|YES|on|ON)
          exit 0
          ;;
      esac
      export MEERKAT_E2E_EXECUTION_MODE="${MEERKAT_E2E_EXECUTION_MODE:-prebuilt}"
    fi
    exec "${root}/scripts/e2e-smoke-lane"
    ;;
  e2e-auth)
    if meerkat_buildbuddy_enabled; then
      exec "${root}/scripts/buildbuddy-dev" e2e-auth
    fi
    exec "${cargo_bin}" e2e-auth
    ;;
  *)
    echo "unknown build backend lane: ${lane}" >&2
    usage >&2
    exit 2
    ;;
esac
