CancelLiveBridgeOperationIdle(channel_id, runtime_id, fence_token, generation, interaction_id, operation_id, reason) ==
    /\ phase = "Idle"
    /\ (((IF (channel_id \in DOMAIN live_execution_runtime_id_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_runtime_id_by_channel THEN live_execution_runtime_id_by_channel[channel_id] ELSE "None")) ELSE None) = Some(runtime_id)) /\ ((IF (channel_id \in DOMAIN live_execution_fence_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_fence_by_channel THEN live_execution_fence_by_channel[channel_id] ELSE "None")) ELSE None) = Some(fence_token)) /\ ((IF (channel_id \in DOMAIN live_execution_generation_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_generation_by_channel THEN live_execution_generation_by_channel[channel_id] ELSE "None")) ELSE None) = Some(generation)) /\ (IF ((IF (channel_id \in DOMAIN live_execution_phase_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_phase_by_channel THEN live_execution_phase_by_channel[channel_id] ELSE "None")) ELSE None) = Some("Active")) THEN TRUE ELSE ((IF (channel_id \in DOMAIN live_execution_phase_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_phase_by_channel THEN live_execution_phase_by_channel[channel_id] ELSE "None")) ELSE None) = Some("Revoked"))))
    /\ (((IF (operation_id \in DOMAIN live_bridge_channel_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_channel_by_operation THEN live_bridge_channel_by_operation[operation_id] ELSE "None")) ELSE None) = Some(channel_id)) /\ ((IF (operation_id \in DOMAIN live_bridge_interaction_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_interaction_by_operation THEN live_bridge_interaction_by_operation[operation_id] ELSE "None")) ELSE None) = Some(interaction_id)) /\ ~((operation_id \in DOMAIN live_bridge_execution_terminal_by_operation)) /\ ~((operation_id \in DOMAIN live_bridge_cancellation_reason_by_operation)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_bridge_phase_by_operation' = IF ((IF (operation_id \in DOMAIN live_bridge_phase_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_phase_by_operation THEN live_bridge_phase_by_operation[operation_id] ELSE "None")) ELSE None) # Some("ExecutionRunning")) THEN MapSet(live_bridge_phase_by_operation, operation_id, "CancellationAuthorized") ELSE live_bridge_phase_by_operation
    /\ live_bridge_cancellation_reason_by_operation' = MapSet(live_bridge_cancellation_reason_by_operation, operation_id, reason)
    /\ UnchangedFrame_9dd7dd92e618cee4


