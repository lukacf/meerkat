AuthorizeExplicitResumeMemberLiveRunning(attempt, agent_identity, binding) ==
    /\ phase = "Running"
    /\ (explicit_resume_attempt = Some(attempt))
    /\ (explicit_resume_cancel_requested = FALSE)
    /\ (explicit_resume_preparation_pending = FALSE)
    /\ ((explicit_resume_readiness_pending = FALSE) /\ (explicit_resume_readiness_settled = FALSE))
    /\ ((agent_identity \in DOMAIN explicit_resume_member_work) = FALSE)
    /\ (definition_epoch = binding.definition_epoch)
    /\ ((IF (agent_identity \in DOMAIN identity_to_runtime) THEN Some((IF agent_identity \in DOMAIN identity_to_runtime THEN identity_to_runtime[agent_identity] ELSE "None")) ELSE None) = Some(binding.agent_runtime_id))
    /\ ((IF (agent_identity \in DOMAIN identity_runtime_fence_tokens) THEN Some((IF agent_identity \in DOMAIN identity_runtime_fence_tokens THEN identity_runtime_fence_tokens[agent_identity] ELSE "None")) ELSE None) = Some(binding.fence_token))
    /\ ((IF (agent_identity \in DOMAIN member_session_bindings) THEN Some((IF agent_identity \in DOMAIN member_session_bindings THEN member_session_bindings[agent_identity] ELSE "None")) ELSE None) = Some(binding.session_id))
    /\ ((IF (agent_identity \in DOMAIN member_materialization) THEN Some((IF agent_identity \in DOMAIN member_materialization THEN member_materialization[agent_identity] ELSE "None")) ELSE None) = Some("Live"))
    /\ (composition_authority = "Authoritative")
    /\ (IF (boot_plan_sealed = FALSE) THEN TRUE ELSE ((agent_identity \in DOMAIN member_peer_endpoints) = TRUE))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ member_materialization' = MapSet(member_materialization, agent_identity, "Waking")
    /\ explicit_resume_member_work' = MapSet(explicit_resume_member_work, agent_identity, binding)
    /\ member_wake_attempts' = MapSet(member_wake_attempts, agent_identity, ((member_wake_attempt_sequence) + 1))
    /\ member_wake_attempt_sequence' = (member_wake_attempt_sequence) + 1
