RegisterOpAcceptedIdle(operation_id, kind, source, max_concurrent) ==
    /\ phase = "Idle"
    /\ ~((operation_id \in DOMAIN op_statuses))
    /\ operation_source_valid(source)
    /\ (IF (max_concurrent = None) THEN TRUE ELSE (active_op_count < (IF "value" \in DOMAIN max_concurrent THEN max_concurrent["value"] ELSE None)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ op_statuses' = MapSet(op_statuses, operation_id, "Provisioning")
    /\ op_kinds' = MapSet(op_kinds, operation_id, kind)
    /\ op_sources' = IF (source # None) THEN MapSet(op_sources, operation_id, (IF "value" \in DOMAIN source THEN source["value"] ELSE None)) ELSE op_sources
    /\ op_peer_ready' = MapSet(op_peer_ready, operation_id, FALSE)
    /\ op_progress_counts' = MapSet(op_progress_counts, operation_id, 0)
    /\ active_op_count' = (active_op_count) + 1
