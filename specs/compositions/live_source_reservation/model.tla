selected_frontier_and_source_publish_together == \E route_name \in RouteNames : /\ RouteSource(route_name) = "transcript" /\ RouteEffect(route_name) = "RangeSelected" /\ RouteTargetMachine(route_name) = "request" /\ RouteTargetInput(route_name) = "Reserve"

RouteObserved_selected_range_freezes_source == \E packet \in delivered_routes : packet.route = "selected_range_freezes_source"
RouteCoverage_selected_range_freezes_source == (RouteObserved_selected_range_freezes_source \/ ~RouteObserved_selected_range_freezes_source)
RouteObserved_ingress_close_fences_request_sources == \E packet \in delivered_routes : packet.route = "ingress_close_fences_request_sources"
RouteCoverage_ingress_close_fences_request_sources == (RouteObserved_ingress_close_fences_request_sources \/ ~RouteObserved_ingress_close_fences_request_sources)
CoverageInstrumentation == RouteCoverage_selected_range_freezes_source /\ RouteCoverage_ingress_close_fences_request_sources

