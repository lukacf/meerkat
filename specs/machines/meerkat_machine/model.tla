    /\ input_abandon_attempt_count' = MapSet(input_abandon_attempt_count, input_id, (IF input_id \in DOMAIN input_attempt_counts THEN input_attempt_counts[input_id] ELSE 0))
    /\ input_lane' = MapRemove(input_lane, input_id)
