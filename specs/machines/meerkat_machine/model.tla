AuthorizeSupervisorStopped(name, peer_id, address, signing_public_key, epoch) ==
    /\ phase = "Stopped"
    /\ (supervisor_binding_kind = "Bound")
    /\ ((supervisor_bound_peer_id = Some(peer_id)) /\ (epoch > (IF "value" \in DOMAIN supervisor_bound_epoch THEN supervisor_bound_epoch["value"] ELSE None)))
    /\ (IF (supervisor_rotation_phase = None) THEN TRUE ELSE (IF (supervisor_rotation_phase = Some("Completed")) THEN TRUE ELSE (supervisor_rotation_phase = Some("Rejected"))))
    /\ phase' = "Stopped"
    /\ model_step_count' = model_step_count + 1
    /\ supervisor_bound_name' = Some(name)
    /\ supervisor_bound_peer_id' = Some(peer_id)
    /\ supervisor_bound_address' = Some(address)
    /\ supervisor_bound_signing_public_key' = Some(signing_public_key)
    /\ supervisor_bound_epoch' = Some(epoch)
    /\ supervisor_publish_pending_name' = Some((IF "value" \in DOMAIN Some(name) THEN Some(name)["value"] ELSE None))
    /\ supervisor_publish_pending_peer_id' = Some((IF "value" \in DOMAIN Some(peer_id) THEN Some(peer_id)["value"] ELSE None))
