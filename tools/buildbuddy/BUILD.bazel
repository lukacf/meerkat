CARGO_EQUIVALENT_EXEC_PROPERTIES = {
    "network": "external",
    "test.network": "external",
}

# The nextest unit and integration actions each run one test process per
# vCPU, and the SDK actions run cold Cargo and wasm-pack builds. Without a
# resource estimate BuildBuddy packs several onto one c3d-standard-30
# (30 vCPU, 120 GB); on 2026-09-23 that cost the peer-admission latency test
# its 3s p99 (3.8s, 3.2s), timed out a 10s turn-boundary wait, and silently
# killed the xtask drift child. Asking for more than half an executor's CPU
# and memory gives each of these actions a machine to itself while staying
# schedulable, which is how the pre-push hook runs them.
HEAVY_CARGO_EQUIVALENT_EXEC_PROPERTIES = CARGO_EQUIVALENT_EXEC_PROPERTIES | {
    "EstimatedCPU": "20",
    "EstimatedMemory": "60GB",
}

CARGO_EQUIVALENT_TAGS = [
    "buildbuddy",
    "cargo-equivalent",
    "requires-network",
]

sh_test(
    name = "cargo_available_test",
    srcs = ["cargo_available_test.sh"],
    data = RUST_TOOLCHAIN_DATA,
    tags = ["buildbuddy"],
)

# Compatibility target for developers invoking the historic monolithic lane.
[
    sh_test(
        name = name,
        srcs = ["cargo_lane_test.sh"],
        args = [lane],
        data = [
            ":lane_scripts",
            "//:workspace_runfiles",
        ] + RUST_TOOLCHAIN_DATA,
        exec_properties = CARGO_EQUIVALENT_EXEC_PROPERTIES,
        size = "enormous",
        timeout = "long",
        tags = CARGO_EQUIVALENT_TAGS,
    )
    for name, lane in {
        "minimal_feature_builds_cargo_equivalent_test": "test-minimal",
        "feature_matrix_lib_cargo_equivalent_test": "test-feature-matrix-lib",
    }.items()
]

