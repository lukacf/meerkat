    /\ (supervisor_binding_kind = "Unbound")
    /\ (IF ((arg_phase = "Rejected") /\ (rejection # None)) THEN TRUE ELSE ((arg_phase # "Rejected") /\ (rejection = None)))
    /\ phase' = "Initializing"
    /\ model_step_count' = model_step_count + 1
    /\ supervisor_binding_kind' = IF (arg_phase = "Rejected") THEN "Bound" ELSE IF (arg_phase = "Completed") THEN "Bound" ELSE supervisor_binding_kind
    /\ supervisor_bound_name' = IF (arg_phase = "Rejected") THEN Some((IF "value" \in DOMAIN Some(previous_name) THEN Some(previous_name)["value"] ELSE None)) ELSE IF (arg_phase = "Completed") THEN Some((IF "value" \in DOMAIN Some(next_name) THEN Some(next_name)["value"] ELSE None)) ELSE supervisor_bound_name
    /\ supervisor_bound_peer_id' = IF (arg_phase = "Rejected") THEN Some((IF "value" \in DOMAIN Some(previous_peer_id) THEN Some(previous_peer_id)["value"] ELSE None)) ELSE IF (arg_phase = "Completed") THEN Some((IF "value" \in DOMAIN Some(next_peer_id) THEN Some(next_peer_id)["value"] ELSE None)) ELSE supervisor_bound_peer_id
    /\ supervisor_bound_address' = IF (arg_phase = "Rejected") THEN Some((IF "value" \in DOMAIN Some(previous_address) THEN Some(previous_address)["value"] ELSE None)) ELSE IF (arg_phase = "Completed") THEN Some((IF "value" \in DOMAIN Some(next_address) THEN Some(next_address)["value"] ELSE None)) ELSE supervisor_bound_address
    /\ supervisor_bound_signing_public_key' = IF (arg_phase = "Rejected") THEN Some((IF "value" \in DOMAIN Some(previous_signing_public_key) THEN Some(previous_signing_public_key)["value"] ELSE None)) ELSE IF (arg_phase = "Completed") THEN Some((IF "value" \in DOMAIN Some(next_signing_public_key) THEN Some(next_signing_public_key)["value"] ELSE None)) ELSE supervisor_bound_signing_public_key
    /\ supervisor_bound_epoch' = IF (arg_phase = "Rejected") THEN Some((IF "value" \in DOMAIN Some(previous_epoch) THEN Some(previous_epoch)["value"] ELSE None)) ELSE IF (arg_phase = "Completed") THEN Some((IF "value" \in DOMAIN Some(next_epoch) THEN Some(next_epoch)["value"] ELSE None)) ELSE supervisor_bound_epoch
    /\ supervisor_publish_pending_name' = IF (arg_phase = "NextPublishPending") THEN Some((IF "value" \in DOMAIN Some(next_name) THEN Some(next_name)["value"] ELSE None)) ELSE supervisor_publish_pending_name
    /\ supervisor_publish_pending_peer_id' = IF (arg_phase = "NextPublishPending") THEN Some((IF "value" \in DOMAIN Some(next_peer_id) THEN Some(next_peer_id)["value"] ELSE None)) ELSE supervisor_publish_pending_peer_id
    /\ supervisor_publish_pending_address' = IF (arg_phase = "NextPublishPending") THEN Some((IF "value" \in DOMAIN Some(next_address) THEN Some(next_address)["value"] ELSE None)) ELSE supervisor_publish_pending_address
    /\ supervisor_publish_pending_signing_public_key' = IF (arg_phase = "NextPublishPending") THEN Some((IF "value" \in DOMAIN Some(next_signing_public_key) THEN Some(next_signing_public_key)["value"] ELSE None)) ELSE supervisor_publish_pending_signing_public_key
    /\ supervisor_publish_pending_epoch' = IF (arg_phase = "NextPublishPending") THEN Some((IF "value" \in DOMAIN Some(next_epoch) THEN Some(next_epoch)["value"] ELSE None)) ELSE supervisor_publish_pending_epoch
    /\ supervisor_revoke_pending_name' = IF (arg_phase = "PreviousRevokePending") THEN Some((IF "value" \in DOMAIN Some(previous_name) THEN Some(previous_name)["value"] ELSE None)) ELSE supervisor_revoke_pending_name
    /\ supervisor_revoke_pending_peer_id' = IF (arg_phase = "PreviousRevokePending") THEN Some((IF "value" \in DOMAIN Some(previous_peer_id) THEN Some(previous_peer_id)["value"] ELSE None)) ELSE supervisor_revoke_pending_peer_id
