SurfaceCallStartedActiveAttached(surface_id) ==
    /\ phase = "Attached"
    /\ ((surface_id \in DOMAIN surface_base_state) /\ ((IF surface_id \in DOMAIN surface_base_state THEN surface_base_state[surface_id] ELSE "None") = "Active"))
    /\ phase' = "Attached"
