    /\ member_placement' = MapSet(member_placement, agent_identity, host_id)
    /\ current_placed_spawn_ids' = MapSet(current_placed_spawn_ids, agent_identity, spawn_id)
    /\ current_placed_spawn_host_binding_generations' = MapSet(current_placed_spawn_host_binding_generations, agent_identity, host_binding_generation)
    /\ current_placed_spawn_provision_operation_ids' = MapSet(current_placed_spawn_provision_operation_ids, agent_identity, provision_operation_id)
    /\ current_placed_spawn_operation_owner_session_ids' = MapSet(current_placed_spawn_operation_owner_session_ids, agent_identity, operation_owner_session_id)
