RecoverCompletionFeedEntryStopped(operation_id, kind, arg_terminal_outcome, terminal_payload, completion_sequence) ==
    /\ phase = "Stopped"
    /\ (IF (kind = "BackgroundToolOp") THEN TRUE ELSE (IF (kind = "MobMemberChild") THEN TRUE ELSE (kind = "DetachedJobWait")))
    /\ (completion_sequence > 0)
    /\ (completion_sequence <= next_completion_seq)
    /\ ~((completion_sequence \in completion_sequence_claims))
    /\ ~((operation_id \in DOMAIN completion_feed_sequences))
    /\ (IF ((arg_terminal_outcome = "Completed") /\ (terminal_payload.tag = "Completed")) THEN TRUE ELSE (IF ((arg_terminal_outcome = "Failed") /\ (terminal_payload.tag = "Failed")) THEN TRUE ELSE (IF ((arg_terminal_outcome = "Aborted") /\ (terminal_payload.tag = "Aborted")) THEN TRUE ELSE (IF ((arg_terminal_outcome = "Cancelled") /\ (terminal_payload.tag = "Cancelled")) THEN TRUE ELSE (IF ((arg_terminal_outcome = "Retired") /\ (terminal_payload.tag = "Retired")) THEN TRUE ELSE ((arg_terminal_outcome = "Terminated") /\ (terminal_payload.tag = "Terminated")))))))
    /\ phase' = "Stopped"
    /\ model_step_count' = model_step_count + 1
    /\ completion_sequence_claims' = (completion_sequence_claims \cup {completion_sequence})
    /\ completion_feed_sequences' = MapSet(completion_feed_sequences, operation_id, completion_sequence)
    /\ completion_feed_kinds' = MapSet(completion_feed_kinds, operation_id, kind)
    /\ completion_feed_terminal_outcomes' = MapSet(completion_feed_terminal_outcomes, operation_id, arg_terminal_outcome)
    /\ completion_feed_terminal_payload' = MapSet(completion_feed_terminal_payload, operation_id, terminal_payload)
