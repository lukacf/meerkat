#!/usr/bin/env python3
"""Owner-only ephemeral GCP runner pool for Meerkat Core and Meta.

usage: fast-runners <command>

  check-trigger      exit 0 when this job may use the pool (advisory; the
                     WIF condition and the runner hook are the boundaries)
  up                 check the review precondition, mint one just-in-time
                     (JIT) runner registration per pool lane, create one VM
                     per lane, wait until every runner is online carrying
                     exactly its own label, write backend/runs_on/attempt to
                     GITHUB_OUTPUT (never printed), and revoke the
                     installation tokens; with backend 'auto' any failure
                     cleans up and selects GitHub-hosted runners instead
  fallback           write the GitHub-hosted outputs; fails for backend 'fast'
  down               delete this run's VMs and runner registrations by their
                     deterministic names (idempotent; non-zero on any failure)
  verify-lanes       gate check: every needed job succeeded (a skipped lane
                     fails), and when the pool came up every pool lane ran on
                     its own runner
  names              print this run's VM names
  render-startup     print the VM boot script
  render-reaper      print the scheduled reaper script (Cloud Run job)
  wif                print the WIF attribute mapping and condition
  approval-commands  print the gcloud commands the owner must approve (never
                     runs them)

Nothing here runs unless MEERKAT_FAST_RUNNERS_ENABLED is 'true', the backend
is not 'hosted', and the job is an owner workflow_dispatch of an allowlisted
workflow on refs/heads/main on a GitHub-hosted runner.

Environment:
  MEERKAT_FAST_RUNNERS_ENABLED   'true' to do anything (repository variable)
  MEERKAT_FAST_RUNNERS_APP_ID    GitHub App id used to mint runner registrations
  MEERKAT_FAST_RUNNERS_PROJECT   pool project (default: the dedicated project)
  FAST_RUNNERS_BACKEND           auto | fast | hosted (default auto)
  FAST_RUNNERS_SPEC              JSON list of {"lane": <job id>, "class": <class>}
  FAST_RUNNERS_UP_BACKEND        for down/verify-lanes: the backend up reported
  FAST_RUNNERS_CODEOWNERS_CALLER / _LAUNCHER   CODEOWNERS files of the caller
                                 repository (at the dispatched commit) and of
                                 the launcher repository (at main)
"""

import base64
import json
import os
