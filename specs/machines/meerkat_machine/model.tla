RecoverInputLifecycleIdle(input_id, arg_phase, terminal_kind, superseded_by, aggregate_id, abandon_reason, abandon_attempt_count, attempt_count, run_id, boundary_sequence, admission_sequence, admission_sequence_recovery, recovery_lane, lane, runtime_boundary, runtime_execution_kind, runtime_peer_response_terminal_apply_intent, is_prompt) ==
    /\ phase = "Idle"
    /\ (IF (arg_phase = "Consumed") THEN TRUE ELSE (IF (arg_phase = "Superseded") THEN TRUE ELSE (IF (arg_phase = "Coalesced") THEN TRUE ELSE (IF (arg_phase = "Abandoned") THEN TRUE ELSE (input_id \in recovered_admitted_inputs)))))
    /\ (IF ((IF (arg_phase = "Consumed") THEN TRUE ELSE (IF (arg_phase = "Superseded") THEN TRUE ELSE (IF (arg_phase = "Coalesced") THEN TRUE ELSE (arg_phase = "Abandoned")))) /\ (recovery_lane = None)) THEN TRUE ELSE ((arg_phase # "Consumed") /\ (arg_phase # "Superseded") /\ (arg_phase # "Coalesced") /\ (arg_phase # "Abandoned") /\ (input_id \in DOMAIN recovered_admitted_lanes) /\ (recovery_lane = Some((IF "value" \in DOMAIN (IF (input_id \in DOMAIN recovered_admitted_lanes) THEN Some((IF input_id \in DOMAIN recovered_admitted_lanes THEN recovered_admitted_lanes[input_id] ELSE "None")) ELSE None) THEN (IF (input_id \in DOMAIN recovered_admitted_lanes) THEN Some((IF input_id \in DOMAIN recovered_admitted_lanes THEN recovered_admitted_lanes[input_id] ELSE "None")) ELSE None)["value"] ELSE None)))))
    /\ (IF ((arg_phase # "Queued") /\ (lane = None)) THEN TRUE ELSE ((arg_phase = "Queued") /\ (input_id \in DOMAIN recovered_admitted_lanes) /\ (lane = Some((IF "value" \in DOMAIN (IF (input_id \in DOMAIN recovered_admitted_lanes) THEN Some((IF input_id \in DOMAIN recovered_admitted_lanes THEN recovered_admitted_lanes[input_id] ELSE "None")) ELSE None) THEN (IF (input_id \in DOMAIN recovered_admitted_lanes) THEN Some((IF input_id \in DOMAIN recovered_admitted_lanes THEN recovered_admitted_lanes[input_id] ELSE "None")) ELSE None)["value"] ELSE None))) /\ (lane = recovery_lane)))
    /\ (IF (arg_phase # "Queued") THEN TRUE ELSE (IF (admission_sequence # None) THEN TRUE ELSE ((admission_sequence_recovery # None) /\ (IF ((IF "value" \in DOMAIN admission_sequence_recovery THEN admission_sequence_recovery["value"] ELSE None) = "QueueAccepted") THEN TRUE ELSE (IF ((IF "value" \in DOMAIN admission_sequence_recovery THEN admission_sequence_recovery["value"] ELSE None) = "RollbackStaged") THEN TRUE ELSE ((IF "value" \in DOMAIN admission_sequence_recovery THEN admission_sequence_recovery["value"] ELSE None) = "MissingBoundaryReceipt"))))))
    /\ (IF (admission_sequence_recovery = None) THEN TRUE ELSE ((arg_phase = "Queued") /\ (admission_sequence = None)))
    /\ (IF ((arg_phase = "Queued") /\ (runtime_boundary # None) /\ (runtime_execution_kind # None)) THEN TRUE ELSE ((arg_phase # "Queued") /\ (runtime_boundary = None) /\ (runtime_execution_kind = None) /\ (runtime_peer_response_terminal_apply_intent = None) /\ (is_prompt = FALSE)))
    /\ (IF ((arg_phase = "Consumed") /\ (terminal_kind = Some("Consumed")) /\ (superseded_by = None) /\ (aggregate_id = None) /\ (abandon_reason = None)) THEN TRUE ELSE (IF ((arg_phase = "Superseded") /\ (terminal_kind = Some("Superseded")) /\ (superseded_by # None) /\ (aggregate_id = None) /\ (abandon_reason = None)) THEN TRUE ELSE (IF ((arg_phase = "Coalesced") /\ (terminal_kind = Some("Coalesced")) /\ (superseded_by = None) /\ (aggregate_id # None) /\ (abandon_reason = None)) THEN TRUE ELSE (IF ((arg_phase = "Abandoned") /\ (terminal_kind = Some("Abandoned")) /\ (superseded_by = None) /\ (aggregate_id = None) /\ (abandon_reason # None)) THEN TRUE ELSE ((arg_phase # "Consumed") /\ (arg_phase # "Superseded") /\ (arg_phase # "Coalesced") /\ (arg_phase # "Abandoned") /\ (terminal_kind = None) /\ (superseded_by = None) /\ (aggregate_id = None) /\ (abandon_reason = None))))))
    /\ (IF (abandon_reason # Some("MaxAttemptsExhausted")) THEN TRUE ELSE (abandon_attempt_count = attempt_count))
    /\ (IF (abandon_reason # Some("MaxAttemptsExhausted")) THEN TRUE ELSE (attempt_count >= max_stage_attempts))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ input_phases' = MapSet(input_phases, input_id, arg_phase)
    /\ input_terminal_kind' = IF (terminal_kind # None) THEN MapSet(input_terminal_kind, input_id, (IF "value" \in DOMAIN terminal_kind THEN terminal_kind["value"] ELSE None)) ELSE MapRemove(input_terminal_kind, input_id)
    /\ input_superseded_by' = IF (superseded_by # None) THEN MapSet(input_superseded_by, input_id, (IF "value" \in DOMAIN superseded_by THEN superseded_by["value"] ELSE None)) ELSE MapRemove(input_superseded_by, input_id)
    /\ input_aggregate_id' = IF (aggregate_id # None) THEN MapSet(input_aggregate_id, input_id, (IF "value" \in DOMAIN aggregate_id THEN aggregate_id["value"] ELSE None)) ELSE MapRemove(input_aggregate_id, input_id)
    /\ input_abandon_reason' = IF (abandon_reason # None) THEN MapSet(input_abandon_reason, input_id, (IF "value" \in DOMAIN abandon_reason THEN abandon_reason["value"] ELSE None)) ELSE MapRemove(input_abandon_reason, input_id)
    /\ input_abandon_attempt_count' = IF (abandon_reason # None) THEN MapSet(input_abandon_attempt_count, input_id, abandon_attempt_count) ELSE MapRemove(input_abandon_attempt_count, input_id)
    /\ input_attempt_counts' = MapSet(input_attempt_counts, input_id, attempt_count)
    /\ input_run_associations' = IF (run_id # None) THEN MapSet(input_run_associations, input_id, (IF "value" \in DOMAIN run_id THEN run_id["value"] ELSE None)) ELSE MapRemove(input_run_associations, input_id)
    /\ input_boundary_sequences' = IF (boundary_sequence # None) THEN MapSet(input_boundary_sequences, input_id, (IF "value" \in DOMAIN boundary_sequence THEN boundary_sequence["value"] ELSE None)) ELSE MapRemove(input_boundary_sequences, input_id)
    /\ input_completion_boundaries' = MapRemove(input_completion_boundaries, input_id)
    /\ next_admission_seq' = IF (admission_sequence # None) THEN IF (next_admission_seq <= (IF "value" \in DOMAIN admission_sequence THEN admission_sequence["value"] ELSE None)) THEN ((IF "value" \in DOMAIN admission_sequence THEN admission_sequence["value"] ELSE None) + 1) ELSE next_admission_seq ELSE IF (admission_sequence_recovery # None) THEN (next_admission_seq) + 1 ELSE next_admission_seq
    /\ input_admission_seq' = IF (admission_sequence # None) THEN MapSet(input_admission_seq, input_id, (IF "value" \in DOMAIN admission_sequence THEN admission_sequence["value"] ELSE None)) ELSE IF (admission_sequence_recovery # None) THEN MapSet(input_admission_seq, input_id, next_admission_seq) ELSE MapRemove(input_admission_seq, input_id)
    /\ input_runtime_boundary' = IF (runtime_boundary # None) THEN MapSet(input_runtime_boundary, input_id, (IF "value" \in DOMAIN runtime_boundary THEN runtime_boundary["value"] ELSE None)) ELSE MapRemove(input_runtime_boundary, input_id)
    /\ input_runtime_execution_kind' = IF (runtime_boundary # None) THEN MapSet(input_runtime_execution_kind, input_id, (IF "value" \in DOMAIN runtime_execution_kind THEN runtime_execution_kind["value"] ELSE None)) ELSE MapRemove(input_runtime_execution_kind, input_id)
    /\ input_runtime_peer_response_terminal_apply_intent' = IF (runtime_boundary # None) THEN IF (runtime_peer_response_terminal_apply_intent # None) THEN MapSet(input_runtime_peer_response_terminal_apply_intent, input_id, (IF "value" \in DOMAIN runtime_peer_response_terminal_apply_intent THEN runtime_peer_response_terminal_apply_intent["value"] ELSE None)) ELSE MapRemove(input_runtime_peer_response_terminal_apply_intent, input_id) ELSE MapRemove(input_runtime_peer_response_terminal_apply_intent, input_id)
