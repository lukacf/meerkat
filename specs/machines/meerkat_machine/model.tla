ObserveLiveAssistantTurnStartedIdle(channel_id, runtime_id, fence_token, generation, assistant_turn_ref, candidate_interaction_id) ==
    /\ phase = "Idle"
    /\ (assistant_turn_ref # "")
    /\ ((IF (channel_id \in DOMAIN live_execution_runtime_id_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_runtime_id_by_channel THEN live_execution_runtime_id_by_channel[channel_id] ELSE "None")) ELSE None) = Some(runtime_id))
    /\ ((IF (channel_id \in DOMAIN live_execution_fence_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_fence_by_channel THEN live_execution_fence_by_channel[channel_id] ELSE "None")) ELSE None) = Some(fence_token))
    /\ ((IF (channel_id \in DOMAIN live_execution_generation_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_generation_by_channel THEN live_execution_generation_by_channel[channel_id] ELSE "None")) ELSE None) = Some(generation))
    /\ (IF (channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel) THEN TRUE ELSE (~((channel_id \in DOMAIN live_provider_turn_by_channel)) /\ ~((channel_id \in DOMAIN live_active_interaction_by_channel)) /\ (candidate_interaction_id # "") /\ ~((candidate_interaction_id \in DOMAIN live_interaction_channel_by_id)) /\ ~((candidate_interaction_id \in live_abandoned_interactions))))
    /\ (~((assistant_turn_ref \in DOMAIN live_assistant_interaction_by_turn)) /\ ~((assistant_turn_ref \in DOMAIN live_assistant_turn_channel_by_ref)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_interaction_channel_by_id' = IF (channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel) THEN live_interaction_channel_by_id ELSE MapSet(live_interaction_channel_by_id, candidate_interaction_id, channel_id)
    /\ live_awaiting_assistant_interaction_by_channel' = MapRemove(live_awaiting_assistant_interaction_by_channel, channel_id)
    /\ live_assistant_interaction_by_turn' = IF (channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel) THEN MapSet(live_assistant_interaction_by_turn, assistant_turn_ref, (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel) THEN Some((IF channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel THEN live_awaiting_assistant_interaction_by_channel[channel_id] ELSE "None")) ELSE None) THEN (IF (channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel) THEN Some((IF channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel THEN live_awaiting_assistant_interaction_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None)) ELSE MapSet(live_assistant_interaction_by_turn, assistant_turn_ref, candidate_interaction_id)
    /\ live_assistant_origin_by_turn' = IF (channel_id \in DOMAIN live_awaiting_assistant_interaction_by_channel) THEN MapSet(live_assistant_origin_by_turn, assistant_turn_ref, "ForegroundCorrelated") ELSE MapSet(live_assistant_origin_by_turn, assistant_turn_ref, "ProviderInitiated")
    /\ live_assistant_turn_channel_by_ref' = MapSet(live_assistant_turn_channel_by_ref, assistant_turn_ref, channel_id)
    /\ live_assistant_playback_segment_by_turn' = MapSet(live_assistant_playback_segment_by_turn, assistant_turn_ref, 0)
    /\ UnchangedFrame_03ab51c3316f6d99


