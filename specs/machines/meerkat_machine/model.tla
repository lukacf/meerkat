LiveBoundaryUnavailableRunning(input_id) ==
    /\ phase = "Running"
    /\ (input_id \in DOMAIN input_phases)
    /\ input_phases[input_id] = "Queued"
    /\ (input_id \in DOMAIN input_lane)
    /\ input_lane[input_id] = "Steer"
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ UNCHANGED Tail(Tail(vars))


