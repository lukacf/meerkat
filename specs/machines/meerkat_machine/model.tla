RunFailed(run_id, runtime_apply_failure_cause, runtime_apply_failure_message, machine_terminal_failure_observed, terminal_failure_source, error) ==
    /\ phase = "Running"
    /\ (current_run_id = Some(run_id))
    /\ (IF (runtime_apply_failure_cause = None) THEN TRUE ELSE ~(machine_terminal_failure_observed))
    /\ (IF ~(machine_terminal_failure_observed) THEN TRUE ELSE (terminal_failure_source = None))
    /\ (IF ~(machine_terminal_failure_observed) THEN TRUE ELSE ((terminal_outcome # None) /\ (terminal_outcome # Some("None")) /\ (terminal_outcome # Some("Completed")) /\ (terminal_outcome # Some("Cancelled"))))
    /\ (IF ~(machine_terminal_failure_observed) THEN TRUE ELSE ((terminal_cause_kind # None) /\ (terminal_cause_kind # Some("Unknown"))))
    /\ (IF ~(machine_terminal_failure_observed) THEN TRUE ELSE (terminal_outcome = Some((IF (terminal_cause_kind = Some("BudgetExhausted")) THEN "BudgetExhausted" ELSE (IF (terminal_cause_kind = Some("TimeBudgetExceeded")) THEN "TimeBudgetExceeded" ELSE (IF (terminal_cause_kind = Some("StructuredOutputValidationFailed")) THEN "StructuredOutputValidationFailed" ELSE "Failed"))))))
    /\ (terminal_failure_source # Some("Unknown"))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ turn_phase' = "Failed"
    /\ turn_terminal_run_id' = Some(run_id)
    /\ terminal_outcome' = IF (IF (terminal_outcome = None) THEN TRUE ELSE (terminal_outcome = Some("None"))) THEN Some((IF (IF (terminal_failure_source = Some("TokenBudgetExceeded")) THEN TRUE ELSE (terminal_failure_source = Some("ToolCallBudgetExceeded"))) THEN "BudgetExhausted" ELSE (IF (terminal_failure_source = Some("TimeBudgetExceeded")) THEN "TimeBudgetExceeded" ELSE (IF (IF (terminal_failure_source = Some("StructuredOutputValidationFailed")) THEN TRUE ELSE (terminal_failure_source = Some("InvalidOutputSchema"))) THEN "StructuredOutputValidationFailed" ELSE "Failed")))) ELSE terminal_outcome
    /\ terminal_cause_kind' = IF (IF (terminal_cause_kind = None) THEN TRUE ELSE (terminal_cause_kind = Some("Unknown"))) THEN Some((IF (runtime_apply_failure_cause # None) THEN "RuntimeApplyFailure" ELSE (IF (terminal_failure_source = Some("HookDenied")) THEN "HookDenied" ELSE (IF (IF (terminal_failure_source = Some("HookTimeout")) THEN TRUE ELSE (IF (terminal_failure_source = Some("HookExecutionFailed")) THEN TRUE ELSE (terminal_failure_source = Some("HookConfigInvalid")))) THEN "HookFailure" ELSE (IF (terminal_failure_source = Some("Llm")) THEN "LlmFailure" ELSE (IF (IF (terminal_failure_source = Some("ToolError")) THEN TRUE ELSE (terminal_failure_source = Some("InvalidToolAccess"))) THEN "ToolFailure" ELSE (IF (IF (terminal_failure_source = Some("StructuredOutputValidationFailed")) THEN TRUE ELSE (terminal_failure_source = Some("InvalidOutputSchema"))) THEN "StructuredOutputValidationFailed" ELSE (IF (IF (terminal_failure_source = Some("TokenBudgetExceeded")) THEN TRUE ELSE (terminal_failure_source = Some("ToolCallBudgetExceeded"))) THEN "BudgetExhausted" ELSE (IF (terminal_failure_source = Some("TimeBudgetExceeded")) THEN "TimeBudgetExceeded" ELSE (IF (terminal_failure_source = Some("LlmRetryExhausted")) THEN "RetryExhausted" ELSE (IF (terminal_failure_source = Some("MaxTurnsReached")) THEN "TurnLimitReached" ELSE "FatalFailure"))))))))))) ELSE terminal_cause_kind
    /\ last_runtime_apply_failure_cause' = runtime_apply_failure_cause
    /\ last_runtime_apply_failure_message' = runtime_apply_failure_message
    /\ runtime_completion_result_run_id' = Some(run_id)
    /\ extraction_active' = FALSE
