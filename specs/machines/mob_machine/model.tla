    /\ ((IF (loop_instance_id \in DOMAIN loop_stage) THEN Some((IF loop_instance_id \in DOMAIN loop_stage THEN loop_stage[loop_instance_id] ELSE "None")) ELSE None) = Some("BodyFrameActive"))
