    /\ ((IF ((agent_identity \in DOMAIN member_rotation_peer_endpoints) = FALSE) THEN TRUE ELSE (agent_identity \in DOMAIN member_rotation_peer_endpoints)) /\ (IF ((agent_identity \in DOMAIN member_rotation_peer_endpoints) = FALSE) THEN TRUE ELSE mob_machine_member_peer_id_available_for_identity(member_peer_endpoints, member_prior_peer_endpoints, agent_identity, (member_rotation_peer_endpoints)[agent_identity])))
    /\ (IF ((agent_identity \in DOMAIN member_rotation_peer_endpoints) = FALSE) THEN TRUE ELSE (\A host \in mob_hosts : (mob_machine_host_id_matches_peer_id(host, mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN (IF (agent_identity \in DOMAIN member_rotation_peer_endpoints) THEN Some((IF agent_identity \in DOMAIN member_rotation_peer_endpoints THEN member_rotation_peer_endpoints[agent_identity] ELSE "None")) ELSE None) THEN (IF (agent_identity \in DOMAIN member_rotation_peer_endpoints) THEN Some((IF agent_identity \in DOMAIN member_rotation_peer_endpoints THEN member_rotation_peer_endpoints[agent_identity] ELSE "None")) ELSE None)["value"] ELSE None))) = FALSE)))
    /\ phase' = "Stopped"
