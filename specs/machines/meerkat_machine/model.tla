    /\ (IF (supervisor_rotation_phase = None) THEN TRUE ELSE ((IF (supervisor_rotation_phase = Some("Completed")) THEN TRUE ELSE (supervisor_rotation_phase = Some("Rejected"))) /\ (supervisor_rotation_operation_id # Some(operation_id))))
