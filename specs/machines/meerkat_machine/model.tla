AuthorizeStoredInputStateSeedIdle(input_id, arg_phase, terminal_kind, superseded_by, aggregate_id, abandon_reason, abandon_attempt_count, attempt_count, run_id, boundary_sequence, admission_sequence, recovery_lane) ==
    /\ phase = "Idle"
    /\ (IF ((arg_phase = "Consumed") /\ (terminal_kind = Some("Consumed")) /\ (superseded_by = None) /\ (aggregate_id = None) /\ (abandon_reason = None)) THEN TRUE ELSE (IF ((arg_phase = "Superseded") /\ (terminal_kind = Some("Superseded")) /\ (superseded_by # None) /\ (aggregate_id = None) /\ (abandon_reason = None)) THEN TRUE ELSE (IF ((arg_phase = "Coalesced") /\ (terminal_kind = Some("Coalesced")) /\ (superseded_by = None) /\ (aggregate_id # None) /\ (abandon_reason = None)) THEN TRUE ELSE (IF ((arg_phase = "Abandoned") /\ (terminal_kind = Some("Abandoned")) /\ (superseded_by = None) /\ (aggregate_id = None) /\ (abandon_reason # None)) THEN TRUE ELSE ((arg_phase # "Consumed") /\ (arg_phase # "Superseded") /\ (arg_phase # "Coalesced") /\ (arg_phase # "Abandoned") /\ (terminal_kind = None) /\ (superseded_by = None) /\ (aggregate_id = None) /\ (abandon_reason = None) /\ (abandon_attempt_count = 0))))))
    /\ (IF ((arg_phase # "Consumed") /\ (arg_phase # "Superseded") /\ (arg_phase # "Coalesced") /\ (arg_phase # "Abandoned")) THEN TRUE ELSE (recovery_lane = None))
    /\ (IF (abandon_reason # Some("MaxAttemptsExhausted")) THEN TRUE ELSE (abandon_attempt_count = attempt_count))
    /\ (IF (abandon_reason # Some("MaxAttemptsExhausted")) THEN TRUE ELSE (attempt_count >= max_stage_attempts))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_deb29ccb8f011b3a


