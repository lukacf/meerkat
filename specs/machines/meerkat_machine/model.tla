d_cursor_by_channel[replacement_channel_id] ELSE 0)) ELSE None)["value"] ELSE None) ELSE canonical_seed_cursor))) /\ ((IF (closing_channel_id \in DOMAIN live_context_recovery_runtime_id_by_channel) THEN Some((IF closing_channel_id \in DOMAIN live_context_recovery_runtime_id_by_channel THEN live_context_recovery_runtime_id_by_channel[closing_channel_id] ELSE "None")) ELSE None) = Some(runtime_id)) /\ ((IF (closing_channel_id \in DOMAIN live_context_recovery_fence_by_channel) THEN Some((IF closing_channel_id \in DOMAIN live_context_recovery_fence_by_channel THEN live_context_recovery_fence_by_channel[closing_channel_id] ELSE "None")) ELSE None) = Some(fence_token)) /\ ((IF (closing_channel_id \in DOMAIN live_context_recovery_generation_by_channel) THEN Some((IF closing_channel_id \in DOMAIN live_context_recovery_generation_by_channel THEN live_context_recovery_generation_by_channel[closing_channel_id] ELSE "None")) ELSE None) = Some(generation)))
