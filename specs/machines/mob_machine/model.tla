operator_instruction_write_well_formed(revision, digest, kind, profile, member) == ((revision >= 1) /\ (digest # "") /\ (IF ((kind = "Mob") /\ (profile = "") /\ (member = None)) THEN TRUE ELSE (IF ((kind = "Profile") /\ (profile # "") /\ (member = None)) THEN TRUE ELSE ((kind = "Member") /\ (profile = "") /\ (member # None)))))
operator_instruction_target_applies(kind, profile, member, member_profile, agent_identity) == (IF (kind = "Mob") THEN TRUE ELSE (IF ((kind = "Profile") /\ (member_profile = Some(profile))) THEN TRUE ELSE ((kind = "Member") /\ (member = Some(agent_identity)))))
member_release_verdict(seated, placed, residency, releasable, wired_to_placed) == (IF (seated = FALSE) THEN "NotAMember" ELSE (IF (placed = TRUE) THEN "HostOwned" ELSE (IF ((residency = Some("Live")) /\ (releasable = TRUE)) THEN "Release" ELSE (IF ((residency = Some("Live")) /\ (wired_to_placed = TRUE)) THEN "PinnedByPlacedPeer" ELSE (IF (residency = Some("Live")) THEN "NotYetReleasable" ELSE (IF (residency = Some("Waking")) THEN "WakeInFlight" ELSE "NothingMaterialized"))))))
member_registration_releasable(residency, placed, sealed, has_endpoint, epoch_recorded, wired_to_placed) == ((residency = Some("Live")) /\ (placed = FALSE) /\ (IF (sealed = FALSE) THEN TRUE ELSE (has_endpoint = TRUE)) /\ (epoch_recorded = TRUE) /\ (wired_to_placed = FALSE))
peer_notice_disposition(recipient_phase, sender_phase, notice_class) == (IF (notice_class = "Lifecycle") THEN (IF (recipient_phase = Some("Dormant")) THEN "Suppressed" ELSE (IF (recipient_phase = Some("Waking")) THEN "Suppressed" ELSE (IF (sender_phase = Some("Dormant")) THEN "Suppressed" ELSE (IF (sender_phase = Some("Waking")) THEN "Suppressed" ELSE "Deliver")))) ELSE "Deliver")
member_boot_materialization(policy, composition_authoritative, host_pending, origin_open, obligation, kickoff_pending, network_transport, orchestrator_notified, has_durable_endpoint, host_required, session_unborn) == (IF (composition_authoritative = FALSE) THEN "StayDormant" ELSE (IF (host_pending = TRUE) THEN "StayDormant" ELSE (IF (origin_open = FALSE) THEN "StayDormant" ELSE (IF (policy = "Eager") THEN "Wake" ELSE (IF (obligation # "None") THEN "Wake" ELSE (IF (kickoff_pending = TRUE) THEN "Wake" ELSE (IF (network_transport = TRUE) THEN "Wake" ELSE (IF (orchestrator_notified = TRUE) THEN "Wake" ELSE (IF (has_durable_endpoint = FALSE) THEN "Wake" ELSE (IF (host_required = TRUE) THEN "Wake" ELSE (IF ((policy = "OnDemandVerified") /\ (session_unborn = FALSE)) THEN "VerifyThenDormant" ELSE "StayDormant")))))))))))
member_wake_refusal(member_present, session_bound, placed, broken, retiring, mob_admitting, composition_authoritative, origin_open, host_pending, input_class, sender_waking, observed_missing, arg_phase) == (IF (member_present = FALSE) THEN Some("NotAMember") ELSE (IF (placed = TRUE) THEN Some("HostOwned") ELSE (IF (broken = TRUE) THEN Some("Broken") ELSE (IF (retiring = TRUE) THEN Some("Retiring") ELSE (IF (session_bound = FALSE) THEN Some("NotAMember") ELSE (IF ((arg_phase = Some("Live")) /\ (observed_missing = FALSE)) THEN None ELSE (IF (mob_admitting = FALSE) THEN Some("MobNotRunning") ELSE (IF (composition_authoritative = FALSE) THEN Some("NonAuthoritativeComposition") ELSE (IF (origin_open = FALSE) THEN Some("LifecycleOriginFenced") ELSE (IF (host_pending = TRUE) THEN Some("HostPreparationPending") ELSE (IF (input_class = "Lifecycle") THEN Some("SuppressedLifecycleNotice") ELSE (IF (sender_waking = TRUE) THEN Some("SenderWaking") ELSE (IF (arg_phase = None) THEN Some("NotAMember") ELSE None)))))))))))))
construction_end_verdict(names_held_attempt, names_activating_attempt, end) == (IF (names_activating_attempt = TRUE) THEN (IF (end = "PublicationFailed") THEN "Ended" ELSE "ActivationPending") ELSE (IF (names_held_attempt = TRUE) THEN "Ended" ELSE "NotOpen"))
preparation_settle_verdict(composition_authoritative, preparation_pending, constructed, attempt_named, names_held_attempt, names_activating_attempt, construction_open, before_deadline, binding_matches) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (preparation_pending = FALSE) THEN "NotPending" ELSE (IF (names_activating_attempt = TRUE) THEN "ActivationPending" ELSE (IF (attempt_named = FALSE) THEN (IF (constructed = TRUE) THEN "ConstructionRequired" ELSE (IF (construction_open = TRUE) THEN "ConstructionOpen" ELSE "Seat")) ELSE (IF (names_held_attempt = FALSE) THEN "StaleAttempt" ELSE (IF (before_deadline = FALSE) THEN "Expired" ELSE (IF (binding_matches = FALSE) THEN "Mismatch" ELSE "ActivationAccepted")))))))
preparation_construction_verdict(composition_authoritative, preparation_pending, constructed, construction_open) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (preparation_pending = FALSE) THEN "NotPending" ELSE (IF (constructed = FALSE) THEN "NotConstructed" ELSE (IF (construction_open = TRUE) THEN "ConstructionOpen" ELSE "Held"))))
unlist_entry_verdict(composition_authoritative, declared_entry, in_flight, seated) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (declared_entry = FALSE) THEN "NotADeclaredEntry" ELSE (IF (in_flight = TRUE) THEN "Deferred" ELSE (IF (seated = TRUE) THEN "Retiring" ELSE "Removed"))))
created_entry_cause(preparation_required, placement, held_creation) == (IF (preparation_required = TRUE) THEN "PreparationPending" ELSE (IF (placement # "Local") THEN "HostedOnFirstUse" ELSE (IF (held_creation = TRUE) THEN "HeldCreation" ELSE "SeatOwed")))
identity_import_verdict(kind, adopted_from_roster, row, composition_authoritative, changes_held, rows_purged, unsettled, rowless, origin_declared, origin_created, name_reserved, seated, placed, session_bound, seat_owed) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (changes_held = TRUE) THEN "ChangesHeld" ELSE (IF (rows_purged = TRUE) THEN "RowsPurged" ELSE (IF (row = "Same") THEN "Unchanged" ELSE (IF (row = "Other") THEN "NameTakenMeanwhile" ELSE (IF (unsettled = TRUE) THEN "Unsettled" ELSE (IF (rowless = TRUE) THEN (IF (kind = "Tombstone") THEN (IF (seated = TRUE) THEN "NameTakenMeanwhile" ELSE "RestoredTombstone") ELSE (IF (seated = TRUE) THEN (IF ((kind = "Present") /\ (placed = FALSE) /\ (session_bound = TRUE)) THEN "RestoredInPlace" ELSE "NameTakenMeanwhile") ELSE (IF (kind = "Present") THEN "RestoredOwedSeat" ELSE (IF (kind = "PendingPreparation") THEN "RestoredPending" ELSE "RestoredArchived")))) ELSE (IF (IF (name_reserved = TRUE) THEN TRUE ELSE (origin_created = TRUE)) THEN "NameTakenMeanwhile" ELSE (IF (origin_declared = TRUE) THEN (IF ((kind = "Present") /\ (adopted_from_roster = TRUE) /\ (IF ((seated = TRUE) /\ (placed = FALSE) /\ (session_bound = TRUE)) THEN TRUE ELSE ((seated = FALSE) /\ (seat_owed = TRUE)))) THEN "RestoredByAdoption" ELSE "NameTakenMeanwhile") ELSE (IF (seated = TRUE) THEN (IF ((kind = "Present") /\ (placed = FALSE) /\ (session_bound = TRUE)) THEN "RestoredInPlace" ELSE "NameTakenMeanwhile") ELSE (IF (kind = "Present") THEN "RestoredOwedSeat" ELSE (IF (kind = "PendingPreparation") THEN "RestoredPending" ELSE (IF (kind = "Archived") THEN "RestoredArchived" ELSE "RestoredTombstone")))))))))))))
identity_rows_purge_verdict(composition_authoritative, receipt, rows_purged, host_operator, changes_held) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (receipt = "Same") THEN "Replayed" ELSE (IF (receipt = "Other") THEN "OperationReused" ELSE (IF (rows_purged = TRUE) THEN "RowsPurged" ELSE (IF (host_operator = FALSE) THEN "NotHostOperator" ELSE (IF (changes_held = FALSE) THEN "ChangesNotHeld" ELSE "Purged"))))))
identity_not_adoptable_reason(source, origin_declared, origin_created, seated, placed, hosted_on_first_use, held_creation) == (IF (origin_created = TRUE) THEN "StoreOwned" ELSE (IF (source = "Roster") THEN (IF (origin_declared = FALSE) THEN "NotAnIdentity" ELSE (IF (seated = TRUE) THEN (IF (placed = TRUE) THEN "Placed" ELSE "NoSession") ELSE (IF (hosted_on_first_use = TRUE) THEN "HostedOnFirstUse" ELSE (IF (held_creation = TRUE) THEN "AwaitingHeldCreation" ELSE "AwaitingHostPreparation")))) ELSE (IF (origin_declared = TRUE) THEN "RosterOwned" ELSE (IF (seated = FALSE) THEN "NotAMember" ELSE (IF (placed = TRUE) THEN "Placed" ELSE "NoSession")))))
identity_adoption_verdict(source, composition_authoritative, changes_held, arg_declared_apply_open, name_unreadable, name_tombstoned, origin_declared, origin_created, seated, generation_current, unsettled, placed, session_bound, seat_owed) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (changes_held = TRUE) THEN "ChangesHeld" ELSE (IF (arg_declared_apply_open = TRUE) THEN "DeclaredApplyOpen" ELSE (IF (name_unreadable = TRUE) THEN "NameUnreadable" ELSE (IF (name_tombstoned = TRUE) THEN "NameTombstoned" ELSE (IF (origin_created = TRUE) THEN "NotAdoptable" ELSE (IF (source = "Roster") THEN (IF (origin_declared = FALSE) THEN "NotAdoptable" ELSE (IF (unsettled = TRUE) THEN "AdmissionUnsettled" ELSE (IF (seated = TRUE) THEN (IF (IF (placed = TRUE) THEN TRUE ELSE (session_bound = FALSE)) THEN "NotAdoptable" ELSE "Adopted") ELSE (IF (seat_owed = TRUE) THEN "Adopted" ELSE "NotAdoptable")))) ELSE (IF (origin_declared = TRUE) THEN "NotAdoptable" ELSE (IF (seated = FALSE) THEN "NotAdoptable" ELSE (IF (generation_current = FALSE) THEN "PredecessorMismatch" ELSE (IF (unsettled = TRUE) THEN "AdmissionUnsettled" ELSE (IF (IF (placed = TRUE) THEN TRUE ELSE (session_bound = FALSE)) THEN "NotAdoptable" ELSE "Adopted"))))))))))))
identity_entry_change_verdict(kind, composition_authoritative, changes_held, name_unreadable, name_tombstoned, entry_recorded, entry_store_owned, in_flight, seated, archived, preparation_pending) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (changes_held = TRUE) THEN "ChangesHeld" ELSE (IF (name_unreadable = TRUE) THEN "NameUnreadable" ELSE (IF (name_tombstoned = TRUE) THEN (IF (kind = "Remove") THEN "AlreadyRemoved" ELSE "Unknown") ELSE (IF (entry_recorded = FALSE) THEN "Unknown" ELSE (IF ((kind = "Archive") /\ (entry_store_owned = TRUE) /\ (preparation_pending = TRUE)) THEN "PreparationPending" ELSE (IF (in_flight = TRUE) THEN "InFlight" ELSE (IF (kind = "Remove") THEN (IF (seated = TRUE) THEN "Retiring" ELSE "Removed") ELSE (IF (entry_store_owned = FALSE) THEN "OwnedByRoster" ELSE (IF (kind = "Archive") THEN (IF (archived = TRUE) THEN "AlreadyArchived" ELSE (IF (seated = TRUE) THEN "Archiving" ELSE "Archived")) ELSE (IF (archived = TRUE) THEN "Restored" ELSE "NotArchived")))))))))))
created_identity_record_verdict(composition_authoritative, changes_held, name_unreadable, name_tombstoned, held_by_identity, held_by_worker) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (changes_held = TRUE) THEN "ChangesHeld" ELSE (IF (name_unreadable = TRUE) THEN "NameUnreadable" ELSE (IF (name_tombstoned = TRUE) THEN "NameTombstoned" ELSE (IF (held_by_identity = TRUE) THEN "NameHeldByIdentity" ELSE (IF (held_by_worker = TRUE) THEN "NameHeldByWorker" ELSE "Recorded"))))))
identity_change_admission(composition_authoritative, receipt, rows_purged, changes_held, consent, permit_binds, permit_admits, host_operator, grant_current, spec_current) == (IF (composition_authoritative = FALSE) THEN "NonAuthoritative" ELSE (IF (receipt = "Same") THEN "Replayed" ELSE (IF (receipt = "Other") THEN "OperationReused" ELSE (IF (rows_purged = TRUE) THEN "RowsPurged" ELSE (IF (changes_held = TRUE) THEN "ChangesHeld" ELSE (IF ((consent = "Decided") /\ (permit_binds = FALSE)) THEN "DecisionUnbound" ELSE (IF ((consent = "Decided") /\ (permit_admits = FALSE)) THEN "DecisionExpired" ELSE (IF ((consent = "Imported") /\ (host_operator = FALSE)) THEN "ImportedNotHostOperator" ELSE (IF (grant_current = FALSE) THEN "GrantRevoked" ELSE (IF (spec_current = FALSE) THEN "StaleSpec" ELSE "Admitted"))))))))))
identity_entry_verdict(composition_authoritative, intent_managed, worker_holds_name, lifecycle_in_flight, seated, ever_created, placement, held_creation, profile_matches, migration_declared_from_current, session_memory_only, mode_matches, resume_role_moved, migration_declared_from_resume_role, preparation_required, record_only) == (IF (composition_authoritative = FALSE) THEN "RefusedNonAuthoritative" ELSE (IF (intent_managed = TRUE) THEN "RefusedHostAdopted" ELSE (IF (worker_holds_name = TRUE) THEN "RefusedNameHeldByWorker" ELSE (IF (lifecycle_in_flight = TRUE) THEN "LifecycleInFlight" ELSE (IF (record_only = TRUE) THEN "RecordOnly" ELSE (IF (seated = FALSE) THEN (IF ((preparation_required = TRUE) /\ (ever_created = FALSE)) THEN "PreparationPending" ELSE (IF (placement # "Local") THEN "HostedOnFirstUse" ELSE (IF ((held_creation = TRUE) /\ (ever_created = FALSE)) THEN "AwaitHeldCreation" ELSE (IF ((resume_role_moved = TRUE) /\ (migration_declared_from_resume_role = FALSE)) THEN "RoleMigrationHeld" ELSE "SeatOwed")))) ELSE (IF (profile_matches = FALSE) THEN (IF (session_memory_only = TRUE) THEN "RoleRotate" ELSE (IF (migration_declared_from_current = TRUE) THEN "RoleMigrate" ELSE "RoleMigrationHeld")) ELSE (IF (mode_matches = FALSE) THEN (IF (session_memory_only = TRUE) THEN "RoleRotate" ELSE "RuntimeModeRestamp") ELSE "Kept"))))))))
identity_reconcile_decision(intent, lease, replacement, external_binding_required, initial_delivery_required, session_creation_receipt, retirement_receipt, session, runtime, member, external_binding_receipt, external_trust, external_ceremony, initial_delivery_receipt, initial_delivery, wiring) == (IF (replacement = "AdmissionOpen") THEN "CloseMemberAdmission" ELSE (IF (replacement = "Draining") THEN "AwaitMemberDrain" ELSE (IF (replacement = "DrainBlocked") THEN "DrainBlocked" ELSE (IF (replacement = "CancelActive") THEN "CancelActiveMember" ELSE (IF (replacement = "Ready") THEN "RetireMemberMaterialization" ELSE (IF (intent = "Unavailable") THEN "Backoff" ELSE (IF (IF (intent = "Missing") THEN TRUE ELSE (intent = "Malformed")) THEN "RepairBlocked" ELSE (IF (lease = "Unavailable") THEN "Backoff" ELSE (IF (IF (lease = "Missing") THEN TRUE ELSE (IF (lease = "HeldByExpiredIncarnation") THEN TRUE ELSE (lease = "HeldByEndedIncarnation"))) THEN "AcquireLease" ELSE (IF (lease = "Malformed") THEN "RepairBlocked" ELSE (IF (lease = "HeldByOtherLiveIncarnation") THEN "AwaitLease" ELSE (IF (intent = "Absent") THEN (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Matching") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (member = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (member = "Matching") THEN TRUE ELSE (member = "Divergent")) THEN "RetireMemberMaterialization" ELSE (IF (runtime = "Unavailable") THEN "Backoff" ELSE (IF (runtime = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (runtime = "Matching") THEN TRUE ELSE (runtime = "Divergent")) THEN "RetireRuntimeRegistration" ELSE (IF (session = "Unavailable") THEN "Backoff" ELSE (IF (IF (session = "Malformed") THEN TRUE ELSE (session = "AmbiguousDivergence")) THEN "RepairBlocked" ELSE (IF (IF (session = "Matching") THEN TRUE ELSE (IF (session = "RecoverableDivergence") THEN TRUE ELSE (session = "IrrecoverablyCorrupt"))) THEN "ReleaseSessionAuthority" ELSE (IF (retirement_receipt = "Unavailable") THEN "Backoff" ELSE (IF (retirement_receipt = "Missing") THEN "SealRetirementProven" ELSE (IF (retirement_receipt = "Matching") THEN "Tombstoned" ELSE "RepairBlocked"))))))))))))))) ELSE (IF (session = "Unavailable") THEN "Backoff" ELSE (IF (IF (session = "Malformed") THEN TRUE ELSE (IF (session = "IrrecoverablyCorrupt") THEN TRUE ELSE (IF (session = "AmbiguousDivergence") THEN TRUE ELSE ((session = "Missing") /\ (intent = "PresentRequireExisting"))))) THEN (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Matching") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (member = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (member = "Matching") THEN TRUE ELSE (member = "Divergent")) THEN "RetireMemberMaterialization" ELSE (IF (runtime = "Unavailable") THEN "Backoff" ELSE (IF (runtime = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (runtime = "Matching") THEN TRUE ELSE (runtime = "Divergent")) THEN "RetireRuntimeRegistration" ELSE (IF (session = "IrrecoverablyCorrupt") THEN "Quarantined" ELSE "RepairBlocked")))))))))) ELSE (IF (IF (session = "Missing") THEN TRUE ELSE (session = "RecoverableDivergence")) THEN (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Unavailable")) THEN "Backoff" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (IF (session_creation_receipt = "Conflicting") THEN TRUE ELSE (IF (session_creation_receipt = "Malformed") THEN TRUE ELSE (session_creation_receipt = "NotRequired")))) THEN "RepairBlocked" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Matching") /\ (session = "Missing")) THEN "RepairBlocked" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (IF (session_creation_receipt = "Missing") THEN TRUE ELSE (session_creation_receipt = "Matching"))) THEN "EnsureSessionAuthority" ELSE (IF ((intent = "PresentRequireExisting") /\ (session_creation_receipt = "NotRequired")) THEN "EnsureSessionAuthority" ELSE (IF ((intent = "PresentRequireExisting") /\ (session_creation_receipt = "Unavailable")) THEN "Backoff" ELSE "RepairBlocked")))))) ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Unavailable")) THEN "Backoff" ELSE (IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Missing")) THEN "SealSessionCreationConsumed" ELSE (IF ~((IF ((intent = "PresentCreateIfAbsent") /\ (session_creation_receipt = "Matching")) THEN TRUE ELSE ((intent = "PresentRequireExisting") /\ (session_creation_receipt = "NotRequired")))) THEN "RepairBlocked" ELSE (IF (runtime = "Unavailable") THEN "Backoff" ELSE (IF (runtime = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (runtime = "Missing") THEN TRUE ELSE (runtime = "Divergent")) THEN "EnsureRuntimeRegistration" ELSE (IF (external_binding_required = TRUE) THEN (IF (external_binding_receipt = "Unavailable") THEN "Backoff" ELSE (IF (external_binding_receipt = "Missing") THEN "EnsureExternalBindingReceipt" ELSE (IF (IF (external_binding_receipt = "Conflicting") THEN TRUE ELSE (IF (external_binding_receipt = "Malformed") THEN TRUE ELSE (external_binding_receipt = "NotRequired"))) THEN "RepairBlocked" ELSE (IF (external_trust = "Unavailable") THEN "Backoff" ELSE (IF (external_trust = "Absent") THEN (IF (external_ceremony = "FreshAvailable") THEN "EnsureExternalBinding" ELSE (IF (external_ceremony = "AwaitFresh") THEN "AwaitExternalBindingCeremony" ELSE (IF (external_ceremony = "TemporarilyUnavailable") THEN "Backoff" ELSE "RepairBlocked"))) ELSE (IF (IF (external_trust = "Contradictory") THEN TRUE ELSE (IF (external_trust = "Indeterminate") THEN TRUE ELSE (IF (external_trust = "Malformed") THEN TRUE ELSE (external_trust = "NotRequired")))) THEN "RepairBlocked" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (IF (member = "Malformed") THEN TRUE ELSE (member = "Divergent")) THEN "RepairBlocked" ELSE (IF (member = "Missing") THEN "EnsureMemberMaterialization" ELSE (IF (initial_delivery_required = TRUE) THEN (IF (initial_delivery_receipt = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery_receipt = "Missing") THEN "EnsureInitialDeliveryReceipt" ELSE (IF (IF (initial_delivery_receipt = "Conflicting") THEN TRUE ELSE (IF (initial_delivery_receipt = "Malformed") THEN TRUE ELSE (initial_delivery_receipt = "NotRequired"))) THEN "RepairBlocked" ELSE (IF (initial_delivery = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery = "ProvenAbsent") THEN "EnsureInitialDelivery" ELSE (IF (initial_delivery = "AcceptedPendingExact") THEN "AwaitInitialDelivery" ELSE (IF (IF (initial_delivery = "ContentOnlyMatch") THEN TRUE ELSE (IF (initial_delivery = "OperationCollision") THEN TRUE ELSE (IF (initial_delivery = "Contradictory") THEN TRUE ELSE (IF (initial_delivery = "Indeterminate") THEN TRUE ELSE (IF (initial_delivery = "Malformed") THEN TRUE ELSE (initial_delivery = "NotRequired")))))) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))) ELSE (IF (IF (initial_delivery_receipt # "NotRequired") THEN TRUE ELSE (initial_delivery # "NotRequired")) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))))))) ELSE (IF (IF (external_binding_receipt # "NotRequired") THEN TRUE ELSE (IF (external_trust # "NotRequired") THEN TRUE ELSE (external_ceremony # "NotRequired"))) THEN "RepairBlocked" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (IF (member = "Malformed") THEN TRUE ELSE (member = "Divergent")) THEN "RepairBlocked" ELSE (IF (member = "Missing") THEN "EnsureMemberMaterialization" ELSE (IF (initial_delivery_required = TRUE) THEN (IF (initial_delivery_receipt = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery_receipt = "Missing") THEN "EnsureInitialDeliveryReceipt" ELSE (IF (IF (initial_delivery_receipt = "Conflicting") THEN TRUE ELSE (IF (initial_delivery_receipt = "Malformed") THEN TRUE ELSE (initial_delivery_receipt = "NotRequired"))) THEN "RepairBlocked" ELSE (IF (initial_delivery = "Unavailable") THEN "Backoff" ELSE (IF (initial_delivery = "ProvenAbsent") THEN "EnsureInitialDelivery" ELSE (IF (initial_delivery = "AcceptedPendingExact") THEN "AwaitInitialDelivery" ELSE (IF (IF (initial_delivery = "ContentOnlyMatch") THEN TRUE ELSE (IF (initial_delivery = "OperationCollision") THEN TRUE ELSE (IF (initial_delivery = "Contradictory") THEN TRUE ELSE (IF (initial_delivery = "Indeterminate") THEN TRUE ELSE (IF (initial_delivery = "Malformed") THEN TRUE ELSE (initial_delivery = "NotRequired")))))) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))) ELSE (IF (IF (initial_delivery_receipt # "NotRequired") THEN TRUE ELSE (initial_delivery # "NotRequired")) THEN "RepairBlocked" ELSE (IF (retirement_receipt # "NotRequired") THEN "RepairBlocked" ELSE (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Missing") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE "Converged"))))))))))))))))))))))))))))))))
mob_machine_next_respawn_generation(arg_identity_runtime_generations, arg_agent_identity) ==
    IF arg_agent_identity \notin DOMAIN arg_identity_runtime_generations
    THEN Some(0)
    ELSE IF arg_identity_runtime_generations[arg_agent_identity] = RustU64Max
         THEN None
         ELSE Some(arg_identity_runtime_generations[arg_agent_identity] + 1)
mob_machine_next_minted_generation(arg_identity_runtime_generations, arg_identity_generation_highwater, arg_agent_identity) ==
    LET retained == IF arg_agent_identity \in DOMAIN arg_identity_runtime_generations
                    THEN arg_identity_runtime_generations[arg_agent_identity] ELSE 0
        highwater == IF arg_agent_identity \in DOMAIN arg_identity_generation_highwater
                     THEN arg_identity_generation_highwater[arg_agent_identity] ELSE 0
        base == IF retained >= highwater THEN retained ELSE highwater
    IN IF arg_agent_identity \notin DOMAIN arg_identity_runtime_generations /\ arg_agent_identity \notin DOMAIN arg_identity_generation_highwater
       THEN Some(0)
       ELSE IF base = RustU64Max THEN None ELSE Some(base + 1)
mob_machine_u64_is_exact_successor(arg_current, arg_next) ==
    /\ arg_current # RustU64Max
    /\ arg_next = arg_current + 1
mob_machine_optional_u64_is_exact_successor(arg_current, arg_next) ==
    /\ arg_current # RustU64Max
    /\ arg_next = Some(arg_current + 1)
mob_machine_remote_turn_custody_admits(pending, committed, resolved, candidate) ==
    LET same_member_host_count == Cardinality({ row \in pending : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
            + Cardinality({ row \in committed : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
            + Cardinality({ row \in resolved : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
    IN /\ Cardinality(pending) + Cardinality(committed) + Cardinality(resolved) < 4096
       /\ candidate.dispatch_sequence > 0
       /\ candidate.input_id # ""
       /\ candidate.run_id # ""
       /\ candidate.step_id # ""
       /\ candidate.host_id # ""
       /\ candidate.member_session_id # ""
       /\ \A row \in pending : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ \A row \in committed : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ \A row \in resolved : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ same_member_host_count < 256
mob_machine_placed_completion_obligation_well_formed(candidate) ==
    /\ candidate.agent_identity # ""
    /\ candidate.host_id # ""
    /\ candidate.host_binding_generation > 0
    /\ candidate.member_session_id # ""
    /\ candidate.dispatch_sequence > 0
    /\ candidate.input_id # ""
mob_machine_placed_completion_custody_admits(pending, resolved, candidate) ==
    LET rows == pending \cup resolved
        same_member_host == Cardinality({ row \in rows : /\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id })
    IN /\ Cardinality(rows) < 4096
       /\ \A row \in rows : /\ row.dispatch_sequence # candidate.dispatch_sequence /\ \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
       /\ same_member_host < 256
mob_machine_adaptive_lifecycle_drained(active_run, active_layer, active_members, layer_phases, layer_dispositions) ==
    /\ active_run = None
    /\ DOMAIN active_layer = {}
    /\ \A run_id \in DOMAIN active_members : active_members[run_id] = 0
    /\ \A layer_id \in DOMAIN layer_phases :
           \/ layer_phases[layer_id] = "Validating"
           \/ /\ layer_id \in DOMAIN layer_dispositions
              /\ layer_phases[layer_id] \in {"Completed", "SetupFailed", "RunFailed", "ResultInvalid", "Canceled"}
mob_machine_adaptive_run_custody_drained(adaptive_run_id, active_layer, active_members, layer_run, layer_phases, layer_dispositions) ==
    /\ adaptive_run_id \notin DOMAIN active_layer
    /\ (IF adaptive_run_id \in DOMAIN active_members THEN active_members[adaptive_run_id] ELSE 0) = 0
    /\ \A layer_id \in DOMAIN layer_run :
           \/ layer_run[layer_id] # adaptive_run_id
           \/ /\ layer_id \in DOMAIN layer_dispositions
              /\ layer_id \in DOMAIN layer_phases
              /\ layer_phases[layer_id] \in {"Completed", "SetupFailed", "RunFailed", "ResultInvalid", "Canceled"}
mob_machine_finalized_placed_kickoff_recovery_well_formed(started, callback_pending, failed, cancelled, kickoff_errors, identity, outcome_kind, outcome_error, closure_kind) ==
    /\ Cardinality({ kickoff_phase \in {"Started", "CallbackPending", "Failed", "Cancelled"} :
           CASE kickoff_phase = "Started" -> identity \in started
             [] kickoff_phase = "CallbackPending" -> identity \in callback_pending
             [] kickoff_phase = "Failed" -> identity \in failed
             [] OTHER -> identity \in cancelled }) = 1
    /\ CASE outcome_kind = "Failed" -> outcome_error # None
          [] outcome_kind = "RejectedNoEffect" -> /\ outcome_error # None /\ outcome_error.value # ""
          [] OTHER -> outcome_error = None
    /\ CASE closure_kind = "Acknowledged" -> /\ outcome_kind # "RejectedNoEffect" /\ outcome_kind # "Disposed"
          [] closure_kind = "RejectedNoEffect" -> outcome_kind = "RejectedNoEffect"
          [] OTHER -> outcome_kind # "RejectedNoEffect"
    /\ CASE identity \in cancelled -> identity \notin DOMAIN kickoff_errors
          [] identity \in started -> /\ outcome_kind = "Started" /\ identity \notin DOMAIN kickoff_errors
          [] identity \in callback_pending -> /\ outcome_kind = "CallbackPending" /\ identity \notin DOMAIN kickoff_errors
          [] OTHER -> /\ outcome_kind \in {"Failed", "RejectedNoEffect"} /\ identity \in DOMAIN kickoff_errors /\ outcome_error = Some(kickoff_errors[identity])
mob_machine_placed_kickoff_obligation_well_formed(candidate) ==
    /\ candidate.agent_identity # ""
    /\ candidate.host_id # ""
    /\ candidate.host_binding_generation > 0
    /\ candidate.member_session_id # ""
    /\ candidate.input_id # ""
    /\ candidate.objective_id # ""
mob_machine_placed_kickoff_correlation_available(pending_kickoffs, resolved_kickoffs, retained_kickoffs, pending_turns, committed_turns, resolved_turns, pending_completions, resolved_completions, candidate) ==
    /\ \A row \in pending_kickoffs \cup resolved_kickoffs : /\ row.agent_identity # candidate.agent_identity /\ \lnot (/\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
    /\ \A identity \in DOMAIN retained_kickoffs : retained_kickoffs[identity].agent_identity # candidate.agent_identity
    /\ \A row \in pending_turns \cup committed_turns \cup resolved_turns : \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
    /\ \A row \in pending_completions \cup resolved_completions : \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
mob_machine_placed_kickoff_custody_absent_for_identity(pending, resolved, agent_identity) ==
    \A row \in pending \cup resolved : row.agent_identity # agent_identity
mob_machine_placed_kickoff_custody_absent_for_host(pending, resolved, host_id) ==
    \A row \in pending \cup resolved : row.host_id # host_id
mob_machine_remote_turn_input_id_available_to_kickoff(pending, resolved, retained, candidate) ==
    /\ \A row \in pending \cup resolved : \lnot (/\ row.agent_identity = candidate.agent_identity /\ row.host_id = candidate.host_id /\ row.generation = candidate.generation /\ row.fence_token = candidate.fence_token /\ row.input_id = candidate.input_id)
    /\ \A identity \in DOMAIN retained : \lnot (/\ retained[identity].agent_identity = candidate.agent_identity /\ retained[identity].host_id = candidate.host_id /\ retained[identity].generation = candidate.generation /\ retained[identity].fence_token = candidate.fence_token /\ retained[identity].input_id = candidate.input_id)
mob_machine_wiring_edges_without_identity(arg_wiring_edges, arg_agent_identity) ==
    { edge \in arg_wiring_edges : /\ edge.a # arg_agent_identity /\ edge.b # arg_agent_identity }
mob_machine_wiring_edge_other(arg_edge, arg_agent_identity) ==
    IF arg_edge.a = arg_agent_identity THEN arg_edge.b ELSE arg_edge.a
mob_machine_owned_edges_without_identity(arg_identity_edge_owners, arg_agent_identity) ==
    [edge \in { e \in DOMAIN arg_identity_edge_owners : /\ e.a # arg_agent_identity /\ e.b # arg_agent_identity } |-> arg_identity_edge_owners[edge]]
mob_machine_external_peer_edges_without_identity(arg_external_peer_edges, arg_agent_identity) ==
    { edge \in arg_external_peer_edges : edge.local # arg_agent_identity }
mob_machine_external_peer_edges_by_key_without_identity(arg_external_peer_edges_by_key, arg_agent_identity) ==
    [key \in { key \in DOMAIN arg_external_peer_edges_by_key : key.local # arg_agent_identity } |-> arg_external_peer_edges_by_key[key]]
mob_machine_fresh_rotation_sessions(arg_member_rotation_session_ids, arg_member_rotation_targets) ==
    [id \in { id \in DOMAIN arg_member_rotation_session_ids : ~(id \in DOMAIN arg_member_rotation_targets /\ arg_member_rotation_targets[id] = "SameSession") } |-> arg_member_rotation_session_ids[id]]
mob_machine_members_to_spawn(arg_identity_to_runtime, arg_identity_entry_origins, arg_identity_entry_tombstones, arg_identity_entry_unreadable, arg_desired) ==
    { member \in arg_desired : member \notin DOMAIN arg_identity_to_runtime /\ member \notin DOMAIN arg_identity_entry_origins /\ member \notin arg_identity_entry_tombstones /\ member \notin arg_identity_entry_unreadable }
mob_machine_members_to_retire(arg_identity_to_runtime, arg_identity_entry_origins, arg_identity_entry_unreadable, arg_desired, arg_retire_stale) ==
    IF arg_retire_stale
    THEN { member \in DOMAIN arg_identity_to_runtime : member \notin arg_desired /\ member \notin DOMAIN arg_identity_entry_origins /\ member \notin arg_identity_entry_unreadable }
    ELSE {}
mob_machine_placed_cleanup_absent_for_identity(arg_obligations, arg_agent_identity) ==
    \A obligation \in arg_obligations : obligation.agent_identity # arg_agent_identity
mob_machine_placed_cleanup_obligation(arg_agent_identity, arg_spawn_id, arg_generation, arg_fence_token, arg_provision_operation_id, arg_operation_owner_session_id, arg_expected_phase) ==
    [agent_identity |-> arg_agent_identity, spawn_id |-> arg_spawn_id, generation |-> arg_generation, fence_token |-> arg_fence_token, provision_operation_id |-> arg_provision_operation_id, operation_owner_session_id |-> arg_operation_owner_session_id, expected_phase |-> arg_expected_phase]
mob_machine_placed_carrier_binding_active(arg_member_placement, arg_current_binding_generations, arg_host_bind_phase, arg_host_binding_generations, arg_agent_identity) ==
    IF arg_agent_identity \notin DOMAIN arg_member_placement
    THEN FALSE
    ELSE LET host == arg_member_placement[arg_agent_identity]
         IN IF host \notin DOMAIN arg_host_bind_phase
            THEN FALSE
            ELSE IF arg_host_bind_phase[host] # "Bound"
                 THEN FALSE
                 ELSE IF arg_agent_identity \notin DOMAIN arg_current_binding_generations
                      THEN FALSE
                      ELSE LET generation == arg_current_binding_generations[arg_agent_identity]
                           IN /\ generation > 0
                              /\ host \in DOMAIN arg_host_binding_generations
                              /\ arg_host_binding_generations[host] = generation
mob_machine_host_binding_generation_tombstone(arg_host_id, arg_binding_generation) ==
    [host_id |-> arg_host_id, binding_generation |-> arg_binding_generation]
mob_machine_placed_carrier_binding_confirmed_revoked(arg_member_placement, arg_current_binding_generations, arg_host_bind_phase, arg_confirmed_revocations, arg_agent_identity) ==
    IF arg_agent_identity \notin DOMAIN arg_member_placement
    THEN FALSE
    ELSE LET host == arg_member_placement[arg_agent_identity]
         IN IF arg_agent_identity \notin DOMAIN arg_current_binding_generations
            THEN FALSE
            ELSE LET generation == arg_current_binding_generations[arg_agent_identity]
                 IN /\ generation > 0
                    /\ (IF host \in DOMAIN arg_host_bind_phase THEN arg_host_bind_phase[host] # "Bound" ELSE TRUE)
                    /\ [host_id |-> host, binding_generation |-> generation] \in arg_confirmed_revocations
mob_coordination_expired_at(expires_at_ms, now_ms) ==
    /\ expires_at_ms # None
    /\ expires_at_ms.value <= now_ms
mob_coordination_work_intent_unexpired(expires_at_ms, now_ms) == ~mob_coordination_expired_at(expires_at_ms, now_ms)
mob_coordination_resource_claim_unexpired(expires_at_ms, now_ms) == ~mob_coordination_expired_at(expires_at_ms, now_ms)
mob_coordination_resource_claim_active_at(status, expires_at_ms, now_ms) ==
    /\ status = "Active"
    /\ ~mob_coordination_expired_at(expires_at_ms, now_ms)
mob_coordination_resource_claim_inactive_at(status, expires_at_ms, now_ms) == ~mob_coordination_resource_claim_active_at(status, expires_at_ms, now_ms)
mob_machine_external_peer_edge_has_matching_key(edges_by_key, edge) ==
    LET key == [local |-> edge.local, name |-> edge.endpoint.name]
    IN /\ key \in DOMAIN edges_by_key
       /\ edges_by_key[key] = edge
mob_machine_external_peer_edge_local(edge) == edge.local
mob_machine_external_peer_edge_peer_id(edge) == edge.endpoint.peer_id
mob_machine_external_peer_key_matches_edge(key, edge) ==
    /\ key.local = edge.local
    /\ key.name = edge.endpoint.name
mob_machine_external_peer_key_matches_local(key, agent_identity) == key.local = agent_identity
mob_machine_external_peer_identity_absent(edges, agent_identity) ==
    \A edge \in edges : edge.endpoint.name /= agent_identity
mob_machine_identity_has_session_binding(arg_member_session_bindings, agent_identity) ==
    /\ agent_identity \in DOMAIN arg_member_session_bindings
    /\ arg_member_session_bindings[agent_identity] /= ""
mob_machine_session_bound_live_runtime_ids_match(arg_identity_to_runtime, arg_member_session_bindings, arg_live_runtime_ids, expected_runtime_ids) ==
    LET eligible_ids == { candidate \in DOMAIN arg_member_session_bindings : arg_member_session_bindings[candidate] /= "" /\ candidate \in DOMAIN arg_identity_to_runtime /\ arg_identity_to_runtime[candidate] \in arg_live_runtime_ids }
    IN expected_runtime_ids = { arg_identity_to_runtime[id] : id \in eligible_ids }
mob_machine_member_peer_endpoint_peer_id(endpoint) == endpoint.peer_id
mob_machine_host_id_matches_peer_id(host_id, peer_id) == host_id = peer_id
mob_machine_member_peer_id_available_for_identity(current_endpoints, prior_endpoints, agent_identity, candidate_endpoint) ==
    /\ \A other_identity \in DOMAIN current_endpoints : other_identity = agent_identity \/ current_endpoints[other_identity].peer_id /= candidate_endpoint.peer_id
    /\ \A other_identity \in DOMAIN prior_endpoints : other_identity = agent_identity \/ \A endpoint \in prior_endpoints[other_identity] : endpoint.peer_id /= candidate_endpoint.peer_id
mob_machine_member_has_no_external_peer_edges(edges, agent_identity) ==
    \A edge \in edges : edge.local /= agent_identity
mob_machine_member_prior_peer_endpoints_after_migration(all_prior_endpoints, agent_identity, current_endpoint, next_endpoint) ==
    LET prior == IF agent_identity \in DOMAIN all_prior_endpoints THEN all_prior_endpoints[agent_identity] ELSE {}
        retained == { endpoint \in (prior \cup {current_endpoint}) : endpoint.peer_id /= next_endpoint.peer_id }
    IN IF retained = {}
       THEN [id \in (DOMAIN all_prior_endpoints \ {agent_identity}) |-> all_prior_endpoints[id]]
       ELSE [id \in (DOMAIN all_prior_endpoints \cup {agent_identity}) |-> IF id = agent_identity THEN retained ELSE all_prior_endpoints[id]]
mob_machine_member_endpoint_migration_cleanup_peer_id(endpoint_identity, migrated_identity, retained_peer_endpoint, current_peer_ids) ==
    IF endpoint_identity = migrated_identity THEN retained_peer_endpoint.peer_id ELSE current_peer_ids[endpoint_identity]
mob_machine_wiring_edge_a(edge) == edge.a
mob_machine_wiring_edge_b(edge) == edge.b
mob_machine_wiring_edge_contains_identity(edge, agent_identity) == edge.a = agent_identity \/ edge.b = agent_identity
mob_machine_member_peer_overlay_complete(arg_wiring_edges, arg_member_peer_endpoints, agent_identity) ==
    \A edge \in arg_wiring_edges: IF edge.a = agent_identity THEN edge.b \in DOMAIN arg_member_peer_endpoints ELSE IF edge.b = agent_identity THEN edge.a \in DOMAIN arg_member_peer_endpoints ELSE TRUE
mob_machine_member_peer_overlay(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity) ==
    LET outgoing_edges == { edge \in arg_wiring_edges : edge.a = agent_identity /\ edge.b \in DOMAIN arg_member_peer_endpoints }
        incoming_edges == { edge \in arg_wiring_edges : edge.b = agent_identity /\ edge.a \in DOMAIN arg_member_peer_endpoints }
        local_external_edges == { edge \in arg_external_peer_edges : edge.local = agent_identity }
    IN { arg_member_peer_endpoints[edge.b] : edge \in outgoing_edges }
       \cup { arg_member_peer_endpoints[edge.a] : edge \in incoming_edges }
       \cup { [name |-> edge.endpoint.name, peer_id |-> edge.endpoint.peer_id, address |-> edge.endpoint.address, signing_key |-> edge.endpoint.signing_key, transport |-> "Tcp"] : edge \in local_external_edges }
mob_machine_wiring_contains_pair(arg_wiring_edges, a_identity, b_identity) == \E edge \in arg_wiring_edges: (edge.a = a_identity /\ edge.b = b_identity) \/ (edge.a = b_identity /\ edge.b = a_identity)
mob_machine_member_peer_overlay_without_identity_complete(arg_wiring_edges, arg_member_peer_endpoints, agent_identity, excluded_identity) ==
    \A edge \in arg_wiring_edges: IF edge.a = agent_identity /\ edge.b # excluded_identity THEN edge.b \in DOMAIN arg_member_peer_endpoints ELSE IF edge.b = agent_identity /\ edge.a # excluded_identity THEN edge.a \in DOMAIN arg_member_peer_endpoints ELSE TRUE
mob_machine_member_peer_overlay_without_identity(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity, excluded_identity) ==
    LET outgoing_edges == { edge \in arg_wiring_edges : edge.a = agent_identity /\ edge.b # excluded_identity /\ edge.b \in DOMAIN arg_member_peer_endpoints }
        incoming_edges == { edge \in arg_wiring_edges : edge.b = agent_identity /\ edge.a # excluded_identity /\ edge.a \in DOMAIN arg_member_peer_endpoints }
        local_external_edges == { edge \in arg_external_peer_edges : edge.local = agent_identity }
    IN { arg_member_peer_endpoints[edge.b] : edge \in outgoing_edges }
       \cup { arg_member_peer_endpoints[edge.a] : edge \in incoming_edges }
       \cup { [name |-> edge.endpoint.name, peer_id |-> edge.endpoint.peer_id, address |-> edge.endpoint.address, signing_key |-> edge.endpoint.signing_key, transport |-> "Tcp"] : edge \in local_external_edges }
mob_machine_member_peer_overlay_without_identity_peer_ids_unique(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity, excluded_identity) ==
    LET overlay == mob_machine_member_peer_overlay_without_identity(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity, excluded_identity) IN Cardinality(overlay) = Cardinality({endpoint.peer_id : endpoint \in overlay})
mob_machine_member_peer_overlay_peer_ids_unique(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity) ==
    LET overlay == mob_machine_member_peer_overlay(arg_wiring_edges, arg_member_peer_endpoints, arg_external_peer_edges, agent_identity) IN Cardinality(overlay) = Cardinality({endpoint.peer_id : endpoint \in overlay})
mob_machine_wiring_edge_matches_members(edge, a_identity, b_identity) ==
    /\ edge.a = a_identity
    /\ edge.b = b_identity
mob_machine_run_step_status_after_set(all_statuses, run_id, step_id, status) ==
    LET current == IF run_id \in DOMAIN all_statuses THEN all_statuses[run_id] ELSE [x \in {} |-> None]
    IN MapSet(all_statuses, run_id, MapSet(current, step_id, Some(status)))
mob_machine_run_step_status_after_cancel_unfinished(all_statuses, run_id) ==
    LET current == IF run_id \in DOMAIN all_statuses THEN all_statuses[run_id] ELSE [x \in {} |-> None]
        folded == [step_id \in DOMAIN current |-> IF current[step_id] = None \/ current[step_id] = Some("Dispatched") THEN Some("Canceled") ELSE current[step_id]]
    IN MapSet(all_statuses, run_id, folded)
mob_machine_run_step_bool_after_set(all_values, run_id, step_id, value) ==
    LET current == IF run_id \in DOMAIN all_values THEN all_values[run_id] ELSE [x \in {} |-> FALSE]
    IN MapSet(all_values, run_id, MapSet(current, step_id, value))
mob_machine_run_step_condition_result_after_set(all_results, run_id, step_id, result) ==
    LET current == IF run_id \in DOMAIN all_results THEN all_results[run_id] ELSE [x \in {} |-> None]
    IN MapSet(all_results, run_id, MapSet(current, step_id, Some(result)))
mob_machine_run_step_u64_after_set(all_counts, run_id, step_id, value) ==
    LET current == IF run_id \in DOMAIN all_counts THEN all_counts[run_id] ELSE [x \in {} |-> 0]
    IN MapSet(all_counts, run_id, MapSet(current, step_id, value))
mob_machine_run_step_u64_after_increment(all_counts, run_id, step_id, delta) ==
    LET current == IF run_id \in DOMAIN all_counts THEN all_counts[run_id] ELSE [x \in {} |-> 0]
        current_value == IF step_id \in DOMAIN current THEN current[step_id] ELSE 0
    IN MapSet(all_counts, run_id, MapSet(current, step_id, current_value + delta))
mob_machine_run_retry_count_after_increment(all_counts, run_id, retry_key, delta) ==
    LET current == IF run_id \in DOMAIN all_counts THEN all_counts[run_id] ELSE [x \in {} |-> 0]
        current_value == IF retry_key \in DOMAIN current THEN current[retry_key] ELSE 0
    IN MapSet(all_counts, run_id, MapSet(current, retry_key, current_value + delta))
mob_machine_frame_node_bool_after_set(all_values, frame_id, node_id, value) ==
    LET current == IF frame_id \in DOMAIN all_values THEN all_values[frame_id] ELSE [x \in {} |-> FALSE]
    IN MapSet(all_values, frame_id, MapSet(current, node_id, value))
mob_machine_node_terminal(status) == status \in {"Completed", "Failed", "Skipped", "Canceled"}
mob_machine_step_status_from_frame_node_status(status) ==
    IF status = "Completed" THEN "Completed"
    ELSE IF status = "Skipped" THEN "Skipped"
    ELSE IF status = "Failed" THEN "Failed"
    ELSE IF status = "Canceled" THEN "Canceled"
    ELSE "Dispatched"
mob_machine_frame_node_status_after_admit(all_statuses, frame_branches, ordered_nodes_by_frame, frame_id, node_id) ==
    LET current == IF frame_id \in DOMAIN all_statuses THEN all_statuses[frame_id] ELSE [x \in {} |-> None]
        branches == IF frame_id \in DOMAIN frame_branches THEN frame_branches[frame_id] ELSE [x \in {} |-> None]
        admitted_branch == IF node_id \in DOMAIN branches THEN branches[node_id] ELSE None
        after_branch_reservation == [candidate \in DOMAIN current |->
            IF admitted_branch # None
                /\ candidate # node_id
                /\ candidate \in DOMAIN branches
                /\ branches[candidate] = admitted_branch
                /\ current[candidate] = "Ready"
            THEN "Pending" ELSE current[candidate]]
        after_admit == MapSet(after_branch_reservation, node_id, "Running")
    IN MapSet(all_statuses, frame_id, after_admit)
mob_machine_frame_ready_queue_after_terminal(all_ready_queues, all_statuses, ordered_nodes_by_frame, frame_id) ==
    LET statuses == IF frame_id \in DOMAIN all_statuses THEN all_statuses[frame_id] ELSE [x \in {} |-> None]
        ordered == IF frame_id \in DOMAIN ordered_nodes_by_frame THEN ordered_nodes_by_frame[frame_id] ELSE <<>>
    IN MapSet(all_ready_queues, frame_id, SelectSeq(ordered, LAMBDA candidate: candidate \in DOMAIN statuses /\ statuses[candidate] = "Ready"))
mob_machine_frame_ready_queue_after_admit(all_ready_queues, all_statuses, ordered_nodes_by_frame, frame_id) ==
    mob_machine_frame_ready_queue_after_terminal(all_ready_queues, all_statuses, ordered_nodes_by_frame, frame_id)
mob_machine_frame_node_status_after_terminal_branch(current, branches, node_id, terminal_status) ==
    LET after_terminal == MapSet(current, node_id, terminal_status)
    IN [candidate \in DOMAIN after_terminal |->
        IF terminal_status = "Completed" /\ candidate # node_id
            /\ candidate \in DOMAIN branches /\ node_id \in DOMAIN branches
            /\ branches[node_id] # None
            /\ branches[candidate] = branches[node_id]
            /\ ~mob_machine_node_terminal(after_terminal[candidate])
            /\ after_terminal[candidate] # "Running"
        THEN "Skipped" ELSE after_terminal[candidate]]
mob_machine_frame_node_status_after_terminal_dependencies(after_branch, dependencies, dependency_modes) ==
    [candidate \in DOMAIN after_branch |->
        IF after_branch[candidate] # "Pending" THEN after_branch[candidate]
        ELSE LET deps == IF candidate \in DOMAIN dependencies THEN dependencies[candidate] ELSE <<>>
                 mode == IF candidate \in DOMAIN dependency_modes THEN dependency_modes[candidate] ELSE "All"
                 failed == Len(deps) # 0
                     /\ ((mode = "All" /\ \E dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] \in {"Failed", "Skipped", "Canceled"})
                         \/ (mode = "Any" /\ \A dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] \in {"Failed", "Skipped", "Canceled"}))
                 satisfied == Len(deps) = 0
                     \/ (mode = "All" /\ \A dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] = "Completed")
                     \/ (mode = "Any" /\ \E dep_index \in DOMAIN deps: LET dep == deps[dep_index] IN dep \in DOMAIN after_branch /\ after_branch[dep] = "Completed")
             IN IF failed THEN "Skipped" ELSE IF satisfied THEN "Ready" ELSE after_branch[candidate]]
mob_machine_frame_node_status_after_terminal(all_statuses, frame_branches, ordered_nodes_by_frame, dependencies_by_frame, dependency_modes_by_frame, frame_id, node_id, terminal_status) ==
    LET current == IF frame_id \in DOMAIN all_statuses THEN all_statuses[frame_id] ELSE [x \in {} |-> None]
        branches == IF frame_id \in DOMAIN frame_branches THEN frame_branches[frame_id] ELSE [x \in {} |-> None]
        dependencies == IF frame_id \in DOMAIN dependencies_by_frame THEN dependencies_by_frame[frame_id] ELSE [x \in {} |-> <<>>]
        dependency_modes == IF frame_id \in DOMAIN dependency_modes_by_frame THEN dependency_modes_by_frame[frame_id] ELSE [x \in {} |-> "All"]
        after_branch == mob_machine_frame_node_status_after_terminal_branch(current, branches, node_id, terminal_status)
        after_dependencies == mob_machine_frame_node_status_after_terminal_dependencies(after_branch, dependencies, dependency_modes)
    IN MapSet(all_statuses, frame_id, after_dependencies)
session_document_instruction_slot_after_set(current, slot, value) ==
    MapSet(current, slot, value)
session_document_instruction_active_bytes(slot_effect, slot_bytes) ==
    LET RECURSIVE SessionDocumentInstructionActiveBytesOver(_)
        SessionDocumentInstructionActiveBytesOver(instruction_slots) ==
            IF instruction_slots = {} THEN 0
            ELSE LET instruction_slot == CHOOSE candidate_slot \in instruction_slots : TRUE
                 IN (IF slot_effect[instruction_slot] = "Active" /\ instruction_slot \in DOMAIN slot_bytes
                     THEN slot_bytes[instruction_slot] ELSE 0)
                    + SessionDocumentInstructionActiveBytesOver(instruction_slots \ {instruction_slot})
    IN SessionDocumentInstructionActiveBytesOver(DOMAIN slot_effect)
session_document_instruction_active_slots(slot_effect, slot_values) ==
    [instruction_slot \in {candidate_slot \in DOMAIN slot_values :
            candidate_slot \in DOMAIN slot_effect /\ slot_effect[candidate_slot] = "Active"}
        |-> slot_values[instruction_slot]]
session_document_activation_retired_after(activation_rows, activation_retired) ==
    [activation_key \in DOMAIN activation_rows |->
        LET retired_count == IF activation_key \in DOMAIN activation_retired THEN activation_retired[activation_key] ELSE 0
            superseded_count == IF activation_rows[activation_key] > 0 THEN activation_rows[activation_key] - 1 ELSE 0
        IN IF retired_count >= superseded_count THEN retired_count ELSE superseded_count]

