member_release_verdict(seated, placed, residency, releasable, wired_to_placed) == (IF (seated = FALSE) THEN "NotAMember" ELSE (IF (placed = TRUE) THEN "HostOwned" ELSE (IF ((residency = Some("Live")) /\ (releasable = TRUE)) THEN "Release" ELSE (IF ((residency = Some("Live")) /\ (wired_to_placed = TRUE)) THEN "PinnedByPlacedPeer" ELSE (IF (residency = Some("Live")) THEN "NotYetReleasable" ELSE (IF (residency = Some("Waking")) THEN "WakeInFlight" ELSE "NothingMaterialized"))))))
member_registration_releasable(residency, placed, sealed, has_endpoint, epoch_recorded, wired_to_placed) == ((residency = Some("Live")) /\ (placed = FALSE) /\ (IF (sealed = FALSE) THEN TRUE ELSE (has_endpoint = TRUE)) /\ (epoch_recorded = TRUE) /\ (wired_to_placed = FALSE))
peer_notice_disposition(recipient_phase, sender_phase, notice_class) == (IF (notice_class = "Lifecycle") THEN (IF (recipient_phase = Some("Dormant")) THEN "Suppressed" ELSE (IF (recipient_phase = Some("Waking")) THEN "Suppressed" ELSE (IF (sender_phase = Some("Dormant")) THEN "Suppressed" ELSE (IF (sender_phase = Some("Waking")) THEN "Suppressed" ELSE "Deliver")))) ELSE "Deliver")
member_boot_materialization(policy, composition_authoritative, host_pending, origin_open, obligation, kickoff_pending, network_transport, orchestrator_notified, has_durable_endpoint, host_required, session_unborn) == (IF (composition_authoritative = FALSE) THEN "StayDormant" ELSE (IF (host_pending = TRUE) THEN "StayDormant" ELSE (IF (origin_open = FALSE) THEN "StayDormant" ELSE (IF (policy = "Eager") THEN "Wake" ELSE (IF (obligation # "None") THEN "Wake" ELSE (IF (kickoff_pending = TRUE) THEN "Wake" ELSE (IF (network_transport = TRUE) THEN "Wake" ELSE (IF (orchestrator_notified = TRUE) THEN "Wake" ELSE (IF (has_durable_endpoint = FALSE) THEN "Wake" ELSE (IF (host_required = TRUE) THEN "Wake" ELSE (IF ((policy = "OnDemandVerified") /\ (session_unborn = FALSE)) THEN "VerifyThenDormant" ELSE "StayDormant")))))))))))
member_wake_refusal(member_present, session_bound, placed, broken, retiring, mob_admitting, composition_authoritative, origin_open, host_pending, input_class, sender_waking, observed_missing, arg_phase) == (IF (member_present = FALSE) THEN Some("NotAMember") ELSE (IF (placed = TRUE) THEN Some("HostOwned") ELSE (IF (broken = TRUE) THEN Some("Broken") ELSE (IF (retiring = TRUE) THEN Some("Retiring") ELSE (IF (session_bound = FALSE) THEN Some("NotAMember") ELSE (IF ((arg_phase = Some("Live")) /\ (observed_missing = FALSE)) THEN None ELSE (IF (mob_admitting = FALSE) THEN Some("MobNotRunning") ELSE (IF (composition_authoritative = FALSE) THEN Some("NonAuthoritativeComposition") ELSE (IF (origin_open = FALSE) THEN Some("LifecycleOriginFenced") ELSE (IF (host_pending = TRUE) THEN Some("HostPreparationPending") ELSE (IF (input_class = "Lifecycle") THEN Some("SuppressedLifecycleNotice") ELSE (IF (sender_waking = TRUE) THEN Some("SenderWaking") ELSE (IF (arg_phase = None) THEN Some("NotAMember") ELSE None)))))))))))))
identity_entry_verdict(composition_authoritative, intent_managed, worker_holds_name, lifecycle_in_flight, seated, ever_created, placement, held_creation, profile_matches, migration_declared_from_current, session_memory_only, mode_matches, resume_role_moved, migration_declared_from_resume_role) == (IF (composition_authoritative = FALSE) THEN "RefusedNonAuthoritative" ELSE (IF (intent_managed = TRUE) THEN "RefusedHostAdopted" ELSE (IF (worker_holds_name = TRUE) THEN "RefusedNameHeldByWorker" ELSE (IF (lifecycle_in_flight = TRUE) THEN "LifecycleInFlight" ELSE (IF (seated = FALSE) THEN (IF (placement # "Local") THEN "HostedOnFirstUse" ELSE (IF ((held_creation = TRUE) /\ (ever_created = FALSE)) THEN "AwaitHeldCreation" ELSE (IF ((resume_role_moved = TRUE) /\ (migration_declared_from_resume_role = FALSE)) THEN "RoleMigrationHeld" ELSE "SeatOwed"))) ELSE (IF (profile_matches = FALSE) THEN (IF (session_memory_only = TRUE) THEN "RoleRotate" ELSE (IF (migration_declared_from_current = TRUE) THEN "RoleMigrate" ELSE "RoleMigrationHeld")) ELSE (IF (mode_matches = FALSE) THEN (IF (session_memory_only = TRUE) THEN "RoleRotate" ELSE "RuntimeModeRestamp") ELSE "Kept")))))))
identity_reconcile_decision(intent, lease, replacement, external_binding_required, initial_delivery_required, session_creation_receipt, retirement_receipt, session, runtime, member, external_binding_receipt, external_trust, external_ceremony, initial_delivery_receipt, initial_delivery, wiring) == (IF (replacement = "AdmissionOpen") THEN "CloseMemberAdmission" ELSE (IF (replacement = "Draining") THEN "AwaitMemberDrain" ELSE (IF (replacement = "DrainBlocked") THEN "DrainBlocked" ELSE (IF (replacement = "CancelActive") THEN "CancelActiveMember" ELSE (IF (replacement = "Ready") THEN "RetireMemberMaterialization" ELSE (IF (intent = "Unavailable") THEN "Backoff" ELSE (IF (IF (intent = "Missing") THEN TRUE ELSE (intent = "Malformed")) THEN "RepairBlocked" ELSE (IF (lease = "Unavailable") THEN "Backoff" ELSE (IF (IF (lease = "Missing") THEN TRUE ELSE (IF (lease = "HeldByExpiredIncarnation") THEN TRUE ELSE (lease = "HeldByEndedIncarnation"))) THEN "AcquireLease" ELSE (IF (lease = "Malformed") THEN "RepairBlocked" ELSE (IF (lease = "HeldByOtherLiveIncarnation") THEN "AwaitLease" ELSE (IF (intent = "Absent") THEN (IF (wiring = "Unavailable") THEN "Backoff" ELSE (IF (wiring = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (wiring = "Matching") THEN TRUE ELSE (wiring = "Divergent")) THEN "ReconcileWiring" ELSE (IF (member = "Unavailable") THEN "Backoff" ELSE (IF (member = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (member = "Matching") THEN TRUE ELSE (member = "Divergent")) THEN "RetireMemberMaterialization" ELSE (IF (runtime = "Unavailable") THEN "Backoff" ELSE (IF (runtime = "Malformed") THEN "RepairBlocked" ELSE (IF (IF (runtime = "Matching") THEN TRUE ELSE (runtime = "Divergent")) THEN "RetireRuntimeRegistration" ELSE (IF (session = "Unavailable") THEN "Backoff" ELSE (IF (IF (session = "Malformed") THEN TRUE ELSE (session = "AmbiguousDivergence")) THEN "RepairBlocked" ELSE (IF (IF (session = "Matching") THEN TRUE ELSE (IF (session = "RecoverableDivergence") THEN TRUE ELS