    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_6442c4792a0a93bc


ClassifyFlowRunTerminalityNonTerminalRunning(run_id, status) ==
    /\ phase = "Running"
    /\ (IF (status = "Absent") THEN TRUE ELSE (IF (status = "Pending") THEN TRUE ELSE (status = "Running")))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ UnchangedFrame_6442c4792a0a93bc


