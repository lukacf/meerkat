load("@crates//:defs.bzl", "aliases", "all_crate_deps")

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")

load("//tools/bazel:workspace_lints.bzl", "WORKSPACE_LINT_RUSTC_FLAGS")



filegroup(

    name = "cargo_manifest",

    srcs = ["Cargo.toml"],

    visibility = ["//visibility:public"],

)



filegroup(

    name = "package_runfiles",

    srcs = glob(["Cargo.toml", "**/*"], exclude = ["BUILD", "BUILD.bazel"], allow_empty = True),

    visibility = ["//visibility:public"],

)



# This package's BUILD file, for the cargo-equivalent lanes' workspace copy.

filegroup(

    name = "build_file",

    srcs = ["BUILD.bazel"],

    visibility = ["//visibility:public"],

)



rust_library(
    name = "meerkat_openai",
    aliases = aliases(package_name = "crates/meerkat-openai"),
    crate_name = "meerkat_openai",
    crate_root = "src/lib.rs",
    crate_features = [
        "copilot",
        "live",
        "oauth",
        "realtime",
        "test-realtime-fixtures",
    ],
    edition = "2024",
    rustc_flags = WORKSPACE_LINT_RUSTC_FLAGS,
    compile_data = [
        "Cargo.toml",
    ],
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    rustc_env = {
        "CARGO_PKG_VERSION": "0.8.44",
        "CARGO_MANIFEST_DIR": "./crates/meerkat-openai",
    },
    proc_macro_deps = all_crate_deps(
        package_name = "crates/meerkat-openai",
        proc_macro = True,
    ),
    deps = [
        "//crates/meerkat-auth-core:meerkat_auth_core",
        "//crates/meerkat-contracts:meerkat_contracts",
        "//crates/meerkat-copilot:meerkat_copilot",
        "//crates/meerkat-core:meerkat_core",
        "//crates/meerkat-llm-core:meerkat_llm_core",
        "//crates/meerkat-models:meerkat_models",
    ] + all_crate_deps(
        package_name = "crates/meerkat-openai",
        normal = True,
    ),
)

