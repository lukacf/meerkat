    /\ phase = "Idle"
    /\ (IF (arg_phase = "Accepted") THEN TRUE ELSE (IF (arg_phase = "Queued") THEN TRUE ELSE (IF (arg_phase = "Staged") THEN TRUE ELSE (IF (arg_phase = "Applied") THEN TRUE ELSE (arg_phase = "AppliedPendingConsumption")))))
