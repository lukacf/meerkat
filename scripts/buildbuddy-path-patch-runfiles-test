#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${RUNFILES_DIR:-}" && -d "${RUNFILES_DIR}/_main" ]]; then
  workspace_root="${RUNFILES_DIR}/_main"
else
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  workspace_root="$(cd -- "${script_dir}/.." && pwd)"
fi

required=(
  "Cargo.toml"
)

for path in "${required[@]}"; do
  if [[ ! -f "${workspace_root}/${path}" ]]; then
    echo "error: Bazel workspace runfiles omit Cargo path-patch input ${path}" >&2
    exit 1
  fi
done

if ! grep -Fq 'oai-rt-rs = { version = "=0.4.1", features = ["experimental-gpt-live"] }' \
  "${workspace_root}/Cargo.toml"; then
  echo "error: workspace no longer binds the published experimental oai-rt-rs crate" >&2
  exit 1
fi

if [[ -e "${workspace_root}/third-party/oai-rt-rs/Cargo.toml" ]]; then
  echo "error: Bazel workspace runfiles still contain the obsolete oai-rt-rs vendor" >&2
  exit 1
fi

echo "Bazel workspace runfiles use the published experimental oai-rt-rs crate"
