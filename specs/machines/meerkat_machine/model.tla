ClassifyImageOperationTerminalSafetyFilteredIdle(operation_id, observation, http_status_code, error_code, provider_text) ==
    /\ phase = "Idle"
    /\ (operation_id \in DOMAIN model_routing_image_operation_phases)
    /\ (IF (observation = "ProviderHttpError") THEN TRUE ELSE (observation = "ProviderNativeError"))
    /\ (IF (error_code = "OpenAiContentFilter") THEN TRUE ELSE (error_code = "GeminiSafety"))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
