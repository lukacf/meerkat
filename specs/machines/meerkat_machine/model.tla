    /\ ((IF (channel_id \in DOMAIN live_execution_generation_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_generation_by_channel THEN live_execution_generation_by_channel[channel_id] ELSE "None")) ELSE None) = Some(generation))
    /\ (~((interaction_id \in live_abandoned_interactions)) /\ ((IF (interaction_id \in DOMAIN live_interaction_channel_by_id) THEN Some((IF interaction_id \in DOMAIN live_interaction_channel_by_id THEN live_interaction_channel_by_id[interaction_id] ELSE "None")) ELSE None) = Some(channel_id)))
    /\ (((IF (operation_id \in DOMAIN live_delegation_interaction_by_operation) THEN Some((IF operation_id \in DOMAIN live_delegation_interaction_by_operation THEN live_delegation_interaction_by_operation[operation_id] ELSE "None")) ELSE None) = Some(interaction_id)) /\ ((IF (operation_id \in DOMAIN live_delegation_provider_turn_by_operation) THEN Some((IF operation_id \in DOMAIN live_delegation_provider_turn_by_operation THEN live_delegation_provider_turn_by_operation[operation_id] ELSE "None")) ELSE None) = Some(provider_turn_correlation)))
