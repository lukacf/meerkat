RecoverPendingPlacedSpawnRunning(spawn_id, agent_identity, generation, fence_token, host_id, host_binding_generation, spec_digest, runtime_mode, provision_operation_id, operation_owner_session_id) ==
    /\ phase = "Running"
    /\ (owner_bridge_session_id = Some(operation_owner_session_id))
    /\ (host_binding_generation > 0)
    /\ ((IF ~(((host_id \in DOMAIN host_binding_generation_highwater) = TRUE)) THEN TRUE ELSE (host_id \in DOMAIN host_binding_generation_highwater)) /\ (((host_id \in DOMAIN host_binding_generation_highwater) = TRUE) /\ ((host_binding_generation_highwater)[host_id] >= host_binding_generation)))
    /\ ((agent_identity \in DOMAIN identity_to_runtime) = FALSE)
    /\ ((agent_identity \in DOMAIN pending_placed_spawn_ids) = FALSE)
    /\ ((agent_identity \in DOMAIN current_placed_spawn_ids) = FALSE)
    /\ mob_machine_placed_cleanup_absent_for_identity(pending_placed_carrier_cleanup, agent_identity)
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ pending_placed_spawn_ids' = MapSet(pending_placed_spawn_ids, agent_identity, spawn_id)
    /\ pending_placed_spawn_generations' = MapSet(pending_placed_spawn_generations, agent_identity, generation)
    /\ pending_placed_spawn_fence_tokens' = MapSet(pending_placed_spawn_fence_tokens, agent_identity, fence_token)
    /\ pending_placed_spawn_hosts' = MapSet(pending_placed_spawn_hosts, agent_identity, host_id)
    /\ pending_autonomous_placed_spawns' = IF (runtime_mode = "AutonomousHost") THEN (pending_autonomous_placed_spawns \cup {agent_identity}) ELSE pending_autonomous_placed_spawns
    /\ pending_placed_spawn_host_binding_generations' = MapSet(pending_placed_spawn_host_binding_generations, agent_identity, host_binding_generation)
    /\ pending_placed_spawn_spec_digests' = MapSet(pending_placed_spawn_spec_digests, agent_identity, spec_digest)
    /\ pending_placed_spawn_provision_operation_ids' = MapSet(pending_placed_spawn_provision_operation_ids, agent_identity, provision_operation_id)
    /\ pending_placed_spawn_operation_owner_session_ids' = MapSet(pending_placed_spawn_operation_owner_session_ids, agent_identity, operation_owner_session_id)
    /\ pending_placed_carrier_cleanup' = (pending_placed_carrier_cleanup \cup {mob_machine_placed_cleanup_obligation(agent_identity, spawn_id, generation, fence_token, provision_operation_id, operation_owner_session_id, "Pending")})
    /\ UnchangedFrame_d862110bf8a6faa0


RecoverCommittedPlacedSpawnRunning(spawn_id, agent_identity, agent_runtime_id, generation, fence_token, host_id, host_binding_generation, member_session_id, member_peer_endpoint, profile_name, runtime_mode, external_addressable, provision_operation_id, operation_owner_session_id) ==
    /\ phase = "Running"
    /\ (owner_bridge_session_id # None)
    /\ (owner_bridge_session_id = Some(operation_owner_session_id))
    /\ (host_binding_generation > 0)
    /\ ((IF ~(((host_id \in DOMAIN host_binding_generation_highwater) = TRUE)) THEN TRUE ELSE (host_id \in DOMAIN host_binding_generation_highwater)) /\ (((host_id \in DOMAIN host_binding_generation_highwater) = TRUE) /\ ((host_binding_generation_highwater)[host_id] >= host_binding_generation)))
    /\ ((agent_identity \in DOMAIN identity_to_runtime) = FALSE)
    /\ ((agent_identity \in identity_entry_tombstones) = FALSE)
    /\ ((IF (agent_identity \in DOMAIN identity_entry_unseated) THEN Some((IF agent_identity \in DOMAIN identity_entry_unseated THEN identity_entry_unseated[agent_identity] ELSE "None")) ELSE None) # Some("Archived"))
    /\ ((agent_runtime_id \in live_runtime_ids) = FALSE)
    /\ ((mob_machine_next_respawn_generation(identity_runtime_generations, agent_identity) # None) /\ (generation >= (IF "value" \in DOMAIN mob_machine_next_respawn_generation(identity_runtime_generations, agent_identity) THEN mob_machine_next_respawn_generation(identity_runtime_generations, agent_identity)["value"] ELSE None)))
    /\ ((agent_identity \in DOMAIN pending_placed_spawn_ids) = FALSE)
    /\ ((agent_identity \in DOMAIN current_placed_spawn_ids) = FALSE)
    /\ mob_machine_placed_cleanup_absent_for_identity(pending_placed_carrier_cleanup, agent_identity)
    /\ (\A other \in DOMAIN member_peer_endpoints : (IF (other = agent_identity) THEN TRUE ELSE (mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN (IF (other \in DOMAIN member_peer_endpoints) THEN Some((IF other \in DOMAIN member_peer_endpoints THEN member_peer_endpoints[other] ELSE "None")) ELSE None) THEN (IF (other \in DOMAIN member_peer_endpoints) THEN Some((IF other \in DOMAIN member_peer_endpoints THEN member_peer_endpoints[other] ELSE "None")) ELSE None)["value"] ELSE None)) # mob_machine_member_peer_endpoint_peer_id(member_peer_endpoint))))
    /\ (\A bound_host \in mob_hosts : (mob_machine_host_id_matches_peer_id(bound_host, mob_machine_member_peer_endpoint_peer_id(member_peer_endpoint)) = FALSE))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ live_runtime_ids' = (live_runtime_ids \cup {agent_runtime_id})
    /\ externally_addressable_runtime_ids' = IF external_addressable THEN (externally_addressable_runtime_ids \cup {agent_runtime_id}) ELSE (externally_addressable_runtime_ids \ {agent_runtime_id})
    /\ runtime_fence_tokens' = MapSet(runtime_fence_tokens, agent_runtime_id, fence_token)
    /\ identity_runtime_generations' = MapSet(identity_runtime_generations, agent_identity, generation)
    /\ identity_runtime_fence_tokens' = MapSet(identity_runtime_fence_tokens, agent_identity, fence_token)
    /\ member_restore_failures' = MapRemove(member_restore_failures, agent_identity)
    /\ member_restore_failure_codes' = MapRemove(member_restore_failure_codes, agent_identity)
    /\ member_materialization' = MapSet(member_materialization, agent_identity, "Live")
    /\ member_run_open' = MapRemove(member_run_open, agent_identity)
    /\ member_in_flight_work' = MapRemove(member_in_flight_work, agent_identity)
    /\ member_progress_tokens' = MapRemove(member_progress_tokens, agent_identity)
    /\ member_last_observed_at_ms' = MapRemove(member_last_observed_at_ms, agent_identity)
    /\ member_last_progress_at_ms' = MapRemove(member_last_progress_at_ms, agent_identity)
    /\ member_last_progress_event' = MapRemove(member_last_progress_event, agent_identity)
    /\ member_health_class' = MapRemove(member_health_class, agent_identity)
    /\ member_state_markers' = MapSet(member_state_markers, agent_runtime_id, "Active")
    /\ pending_respawn_topology' = (pending_respawn_topology \ {agent_identity})
    /\ abandoned_respawn_topology' = MapRemove(abandoned_respawn_topology, agent_identity)
    /\ identity_to_runtime' = MapSet(identity_to_runtime, agent_identity, agent_runtime_id)
    /\ member_session_bindings' = MapSet(member_session_bindings, agent_identity, member_session_id)
    /\ member_profile_names' = MapSet(member_profile_names, agent_identity, profile_name)
    /\ member_runtime_modes' = MapSet(member_runtime_modes, agent_identity, runtime_mode)
    /\ member_peer_ids' = MapSet(member_peer_ids, agent_identity, mob_machine_member_peer_endpoint_peer_id(member_peer_endpoint))
    /\ member_peer_endpoints' = MapSet(member_peer_endpoints, agent_identity, member_peer_endpoint)
    /\ spawn_profile_authority_profile_names' = MapRemove(spawn_profile_authority_profile_names, agent_identity)
    /\ spawn_profile_authority_models' = MapRemove(spawn_profile_authority_models, agent_identity)
    /\ spawn_profile_authority_material_digests' = MapRemove(spawn_profile_authority_material_digests, agent_identity)
    /\ spawn_profile_authority_tool_config_digests' = MapRemove(spawn_profile_authority_tool_config_digests, agent_identity)
