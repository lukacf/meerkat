meerkat_session_llm_visibility_delta_matches(tool_visibility_delta, previous_capability_base_filter, next_capability_base_filter, committed_visible_set_changed) == ((tool_visibility_delta.previous_capability_base_filter = previous_capability_base_filter) /\ (tool_visibility_delta.current_capability_base_filter = next_capability_base_filter) /\ (tool_visibility_delta.committed_visible_set_changed = committed_visible_set_changed) /\ (tool_visibility_delta.revision_bumped = committed_visible_set_changed))
meerkat_session_llm_visibility_shape_matches(previous_visibility_state, next_visibility_state, previous_capability_base_filter, next_capability_base_filter, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision) == ((previous_visibility_state.capability_base_filter = previous_capability_base_filter) /\ (next_visibility_state.capability_base_filter = next_capability_base_filter) /\ (previous_visibility_state.inherited_base_filter = next_visibility_state.inherited_base_filter) /\ (previous_visibility_state.active_filter = next_visibility_state.active_filter) /\ (previous_visibility_state.staged_filter = next_visibility_state.staged_filter) /\ (previous_visibility_state.active_requested_deferred_names = next_visibility_state.active_requested_deferred_names) /\ (previous_visibility_state.staged_requested_deferred_names = next_visibility_state.staged_requested_deferred_names) /\ (previous_visibility_state.requested_witnesses = next_visibility_state.requested_witnesses) /\ (previous_visibility_state.filter_witnesses = next_visibility_state.filter_witnesses) /\ (previous_visibility_state.active_revision = previous_active_visibility_revision) /\ (previous_visibility_state.staged_revision = previous_staged_visibility_revision) /\ (next_visibility_state.active_revision = next_active_visibility_revision))
meerkat_session_llm_expected_next_staged_visibility_revision(committed_visible_set_changed, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision) == (IF committed_visible_set_changed THEN (IF (previous_staged_visibility_revision > previous_active_visibility_revision) THEN (next_active_visibility_revision + 1) ELSE next_active_visibility_revision) ELSE previous_staged_visibility_revision)
meerkat_session_llm_expected_next_visibility_revision(committed_visible_set_changed, previous_active_visibility_revision, previous_staged_visibility_revision) == (IF committed_visible_set_changed THEN (IF (previous_active_visibility_revision >= previous_staged_visibility_revision) THEN (previous_active_visibility_revision + 1) ELSE (previous_staged_visibility_revision + 1)) ELSE previous_active_visibility_revision)
meerkat_session_llm_profile_provenance_matches(target_identity, target_profile_provider, target_profile_model, target_capability_surface_status) == (IF (target_capability_surface_status = "Resolved") THEN ((target_profile_provider # None) /\ (target_profile_model # None) /\ ((IF "value" \in DOMAIN target_profile_provider THEN target_profile_provider["value"] ELSE None) = target_identity.provider) /\ ((IF "value" \in DOMAIN target_profile_model THEN target_profile_model["value"] ELSE None) = target_identity.model)) ELSE ((target_profile_provider = None) /\ (target_profile_model = None)))
meerkat_tool_visibility_authorities_match_names(names, witnesses, authorities) == ((DOMAIN authorities = names) /\ (\A name \in names : ((name \in DOMAIN witnesses) /\ ((IF "value" \in DOMAIN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN authorities) THEN Some((IF name \in DOMAIN authorities THEN authorities[name] ELSE "None")) ELSE None)["value"] ELSE None) = (IF "value" \in DOMAIN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None) THEN (IF (name \in DOMAIN witnesses) THEN Some((IF name \in DOMAIN witnesses THEN witnesses[name] ELSE "None")) ELSE None)["value"] ELSE None)))))
meerkat_tool_visibility_filter_names(filter) == (IF (filter.tag = "All") THEN {} ELSE (IF (filter.tag = "Allow") THEN (IF filter.tag = "Allow" THEN filter.names ELSE {}) ELSE (IF filter.tag = "Deny" THEN filter.names ELSE {})))
