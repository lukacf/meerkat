deferred_authorities_have_identity(names, witnesses) == (\A requested_name \in names : deferred_authority_has_identity((IF "value" \in DOMAIN (IF (requested_name \in DOMAIN witnesses) THEN Some((IF requested_name \in DOMAIN witnesses THEN witnesses[requested_name] ELSE "None")) ELSE None) THEN (IF (requested_name \in DOMAIN witnesses) THEN Some((IF requested_name \in DOMAIN witnesses THEN witnesses[requested_name] ELSE "None")) ELSE None)["value"] ELSE None)))
op_lifecycle_transition_rejection_idempotent(action, status) == (IF ((action = "Start") /\ (status = "Running")) THEN TRUE ELSE (IF ((action = "RetireRequested") /\ (status = "Retiring")) THEN TRUE ELSE ((IF (action = "PeerReady") THEN TRUE ELSE (IF (action = "ProgressReported") THEN TRUE ELSE (IF (action = "RetireRequested") THEN TRUE ELSE (IF (action = "RetireCompleted") THEN TRUE ELSE (action = "Abort"))))) /\ operation_status_terminal(status))))
meerkat_session_llm_visibility_state_allows_view_image(view_image_tool_available, visibility_state) == (view_image_tool_available /\ meerkat_session_llm_filter_allows_view_image(visibility_state.capability_base_filter) /\ meerkat_session_llm_filter_allows_view_image(visibility_state.inherited_base_filter) /\ meerkat_session_llm_filter_allows_view_image(visibility_state.active_filter))
meerkat_session_llm_capability_base_filter_matches(target_capability_surface, next_capability_base_filter) == (IF target_capability_surface.image_tool_results THEN (next_capability_base_filter.tag = "All") ELSE ((next_capability_base_filter.tag = "Deny") /\ meerkat_session_llm_filter_has_view_image_only(next_capability_base_filter)))
meerkat_tool_visibility_state_replacement_matches(arg_inherited_base_filter, arg_active_filter, arg_staged_filter, active_requested_deferred_names, staged_requested_deferred_names, requested_witnesses, filter_witnesses, arg_active_deferred_authorities, arg_staged_deferred_authorities, deferred_authority_catalog, filter_authority_catalog, arg_active_visibility_revision, arg_staged_visibility_revision) == ((IF (arg_active_visibility_revision # arg_staged_visibility_revision) THEN TRUE ELSE ((arg_active_filter = arg_staged_filter) /\ (active_requested_deferred_names = staged_requested_deferred_names) /\ (arg_active_deferred_authorities = arg_staged_deferred_authorities))) /\ (\A name \in DOMAIN requested_witnesses : (IF (name \in active_requested_deferred_names) THEN TRUE ELSE (name \in staged_requested_deferred_names))) /\ meerkat_tool_visibility_filter_witnesses_are_catalog_backed(filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_inherited_base_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_active_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_staged_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(requested_witnesses, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_active_deferred_authorities, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_staged_deferred_authorities, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_match_names(active_requested_deferred_names, requested_witnesses, arg_active_deferred_authorities) /\ meerkat_tool_visibility_authorities_match_names(staged_requested_deferred_names, requested_witnesses, arg_staged_deferred_authorities))
meerkat_tool_visibility_publish_matches_catalog(arg_active_filter, arg_staged_filter, arg_active_deferred_authorities, arg_staged_deferred_authorities, filter_witnesses, deferred_authority_catalog, filter_authority_catalog) == (meerkat_tool_visibility_filter_has_catalog_witnesses(arg_active_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_filter_has_catalog_witnesses(arg_staged_filter, filter_witnesses, filter_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_active_deferred_authorities, deferred_authority_catalog) /\ meerkat_tool_visibility_authorities_are_catalog_backed(arg_staged_deferred_authorities, deferred_authority_catalog))
meerkat_session_llm_visibility_reconfigure_plan_matches(previous_visibility_state, next_visibility_state, previous_capability_base_filter, next_capability_base_filter, view_image_tool_available, previous_view_image_visible, next_view_image_visible, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision, tool_visibility_delta) == (meerkat_session_llm_visibility_shape_matches(previous_visibility_state, next_visibility_state, previous_capability_base_filter, next_capability_base_filter, previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision) /\ (previous_view_image_visible = meerkat_session_llm_visibility_state_allows_view_image(view_image_tool_available, previous_visibility_state)) /\ (next_view_image_visible = meerkat_session_llm_visibility_state_allows_view_image(view_image_tool_available, next_visibility_state)) /\ (next_active_visibility_revision = meerkat_session_llm_expected_next_visibility_revision((previous_view_image_visible # next_view_image_visible), previous_active_visibility_revision, previous_staged_visibility_revision)) /\ (next_active_visibility_revision >= previous_active_visibility_revision) /\ (next_visibility_state.staged_revision = meerkat_session_llm_expected_next_staged_visibility_revision((previous_view_image_visible # next_view_image_visible), previous_active_visibility_revision, previous_staged_visibility_revision, next_active_visibility_revision)) /\ meerkat_session_llm_visibility_delta_matches(tool_visibility_delta, previous_capability_base_filter, next_capability_base_filter, (previous_view_image_visible # next_view_image_visible)))
meerkat_session_llm_capability_base_filter_replacement_matches(current_capability_surface, current_capability_surface_status, current_capability_base_filter, next_capability_base_filter) == (IF (current_capability_surface_status = "Resolved") THEN ((current_capability_surface # None) /\ meerkat_session_llm_capability_base_filter_matches((IF "value" \in DOMAIN current_capability_surface THEN current_capability_surface["value"] ELSE None), next_capability_base_filter)) ELSE (next_capability_base_filter = current_capability_base_filter))
meerkat_session_llm_hydrated_capability_base_filter_matches(current_capability_surface, current_capability_surface_status, current_capability_base_filter) == (IF (current_capability_surface_status = "Resolved") THEN ((current_capability_surface # None) /\ meerkat_session_llm_capability_base_filter_matches((IF "value" \in DOMAIN current_capability_surface THEN current_capability_surface["value"] ELSE None), current_capability_base_filter)) ELSE ((current_capability_surface = None) /\ (current_capability_base_filter.tag = "All")))
meerkat_machine_session_id_matches_string(current, candidate) ==
    current # None /\ current.value = candidate
meerkat_peer_endpoint_set_cardinality_matches(endpoints, endpoint_count) ==
    Cardinality(endpoints) = endpoint_count
meerkat_peer_endpoint_set_contains_peer_id(endpoints, peer_id) ==
    \E endpoint \in endpoints: endpoint.peer_id = peer_id
meerkat_peer_endpoint_option_peer_id_matches(endpoint, peer_id) ==
    endpoint # None /\ endpoint.value.peer_id = peer_id
meerkat_peer_endpoint_peer_id_matches(endpoint, peer_id) ==
    endpoint.peer_id = peer_id
meerkat_peer_endpoint_set_peer_ids_unique(endpoints) ==
    Cardinality(endpoints) = Cardinality({ endpoint.peer_id : endpoint \in endpoints })
meerkat_machine_live_bridge_authority_rows_without_operation(rows, operation_by_authority, operation_id) ==
    [authority_id \in { candidate \in DOMAIN rows : IF candidate \in DOMAIN operation_by_authority THEN operation_by_authority[candidate] # operation_id ELSE TRUE } |-> rows[authority_id]]
meerkat_machine_live_bridge_authorities_without_operation(authorities, operation_by_authority, operation_id) ==
    { authority_id \in authorities : IF authority_id \in DOMAIN operation_by_authority THEN operation_by_authority[authority_id] # operation_id ELSE TRUE }

