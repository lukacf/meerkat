ObserveMemberProgressChangedOpenRunning(agent_identity, run_open, in_flight_work, progress_token, observed_at_ms) ==
    /\ phase = "Running"
    /\ OptionLe((IF (agent_identity \in DOMAIN member_last_observed_at_ms) THEN Some((IF agent_identity \in DOMAIN member_last_observed_at_ms THEN member_last_observed_at_ms[agent_identity] ELSE 0)) ELSE None), Some(observed_at_ms))
    /\ ((IF (agent_identity \in DOMAIN member_progress_tokens) THEN Some((IF agent_identity \in DOMAIN member_progress_tokens THEN member_progress_tokens[agent_identity] ELSE "None")) ELSE None) # Some(progress_token))
    /\ (run_open = TRUE)
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ member_run_open' = MapSet(member_run_open, agent_identity, run_open)
    /\ member_in_flight_work' = MapSet(member_in_flight_work, agent_identity, in_flight_work)
    /\ member_progress_tokens' = MapSet(member_progress_tokens, agent_identity, progress_token)
    /\ member_last_observed_at_ms' = MapSet(member_last_observed_at_ms, agent_identity, observed_at_ms)
    /\ member_last_progress_at_ms' = MapSet(member_last_progress_at_ms, agent_identity, observed_at_ms)
    /\ member_last_progress_event' = MapSet(member_last_progress_event, agent_identity, "ExecutionAdvanced")
    /\ member_health_class' = MapSet(member_health_class, agent_identity, "Healthy")
    /\ UnchangedFrame_25e303c4cd0a1542


