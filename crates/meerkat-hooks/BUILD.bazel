load("@crates//:defs.bzl", "aliases", "all_crate_deps")

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_proc_macro", "rust_test")

load("//tools/bazel:workspace_lints.bzl", "WORKSPACE_LINT_RUSTC_FLAGS")



filegroup(

    name = "cargo_manifest",

    srcs = ["Cargo.toml"],

    visibility = ["//visibility:public"],

)



filegroup(

    name = "package_runfiles",

    srcs = glob(["Cargo.toml", "**/*"], exclude = ["BUILD", "BUILD.bazel"], allow_empty = True),

    visibility = ["//visibility:public"],

)



# This package's BUILD file, for the cargo-equivalent lanes' workspace copy.

filegroup(

    name = "build_file",

    srcs = ["BUILD.bazel"],

    visibility = ["//visibility:public"],

)



rust_library(
    name = "meerkat_hooks",
    aliases = aliases(package_name = "meerkat-hooks"),
    crate_name = "meerkat_hooks",
    crate_root = "src/lib.rs",
    crate_features = [],
    edition = "2024",
    rustc_flags = WORKSPACE_LINT_RUSTC_FLAGS,
    compile_data = [
        "Cargo.toml",
        "skills/hook-authoring/SKILL.md",
    ],
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    rustc_env = {
        "CARGO_PKG_VERSION": "0.8.42",
        "CARGO_MANIFEST_DIR": "./crates/meerkat-hooks",
    },
    proc_macro_deps = all_crate_deps(
        package_name = "meerkat-hooks",
        proc_macro = True,
    ),
    deps = [
        "//crates/meerkat-capabilities:meerkat_capabilities",
        "//crates/meerkat-contracts:meerkat_contracts",
        "//crates/meerkat-core:meerkat_core",
        "//crates/meerkat-skills:meerkat_skills",
    ] + all_crate_deps(
        package_name = "meerkat-hooks",
        normal = True,
    ),
)

rust_library(
    name = "meerkat_hooks_agent_factory_build",
    aliases = aliases(package_name = "meerkat-hooks"),
    crate_name = "meerkat_hooks",
    crate_root = "src/lib.rs",
    crate_features = [],
    edition = "2024",
    rustc_flags = WORKSPACE_LINT_RUSTC_FLAGS,
    compile_data = [
        "Cargo.toml",
        "skills/hook-authoring/SKILL.md",
    ],
    srcs = glob(["src/**/*.rs"]),
    visibility = [
        "//crates/meerkat:__pkg__",
    ],
    rustc_env = {
        "CARGO_PKG_VERSION": "0.8.42",
        "CARGO_MANIFEST_DIR": "./crates/meerkat-hooks",
    },
    proc_macro_deps = all_crate_deps(
        package_name = "meerkat-hooks",
        proc_macro = True,
    ),
    deps = [
        "//crates/meerkat:meerkat_capabilities_agent_factory_build",
        "//crates/meerkat:meerkat_contracts_agent_factory_build",
        "//crates/meerkat:meerkat_core_agent_factory_build",
        "//crates/meerkat:meerkat_skills_agent_factory_build",
    ] + all_crate_deps(
        package_name = "meerkat-hooks",
        normal = True,
    ),
)

rust_test(
    name = "meerkat_hooks_unit_test",
    aliases = aliases(
        package_name = "meerkat-hooks",
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "meerkat_hooks",
    crate_root = "src/lib.rs",
    crate_features = [],
    edition = "2024",
    rustc_flags = WORKSPACE_LINT_RUSTC_FLAGS,
    compile_data = [
        "Cargo.toml",
        "skills/hook-authoring/SKILL.md",
    ],
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
    rustc_env = {
        "CARGO_PKG_VERSION": "0.8.42",
        "CARGO_MANIFEST_DIR": "./crates/meerkat-hooks",
    },
    tags = [
        "fast",
        "unit",
    ],
    size = "medium",
    data = [
        ":package_runfiles",
    ],
    env = {
        "RUST_MIN_STACK": "8388608",
        "RUST_TEST_THREADS": "1",
    },
    proc_macro_deps = all_crate_deps(
        package_name = "meerkat-hooks",
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = [
        "//crates/meerkat-capabilities:meerkat_capabilities",
        "//crates/meerkat-contracts:meerkat_contracts",
        "//crates/meerkat-core:meerkat_core",
        "//crates/meerkat-skills:meerkat_skills",
    ] + all_crate_deps(
        package_name = "meerkat-hooks",
        normal = True,
        normal_dev = True,
    ),
)

test_suite(
    name = "fast_tests",
    tests = [
        ":meerkat_hooks_unit_test",
    ],
)
