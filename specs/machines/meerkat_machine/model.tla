RecordLiveCloseClosedRunning(arg_session_id, channel_id, close_observation_sequence) ==
    /\ phase = "Running"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (close_observation_sequence > 0)
    /\ (IF ~((arg_session_id \in DOMAIN live_active_channel_by_session)) THEN TRUE ELSE ((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(channel_id)))
    /\ (IF ~((channel_id \in DOMAIN live_channel_session_by_channel)) THEN TRUE ELSE ((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id)))
    /\ ((IF ~((channel_id \in DOMAIN live_close_observation_sequence_by_channel)) THEN TRUE ELSE (channel_id \in DOMAIN live_close_observation_sequence_by_channel)) /\ (IF ~((channel_id \in DOMAIN live_close_observation_sequence_by_channel)) THEN TRUE ELSE (close_observation_sequence > (live_close_observation_sequence_by_channel)[channel_id])))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ live_active_channel_by_session' = MapRemove(live_active_channel_by_session, arg_session_id)
    /\ live_channel_session_by_channel' = MapRemove(live_channel_session_by_channel, channel_id)
    /\ live_channel_identity_by_channel' = MapRemove(live_channel_identity_by_channel, channel_id)
    /\ live_member_turn_reasoning_by_channel' = MapRemove(live_member_turn_reasoning_by_channel, channel_id)
