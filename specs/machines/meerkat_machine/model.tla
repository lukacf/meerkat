AbandonLiveOpenAdmissionIdle(arg_session_id, channel_id) ==
    /\ phase = "Idle"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ ((IF (arg_session_id \in DOMAIN live_active_channel_by_session) THEN Some((IF arg_session_id \in DOMAIN live_active_channel_by_session THEN live_active_channel_by_session[arg_session_id] ELSE "None")) ELSE None) = Some(channel_id))
    /\ ((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_open_admission_sequence' = (live_open_admission_sequence) + 1
    /\ live_active_channel_by_session' = MapRemove(live_active_channel_by_session, arg_session_id)
    /\ live_channel_session_by_channel' = MapRemove(live_channel_session_by_channel, channel_id)
    /\ live_channel_identity_by_channel' = MapRemove(live_channel_identity_by_channel, channel_id)
    /\ live_execution_runtime_id_by_channel' = MapRemove(live_execution_runtime_id_by_channel, channel_id)
    /\ live_execution_fence_by_channel' = MapRemove(live_execution_fence_by_channel, channel_id)
    /\ live_execution_generation_by_channel' = MapRemove(live_execution_generation_by_channel, channel_id)
    /\ live_execution_phase_by_channel' = MapSet(live_execution_phase_by_channel, channel_id, "Revoked")
    /\ live_revoked_execution_channels' = (live_revoked_execution_channels \cup {channel_id})
    /\ live_cancelled_recovery_channels' = IF (((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id)) /\ (IF (channel_id \in DOMAIN live_context_recovery_source_by_replacement) THEN TRUE ELSE (channel_id \in DOMAIN live_result_recovery_source_by_replacement))) THEN (live_cancelled_recovery_channels \cup {channel_id}) ELSE live_cancelled_recovery_channels
    /\ live_execution_profile_by_channel' = MapRemove(MapRemove(live_execution_profile_by_channel, channel_id), channel_id)
    /\ live_execution_mode_by_channel' = MapRemove(MapRemove(live_execution_mode_by_channel, channel_id), channel_id)
    /\ live_function_bridge_capable_channels' = ((live_function_bridge_capable_channels \ {channel_id}) \ {channel_id})
    /\ live_client_context_capable_channels' = ((live_client_context_capable_channels \ {channel_id}) \ {channel_id})
    /\ live_playback_owner_by_channel' = MapRemove(live_playback_owner_by_channel, channel_id)
    /\ live_playback_readiness_by_channel' = MapRemove(live_playback_readiness_by_channel, channel_id)
