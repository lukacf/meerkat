    /\ ((agent_identity \in DOMAIN identity_to_runtime) = FALSE)
    /\ (Some(generation) = mob_machine_next_minted_generation(identity_runtime_generations, identity_generation_highwater, agent_identity))
    /\ (replacing = None)
    /\ (bridge_session_id # None)
    /\ (member_peer_endpoint # None)
    /\ (\A other \in DOMAIN member_peer_endpoints : (IF (other = agent_identity) THEN TRUE ELSE (mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN (IF (other \in DOMAIN member_peer_endpoints) THEN Some((IF other \in DOMAIN member_peer_endpoints THEN member_peer_endpoints[other] ELSE "None")) ELSE None) THEN (IF (other \in DOMAIN member_peer_endpoints) THEN Some((IF other \in DOMAIN member_peer_endpoints THEN member_peer_endpoints[other] ELSE "None")) ELSE None)["value"] ELSE None)) # mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN member_peer_endpoint THEN member_peer_endpoint["value"] ELSE None)))))
    /\ (\A host \in mob_hosts : (mob_machine_host_id_matches_peer_id(host, mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN member_peer_endpoint THEN member_peer_endpoint["value"] ELSE None))) = FALSE))
