live_bridge_operation_identity_is_complete_and_direct == ((DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_interaction_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_provider_turn_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_provider_delegation_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_provider_call_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_agent_identity_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_context_revision_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_request_digest_by_operation) /\ (DOMAIN live_bridge_channel_by_operation = DOMAIN live_bridge_phase_by_operation) /\ (\A channel_id \in DOMAIN live_bridge_operation_by_channel : ((IF ((IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None) THEN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN live_bridge_channel_by_operation) THEN Some((IF (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None) THEN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None) \in DOMAIN live_bridge_channel_by_operation THEN live_bridge_channel_by_operation[(IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None) THEN (IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None)["value"] ELSE None)] ELSE "None")) ELSE None) = Some(channel_id))))
