    /\ (((IF (channel_id \in DOMAIN live_execution_runtime_id_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_runtime_id_by_channel THEN live_execution_runtime_id_by_channel[channel_id] ELSE "None")) ELSE None) = Some(runtime_id)) /\ ((IF (channel_id \in DOMAIN live_execution_fence_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_fence_by_channel THEN live_execution_fence_by_channel[channel_id] ELSE "None")) ELSE None) = Some(fence_token)) /\ ((IF (channel_id \in DOMAIN live_execution_generation_by_channel) THEN Some((IF channel_id \in DOMAIN live_execution_generation_by_channel THEN live_execution_generation_by_channel[channel_id] ELSE "None")) ELSE None) = Some(generation)))
    /\ (((IF (operation_id \in DOMAIN live_bridge_channel_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_channel_by_operation THEN live_bridge_channel_by_operation[operation_id] ELSE "None")) ELSE None) = Some(channel_id)) /\ ((IF (operation_id \in DOMAIN live_bridge_provider_call_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_provider_call_by_operation THEN live_bridge_provider_call_by_operation[operation_id] ELSE "None")) ELSE None) = Some(provider_call_ref)) /\ ((IF (operation_id \in DOMAIN live_bridge_submission_digest_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_digest_by_operation THEN live_bridge_submission_digest_by_operation[operation_id] ELSE "None")) ELSE None) = Some(output_digest)))
    /\ (IF ((IF (observation = "ProviderProcessed") THEN TRUE ELSE (observation = "ProviderRejected")) /\ ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("LocalWriteCompletedAwaitingProof"))) THEN TRUE ELSE (IF ((observation = "SubmissionAmbiguous") /\ (IF ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("SubmissionAttemptClaimed")) THEN TRUE ELSE ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("LocalWriteCompletedAwaitingProof")))) THEN TRUE ELSE ((IF (observation = "CallExpired") THEN TRUE ELSE (observation = "CallAbandonedByClose")) /\ ((IF (operation_id \in DOMAIN live_bridge_submission_state_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_submission_state_by_operation THEN live_bridge_submission_state_by_operation[operation_id] ELSE "None")) ELSE None) = Some("SubmissionAuthorized")))))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ live_bridge_operation_by_channel' = IF ((IF (channel_id \in DOMAIN live_bridge_operation_by_channel) THEN Some((IF channel_id \in DOMAIN live_bridge_operation_by_channel THEN live_bridge_operation_by_channel[channel_id] ELSE "None")) ELSE None) = Some(operation_id)) THEN MapRemove(live_bridge_operation_by_channel, channel_id) ELSE live_bridge_operation_by_channel
    /\ live_bridge_submission_state_by_operation' = MapSet(live_bridge_submission_state_by_operation, operation_id, (IF (observation = "ProviderProcessed") THEN "ProviderProcessed" ELSE (IF (observation = "ProviderRejected") THEN "ProviderRejected" ELSE (IF (observation = "SubmissionAmbiguous") THEN "SubmissionAmbiguous" ELSE (IF (observation = "CallExpired") THEN "CallExpired" ELSE "CallAbandonedByClose")))))
    /\ UnchangedFrame_3cbbf493ab18a5ac


