OptionPreRunPhaseValues == {None} \cup {Some(x) : x \in PreRunPhaseValues}
OptionProviderValues == {None} \cup {Some(x) : x \in ProviderValues}
OptionRecoveredInputNormalizationReasonKindValues == {None} \cup {Some(x) : x \in RecoveredInputNormalizationReasonKindValues}
OptionRecoveredPeerResponseTerminalApplyIntentValues == {None} \cup {Some(x) : x \in RecoveredPeerResponseTerminalApplyIntentValues}
