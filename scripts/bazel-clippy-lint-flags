#!/usr/bin/env python3
"""Print the workspace `[lints]` table as rules_rust clippy flags.

Cargo applies `[workspace.lints.clippy]` and `[workspace.lints.rust]` from
the root Cargo.toml to every member that declares `[lints] workspace = true`.
The rules_rust clippy aspect never reads that table: the Bazel clippy lanes
used to run with `-Dwarnings` alone, which made them laxer than `make lint`
(no `pedantic`, no `unwrap_used = deny`) and stricter at the same time (the
first real lane failed on `large_enum_variant`, which the table allows).

Each `--@rules_rust//rust/settings:clippy_flag=<flag>` line printed here is
appended by scripts/buildbuddy-bazel-poc to every clippy lane. Entries are
emitted in Cargo's order: lower `priority` first, so later flags override.

The `cargo` lint group is not forwarded: those lints read Cargo metadata
through `cargo metadata`, which does not exist inside a Bazel action. Rust
lints with extra configuration (`check-cfg`) are not forwarded either; the
Bazel build declares its cfgs itself. Both exclusions are printed to stderr
so the lane log shows what the table asked for and what was applied.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

LEVELS = {"allow": "A", "warn": "W", "deny": "D", "forbid": "F"}
SETTING = "--@rules_rust//rust/settings:clippy_flag="
SIMPLE = re.compile(r'^([A-Za-z0-9_]+)\s*=\s*"(allow|warn|deny|forbid)"\s*$')
TABLE = re.compile(
    r'^([A-Za-z0-9_]+)\s*=\s*\{\s*level\s*=\s*"(allow|warn|deny|forbid)"'
    r"(?:\s*,\s*priority\s*=\s*(-?\d+))?\s*(?:,\s*(.*?))?\s*\}\s*$"
)


def parse_lint_table(lines: list[str], header: str) -> list[tuple[int, str, str, str | None]]:
    entries: list[tuple[int, str, str, str | None]] = []
    in_table = False
    for raw in lines:
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        if line.startswith("["):
            in_table = line.strip() == header
            continue
        if not in_table:
            continue
        simple = SIMPLE.match(line)
        if simple:
            entries.append((0, simple.group(1), simple.group(2), None))
            continue
        table = TABLE.match(line)
        if table:
            priority = int(table.group(3)) if table.group(3) is not None else 0
            entries.append((priority, table.group(1), table.group(2), table.group(4) or None))
            continue
        raise SystemExit(f"bazel-clippy-lint-flags: cannot parse {header} entry: {line!r}")
    return entries


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    lines = (root / "Cargo.toml").read_text(encoding="utf-8").splitlines()
    flags: list[str] = []
    skipped: list[str] = []

    for priority, name, level, extra in sorted(
        parse_lint_table(lines, "[workspace.lints.rust]"), key=lambda entry: entry[0]
    ):
        if extra:
            skipped.append(f"rust::{name} (carries {extra.split('=', 1)[0].strip()})")
            continue
        flags.append(f"-{LEVELS[level]}{name}")

    for priority, name, level, extra in sorted(
        parse_lint_table(lines, "[workspace.lints.clippy]"), key=lambda entry: entry[0]
    ):
        if name == "cargo":
            skipped.append("clippy::cargo (needs `cargo metadata`, absent under Bazel)")
            continue
        if extra:
            raise SystemExit(f"bazel-clippy-lint-flags: unsupported clippy lint options on {name}: {extra}")
        flags.append(f"-{LEVELS[level]}clippy::{name}")

    if not flags:
        raise SystemExit("bazel-clippy-lint-flags: no lints found in Cargo.toml [workspace.lints]")
    for entry in skipped:
        print(f"bazel-clippy-lint-flags: not forwarded: {entry}", file=sys.stderr)
    for flag in flags:
        print(f"{SETTING}{flag}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
