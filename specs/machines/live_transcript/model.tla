ActivateFreshChannel(channel, sequence, arg_ingress_generation, credit_records, credit_bytes, maximum_record_charge, voice_accounting) ==
    /\ phase = "Ready"
    /\ (ingress_open /\ (arg_ingress_generation = ingress_generation) /\ (channel # "") /\ ~((channel \in channels)) /\ (sequence > 0) /\ (credit_records > 1) /\ (maximum_record_charge > 0) /\ (IF ~(voice_accounting) THEN TRUE ELSE (credit_records > 2)) /\ (maximum_record_charge <= (credit_bytes \div credit_records)))
