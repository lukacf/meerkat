{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "strict": false,
    "noImplicitAny": false,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@flow-editor-core": ["../flow-editor-core/src/index.ts"] }
  },
  "include": ["src"]
}
