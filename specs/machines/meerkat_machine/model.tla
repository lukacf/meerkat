ResolveLiveWebsocketTokenAdmissionTokenExpiredAttached(arg_session_id, channel_id, token, observed_at_ms) ==
    /\ phase = "Attached"
    /\ (arg_session_id # "")
    /\ (channel_id # "")
    /\ (token # "")
    /\ (observed_at_ms > 0)
    /\ (token \in DOMAIN live_websocket_token_channel_by_token)
    /\ ~((token \in live_websocket_consumed_tokens))
    /\ ((IF (token \in DOMAIN live_websocket_token_channel_by_token) THEN Some((IF token \in DOMAIN live_websocket_token_channel_by_token THEN live_websocket_token_channel_by_token[token] ELSE "None")) ELSE None) = Some(channel_id))
