RecordRouteInstallInstall(obligation) ==
    /\ phase = "Running"
    /\ (placed_completion_lifecycle_quiescing = FALSE)
    /\ (obligation.kind = "Install")
    /\ ((obligation.edge \in wiring_edges) = TRUE)
    /\ ((IF (obligation.host \in DOMAIN host_bind_phase) THEN Some((IF obligation.host \in DOMAIN host_bind_phase THEN host_bind_phase[obligation.host] ELSE "None")) ELSE None) = Some("Bound"))
    /\ ((IF ((IF (obligation.edge.a \in DOMAIN member_placement) THEN Some((IF obligation.edge.a \in DOMAIN member_placement THEN member_placement[obligation.edge.a] ELSE "None")) ELSE None) # Some(obligation.host)) THEN TRUE ELSE mob_machine_placed_carrier_binding_active(member_placement, current_placed_spawn_host_binding_generations, host_bind_phase, host_binding_generations, obligation.edge.a)) /\ (IF ((IF (obligation.edge.b \in DOMAIN member_placement) THEN Some((IF obligation.edge.b \in DOMAIN member_placement THEN member_placement[obligation.edge.b] ELSE "None")) ELSE None) # Some(obligation.host)) THEN TRUE ELSE mob_machine_placed_carrier_binding_active(member_placement, current_placed_spawn_host_binding_generations, host_bind_phase, host_binding_generations, obligation.edge.b)))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ pending_route_installs' = (pending_route_installs \cup {obligation})
    /\ UnchangedFrame_89a547977c28f356


AuthorizeRouteRemovalBeforeUnwire(obligation) ==
    /\ phase = "Running"
