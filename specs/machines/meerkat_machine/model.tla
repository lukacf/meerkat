CompleteImageOperationWithoutScopedOverrideIdle(operation_id, terminal, terminal_payload) ==
    /\ phase = "Idle"
    /\ (operation_id \in DOMAIN model_routing_image_operation_target_models)
    /\ ~((operation_id \in DOMAIN model_routing_image_operation_requires_scoped_override))
    /\ (model_routing_operation_override_id = None)
    /\ ((IF (operation_id \in DOMAIN model_routing_image_classified_terminals) THEN Some((IF operation_id \in DOMAIN model_routing_image_classified_terminals THEN model_routing_image_classified_terminals[operation_id] ELSE "None")) ELSE None) = Some(terminal))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ model_routing_image_operation_phases' = MapSet(model_routing_image_operation_phases, operation_id, "Terminal")
    /\ model_routing_image_operation_target_models' = MapRemove(model_routing_image_operation_target_models, operation_id)
    /\ model_routing_image_operation_realtime' = MapRemove(model_routing_image_operation_realtime, operation_id)
    /\ model_routing_image_operation_requires_scoped_override' = MapRemove(model_routing_image_operation_requires_scoped_override, operation_id)
