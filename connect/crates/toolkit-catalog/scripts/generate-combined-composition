        # outside the evidence, which covers only the dispatches recorded before it.
        'I13_FinalAbsenceSound':
            "[][\\A i \\in Slots : OAbsenceThrough(i)' # OAbsenceThrough(i) => ~jr[i].redrive]_vars",
        # A decision refuses only for its cause: a closed admission, a closed source, a denied
        # authority, or a re-offered claim whose record is NotAdmitted or was withdrawn for a
        # verdict. Contention (a held source, a replaced session) is never refused.
        'I5_RefusalNeedsItsCause':
            "[][\\A p \\in Procs : (sp[p].pc \\in {\"DecideP\", \"DecideA\"} /\\ sp'[p].dec = \"Refused\")\n"
            "       => \\/ sp'[p].cause = \"AdmissionClosed\" /\\ ~Admission\n"
            "          \\/ sp'[p].cause = \"SourceClosed\" /\\ ~SourceOpen\n"
            "          \\/ sp'[p].cause = \"PolicyDenied\" /\\ ~sp[p].view\n"
            "          \\/ sp'[p].cause = \"OfferNotAdmitted\" /\\ sp[p].kind = \"core\" /\\ ObservedNotAdmitted(sp[p].slot)\n"
            "          \\/ /\\ sp'[p].cause = \"PreparationWithdrawn\" /\\ sp[p].kind = \"core\"\n"
            "             /\\ OPhase(sp[p].slot) = \"Withdrawn\" /\\ OVerdictWithdrawal(sp[p].slot)]_vars",
        # Core's drain binds its FIFO head first: no fresh peer delivery begins while a claim is
        # queued, with or without a record.
        'I6_PeerHeadFirst':
            "[][\\A p \\in Procs : (door = \"Peer\" /\\ ~Live(p) /\\ sp'[p].pc = \"Lookup\" /\\ sp'[p].kind = \"caller\")\n"
            "       => ~QueuedClaim]_vars",
        # A durable peer delivery ends its claim (Core's Denied) only for a verdict, never over
        # another dispatch of its record that may have admitted, at the decision and at the entry
        # fence alike (the fence's refusal ends it only for a verdict cause, the cause the fence
        # recorded with it); otherwise Core keeps the claim (NotReady): a closed admission, a
        # replaced session, a record withdrawn for no verdict. A re-offer of a record Core refused
        # (NotAdmitted) and a failed preparation end it too.
        'I6_ClaimEndsOnlyForVerdict':
            "[][\\A p \\in Procs : (ClaimedPeer /\\ sp[p].pc # \"Done\" /\\ sp'[p].pc = \"Done\" /\\ sp'[p].out = \"Refused\")\n"
            "       => \\/ /\\ sp'[p].cause \\in {\"PolicyDenied\", \"SourceClosed\"}\n"
            "             /\\ (sp[p].slot # 0 => ~Ambiguous(sp[p].slot, sp[p].d))\n"
            "          \\/ /\\ sp'[p].cause = \"EntryRefused\" /\\ sp[p].cause \\in {\"PolicyDenied\", \"SourceClosed\"}\n"
            "             /\\ ~Ambiguous(sp[p].slot, sp[p].d)\n"
            "          \\/ sp'[p].cause \\in {\"OfferNotAdmitted\", \"PreparationRefused\"}\n"
            "          \\/ sp'[p].cause = \"PreparationWithdrawn\" /\\ OVerdictWithdrawal(sp[p].slot)]_vars",
        # The entry fence guards a new admission only: a re-offered claim whose record Core
        # admitted is answered by Core's dedup and never refused at the entry.
        'I9_AdmittedReofferNotFenced':
            "[][\\A p \\in Procs : (sp[p].pc = \"Entry\" /\\ sp[p].kind = \"core\" /\\ ObservedAdmitted(sp[p].slot))\n"
            "       => sp'[p].ans # \"EntryRefused\"]_vars",
        # The driver reads durably only while an admission write is in flight on the record's
        # session, when the live read cannot answer; otherwise it reads live.
        'I13_DurableReadOnlyWhileWriteInFlight':
            "[][\\A i \\in Slots : (read_slot = 0 /\\ read_slot' = i /\\ read_kind' = \"Durable\")\n"
            "       => WritesInFlight(OInc(i)) # {}]_vars",
        # The restart after a fail-stop: the next process's lifetime is open, the one it had (it was
        # open) or a new one (the failstop-keeps-closing-lifetime mutant keeps a closing lifetime).
        'I11_FailStopNewLifetime':
            "[][(~alive /\\ alive' /\\ fatal # \"\") => (LPhase' = \"Open\" \\/ life_cur' = 2)]_vars",
    }
    text = '\n\n'.join([
        '---- MODULE combined_composition ----\nEXTENDS TLC, Naturals, Sequences, FiniteSets',
        '\\* The combined I1-I13 model. Stage A: the bind attempt model, instanced byte-exact (the\n'
        '\\* first-send writes and the service setup observation record, their marks, drops,\n'
        '\\* failures, one interruption, the partial-issuance and shared-parent states, G3). Stage B,\n'
        '\\* in the accepted order: one source with two offer slots and a component lifetime (and,\n'
        '\\* after a stop, the next process\'s new one; generated owners: only their transitions change\n'
        '\\* owner state); two send tasks; the offer owner prepared first, the same writes issued\n'
        '\\* outside protection and looked up again on Duplicate, the preparation sealed, the send\n'
        '\\* intent recorded with its outbox under the publication writer then the store transaction,\n'
        '\\* the dispatch start recorded in the owner, then Meta entered (the peer door: its section in\n'
        '\\* Core\'s drain, one peer bind per session, the FIFO head first): its pure decision at (P)\n'
        '\\* and (A), its wait (or Core\'s peer waiter) with one deadline, and native admission behind\n'
        '\\* the entry fence in the same section; the answer fed to the owner after Meta returns. Held\n'
        '\\* and the peer deadline end only the caller\'s wait. The driver reads by key (Core\'s live\n'
        '\\* read, ordered after an admission write still in flight; with late landings also its\n'
        '\\* durable read), one crash and restart with its scan, admission closure with the close\'s\n'
        '\\* join (its unresolved records scoped to the closing process), a stop after the close and\n'
        '\\* the restart into the next lifetime, the fail-stop on a poisoned publication (the crash\'s\n'
        '\\* path, during the close too), the declared composition mode. Core\'s commit and dedup by\n'
        '\\* qualified key are assumptions. Liveness: LiveSpec, under the declared fairness and\n'
        '\\* environment assumptions (below).',
        'CONSTANTS ' + ', '.join(constants) + ',\n    Fault, StageValues, DoorValues, InitialValues, MaxAttempts, '
                                              'Interrupts, ModeValues,\n    ProcBound, SendBound, UnavailBound, '
                                              'LostBound, CoreRefuseBound, GateBound, Env, RecordRows, PeerClaims',
        '\\* RecordRows: the row-only history variables (held_site, cas_lost, replayed, dup_arts, drop_partial,\n'
        '\\* lost_reply_seen, crashed_offered, close_waited_prep, dead_prep, a_held, absence_epoch, a send\'s\n'
        '\\* waited) are recorded. No action reads them (a send\'s waited only in the cached-authority\n'
        '\\* mutant, which records), so they change no behavior; the clean bases and the liveness profiles\n'
        '\\* run without them (their invariants and properties read none), the rows and mutants with them.',
        'VARIABLES ' + ', '.join(variables),
        'vars == <<' + ', '.join(variables) + '>>',
        'AttemptFaults == {' + ', '.join(json.dumps(f) for f in ATTEMPT_FAULTS) + '}',
        'AFault == IF Fault \\in AttemptFaults THEN Fault ELSE "none"',
        ba_instance, src_instance, offer_instance, offer2_instance, life_instance, life2_instance,
        *helpers,
        'GrantUniqueB == \\A x \\in BA!AllArts : issue_count[x] <= 1',
        'Init ==\n' + '\n'.join('    /\\ ' + e for e in init),
        *definitions,
        'Next ==\n' + '\n'.join('    \\/ ' + a for a in actions),
        'Spec == Init /\\ [][Next]_vars',
        *[name + ' ==\n    ' + expr for name, expr in invariants.items()],
        *[name + ' ==\n    ' + expr for name, expr in rows.items()],
        *[name + ' ==\n    ' + expr for name, expr in properties.items()],
        *fairness_definitions(),
        *[name + ' ==\n    ' + expr for name, expr in LIVENESS.items()],
        '=============================================================================',
    ]) + '\n'
    (output / 'combined_composition.tla').write_text(text)
    # The owner mutants: the generated offer owner with one guard conjunct replaced inside one
    # transition, composed by a copy of this module that differs only in its header and the
    # two offer INSTANCE lines.
    owner_text = (output / 'offer_owner.tla').read_text()
    owner_mutants = {}
    for mutant, (transition, conjunct, replacement) in OWNER_MUTANTS.items():
        ident = mutant.replace('-', '_')
        start = owner_text.index('\n' + transition + '(') + 1
        end = owner_text.index('\n\n', start)
        block = owner_text[start:end]
        if block.count(conjunct) != 1:
            raise ValueError(f'{mutant}: the conjunct must occur once in {transition}')
        patched = owner_text[:start] + block.replace(conjunct, replacement) + owner_text[end:]
        patched = patched.replace('---- MODULE offer_owner ----', f'---- MODULE offer_owner_{ident} ----', 1)
        (output / f'offer_owner_{ident}.tla').write_text(patched)
        composed = text.replace('---- MODULE combined_composition ----',
                                f'---- MODULE combined_composition_{ident} ----', 1)
        for prefix in ('offer', 'offer2'):
            line = f'{prefix} == INSTANCE offer_owner WITH'
            if composed.count(line) != 1:
                raise ValueError(f'{mutant}: expected one {line!r}')
            composed = composed.replace(line, f'{prefix} == INSTANCE offer_owner_{ident} WITH', 1)
        (output / f'combined_composition_{ident}.tla').write_text(composed)
        owner_mutants[mutant] = {'transition': transition, 'conjunct': conjunct, 'replacement': replacement,
                                 'owner_module': f'offer_owner_{ident}', 'module': f'combined_composition_{ident}'}
    info = {'owners': {'source': src_prov, 'offer': offer_prov, 'offer2': offer2_prov, 'lifetime': life_prov,
                       'lifetime2': life2_prov},
            'attempt_model': {'name': attempt_source.name, 'sha256': sha(attempt)},
            'rank_table': table, 'owner_mutants': owner_mutants}
    return actions, list(invariants), rows, properties, info


# Declared liveness bounds. Weak fairness for enabled driver and effect steps: the effect
# runner (lookup, owner, preparers, seal, commit, read-back, dispatch, recording the answer),
# Meta's protected section (lock, decision, entry), the peer binder's section in Core's drain,
# and Core (admission, its store's answer to an admission write still in flight, reads, the
# peer FIFO re-offer, a queued claim's with or without its record), the driver (live read,
# observation, re-drive; the durable read is allowed, never relied on), restart and scan, the
# next process's new lifetime after a stop (staged, opened), the other store write, the close's
# join and its records; Core and storage are unavailable for at most UnavailBound reads. Meta's
# identity lock (B_Lock, Meta's doors only) is a tokio FIFO mutex: strong fairness per task.
# The peer door takes no Meta lock: Core's drain binds one delivery at a time (weak fairness
# suffices). The declared environment assumption: a wait ends. Meta's waiter (Core's for a
# peer) wakes when its condition clears, the deadline passes while the condition persists,
# and the expiry answers Held, Pending or the transport's drop. Each liveness mutant drops one
# fairness or the bound, or feeds the live read as durable.
DRIVER_FAIRNESS = ['B_Lookup', 'B_Create', 'B_PrepLookup', 'B_PrepIssue', 'B_PrepDone', 'B_Seal', 'B_CommitPub',
                   'B_CommitStore', 'B_CommitRefuse', 'B_ReadBack', 'B_Call', 'B_FixtureCall', 'B_Lock',
                   'B_PeerSection', 'B_DecideP', 'B_DecideA', 'B_Entry', 'B_Land', 'B_Settle', 'B_ReadCore',
                   'B_ObserveRead', 'B_Redrive', 'B_CoreReoffer', 'B_CoreReofferFresh', 'B_Restart', 'B_ScanWithdraw',
                   'B_Scan', 'B_StoreEnd', 'B_JoinDriver', 'B_CloseRecord', 'B_Life2Stage', 'B_Life2Open']
WAIT_FAIRNESS = ['B_MetaRebind', 'B_PeerRebind', 'B_Deadline', 'B_MetaExpire', 'B_PeerExpire']
STRONG_FAIRNESS = {'B_Lock'}
ACTION_PARAMS = {}
UNFAIR = {
    'LiveSpec': [],
    'LiveSpecNoDispatch': ['B_Call'],
    'LiveSpecNoRead': ['B_ReadCore'],
    'LiveSpecNoRestart': ['B_Restart'],
    'LiveSpecNoPreparer': ['B_PrepIssue'],
    'LiveSpecNoOrphanWithdrawal': ['B_ScanWithdraw'],
    'LiveSpecNoDeadline': ['B_Deadline'],
    'LiveSpecNoReoffer': ['B_CoreReoffer', 'B_CoreReofferFresh'],
    # The driver and effect steps alone, without the declared wait assumption.
    'LiveSpecDriverOnly': list(WAIT_FAIRNESS),
}
LIVENESS = {
    # Every Offered record reaches Core's observed outcome, or is kept with its intent and
    # nothing owed by the driver (its owner a caller's same-key replay, Core's re-offer of a
    # queued claim (LV7), a sender's retry of a delivery with no claim, the restart or the
    # close), or the close records it durably unresolved through its owner, nothing in this
    # process driving it any more (I6, I11); after a stop, the next process drives it again.
    'LV1_OfferDisposition': ('\\A i \\in Slots : OPhase(i) = "Offered"\n'
                             '    ~> (OPhase(i) # "Offered" \\/ Kept(i) \\/ (joined /\\ OCloseEpoch(i) > 0))'),
    # Every native admission of an Offered record is observed, or recorded at the close.
    'LV1_AdmissionObserved': ('\\A i \\in Slots : (OPhase(i) = "Offered" /\\ OfferAdmitted(i))\n'
                              '    ~> (OPhase(i) # "Offered" \\/ (joined /\\ OCloseEpoch(i) > 0))'),
    # A wait whose condition cleared before its deadline binds again, unless the condition is
    # held again or the process stops first (the one retry owner retries).
    'LV2_FreedWaitRebinds': ('\\A p \\in Procs : (Waiting(p) /\\ Cleared(p) /\\ ~sp[p].dl)\n'
                             '    ~> (sp[p].pc = "Lock" \\/ ~Cleared(p) \\/ ~alive)'),
    # A restart is followed by its scan (I11).
    'LV3_RestartRecovers': '~alive ~> (alive /\\ scanned)',
    # Every preparer, a dropped send's included, ends.
    'LV4_PreparersEnd': ('(\\E n \\in Preparers : prep[n].st = "Running") ~> (\\A n \\in Preparers : prep[n].st # "Running")'),
    # A preparation of an ended process is withdrawn (its epoch is the owner's).
    'LV5_OrphanPreparationWithdrawn': ('\\A i \\in Slots : (OPhase(i) = "Prepared" /\\ OPrepEpoch(i) < epoch)\n'
                                       '    ~> OPhase(i) # "Prepared"'),
    # Every send task ends: admitted, refused, held, pending, unresolved or dropped.
    'LV6_SendEnds': '\\A p \\in Procs : Live(p) ~> ~Live(p)',
    # Core re-offers a queued peer claim, with or without its record, while admission is open
    # (the peer discharge of a kept record), a held claim included: a verdict met while another
    # dispatch of the record may have admitted holds it only until the read owed settles the
    # record or records its final absence, Core's live read counting a lost dispatch of this
    # process.
    'LV7_PeerClaimReoffered': ('(\\A i \\in Slots : jr[i].fifo ~> (~jr[i].fifo \\/ joined \\/ LPhase # "Open"))\n'
                               '    /\\ (orphan_claim ~> (~orphan_claim \\/ joined \\/ LPhase # "Open"))'),
}
DRIVER_ONLY_HOLDS = ['LV1_AdmissionObserved', 'LV3_RestartRecovers', 'LV4_PreparersEnd',
                     'LV5_OrphanPreparationWithdrawn', 'LV7_PeerClaimReoffered']


def fairness_term(name):
    # Fairness per send task, preparer and slot: a task's step, not just some task's step.
    # Meta's identity lock is a tokio FIFO mutex: strong fairness per task.
    kind = 'SF_vars' if name in STRONG_FAIRNESS else 'WF_vars'
    params = ACTION_PARAMS[name]
    if not params:
        return f'{kind}({name})'
    if [v for v, _ in params] == ['i', 'p']:
        return f'\\A i \\in Slots : {kind}(\\E p \\in Procs : {name}Of(i, p))'
    (var, dom), = params
    return f'\\A {var} \\in {dom} : {kind}({name}Of({var}))'


def fairness_definitions():
    out = ['\\* Declared liveness bounds: fairness for enabled driver and effect steps, per send task,\n'
           '\\* preparer and slot (the effect runner, Meta\'s protected section with its lock a tokio\n'
           '\\* FIFO mutex (strong fairness, Meta\'s doors), the peer binder\'s section in Core\'s drain (one\n'
           '\\* bind at a time), Core\'s admission, its store\'s answer to an admission write still in\n'
           '\\* flight, Core\'s live reads and FIFO re-offer, the driver, restart and scan,\n'
           '\\* the other store write, the close\'s join and records), with Core and storage unavailable\n'
           '\\* for at most UnavailBound reads; and, as a declared environment assumption, that a\n'
           '\\* wait ends: the waiter is taken to observe a cleared condition before its deadline, the\n'
           '\\* deadline passes while the condition persists, the expiry answers. Production bounds the\n'
           '\\* wait by the door\'s budget clamped to Core\'s 2 s owner-change bound and at most 3 free\n'
           '\\* rebinds (Meta), or the peer delivery\'s one deadline (Core\'s waiter). LiveSpecDriverOnly\n'
           '\\* drops the assumption.']
    for name, dropped in UNFAIR.items():
        steps = [fairness_term(a) for a in DRIVER_FAIRNESS + WAIT_FAIRNESS if a not in dropped]
        out.append(f'{name} ==\n    /\\ Spec\n' + ''.join(f'    /\\ {c}\n' for c in steps).rstrip('\n'))
    return out


DEFAULTS = {'stage': ['B'], 'door': ['Find'], 'initial': ['First'], 'attempts': 1, 'interrupts': [],
            'modes': ['production'], 'procs': 1, 'sends': 1, 'env': [], 'unavail': 1, 'lost': 1, 'corerefuse': 1,
            'gate': 2, 'spec': 'Spec', 'live': [], 'record': True, 'claims': True, 'module': 'combined_composition'}


def profile(kind, fault='none', expected=None, **values):
    unknown = set(values) - set(DEFAULTS)
    if unknown:
        raise ValueError(f'unknown profile fields {sorted(unknown)}')
    spec = {'kind': kind, 'fault': fault, 'expected': expected, **DEFAULTS, **values}
    if kind in ('base', 'live-base', 'live-mutant'):
        spec['record'] = False
    if spec['stage'] == ['A']:
        spec.update(modes=['production'], procs=1, sends=1, env=[])
    if any(e not in ENV_TOKENS for e in spec['env']):
        raise ValueError(f'unknown environment in {spec["env"]}')
    if fault in OWNER_MUTANTS:
        spec['module'] = 'combined_composition_' + fault.replace('-', '_')
    return spec


def config_text(spec, checked, properties):
    def domain(values):
        return '{' + ','.join(json.dumps(v) for v in values) + '}'
    return (f'SPECIFICATION {spec["spec"]}\nCONSTANTS\n'
            '  BooleanValues = {TRUE,FALSE}\n  NatValues = {0,1,2}\n  StringValues = {"","alpha"}\n'
            '  SetOfU64Values = {{},{1}}\n'
            '  RustU64Max = 16\n'
            '  ToolkitSourceKindValues = {"Ordinary","Helper"}\n'
            '  ToolkitSourceReadinessValues = {"Preparing","Ready","ClosedToOffers"}\n'
            '  ToolkitCoreObservationValues = {"Unresolved","Admitted","NotAdmitted","Absent","Unavailable"}\n'
            '  ToolkitDispatchAnswerValues = {"NotSubmitted","Admitted","CoreRefused","EntryRefused","Unresolved"}\n'
            '  ToolkitReceiptKindValues = {"Unsettled","Admitted","Found","CoreRefused","EntryRefused"}\n'
            '  ToolkitWithdrawalCauseValues = {"NotWithdrawn","PolicyDenied","SourceClosed","AdmissionClosed",'
            '"PreparationStale","ProcessEnded"}\n'
            '  ToolkitCoreReadValues = {"Durable","Live"}\n'
            f'  Fault = "{spec["fault"]}"\n'
            f'  StageValues = {domain(spec["stage"])}\n'
            f'  DoorValues = {domain(spec["door"])}\n'
            f'  InitialValues = {domain(spec["initial"])}\n'
            f'  MaxAttempts = {spec["attempts"]}\n'
            f'  Interrupts = {domain(spec["interrupts"])}\n'
            f'  ModeValues = {domain(spec["modes"])}\n'
            f'  ProcBound = {spec["procs"]}\n'
            f'  SendBound = {spec["sends"]}\n'
            f'  UnavailBound = {spec["unavail"]}\n'
            f'  LostBound = {spec["lost"]}\n'
            f'  CoreRefuseBound = {spec["corerefuse"]}\n'
            f'  GateBound = {spec["gate"]}\n'
            f'  Env = {domain(spec["env"])}\n'
            f'  RecordRows = {"TRUE" if spec["record"] else "FALSE"}\n'
            f'  PeerClaims = {"TRUE" if spec["claims"] else "FALSE"}\n'
            'INVARIANTS\n' + ''.join(f'  {inv}\n' for inv in checked)
            + ('PROPERTIES\n' + ''.join(f'  {p}\n' for p in properties) if properties else ''))


SAFETY_PROPERTIES = ['I8_MachineOnlyLifecycle', 'I8_OwnerFieldsByTransition', 'I5_NotNowOnlyOverOpenSource',
                     'I13_FinalAbsenceSound', 'I5_RefusalNeedsItsCause', 'I6_PeerHeadFirst',
                     'I6_ClaimEndsOnlyForVerdict', 'I9_AdmittedReofferNotFenced',
                     'I13_DurableReadOnlyWhileWriteInFlight', 'I11_FailStopNewLifetime']


def main():
    if len(sys.argv) != 3:
        raise ValueError(__doc__)
    root, output = Path(sys.argv[1]), Path(sys.argv[2])
    output.mkdir(exist_ok=False)
    actions, safety, rows, properties, info = build_model(root, output)
    exported = {}
    for name, spec in PROFILES.items():
        kind, expected = spec['kind'], spec['expected']
        if kind == 'row' and expected not in rows:
            raise ValueError('unknown row ' + expected)
        if kind == 'mutant' and expected not in safety and expected not in properties:
            raise ValueError('unknown invariant ' + expected)
        if kind == 'live-mutant' and expected not in LIVENESS:
            raise ValueError('unknown liveness property ' + expected)
        if kind == 'row':
            text = config_text(spec, [expected], [])
        elif kind == 'live-base':
            text = config_text(spec, safety, SAFETY_PROPERTIES + (spec['live'] or list(LIVENESS)))
        elif kind == 'live-mutant':
            text = config_text(spec, safety, [expected])
        elif spec['fault'] in FORGE_FAULTS:
            # An I8 mutant writes one owner field outside a transition: TypeOK and the
            # field-level property only (the forged value may break other invariants first).
            text = config_text(spec, ['TypeOK'], ['I8_OwnerFieldsByTransition'])
        else:
            text = config_text(spec, safety, SAFETY_PROPERTIES)
        (output / (name + '.cfg')).write_text(text)
        exported[name] = spec
    missing_rows = set(rows) - {spec['expected'] for spec in PROFILES.values() if spec['kind'] == 'row'}
    if missing_rows:
        raise ValueError(f'rows without a profile: {sorted(missing_rows)}')
    missing_forges = FORGE_FAULTS - {s['fault'] for s in PROFILES.values()}
    missing_owner = set(OWNER_MUTANTS) - {s['fault'] for s in PROFILES.values()}
    if missing_forges or missing_owner:
        raise ValueError(f'mutants without a profile: {sorted(missing_forges | missing_owner)}')
    manifest = {
        'scope': 'combined I1-I13: stage A bind attempt (the first-send write inventory and the service setup '
                 'observation record, marks, partial-issuance and shared-parent states) and stage B in the accepted '
                 'order (owner first, preparation outside protection with re-lookup, seal, send intent with its '
                 'outbox under the publication writer then the store transaction, the dispatch start recorded in '
                 'the owner, then Meta: pure decision, wait or Core\'s peer waiter, native admission behind the '
                 'entry fence in the same section, the answer fed to the owner after Meta returns; every fact that '
                 'decides an owner transition is owner state; Held and the peer deadline keep the offer; the peer '
                 'door as Core\'s drain runs it, durable and claimless deliveries; two offer slots, two send tasks, '
                 'Core\'s results (with late landings a lost answer whose admission write is still in flight), the '
                 'driver by key with Core\'s live read and its durable read, one crash and restart, admission closure '
                 'with the close\'s record scoped to the closing process, a stop and the restart into the next '
                 'lifetime, the fail-stop on a poisoned publication, declared mode)',
        'full_b1_acceptance': False,
        **info,
        'actions': actions,
        'fault_only_actions': FAULT_ONLY_ACTIONS,
        'safety': safety,
        'safety_properties': SAFETY_PROPERTIES,
        'rows': list(rows),
        'liveness': list(LIVENESS),
        'driver_only_holds': DRIVER_ONLY_HOLDS,
        'fairness': {'driver': DRIVER_FAIRNESS, 'wait': WAIT_FAIRNESS, 'strong': sorted(STRONG_FAIRNESS),
                     'per_task': True, 'variants': UNFAIR},
        'profiles': exported,
        'generator_sha256': sha(Path(__file__).read_bytes()),
        'artifact_hashes': {f.name: sha(f.read_bytes()) for f in sorted(output.iterdir()) if f.is_file()},
    }
    (output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')


def m(fault, expected, **values):
    return profile('mutant', fault, expected, **values)


def r(expected, **values):
    return profile('row', 'none', expected, **values)


def c(fault, **values):
    return profile('control', fault, None, **values)


def lb(spec_name, live=None, **values):
    return profile('live-base', 'none', None, spec=spec_name, live=live or [], **values)


def lm(fault, expected, spec_name, **values):
    return profile('live-mutant', fault, expected, spec=spec_name, **values)


A = {'stage': ['A']}
FULL_ENV_B = {'procs': 2, 'sends': 2, 'env': ALL_ENV}
INVENTORY_DOORS = ['FindNative', 'ClassInput', 'ClassNative', 'BatchSetup', 'ConfiguredSetup', 'SetupRequest']
# The liveness profiles: two send tasks and two caller sends, each over the environment one
# family of obligations meets (the waits and their conditions with a restart; lost answers and
# reads, a restart and the close; refusals, Core's refusal and drops; the helper door; the peer
# FIFO), production mode (the fixture's stand-in has the same fairness), Core and storage
# unavailable for at most one read. TLC's liveness search is far slower than its safety
# search, so the environment is split by family rather than joined in one profile.
LIVE2 = {'procs': 2, 'sends': 2}
ONE = {'procs': 1, 'sends': 1}

PROFILES = {
    # ---- Clean bases (their union is the model's full scope). Stage B treats Find, Launch and
    # Console alike (the same preparation inventory and decision path), so the full stage B
    # environment runs on Find, the helper door and the peer door; the fixture's stand-in, the
    # entry doors and the preparation inventory doors (with every initial state) run with the
    # environment that reaches what they change.
    'none-a': profile('base', stage=['A'], door=ALL_DOORS, initial=ALL_INITIAL, attempts=3,
                      interrupts=['fail', 'crash']),
    'none-b-peer': profile('base', door=['Peer'], **FULL_ENV_B),
    # The peer door's volatile and supervisor deliveries: no Core claim.
