RecordLiveChannelStatusIdle(channel_id, status, status_observation_sequence, degradation_reason, degradation_detail) ==
    /\ phase = "Idle"
    /\ (channel_id # "")
    /\ (status_observation_sequence > 0)
    /\ (IF ~((channel_id \in DOMAIN live_channel_status_observation_sequence_by_channel)) THEN TRUE ELSE (status_observation_sequence > (IF "value" \in DOMAIN (IF (channel_id \in DOMAIN live_channel_status_observation_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_status_observation_sequence_by_channel THEN live_channel_status_observation_sequence_by_channel[channel_id] ELSE 0)) ELSE None) THEN (IF (channel_id \in DOMAIN live_channel_status_observation_sequence_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_status_observation_sequence_by_channel THEN live_channel_status_observation_sequence_by_channel[channel_id] ELSE 0)) ELSE None)["value"] ELSE None)))
    /\ (IF ((status = "Degraded") /\ (degradation_reason # None)) THEN TRUE ELSE ((status # "Degraded") /\ (degradation_reason = None) /\ (degradation_detail = None)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_channel_status_result_sequence' = (live_channel_status_result_sequence) + 1
    /\ live_channel_status_observation_sequence_by_channel' = MapSet(live_channel_status_observation_sequence_by_channel, channel_id, status_observation_sequence)
    /\ live_channel_status_by_channel' = MapSet(live_channel_status_by_channel, channel_id, status)
