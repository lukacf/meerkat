#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: release-workflow-dispatch [--mode full|assets|packages|web-sdk|web-sdk-publish|prebuild] [--version vX.Y.Z] [--backend auto|github-hosted|buildbuddy] [--ref REF] [--web-sdk-artifact-run-id RUN_ID] [--assets-run-id RUN_ID] [--semver-evidence-run-id RUN_ID --semver-evidence-job-id JOB_ID] [--dry-run]

Dispatches the release workflow through the same public/default vs owner-only
BuildBuddy backend split used by CI.

Backend note: release_backend=buildbuddy covers release validation plus the
critical Linux and macOS arm64 surface binaries and, in a job of its own, the
Intel macOS ones, which a GitHub-hosted Apple silicon runner then runs and
inspects; on the GitHub-hosted backend Intel macOS is cross-compiled on that
runner. The trailing Windows binaries are cross-compiled on GitHub-hosted
runners. The critical assets publish without waiting for Intel macOS and
Windows, and the trailing archives, the
complete manifest and the Homebrew formula follow, add-only. @rkat/web
is built once as a release artifact before npm publishing. Credentialed
registry publish jobs still run on GitHub-hosted runners; use the narrow
recovery modes for retries.

--mode prebuild dispatches the pre-tag prebuild on main: every release binary
and the Web SDK package of main's current commit, which must already carry
VERSION, are built, attested and uploaded, and nothing is published. The tag
run of exactly that commit then publishes those artifacts instead of
rebuilding them. Dispatch it as soon as the release commit lands on main. It
builds with the backend the tag run selects (auto reads the repository's
MEERKAT_RELEASE_BUILDBUDDY, never the local MEERKAT_BUILDBUDDY), and
release.yml refuses a prebuild on any other backend. It then dispatches
Meta's two candidate tiers of the same commit, core then trailing
(make -C meta release-candidate): they build before Core's tag exists, and
Meta's promotion compares the Core they embed with that tag.

Environment equivalents:
  VERSION or RELEASE_TAG     Release tag, for example v0.6.1.
  RELEASE_BACKEND            auto, github-hosted, or buildbuddy. Defaults to auto.
  RELEASE_REF                Workflow ref. Defaults to the tag for full and main for recovery and prebuild modes.
  REGISTRY_DRY_RUN           true/false for package publish dry-runs.
  WEB_SDK_ARTIFACT_RUN_ID    Existing workflow run id containing rkat-web-package.
  ASSETS_RUN_ID              --mode assets only: publish the attested archives of
                              this earlier main-dispatched asset recovery run
                              instead of rebuilding them.
  SEMVER_EVIDENCE_RUN_ID     Exact failed tag-run id with a completed semver measurement.
  SEMVER_EVIDENCE_JOB_ID     Exact failed semver job id from that run.
  RELEASE_WORKFLOW_DRY_RUN   true/false to print the gh command without dispatching.
  MEERKAT_BUILDBUDDY         When RELEASE_BACKEND=auto (prebuild mode excepted),
                              true selects buildbuddy and false/0 selects
                              github-hosted. If unset, auto selects buildbuddy
                              only for the lukacf GitHub account, and only while
                              the repository's MEERKAT_RELEASE_BUILDBUDDY is true
                              or 1 (any case), as release.yml does.
EOF
}

mode="${MODE:-full}"
version="${VERSION:-${RELEASE_TAG:-}}"
backend="${RELEASE_BACKEND:-auto}"
workflow_ref="${RELEASE_REF:-}"
web_sdk_artifact_run_id="${WEB_SDK_ARTIFACT_RUN_ID:-}"
assets_run_id="${ASSETS_RUN_ID:-}"
semver_evidence_run_id="${SEMVER_EVIDENCE_RUN_ID:-}"
semver_evidence_job_id="${SEMVER_EVIDENCE_JOB_ID:-}"
case "${RELEASE_WORKFLOW_DRY_RUN:-false}" in
  1|true|TRUE|yes|YES|on|ON) dry_run=1 ;;
  *) dry_run=0 ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      mode="${2:?--mode requires a value}"
      shift 2
      ;;
    --version|--tag)
      version="${2:?--version requires a value}"
      shift 2
      ;;
    --backend)
      backend="${2:?--backend requires a value}"
      shift 2
      ;;
    --ref)
      workflow_ref="${2:?--ref requires a value}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --web-sdk-artifact-run-id)
      web_sdk_artifact_run_id="${2:?--web-sdk-artifact-run-id requires a value}"
      shift 2
      ;;
    --assets-run-id)
      assets_run_id="${2:?--assets-run-id requires a value}"
      shift 2
      ;;
    --semver-evidence-run-id)
      semver_evidence_run_id="${2:?--semver-evidence-run-id requires a value}"
      shift 2
      ;;
    --semver-evidence-job-id)
      semver_evidence_job_id="${2:?--semver-evidence-job-id requires a value}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "${mode}" in
  full|assets|packages|web-sdk|web-sdk-publish|prebuild) ;;
  *)
    echo "unknown release mode: ${mode}" >&2
    usage >&2
    exit 2
    ;;
esac

if [[ -z "${version}" ]]; then
  echo "VERSION=vX.Y.Z is required" >&2
  usage >&2
  exit 2
fi

case "${version}" in
  v*) ;;
  *)
    echo "release VERSION must include the v prefix, for example v0.6.1" >&2
    exit 2
    ;;
esac

workspace_root="$(git rev-parse --show-toplevel)"
cd "${workspace_root}"
source "${workspace_root}/scripts/build-backend-env"

repo_release_buildbuddy_enabled() {
  if ! command -v gh >/dev/null 2>&1; then
    return 1
  fi
  local user value
  user="$(gh api user --jq '.login' 2>/dev/null || true)"
  if [[ "${user}" != "lukacf" ]]; then
    return 1
  fi
  value="$(
    gh api repos/lukacf/meerkat/actions/variables/MEERKAT_RELEASE_BUILDBUDDY \
      --jq '.value' 2>/dev/null || true
  )"
  # release.yml selects BuildBuddy when the variable is 'true' or '1', and
  # GitHub's expression comparisons ignore case.
  case "$(printf '%s' "${value}" | tr '[:upper:]' '[:lower:]')" in
    1|true)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

case "${backend}" in
  auto)
    # A prebuild must build with its tag run's backend, which the repository
    # variable selects (release.yml refuses any other), so a local
    # MEERKAT_BUILDBUDDY does not choose it.
    if [[ "${mode}" != "prebuild" && -n "${MEERKAT_BUILDBUDDY+x}" ]]; then
      if meerkat_buildbuddy_enabled; then
        backend="buildbuddy"
      else
        backend="github-hosted"
      fi
    elif repo_release_buildbuddy_enabled; then
      backend="buildbuddy"
    else
      backend="github-hosted"
    fi
    ;;
  github-hosted|buildbuddy) ;;
  *)
    echo "unknown release backend: ${backend}" >&2
    usage >&2
    exit 2
    ;;
esac

if [[ -z "${workflow_ref}" ]]; then
  case "${mode}" in
    full) workflow_ref="${version}" ;;
    assets|packages|web-sdk|web-sdk-publish|prebuild) workflow_ref="main" ;;
  esac
fi

if [[ "${mode}" == "prebuild" ]]; then
  if [[ "${workflow_ref}" != "main" ]]; then
    echo "--mode prebuild runs on main only (got ${workflow_ref}): a tag run trusts only archives attested on main" >&2
    exit 2
  fi
  if [[ -n "${assets_run_id}" || -n "${web_sdk_artifact_run_id}" || -n "${semver_evidence_run_id}" || -n "${semver_evidence_job_id}" ]]; then
    echo "--mode prebuild publishes nothing and takes no recovery input" >&2
    exit 2
  fi
fi

if [[ -n "${assets_run_id}" ]]; then
  if [[ "${mode}" != "assets" ]]; then
    echo "--assets-run-id is supported only for --mode assets" >&2
    exit 2
  fi
  if [[ ! "${assets_run_id}" =~ ^[0-9]+$ ]]; then
    echo "--assets-run-id must be a workflow run id: ${assets_run_id}" >&2
    exit 2
  fi
  if [[ "${workflow_ref}" != "main" ]]; then
    echo "--assets-run-id requires the main workflow ref (got ${workflow_ref})" >&2
    exit 2
  fi
fi

if [[ -n "${semver_evidence_run_id}" || -n "${semver_evidence_job_id}" ]]; then
  if [[ -z "${semver_evidence_run_id}" || -z "${semver_evidence_job_id}" ]]; then
    echo "semver recovery requires both --semver-evidence-run-id and --semver-evidence-job-id" >&2
    exit 2
  fi
  if [[ "${mode}" != "packages" ]]; then
    echo "semver evidence recovery is supported only for --mode packages" >&2
    exit 2
  fi
fi

args=(
  gh workflow run release.yml
  --ref "${workflow_ref}"
)
if [[ "${mode}" == "prebuild" ]]; then
  # The tag does not exist yet: the workflow derives it from the commit.
  args+=(-f "prebuild_release_artifacts=true")
else
  args+=(-f "release_tag=${version}")
fi
args+=(-f "release_backend=${backend}")

if [[ -n "${semver_evidence_run_id}" ]]; then
  args+=(
    -f "semver_evidence_run_id=${semver_evidence_run_id}"
    -f "semver_evidence_job_id=${semver_evidence_job_id}"
  )
fi

case "${mode}" in
  full)
    args+=(
      -f "publish_release_packages=true"
      -f "registry_dry_run=${REGISTRY_DRY_RUN:-false}"
    )
    ;;
  assets)
    args+=(
      -f "publish_release_assets_only=true"
    )
    if [[ -n "${assets_run_id}" ]]; then
      args+=(-f "assets_run_id=${assets_run_id}")
    fi
    ;;
  packages)
    args+=(
      -f "publish_release_packages=true"
      -f "registry_dry_run=${REGISTRY_DRY_RUN:-false}"
    )
    ;;
  web-sdk)
    args+=(
      -f "publish_release_packages=true"
      -f "publish_web_sdk_only=true"
      -f "registry_dry_run=${REGISTRY_DRY_RUN:-false}"
    )
    ;;
  prebuild) ;;
  web-sdk-publish)
    if [[ -z "${web_sdk_artifact_run_id}" ]]; then
      echo "--web-sdk-artifact-run-id is required for --mode web-sdk-publish" >&2
      exit 2
    fi
    args+=(
      -f "publish_release_packages=true"
      -f "publish_web_sdk_only=true"
      -f "web_sdk_artifact_run_id=${web_sdk_artifact_run_id}"
      -f "registry_dry_run=${REGISTRY_DRY_RUN:-false}"
    )
    ;;
esac

printf 'release workflow backend: %s\n' "${backend}"
printf 'release workflow mode: %s\n' "${mode}"
printf 'release workflow ref: %s\n' "${workflow_ref}"
printf 'release workflow tag: %s\n' "${version}"
if [[ -n "${assets_run_id}" ]]; then
  printf 'release workflow assets from run: %s (no rebuild)\n' "${assets_run_id}"
fi
if [[ -n "${semver_evidence_run_id}" ]]; then
  printf 'release workflow semver evidence: run %s, job %s\n' "${semver_evidence_run_id}" "${semver_evidence_job_id}"
fi
if [[ "${mode}" == "prebuild" ]]; then
  printf 'release workflow builds: %s Linux, macOS arm64 and Intel macOS binaries, Windows cross-built on GitHub-hosted runners, Web SDK package; no validation (the tag run requires exact-main CI)\n' "${backend}"
elif [[ "${backend}" == "buildbuddy" ]]; then
  printf 'release workflow acceleration: BuildBuddy validation + early Linux and macOS arm64 assets; Intel macOS (BuildBuddy) and Windows (GitHub-hosted) trail\n'
else
  printf 'release workflow acceleration: GitHub-hosted validation + binary asset builds\n'
fi
case "${mode}" in
  full|packages|web-sdk)
    printf 'release workflow registry publishing: prebuilt Web SDK artifact + GitHub-hosted credentialed publish (use web-sdk/packages recovery for retries)\n'
    ;;
  web-sdk-publish)
    printf 'release workflow registry publishing: existing Web SDK artifact %s + GitHub-hosted credentialed publish\n' "${web_sdk_artifact_run_id}"
    ;;
  prebuild)
    printf 'release workflow publishing: none (prebuild); the %s tag run of the same commit publishes these artifacts\n' "${version}"
    ;;
esac

# A prebuild builds main's commit at dispatch time; it must be the release
# commit, or the tag run will not find it.
prebuild_commit=""
if [[ "${mode}" == "prebuild" && "${dry_run}" != "1" ]]; then
  git fetch --quiet origin main
  prebuild_commit="$(git rev-parse --verify 'FETCH_HEAD^{commit}')"
  main_version="$(git show "${prebuild_commit}:Cargo.toml" | awk '
    /^\[workspace.package\]/ { in_workspace_package = 1; next }
    /^\[/ { in_workspace_package = 0 }
    in_workspace_package && $1 == "version" { gsub(/"/, "", $3); print $3; exit }
  ')"
  if [[ "v${main_version}" != "${version}" ]]; then
    echo "origin/main carries workspace version ${main_version:-unknown}, not ${version}: land the release commit on main before prebuilding" >&2
    exit 1
  fi
  printf 'release workflow prebuild commit: %s\n' "${prebuild_commit}"
fi

# After Core's prebuild (so Core's jobs queue first), Meta's two candidate
# tiers of the same commit, core first. A word list, not an array: an empty
# array is unbound under set -u in the bash 3.2 macOS ships.
meta_tiers=""
if [[ "${mode}" == "prebuild" ]]; then
  meta_tiers="core trailing"
fi

if [[ "${dry_run}" == "1" ]]; then
  printf 'DRY-RUN '
  printf '%q ' "${args[@]}"
  printf '\n'
  for tier in ${meta_tiers}; do
    printf 'DRY-RUN make -C meta release-candidate SOURCE_SHA=<the prebuild commit> TIER=%s\n' "${tier}"
  done
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "gh is required to dispatch the release workflow" >&2
  exit 127
fi

if [[ -z "${meta_tiers}" ]]; then
  exec "${args[@]}"
fi
"${args[@]}"
for tier in ${meta_tiers}; do
  printf 'release workflow prebuild: dispatching Meta candidate tier %s of %s\n' "${tier}" "${prebuild_commit}"
  make --no-print-directory -C meta release-candidate SOURCE_SHA="${prebuild_commit}" TIER="${tier}"
done
