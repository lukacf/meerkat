    /\ phase = "Attached"
    /\ (session_id # None)
    /\ (active_runtime_id # None)
    /\ (current_session_llm_identity = Some(previous_identity))
    /\ (current_session_capability_surface = previous_capability_surface)
    /\ (current_session_capability_surface_status = previous_capability_surface_status)
    /\ (current_session_capability_base_filter = previous_capability_base_filter)
    /\ (meerkat_session_llm_capability_base_filter_matches(target_capability_surface, next_capability_base_filter) = TRUE)
