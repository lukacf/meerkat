ReconcileRevokedLiveBridgeExecutionTerminalFreshIdle(channel_id, interaction_id, operation_id, request_digest, terminal, result_digest) ==
    /\ phase = "Idle"
    /\ ((channel_id \in live_revoked_execution_channels) /\ ((IF (operation_id \in DOMAIN live_bridge_channel_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_channel_by_operation THEN live_bridge_channel_by_operation[operation_id] ELSE "None")) ELSE None) = Some(channel_id)) /\ ((IF (operation_id \in DOMAIN live_bridge_interaction_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_interaction_by_operation THEN live_bridge_interaction_by_operation[operation_id] ELSE "None")) ELSE None) = Some(interaction_id)) /\ ((IF (operation_id \in DOMAIN live_bridge_request_digest_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_request_digest_by_operation THEN live_bridge_request_digest_by_operation[operation_id] ELSE "None")) ELSE None) = Some(request_digest)) /\ ((IF (operation_id \in DOMAIN live_bridge_phase_by_operation) THEN Some((IF operation_id \in DOMAIN live_bridge_phase_by_operation THEN live_bridge_phase_by_operation[operation_id] ELSE "None")) ELSE None) = Some("ExecutionRunning")) /\ (operation_id \in DOMAIN live_bridge_cancellation_reason_by_operation) /\ ~((operation_id \in DOMAIN live_bridge_execution_terminal_by_operation)))
    /\ (IF ((terminal = "Completed") /\ (result_digest # None) /\ ((IF "value" \in DOMAIN result_digest THEN result_digest["value"] ELSE None) # "")) THEN TRUE ELSE ((terminal # "Completed") /\ (result_digest = None)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_bridge_phase_by_operation' = MapSet(live_bridge_phase_by_operation, operation_id, "ExecutionTerminal")
    /\ live_bridge_execution_terminal_by_operation' = MapSet(live_bridge_execution_terminal_by_operation, operation_id, terminal)
    /\ live_bridge_execution_result_digest_by_operation' = IF (result_digest # None) THEN MapSet(live_bridge_execution_result_digest_by_operation, operation_id, (IF "value" \in DOMAIN result_digest THEN result_digest["value"] ELSE None)) ELSE live_bridge_execution_result_digest_by_operation
    /\ UnchangedFrame_bb52c5560c0c1567


