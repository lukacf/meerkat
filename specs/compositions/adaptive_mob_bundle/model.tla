}

Actors == {
    "control_mob_authority",
    "layer_mob_authority"
}

ActorPriorities == {
}

SchedulerRules == {
}

ActorOfMachine(machine_id) ==
    CASE machine_id = "control_mob" -> "control_mob_authority"
      [] machine_id = "layer_mob" -> "layer_mob_authority"

RouteSource(route_name) ==
    CASE route_name = "layer_terminal_reaches_adaptive_kernel" -> "layer_mob"

RouteEffect(route_name) ==
    CASE route_name = "layer_terminal_reaches_adaptive_kernel" -> "FlowRunPublicResultClassified"

RouteTargetMachine(route_name) ==
    CASE route_name = "layer_terminal_reaches_adaptive_kernel" -> "control_mob"

RouteTargetInput(route_name) ==
    CASE route_name = "layer_terminal_reaches_adaptive_kernel" -> "IngestLayerTerminal"

RouteTargetKind(route_name) ==
    CASE route_name = "layer_terminal_reaches_adaptive_kernel" -> "Input"
      [] OTHER -> "Unknown"

RouteDeliveryKind(route_name) ==
    CASE route_name = "layer_terminal_reaches_adaptive_kernel" -> "Immediate"
      [] OTHER -> "Unknown"

RouteTargetActor(route_name) == ActorOfMachine(RouteTargetMachine(route_name))

