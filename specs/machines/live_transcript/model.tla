    /\ control_spent_records' = MapSet(control_spent_records, channel, 0)
    /\ control_spent_bytes' = MapSet(control_spent_bytes, channel, 0)
    /\ voice_channels' = IF voice_accounting THEN (voice_channels \cup {channel}) ELSE voice_channels
    /\ voice_observation_open' = IF voice_accounting THEN (voice_observation_open \cup {channel}) ELSE voice_observation_open
    /\ voice_seconds_bits' = IF voice_accounting THEN MapSet(voice_seconds_bits, channel, 0) ELSE voice_seconds_bits
    /\ voice_usage_disputes' = IF voice_accounting THEN MapSet(voice_usage_disputes, channel, "None") ELSE voice_usage_disputes
    /\ voice_usage_digests' = IF voice_accounting THEN MapSet(voice_usage_digests, channel, "") ELSE voice_usage_digests
    /\ voice_usage_sequences' = IF voice_accounting THEN MapSet(voice_usage_sequences, channel, 0) ELSE voice_usage_sequences
    /\ UnchangedFrame_2c40d86e743182b6


