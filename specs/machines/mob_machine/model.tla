    /\ ((IF (obligation.host \in DOMAIN host_bind_phase) THEN Some((IF obligation.host \in DOMAIN host_bind_phase THEN host_bind_phase[obligation.host] ELSE "None")) ELSE None) = Some("Bound"))
    /\ (IF (((IF (obligation.edge.a \in DOMAIN member_placement) THEN Some((IF obligation.edge.a \in DOMAIN member_placement THEN member_placement[obligation.edge.a] ELSE "None")) ELSE None) = Some(obligation.host)) /\ mob_machine_placed_carrier_binding_active(member_placement, current_placed_spawn_host_binding_generations, host_bind_phase, host_binding_generations, obligation.edge.a)) THEN TRUE ELSE (((IF (obligation.edge.b \in DOMAIN member_placement) THEN Some((IF obligation.edge.b \in DOMAIN member_placement THEN member_placement[obligation.edge.b] ELSE "None")) ELSE None) = Some(obligation.host)) /\ mob_machine_placed_carrier_binding_active(member_placement, current_placed_spawn_host_binding_generations, host_bind_phase, host_binding_generations, obligation.edge.b)))
    /\ (IF ((IF (obligation.edge.a \in DOMAIN member_placement) THEN Some((IF obligation.edge.a \in DOMAIN member_placement THEN member_placement[obligation.edge.a] ELSE "None")) ELSE None) = Some(obligation.host)) THEN TRUE ELSE ((IF (obligation.edge.b \in DOMAIN member_placement) THEN Some((IF obligation.edge.b \in DOMAIN member_placement THEN member_placement[obligation.edge.b] ELSE "None")) ELSE None) = Some(obligation.host)))
