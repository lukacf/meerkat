ResolveLiveExecutionModeAdmissionIdle(arg_session_id, channel_id, profile_id, requested_mode, function_bridge_available, client_context_available) ==
    /\ phase = "Idle"
    /\ (profile_id # "")
    /\ (((IF (channel_id \in DOMAIN live_channel_session_by_channel) THEN Some((IF channel_id \in DOMAIN live_channel_session_by_channel THEN live_channel_session_by_channel[channel_id] ELSE "None")) ELSE None) = Some(arg_session_id)) /\ ~((channel_id \in live_revoked_execution_channels)))
    /\ (IF ((requested_mode = "FunctionBridge") /\ (function_bridge_available = TRUE)) THEN TRUE ELSE ((requested_mode = "ClientContext") /\ (client_context_available = TRUE)))
    /\ (~((channel_id \in DOMAIN live_execution_profile_by_channel)) /\ ~((channel_id \in DOMAIN live_execution_mode_by_channel)))
    /\ phase' = "Idle"
    /\ model_step_count' = model_step_count + 1
    /\ live_execution_profile_by_channel' = MapSet(live_execution_profile_by_channel, channel_id, profile_id)
    /\ live_execution_mode_by_channel' = MapSet(live_execution_mode_by_channel, channel_id, requested_mode)
    /\ live_function_bridge_capable_channels' = IF (function_bridge_available = TRUE) THEN (live_function_bridge_capable_channels \cup {channel_id}) ELSE live_function_bridge_capable_channels
    /\ live_client_context_capable_channels' = IF (client_context_available = TRUE) THEN (live_client_context_capable_channels \cup {channel_id}) ELSE live_client_context_capable_channels
    /\ UnchangedFrame_e408d09da2607a8d


