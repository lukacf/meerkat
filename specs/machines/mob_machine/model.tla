CommitMemberRotationLiveKickoffRunning(agent_identity, agent_runtime_id, fence_token, generation, session_id, disposal, next_agent_runtime_id, next_fence_token, next_generation, runtime_mode, external_addressable, kickoff_owed, kickoff_objective_id, definition_wiring_exempt) ==
    /\ phase = "Running"
    /\ ((agent_identity \in DOMAIN member_rotation_session_ids) = TRUE)
    /\ (composition_authority = "Authoritative")
    /\ (kickoff_owed = TRUE)
    /\ (destroy_admitted = FALSE)
    /\ ((agent_runtime_id \in pending_session_ingress_detach_runtime_ids) = FALSE)
    /\ ((IF (agent_identity \in DOMAIN identity_to_runtime) THEN Some((IF agent_identity \in DOMAIN identity_to_runtime THEN identity_to_runtime[agent_identity] ELSE "None")) ELSE None) = Some(agent_runtime_id))
    /\ ((agent_identity \in DOMAIN current_placed_spawn_ids) = FALSE)
    /\ ((agent_identity \in DOMAIN member_placement) = FALSE)
    /\ (agent_runtime_id \in live_runtime_ids)
    /\ ((IF (agent_runtime_id \in DOMAIN runtime_fence_tokens) THEN Some((IF agent_runtime_id \in DOMAIN runtime_fence_tokens THEN runtime_fence_tokens[agent_runtime_id] ELSE "None")) ELSE None) = Some(fence_token))
    /\ ((IF (agent_identity \in DOMAIN identity_runtime_generations) THEN Some((IF agent_identity \in DOMAIN identity_runtime_generations THEN identity_runtime_generations[agent_identity] ELSE "None")) ELSE None) = Some(generation))
    /\ ((IF (agent_runtime_id \in DOMAIN member_state_markers) THEN Some((IF agent_runtime_id \in DOMAIN member_state_markers THEN member_state_markers[agent_runtime_id] ELSE "None")) ELSE None) = Some("Retiring"))
    /\ ((IF (agent_runtime_id \in DOMAIN runtime_retire_pending_sessions) THEN Some((IF agent_runtime_id \in DOMAIN runtime_retire_pending_sessions THEN runtime_retire_pending_sessions[agent_runtime_id] ELSE "None")) ELSE None) = session_id)
    /\ (session_id # None)
    /\ (IF ((IF (agent_identity \in DOMAIN member_session_bindings) THEN Some((IF agent_identity \in DOMAIN member_session_bindings THEN member_session_bindings[agent_identity] ELSE "None")) ELSE None) = None) THEN TRUE ELSE ((IF (agent_identity \in DOMAIN member_session_bindings) THEN Some((IF agent_identity \in DOMAIN member_session_bindings THEN member_session_bindings[agent_identity] ELSE "None")) ELSE None) = session_id))
    /\ (~((agent_identity \in member_kickoff_pending)) /\ ~((agent_identity \in member_kickoff_starting)) /\ ~((agent_identity \in member_kickoff_callback_pending)) /\ mob_machine_placed_kickoff_custody_absent_for_identity(pending_placed_kickoff_outcomes, resolved_placed_kickoff_outcomes, agent_identity))
    /\ (Some(next_generation) = mob_machine_next_minted_generation(identity_runtime_generations, identity_generation_highwater, agent_identity))
    /\ (((next_agent_runtime_id \in live_runtime_ids) = FALSE) /\ (next_agent_runtime_id # agent_runtime_id))
    /\ ((agent_identity \in DOMAIN spawn_profile_authority_profile_names) = TRUE)
    /\ ((IF (agent_identity \in DOMAIN spawn_profile_authority_external_addressable) THEN Some((IF agent_identity \in DOMAIN spawn_profile_authority_external_addressable THEN spawn_profile_authority_external_addressable[agent_identity] ELSE FALSE)) ELSE None) = Some(external_addressable))
    /\ ((IF ((agent_identity \in DOMAIN member_rotation_peer_endpoints) = FALSE) THEN TRUE ELSE (agent_identity \in DOMAIN member_rotation_peer_endpoints)) /\ (IF ((agent_identity \in DOMAIN member_rotation_peer_endpoints) = FALSE) THEN TRUE ELSE mob_machine_member_peer_id_available_for_identity(member_peer_endpoints, member_prior_peer_endpoints, agent_identity, (member_rotation_peer_endpoints)[agent_identity])))
    /\ (IF ((agent_identity \in DOMAIN member_rotation_peer_endpoints) = FALSE) THEN TRUE ELSE (\A host \in mob_hosts : (mob_machine_host_id_matches_peer_id(host, mob_machine_member_peer_endpoint_peer_id((IF "value" \in DOMAIN (IF (agent_identity \in DOMAIN member_rotation_peer_endpoints) THEN Some((IF agent_identity \in DOMAIN member_rotation_peer_endpoints THEN member_rotation_peer_endpoints[agent_identity] ELSE "None")) ELSE None) THEN (IF (agent_identity \in DOMAIN member_rotation_peer_endpoints) THEN Some((IF agent_identity \in DOMAIN member_rotation_peer_endpoints THEN member_rotation_peer_endpoints[agent_identity] ELSE "None")) ELSE None)["value"] ELSE None))) = FALSE)))
    /\ phase' = "Running"
    /\ model_step_count' = model_step_count + 1
    /\ live_runtime_ids' = ((live_runtime_ids \ {agent_runtime_id}) \cup {next_agent_runtime_id})
    /\ externally_addressable_runtime_ids' = IF external_addressable THEN ((externally_addressable_runtime_ids \ {agent_runtime_id}) \cup {next_agent_runtime_id}) ELSE ((externally_addressable_runtime_ids \ {agent_runtime_id}) \ {next_agent_runtime_id})
    /\ runtime_fence_tokens' = MapSet(MapRemove(runtime_fence_tokens, agent_runtime_id), next_agent_runtime_id, next_fence_token)
    /\ identity_runtime_generations' = MapSet(identity_runtime_generations, agent_identity, next_generation)
    /\ identity_runtime_fence_tokens' = MapSet(identity_runtime_fence_tokens, agent_identity, next_fence_token)
    /\ member_startup_binding_requested' = ((member_startup_binding_requested \ {agent_runtime_id}) \ {next_agent_runtime_id})
    /\ member_startup_runtime_ready' = ((member_startup_runtime_ready \ {agent_runtime_id}) \ {next_agent_runtime_id})
    /\ member_startup_ready' = ((member_startup_ready \ {agent_runtime_id}) \ {next_agent_runtime_id})
    /\ member_kickoff_pending' = (member_kickoff_pending \cup {agent_identity})
    /\ member_kickoff_starting' = (member_kickoff_starting \ {agent_identity})
    /\ member_kickoff_callback_pending' = (member_kickoff_callback_pending \ {agent_identity})
    /\ member_kickoff_started' = (member_kickoff_started \ {agent_identity})
    /\ member_kickoff_failed' = (member_kickoff_failed \ {agent_identity})
    /\ member_kickoff_cancelled' = (member_kickoff_cancelled \ {agent_identity})
    /\ member_kickoff_error' = MapRemove(member_kickoff_error, agent_identity)
    /\ member_kickoff_objective_ids' = MapSet(member_kickoff_objective_ids, agent_identity, kickoff_objective_id)
    /\ member_kickoff_input_ids' = MapRemove(member_kickoff_input_ids, agent_identity)
    /\ retained_placed_kickoff_obligations' = MapRemove(retained_placed_kickoff_obligations, agent_identity)
    /\ member_placed_kickoff_outcome_kinds' = MapRemove(member_placed_kickoff_outcome_kinds, agent_identity)
    /\ member_placed_kickoff_outcome_errors' = MapRemove(member_placed_kickoff_outcome_errors, agent_identity)
    /\ member_placed_kickoff_closure_kinds' = MapRemove(member_placed_kickoff_closure_kinds, agent_identity)
    /\ objective_owner_ids' = IF ~((kickoff_objective_id \in DOMAIN objective_owner_ids)) THEN MapSet(objective_owner_ids, kickoff_objective_id, agent_identity) ELSE objective_owner_ids
    /\ member_restore_failures' = MapRemove(member_restore_failures, agent_identity)
    /\ member_restore_failure_codes' = MapRemove(member_restore_failure_codes, agent_identity)
    /\ runtime_retire_refusal_codes' = MapRemove(runtime_retire_refusal_codes, agent_runtime_id)
    /\ runtime_retire_refusal_reasons' = MapRemove(runtime_retire_refusal_reasons, agent_runtime_id)
    /\ runtime_retire_pending_sessions' = MapRemove(runtime_retire_pending_sessions, agent_runtime_id)
